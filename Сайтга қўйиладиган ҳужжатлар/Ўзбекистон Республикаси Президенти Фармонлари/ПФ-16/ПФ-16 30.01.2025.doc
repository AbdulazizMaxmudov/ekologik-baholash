0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">74.</span></span></p></td><td style="border-bottom:1px solid black;width:43%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:15.3pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>56 минг километр </b>автомобиль йўлларини реконструкция қилиш ва таъмирлаш.</span></span></p></td><td style="border-bottom:1px solid black;width:9%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">минг километр</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>3,5</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">0,4</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">2,1</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">3,1</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>3,5</b></span></span></p></td></tr></tbody></table></div></div><div class="FOOTNOTE"><div name="7989213" id="7989213">Изоҳ. Чораклар кесимидаги мақсадли кўрсаткичларга асосий масъул ташкилот раҳбарининг асослантирилган таклифи асосида «Ўзбекистон — 2030» <a href="https://lex.uz/ru/docs/6600413#6605157">стратегиясини</a> амалга ошириш бўйича Республика комиссияси раиси — Бош вазир томонидан ўзгартиришлар (белгиланган йиллик мақсадли кўрсаткичлар доирасида) киритилиши мумкин.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7989214" id="7989214">(6-илова Ўзбекистон Республикаси Президентининг 2025 йил 18 декабрдаги ПФ-254-сонли <a href="https://lex.uz/ru/docs/7932083?ONDATE=22.12.2025 00#7938564">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 22.12.2025 й., 06/25/254/1195-сон)</div></div><div class="BY_DEFAULT"><div name="7372025" id="7372025"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="7372026" id="7372026">Ўзбекистон Республикаси Президентининг 2025 йил 30 январдаги ПФ-16-сон <a href="https://lex.uz/ru/docs/7369703">Фармонига</a><br />7-ИЛОВА</div></div><div class="ACT_TITLE_APPL"><div name="7372275" id="7372275">«Ўзбекистон — 2030» стратегиясининг Сув ресурсларини тежаш ва атроф-муҳитни муҳофаза қилиш йўналиши бўйича 2025 йилга мўлжалланган</div></div><div class="ACT_FORM"><div name="7372276" id="7372276">АМАЛИЙ ТАДБИРЛАР РЕЖАСИ</div></div><div class="BY_DEFAULT"><div name="7372286" id="7372286"></div></div><div class="BY_DEFAULT"><div name="7372289" id="7372289"><table class="Table" style="width:100.0%;border-collapse:collapse;border:none" width="100%"><tbody><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Т/р</span></span></b></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Вазифа</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро муддати</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Молиялаштириш манбалари</span></span></b></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Масъул ижрочилар</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">СУВ РЕСУРСЛАРИНИ ТЕЖАШ ВА АТРОФ-МУҲИТНИ МУҲОФАЗА ҚИЛИШ</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">62-мақсад: Республикада сувдан оқилона фойдаланиш маданиятини ва сув ишлатиш самарадорлигини ошириш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Сув хўжалиги вазирлиги (Ш. Хамраев)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳудудларда <b>сув тежовчи</b> технологияларни жорий қилишни жадаллаштириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Сув тежовчи технологияларни жорий қилиш бўйича талабгорлар кесимида манзилли рўйхатларни тасдиқлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Тасдиқланган манзилли рўйхатларга асосан талабгор ва пудрат корхоналари ўртасида «suvkredit.uz» платформаси орқали шартномалар расмийлаштириш ва молиялаштиришни амалга ошириш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Пудрат шартномаларида белгиланган муддатларда қурилиш-монтаж ишларини якунлаш чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль ойидан бошлаб йил давомида</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Имтиёзли кредит маблағлари ҳамда талабгорларнинг маблағлари</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Абдурахмонов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="2"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллий корхоналарнинг <b>сув тежовчи технологияларни ишлаб чиқариш</b> қувватларини ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сув тежовчи технологияларга бўлган талаб ва эҳтиёжларни инобатга олган ҳолда маҳаллий корхоналарнинг йиллик қувватини камида <b>300 минг</b> гектарга етказиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль ойидан бошлаб йил давомида</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллий ишлаб чиқарувчи корхоналарнинг маблағлари</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Абдурахмонов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="3"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Каналларда сув йўқотилишининг олдини олиш бўйича замонавий ва самарали ёндашувларни жорий қилиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Каналларни бетонлаштириш билан бирга мазкур мақсадларда узоқ муддатга чидамли пленкадан фойдаланиш амалиётини ҳам йўлга қўйиш бўйича таклифларни ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил апрель</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Абдурахмонов),</span></span></i></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — «Ўзсувтаъминот» АЖ (А. Суванкулов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="4"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Барча ичимлик суви таъминоти корхоналарида <b>сифат мониторингини</b> юритиш ва маълумотларни бошқариш марказларини яратиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ҳудудларда ичимлик сув сифати мониторингини юритувчи марказий лаборатория ташкил этиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Барча шаҳар ва туманлардаги ичимлик сув сифатини назорат қилиш учун лабораторияларга бириктириш ёки ҳудудий санитария-эпидемиологик осойишталик ва жамоат саломатлиги бўлимлари билан шартномаларни расмийлаштириш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ичимлик сув сифатини мониторингини юритадиган лабораторияларининг техник жиҳатдан малакалилигини маъқуллаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Корхоналар маблағлари ва бошқа тақиқланмаган манбалар</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="5"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳудудларда оқова тизимини янада ривожлантириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳудудларда <b>155 км</b> узунликдаги замонавий оқова сув тармоқларини барпо этиш ва бу орқали аҳоли учун қулай яшаш шароитларини яратиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга кўра</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Олий Мажлис Сенати (келишув асосида)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="6"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ичимлик суви ва оқова тизимини яхшилаш борасида амалга оширилаётган ишлар устидан парламент назоратини кучайтириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ҳудудларда ичимлик суви ва </span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">оқова тизимини такомиллаштириш юзасидан амалга оширилган ишлар ҳолатини вилоят ҳалқ депутатлари Кенгаши билан биргаликда ўрганиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ўрганиш натижаларини Сенат Кенгашининг сайёр мажлиси муҳокамасига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Ўзсувтаъминот» АЖ</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(А.</span></span></i><i> </i><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Суванкулов</span></span></i><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">маҳаллий ҳокимликлар</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">63-мақсад: Қишлоқ хўжалиги соҳасида сув ресурсларидан оқилона фойдаланишни таъминлаш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Сув хўжалиги вазирлиги (Ш. Хамраев)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="7"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Мелиорация объектларини қуриш ва реконструкция қилиш орқали суғориладиган ерларда <b>шўрланган майдонларни</b> <b>26 минг</b> гектаргача камайтириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Мелиоратив объектларни <b>қуриш</b>, <b>реконструкция қилиш</b> ва <b>таъмирлаш-тиклаш</b> ишлари бўйича йиллик дастурни тасдиқлаш ва ижросини таъминлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Шўр ювиш технологияларига риоя қилган ҳолда ерларни лазерли текислаш, тупроқларни чуқур юмшатиш каби ишларни амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил феврал ойидан бошлаб йил давомида дастурга мувофиқ</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат бюджети ва ташаббускорлар маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодиёт ва молия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Норқулов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Абдурахманов),</span></span></i></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">64-мақсад: Ирригация тизими ва сув тежовчи технологияларни ривожлантириш, соҳа бошқарувига хусусий сектор ва давлат-хусусий шериклик механизмларини кенг жорий этиш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Сув хўжалиги вазирлиги (Ш. Хамраев)</span></span></i></span></span></span></p></td></tr><tr><td rowspan="3" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="8"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" rowspan="3" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги объектларида <b>автоматлаштирилган бошқарув тизими</b>ни жорий қилиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> <b>Автоматлаштириладиган сув хўжалиги объектлари</b> рўйхатини шакллантириш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль</span></span></span></span></span></p></td><td colspan="2" rowspan="3" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга кўра</span></span></span></span></span></p></td><td rowspan="3" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Объектлар бўйича <b>лойиҳа-смета ҳужжатларини ишлаб чиқиш</b>, давлат экспертизасидан ўтказиш ва тендер савдоларини амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил май</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Объектларда белгиланган тартибда қурилиш-монтаж ишларини якунлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="9"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ирригация соҳасига хусусий секторни жалб қилиш, давлат-хусусий шерикликни кенг жорий қилиш ҳисобига хусусий инвестициялар оқимини кўпайтириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлигининг тизим ташкилотлари ҳисобидаги <b>200 та</b> насос станцияларини <b>давлат-хусусий шериклик асосида бошқарувга бериш </b>чораларини кўриш орқали электр энергияси истеъмолини <b>30</b> фоизгача камайтириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республика бюджети ва хусусий шерик маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодиёт ва молия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Умрзаков)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="10"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллаларда ариқлар ҳолатини назорат қилиш ва уларни соз ҳолатда сақлаш чораларини кучайтириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Маҳаллаларда ариқлар ҳолатини ўрганиш ишларини ташкил этиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ёпилиб қолган ва носоз ҳолатдаги ариқларни тиклаш ишларини амалга ошириш. Бунда, маҳалла фаолларини жалб қилган ҳолда маҳалланинг ариқларини тозалаш ва чеккаларига гуллар экиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март — октябрь ойлари мобайнида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон маҳаллалари уюшмаси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Қ. Қуронбоев)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">65-мақсад: «Яшил энергия» технологияларини кенг жорий қилиш доирасида насос станцияларининг электр энергияси истеъмолини камайтириш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Сув хўжалиги вазирлиги (Ш. Хамраев)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="11"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Насос станцияларида энергия тежамкор технологияларни жорий этиш ва энергия истеъмолини камайтириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Эскирган <b>150 та</b> насосларни замонавий энерготежамкор турларига алмаштириш ва <b>6,8 млн кВт/соат электр энергия тежалишига</b> эришиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Энергия тежамкор қурилмалар ўрнатиш ва модернизация қилиш орқали насос станцияларининг йиллик электр энергия истеъмолини <b>6,8 млрд кВт дан оширмаслик </b>чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат бюджети маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">66-мақсад: Республикада экологик вазиятни тубдан яхшилаш, инсон ҳаётига таъсир ўтказувчи экологик муаммоларни бартараф этиш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="12"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Эко Экспо»</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> <b>халқаро кўргазмасини</b> ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Салбий оқибатларни юмшатиш, чиқиндиларни бошқаришга қаратилган илмий асосланган ва иқлим шароитига мос келадиган технологияларни жалб қилиш мақсадида «Эко Экспо» халқаро кўргазмасини, шу жумладан онлайн шаклда ташкил этиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">маҳаллий тадбиркорлар иштирокига</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Савдо-саноат палатаси;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Билимлар макони»</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> павильонини ташкил этишга ва унда барча олий таълим ва илмий-тадқиқот муассасалари иштирок этишига — Олий таълим, фан ва инновациялар вазирлиги, Фанлар Академияси;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">хорижий компаниялар ва ҳамкорлар иштирокига</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Ташқи ишлар вазирлиги, Инвестициялар, саноат ва савдо вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил молия ва яшил иқтисодиёт» </span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">павильонини ташкил этишга ва қатнашувчиларнинг иштирокини таъминлашга — Марказий банк, Иқтисодиёт ва молия вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил қурилиш ва бинолар»</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> павильонини ташкил этишга ва қатнашувчиларнинг иштирокини таъминлашга — Қурилиш ва уй-жой коммунал хўжалиги вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил маданият»</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> павильонини ташкил этишга — Маданият вазирлиги ва Ёшлар ишлари агентлиги масъул этиб белгилаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил июнь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ташкилотларнинг бюджетдан ташқари маблағлари, тақиқланмаган бошқа манбалар,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ҳомийлик ва грант маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Савдо-саноат палатаси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Д. Вахобов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Олий таълим, фан ва инновациялар вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Қ. Шарипов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фанлар академияси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Аюпов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Инвестициялар, саноат ва савдо вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Л. Қудратов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Марказий банк</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Т. Ишметов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодиёт ва молия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Норқулов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Хидоятов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маданият вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(О. Назарбеков)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ёшлар ишлари агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(А. Саъдуллаев)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="13"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Атроф-муҳитни муҳофаза қилиш соҳасига халқаро донорларнинг грант маблағларини жалб қилиш ва лойиҳа таклифларини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Атроф-муҳитни муҳофаза қилиш соҳасига халқаро донорларнинг грант маблағларини жалб қилиш ва лойиҳа таклифларини ишлаб чиқиш бўйича Экология вазирлигига 10 нафар хорижий консультантларни жалб қилиш ва 2025 йилда камида 30 миллион АҚШ доллари миқдоридаги грант маблағларини жалб қилиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил июлдан бошлаб</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Халқаро молия институтлари маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Инвестициялар, саноат ва савдо вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Л. Қудратов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="14"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Бир миллион яшил оила» умуммиллий ҳаракати доирасида «Соғлом турмуш тарзи» платформасини қайта тиклаб, уни ўз ичига олувчи «Экофаол фуқаро» платформасини ишга тушириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Қўшма чора-тадбирлар режасини ишлаб чиқиш ва тасдиқлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> «Соғлом турмуш тарзи» платформасини қайта тиклаш ва уни ўз ичига олувчи «Экофаол фуқаро» платформасини яратиш бўйича техник топшириқни ишлаб чиқиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Платформаларни ишга тушириш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">4.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> «Бир миллион яшил оила» умуммиллий ҳаракати доирасида юқори кўрсаткичларга эришган оила аъзолари учун «Экофаол фуқаро» мақомини олиш тартибини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил май</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология жамғармаси маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Рақамли технологиялар вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Шерматов)</span></span></i></span></span></span></p></td></tr><tr><td rowspan="4" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="15"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" rowspan="4" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университетига ҳар бир вилоятда <b>1 та</b>дан техникумни бириктириш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил» техникумлар фаолиятини самарали йўлга қўйиш мақсадида:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил» техникумлар ташкил этиладиган касбий таълим ташкилотларини Университетга бириктириш;</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил июнь</span></span></span></span></span></p></td><td colspan="2" rowspan="4" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга асосан,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан ажратилган маблағлар доирасида,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">жисмоний ва юридик шахсларнинг ҳомийлик хайриялари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">халқаро молия институтлари ва хорижий ташкилотларнинг грантлари</span></span></span></span></span></p></td><td rowspan="4" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Олий таълим, фан ва инновациялар вазирлиги,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Қ. Шарипов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат активларини бошқариш агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(А. Ортиқов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Кадастр агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ф. Пўлатов)</span></span></i></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университети</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил» техникумлар атрофида амалий машғулотларни олиб бориш учун Экология вазирлигининг талабномасига кўра ботаника ёки дендрология боғларини ташкил этиш учун зарур ер майдонларини ажратиш;</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил сентябрь</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил» техникумлар биноларини қайта таъмирлаш ва жиҳозлаш бўйича лойиҳа ҳужжатларини (ишчи лойиҳа, иш ҳужжатлари, лойиҳа-смета ҳужжатлари) ишлаб чиқиш;</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил октябрь</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил» техникумлар атрофида боғлар ташкил этиш ва унда олиб бориладиган амалий машғулотлар бўйича дастур ишлаб чиқиш</span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил ноябрь</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="16"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экологик назорат инспекцияси назоратини самарадорлигини тубдан ошириш, уларнинг ходимларини махсус восита ва транспортлар билан таъминлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология назорати инспекцияси автотранспорт воситаларини махсус товуш чиқарувчи, ёритувчи ускуналар ва ажратувчи белгилари билан жиҳозлаш ва уларни махсус автотранспорт воситаси тоифасига киритиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Инспекторларни махсус хизмат қуроли (электрошокер, резина ўқли, тўр отувчи) билан таъминлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил апрель</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республика бюджети маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодиёт ва молия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Норқулов</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">)</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="17"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқлим ўзгаришига мослашиш ва унинг салбий оқибатларини юмшатиш чораларини кенг тарғиб қилиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Энергосамарадор, камчиқитли, сув тежовчи ва яшил технологияларни ўз ичига олган очиқ ва ҳамма эркин фойдаланиши мумкин бўлган ахборот платформани ташкил этиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда платформани даврий янги технологиялар билан бойитиб бориш:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">яшил қурилиш йўналиши бўйича — Қурилиш ва уй-жой коммунал хўжалиги вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">энергия самарадорлик бўйича — Энергетика вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">сув тежовчи технологиялар бўйича — Сув хўжалиги вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">яшил ишлаб чиқариш бўйича — Иқтисодиёт ва молия вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">барқарор қишлоқ хўжалиги бўйича — Қишлоқ хўжалиги вазирлиги;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">яшилликни ошириш — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил ноябрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология жамғармаси маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Рақамли технологиялар вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Шерматов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Хидоятов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Энергетика вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ж. Мирзамахмудов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Хамраев)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодиёт ва молия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Норқулов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Абдурахмонов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Инвестициялар, саноат ва савдо вазирлиги (Л. Қудратов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="18"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республикада ишлаб чиқарилаётган маҳсулотларнинг «Эко» брендини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Республикада ишлаб чиқарувчиларни ўрганган ҳолда «Эко» бренди ишлаб чиқарувчилар рўйхатини тузиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Харидорларнинг экологик маҳсулотларга бўлган талабини қондириш мақсадида республикада ишлаб чиқарилаётган маҳсулотларнинг «Эко» брендини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил май</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижрочилар маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Савдо-саноат палатаси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Д. Вахобов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="19"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳудудий «ин-витро» лабораторияларини ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳудудий «ин-витро» лабораторияларини ташкил этиш учун халқаро молия институтларидан камида <b>30 миллион АҚШ доллари</b> миқдорида инвестициялар жалб этиш. Бунда:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">республиканинг мавжуд иқлим зоналари ва улардаги шароитлардан келиб чиқиб Қорақалпоғистон Республикаси, Бухоро, Сурхондарё, Жиззах, Фарғона ва Тошкент вилоятларида «ин-витро» лабораторияларини ташкил этиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">хусусий «ин-витро» лабораторияларини ташкил этиш учун тадбиркорлик субъектларига кредит ажратиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Халқаро молия институтлари маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><i>(А. Абдухакимов)</i>,</span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Олий таълим, фан ва инновациялар вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Қ. Шарипов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, Бухоро, Сурхондарё, Жиззах, Фарғона ва Тошкент вилоятлари ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Мудофаа вазирлиги (Ш. Холмухамедов)</span></span></i></span></span></span></p></td></tr><tr><td rowspan="2" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="20"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" rowspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Овчиларга муқобил машғулот сифатида республика ҳудудларида ўқ отиш спортини ривожлантириш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Республиканинг барча ҳудудларида ўқ отиш спортига ихтисослаштирилган махсус полигонларда хизмат кўрсатилишини йўлга қўйиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март ойидан бошлаб</span></span></span></span></span></p></td><td colspan="2" rowspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td rowspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ҳамда Тошкент шаҳри ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодиёт ва молия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Норқулов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ўқ отиш спортига ихтисослаштирилган янги машқ полигонларини ташкил этиш учун зарур бўлган ер майдонлари қонун ҳужжатларида белгиланган тартибда ажратилишини таъминлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил апрель</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Ветеринария ва чорвачиликни ривожлантириш қўмитаси (Б. Норқобилов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="21"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Шаҳарларда оқиб ўтувчи табиий сув ҳавзалари ихтиофаунасининг популяциясини қайта тиклаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республиканинг марказий шаҳарларида оқиб ўтувчи дарё ва сойларда 15 тоннадан кам бўлмаган чавоқлантириш ишларини амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил июнь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Ўзбекбалиқсаноат» уюшмаси</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Ташқи ишлар вазирлиги (Б. Саидов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="22"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистоннинг халқаро майдондаги ижобий имиджини янада мустаҳкамлаш ва ташаббусларини илгари суриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Манфаатдор вазирлик ва идораларнинг истеъдодли мутахассисларини уларга зарур шарт-шароитлар яратиш орқали тегишли йўналишлар бўйича халқаро ташкилотларда фаолият юритишини йўлга қўйиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март ойидан бошлаб</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="23"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳайвонларни сақлаш ва парваришлаш ишларини амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">14 та ҳудудда</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> қаровсиз ҳайвонларни сақлаш ва парваришлашга мўлжалланган питомникларни (приют) ташкил этиш учун маблағлар йўналтириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил апрель</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллий бюджет маблағлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ҳомийлар маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td rowspan="2" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="24"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" rowspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Халқаро аҳамиятга эга бўлган автомобиль йўллари бўйида электромобилларни зарядлаш станцияларини ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Халқаро аҳамиятга эга бўлган автомобиль йўлларида жойлашган мавжуд АЁҚШ (автомобилларга ёқилғи қуйиш шохобчаси) ва АГТКШ (автомобилларга газ тўлдириш компрессор шохобчаси)ларда электромобилларни зарядлаш станцияларини ташкил этиш бўйича дислокациясини белгилаш ва Вазирлар Маҳкамасига тақдим қилиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил май</span></span></span></span></span></p></td><td colspan="2" rowspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тадбиркорларнинг ўз маблағлари ҳисобидан</span></span></span></span></span></p></td><td rowspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Энергетика вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ж. Мирзамахмудов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Савдо-саноат палатаси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Д. Вахабов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Электромобилларни зарядлаш станцияларини ташкил этиш чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил якунига қадар</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">67-мақсад: Экологик вазиятни барқарорлаштиришга қаратилган «Яшил макон» умуммиллий лойиҳасини кенгайтириш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p class="a2" style="text-align:center"><span style="font-size:13pt"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></span></i></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="25"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил макон»</span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> умуммиллий лойиҳаси доирасида 200 миллион туп манзарали ва мевали дарахтлар ҳамда буталар кўчатлари ва қаламчаларини экиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> «Яшил макон» умуммиллий дастури доирасида ҳудудларнинг тупроқ-иқлим шароитига мос кўчат турларини танлаб, баҳорги ва кузги мавсум учун манзилли дастурларни ишлаб чиқиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Маҳаллий ҳокимликлар томонидан ишлаб чиқилган манзилли дастурларни тасдиқланган ҳолда Экология вазирлигига киритиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> «Яшил макон» умуммиллий дастури доирасида баҳорда <b>125</b><b> миллион</b> туп ва кузда <b>75 миллион</b> туп манзарали, мевали дарахтлар ва буталар кўчатлари ҳамда қаламчаларини экишни ташкил этиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">4.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Лойиҳа доирасида кўчат экиш ишларини ташкиллаштиришда маҳалла фуқаролар йиғинлари билан ҳамкорликни йўлга қўйиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил баҳорги ва кузги кўчат экиш мавсумларида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан яшил макон лойиҳасига ажратилган маблағлар,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">бюджетдан ташқари маблағлар,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ҳомийлик ва грант маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td rowspan="3" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="26"><li align="center" class="a" style="text-align:center"></li></ol></td><td rowspan="3" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республикада «яшил боғлар» барпо этиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрининг туман (шаҳар)ларида «яшил боғлар» барпо этиш учун ер майдонларини танлаш, (талаб этилса ажратиш юзасидан тегишли қарор ёки фармойиш қабул қилиш).</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль</span></span></span></span></span></p></td><td colspan="2" rowspan="3" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳомийлик ва грант маблағлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан ажратилган маблағлар доирасида,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">бюджетдан ташқари тақиқланмаган бошқа манбалар</span></span></span></span></span></p></td><td rowspan="3" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Танланган (ажратилган) ер майдонларида «яшил боғлар» барпо этиш учун «Яшил лойиҳа» лойиҳалаш институти билан шартномалар тузиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда ажратилган ер майдонларида ҳудуднинг тупроқ-иқлим шароитига мос дарахт ва буталар турини танлаш, экиш схемасини белгилаш, парваришлаш, суғориш ва уч йил муддатга бириктириш тизимлари назарда тутилган лойиҳалаш ва харажатлар-смета ҳужжатларини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Танланган ер майдонларида лойиҳа ҳужжатлари асосида «яшил боғлар» барпо этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил ноябрь-декабрь</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="27"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Барча шаҳарларни</span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> тўлиқ «яшил белбоғ»лар билан қамраб олиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> «Яшил белбоғ»ларни барпо этиш учун ер майдонларини белгилаш, уларни белгиланган тартибда ажратиш бўйича чоралар кўриш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Барпо этиладиган «яшил белбоғ»ларнинг лойиҳа-смета ҳужжатларини ишлаб чиқиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Тайёрланган лойиҳа-смета ҳужжатлари асосида тупроқ ва иқлим шароитига мос дарахт турларини танлаган ҳолда «яшил белбоғ»ларни барпо этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йилдан бошлаб</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳомийлик ва грант маблағлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан ажратилган маблағлар доирасида,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">бюджетдан ташқари тақиқланмаган бошқа манбалар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар, Тошкент шаҳри, туман ва шаҳарлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="28"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ҳар бир йирик саноат корхонаси ҳудудида ва унга туташ ҳудудларда «яшил белбоғ»ларни барпо этиш.</span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Атроф-муҳитга таъсир кўрсатишнинг юқори ва ўрта даражадаги хавфли саноат корхоналари ва уларга туташ ҳудудларида «яшил белбоғ»лар барпо этиш учун ҳудудларда фаолият юритиб келаётган саноат корхоналари рўйхатини шакллантириш ва ҳудуднинг тупроқ-иқлим шароитидан келиб чиқиб дарахт ва бута кўчатларини танлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Саноат корхоналари атрофида «яшил белбоғ»лар барпо этиш учун 10 миллион дона дарахт ва бута кўчатлари экишни таъминлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль ойидан бошлаб йил давомида</span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Хўжалик юритувчи субъектлар маблағлари</span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Манфаатдор вазирлик ва идоралар</span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p class="a2" style="text-align:center"><span style="font-size:13pt"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Иқтисодиёт ва молия вазирлиги (И. Норқулов)</span></span></i></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="29"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Туман (шаҳар) марказларида ҳамда соҳил ва дарё бўйларида пиёда ва велосипед йўлаклари, сояли сайр кўчаларини тармоғини ташкил этиш орқали аҳолига қулай маскан яратиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Туман (шаҳар) марказларида ҳамда соҳил ва дарё бўйларида хизматлар инфратузилмасини ривожлантиришни инобатга олган ҳолда соҳил ва дарё бўйларида пиёда ва велосипед йўлаклари, сояли сайр кўчаларини ташкил этишни назарда тутувчи лойиҳалар концепциясини ва мастер режаларини ишлаб чиқиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Аҳоли<b> </b></span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">учун пиёда ва велосипед йўлакларида дарахтлар ва ўсимликларни экиш, <b>80 та</b> инфратузилма объектларини ҳамда <b>110 километр</b>дан ортиқ <b>соғломлаштириш йўлаклари</b> қуриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Халқаро молия институтлари, грант маблағлари, қонунчиликда тақиқланмаган бошқа манбалар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қурилиш ва уй-жой-коммунал хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Хидоятов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="30"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Мамлакатимизнинг халқаро углерод савдоси (carbon trading system) бозорида иштирокини фаоллаштириш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил макон» лойиҳаси ва «яшиллаштириш» бўйича лойиҳалар доирасида углерод савдосини йўлга қўйиш бўйича таклифларни ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил май</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">68-мақсад: Ўрмонлар майдонини кенгайтириш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="31"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон билан қопланган майдонларни 4,1 миллион гектарга етказиш ва муҳофаза қилинадиган табиий ҳудудларни 14,5 фоизгача кенгайтириш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Тегишли туманлар ҳокимликларининг захирасидаги табиий ўрмонзорларни ўрмон хўжаликларига доимий фойдаланиш учун ажратиш тўғрисидаги маҳаллий ҳокимликлар қарорларини қабул қилиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ўрмон фонди ер майдонларида ўрмонларни кенгайтириш тадбирларини амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигига ажратилган маблағлар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳамда тегишли туманлар ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="32"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Чўл, тоғли ва тоғолди ҳудудларда чўлланиш ва қум кўчиши, тупроқнинг сув ва шамол эрозиясининг олдини олиш ҳамда экологик муҳитни яхшилаш мақсадида ҳимоя ўрмонларини (иҳота) барпо этиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ер майдонларини танлаш ва лойиҳа-смета ҳужжатларини ишлаб чиқиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Молиялаштириш масаласини ҳал қилиш, ҳисоб-китоб асосида талаб этиладиган маблағларни ажратиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Белгиланган ҳудудларда иҳота дарахтзорларини барпо этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль ойидан бошлаб</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигига ажратилган маблағлар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳамда тегишли туманлар ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="33"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Дарахт ва бута уруғлари тайёрлашни 1 050 тоннага ошириш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Тупроқ-иқлим шароитидан келиб чиққан ҳолда дарахт-буталар уруғларини жамғариш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Жамғарилган уруғларни экиш мавсумига қадар вақтинча сақлаш ва ниҳолхоналарга экиш ишларини амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль ойидан бошлаб</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигига ажратилган маблағлар</span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов)</span></span></i></span></span></span></p></td></tr><tr><td rowspan="2" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="34"><li align="center" class="a" style="text-align:center"></li></ol></td><td rowspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Доривор ва озиқ-овқатбоп ўсимликлар хомашёсини 10 002<b> </b>тоннага етказиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Доривор ўсимликларнинг маданий плантацияларини ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил баҳор ва куз мавсуми</span></span></span></span></span></p></td><td colspan="2" rowspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўз маблағлари ҳисобидан</span></span></span></span></span></p></td><td rowspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Табиий ҳолда ўсувчи доривор ўсимликларни табиий муҳитдан йиғиш учун квота миқдорини шакллантириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></span></p></td></tr><tr><td rowspan="2" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="35"><li align="center" class="a" style="text-align:center"></li></ol></td><td rowspan="2" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фойдаланилмаётган ўрмон фонди ер майдонларини ўзлаштириш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ўрмон хўжаликларида фойдаланилмаётган ерларни ўзлаштириш учун ер майдонларини танлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Жами <b>7 минг гектар</b> майдонда фойдаланилмаётган ер майдонларини ўзлаштириш ҳамда улардан самарали фойдаланиш чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат ўрмон хўжаликларига ажратилган маблағлар доирасида</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3. </span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон фонди ерларини тўлиқ хатловдан ўтказиб, улардан самарасиз ва ноқонуний фойдаланиш ҳолатларини аниқлаш ва белгиланган тартибда бартараф этиш чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март ойидан бошлаб йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов),</span></span></i></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бош прокуратура</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Тўхтабоев)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="36"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжаликларида ниҳол ва кўчатлар етиштиришни <b>123</b> млн тупга етказиш.</span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Кўчатхона ва ниҳолхоналар ташкил этиш мақсадида ер тайёрлаш ва экиш ишларини ташкил этиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Кўчатхоналарда агротехник тадбирларни амалга ошириш (суғориш, қатор ораларига ишлов бериш, бегона ўтлардан тозалаш) ҳамда парвариш қилиш ишларини олиб бориш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ижрочилар маблағлари</span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="37"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Терасса»</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> усулида дарахтлар кўчатларини экиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="tab-stops:15.25pt 22.15pt 29.4pt"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1. </span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тоғ ва тоғолди ҳудудларида ер майдонларида кўчатлар экиладиган ҳудудларни белгилаш, дарахт турларини танлаш, лойиҳа-смета ҳужжатларини ишлаб чиқиш.</span></span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="tab-stops:15.25pt 29.4pt"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2. </span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сурхондарё, Қашқадарё, Самарқанд, Жиззах, Наманган вилоятларидаги 14 туманлар ҳудудларидаги тоғ ва адир қияликларида жами <b>480 гектар</b><b> майдонда терасса</b> усулида тупроқ-иқлим шароитга мос дарахтларни кўчатларини экиш.</span></span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Ўзбекистонда барқарор ўрмон ландшафтларини тиклаш» лойиҳаси доирасида ажратиладиган маблағлар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сурхондарё, Қашқадарё, Самарқанд, Жиззах, Наманган вилоятлари ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="38"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳудудларнинг жойлашувидан ва тупроқ-иқлим шароитларидан келиб чиқиб давлат ўрмон хўжаликларини кўчатчиликка <b>ихтисослаштириш</b>.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">18 та давлат ўрмон хўжаликларини кўчат етиштиришга ихтисослаштириш. Бунда:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«илм-лойиҳа-амалиёт» занжирида генетик селекция ишлари кучайтирилиб, уруғчилик лабораториялари, интенсив тажриба участкалари ва «оналик» плантациялари фаолиятини йўлга қўйиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">уруғларни генетик таҳлил қилиш, ўсувчанлигини таъминлаш, уруғларни сертификация қилишни амалга ошириш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">хориждан унумдор уруғ, ниҳол ва кўчатларни олиб келиш ҳамда уларни интродукция қилиш ва районлаштириш дастурини ишлаб чиқиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">интенсив амалиёт тажриба участкалари ва уруғчилик оналик плантациялари ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 — 2030 йиллар давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигига ажратилган маблағлар,</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">қонунчиликда тақиқланмаган бошқа манбалар</span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги агентлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Э. Муҳитдинов),</span></span></i></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодиёт ва молия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Норқулов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳамда тегишли туманлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="39"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тошкент вилояти ва Тошкент шаҳрида яшиллик даражасини ошириш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Тошкент шаҳри Мирзо Улуғбек туманидаги Фанлар академиясининг Ядровий физика институти ва унга туташ бўлган 100 гектарда (Мирзо Улуғбек кичик шаҳарчаси) «яшил боғ» яратиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Яшнобод ва Мирзо Улуғбек туманларидаги Чирчиқ дарёси чегараларида камида 50 мингта дарахт кўчатларини экиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Кичик ва катта ҳалқа автомобиль йўли бўйлаб дарахт ва бута кўчатларини экиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Маҳаллий бюджет маблағлари</span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тошкент вилояти ва Тошкент шаҳри ҳокимликлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фанлар академияси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Аюпов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">69-мақсад: Оролбўйи минтақасида экологик вазиятни барқарорлаштириш, Орол денгизи қуриши натижасида юзага келган экологик муаммоларнинг салбий таъсирини юмшатиш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Тоғ-кон саноати ва геология вазирлиги (Б. Исламов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="40"><li align="center" class="a" style="text-align:center"></li></ol></td><td colspan="2" style="border-bottom:1px solid black;width:20%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фойдали қазилмаларни қазиб олиш натижасида бузилган ер майдонларини рекультивация қилиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2 075 гектар</span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> бузилган ер майдонининг рекультивация қилинишини таъминлаш, мазкур соҳада экологик назорат тадбирларини амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китоблар асосида</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><i>(А. Абдухакимов)</i>,</span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b><i>Ижро учун асосий масъул</i></b><i> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</i></span></span></p></td></tr><tr><td rowspan="3" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="41"><li align="center" class="a" style="text-align:center"></li></ol></td><td rowspan="3" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Оролбўйи минтақасидаги ўрмонзорларни 2,1 млн гектарга етказиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Орол денгизининг қуриган тубида ва Оролбўйи минтақасида ўрмон барпо этиладиган майдонларни аниқлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Қорақалпоғистон Республикаси, Бухоро, Навоий ва Хоразм вилоятларида «яшил қопламалар» барпо этиш бўйича лойиҳа ҳужжатларини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль</span></span></span></span></span></p></td><td colspan="2" rowspan="3" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга кўра,</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан ажратилган маблағлар доирасида,</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">ҳомийлик ва грант маблағлари</span></span></p></td><td rowspan="3" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, Хоразм, Навоий ва Бухоро вилояти ҳокимликлари</span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Молиялаштириш масаласини ҳал этиш, талаб этиладиган маблағларни ажратиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">4.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ўрмон барпо этиш ишларини амалга ошириш ва умумий ўрмонзорлар майдонини 2,1 млн гектарга етказиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">70-мақсад: Иқлим ўзгариши салбий таъсирининг олдини олиш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Ўрмон хўжалиги агентлиги (Э. Мухитдинов)</span></span></i></span></span></span></p></td></tr><tr><td rowspan="4" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="42"><li align="center" class="a" style="text-align:center"></li></ol></td><td rowspan="4" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Чўлланиш, қурғоқчилик, чанг-қум бўронлари ва ҳароратнинг кўтарилишига қарши чора сифатида жами<b> 200 минг гектар</b> майдонда «яшил қопламалар» — ҳимоя ўрмонзорларини барпо этиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Орол денгизининг қуриган тубида ва Оролбўйи минтақасида ўрмон барпо этиладиган майдонларни аниқлаш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль</span></span></span></span></span></p></td><td colspan="2" rowspan="4" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга кўра,</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан ажратилган маблағлар доирасида,</span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ҳомийлик ва грант маблағлари</span></span></span></span></span></p></td><td rowspan="4" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><i>(А. Абдухакимов)</i>,</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, Хоразм, Навоий ва Бухоро вилояти ҳокимликлари</span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Қорақалпоғистон Республикаси, Бухоро, Навоий ва Хоразм вилоятларида «яшил қопламалар» барпо этиш бўйича лойиҳа ҳужжатларини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил февраль</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Молиялаштириш масаласини ҳал этиш, талаб этиладиган маблағларни ажратиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">4.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Орол денгизининг қуриган тубида ва Оролбўйи минтақасида 200 минг гектарда «яшил қопламалар» — ҳимоя ўрмонзорларини барпо этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="43"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Шинжон экология ва география институтининг Марказий Осиёдаги қўшма илмий-тадқиқот марказини ташкил қилиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Замонавий қўшма илмий-тадқиқот лабораторияси ва ўқув-амалиёт корпусларини ташкил этиш учун собиқ Тошкент туризм ва сервис коллежи бино ва иншоотларини капитал таъмирлаш ва реконструкция қилиш ҳамда замонавий қўшма илмий-тадқиқот лабораторияси ва ўқув-амалиёт корпусларини қуриш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Шинжон экология ва география институтининг Марказий Осиёдаги қўшма илмий-тадқиқот марказини ташкил қилиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март ойидан бошлаб</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга кўра,</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан ажратилган маблағлар доирасида,</span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ҳомийлик ва грант маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Олий таълим, фан ва инновациялар вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Қ. Шарипов)</span></span></i></span></span></span></p></td></tr><tr><td rowspan="5" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="44"><li align="center" class="a" style="text-align:center"></li></ol></td><td rowspan="5" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Булутлардан сунъий ёғин ёғдириш усуллари ва технологияларини ўрганиш ҳамда технологияни келгусида Ўзбекистонда маҳаллийлаштириш масаласини кўриб чиқиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:justify;text-indent:15.1pt"><span style="font-size:13pt"><span style="tab-stops:53.3pt"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ишчи гуруҳни шакллантириш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил июль</span></span></span></span></span></p></td><td colspan="2" rowspan="5" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Хўжалик юритувчи субъектларнинг маблағлари</span></span></p></td><td rowspan="5" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Хамраев)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Абдурахмонов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Инвестициялар, саноат ва савдо вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Л. Қудратов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:justify;text-indent:15.1pt"><span style="font-size:13pt"><span style="tab-stops:53.3pt"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Услуб ва технологияларни ўрганиш, методларни аниқлаш ва самарадорлигини баҳолаш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил август</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:justify;text-indent:15.1pt"><span style="font-size:13pt"><span style="tab-stops:53.3pt"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Мазкур технологияни маҳаллийлаштириш имкониятларини таҳлил қилиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил август</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:justify;text-indent:15.1pt"><span style="font-size:13pt"><span style="tab-stops:53.3pt"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">4.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Лойиҳани амалга ошириш бўйича тавсиялар ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил сентябрь</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:justify;text-indent:15.1pt"><span style="font-size:13pt"><span style="tab-stops:53.3pt"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">5</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">. Вазирлар Маҳкамасига таклифларни киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил октябрь</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">71-мақсад: Биологик хилма-хиллик ишончли сақланишини таъминлаш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="45"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="tab-stops:83.0pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Трансчегаравий муҳофаза этиладиган табиий ҳудудлар ташкил этиш чораларини кўриш.</span></span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:justify;text-indent:15.1pt"><span style="font-size:13pt"><span style="tab-stops:right 146.4pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қўшни давлатлар билан чегара ҳудудларда трансчегаравий муҳофаза этиладиган табиий ҳудудлар ташкил этиш бўйича таклиф киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил </span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">февраль ойидан бошлаб йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ташқи ишлар вазирлиги</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><i>(Б. Саидов)</i></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="46"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси Қизил китобининг янги (олтинчи) нашрини тайёрлаш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ўзбекистон Республикаси Қизил китобининг олтинчи нашрини Халқаро табиатни муҳофаза қилиш иттифоқи тоифалари ва мезонлари асосида тайёрлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Қизил китобга киритилган турларнинг муҳофазаси борасидаги мақомини халқаро стандартларга мослаштириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил декабрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология жамғармаси</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фанлар академияси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Аюпов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="47"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республика ҳудудидаги танлаб олинган ёввойи ҳолда ўсувчи истиқболли хомашёбоп доривор, озуқабоп ва техник ўсимликларнинг давлат рўйхати ва кадастрини яратиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a" style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Танлаб олинган ёввойи ўсимлик турларини илмий манбалар асосида камерал ўрганиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ёввойи ўсимлик турларини хатловдан ўтказиш мақсадида илмий экспедициялар ташкил этиш.</span></span></span></span></span></p><p class="a" style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ёввойи ўсимлик турларини давлат рўйхати ва кадастрини яратиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил ноябрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат бюджетидан ажратилган маблағлар доирасида, бюджетдан ташқари ва тақиқланмаган бошқа манбалар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фанлар академияси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Аюпов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="48"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикасининг Қизил китобига киритилган питомникларда сунъий етиштирилган <b>4000 бош</b> йўрға тувалоқ қушларини табиатдаги популяцияларини тиклаш мақсадида табиатга қўйиб юбориш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Йўрға тувалоқ қушларини уларнинг биоэкологик хусусиятларини инобатга олиб, табиий яшаш муҳитига қўйиб юбориш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил </span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ноябрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ташаббускор ташкилотлар маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фанлар академияси</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Ш. Аюпов)</span></span></i></span></span></span></p></td></tr><tr><td rowspan="4" style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="49"><li align="center" class="a" style="text-align:center"></li></ol></td><td rowspan="4" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Яшил макон» умуммиллий лойиҳаси доирасида республика ҳудудидаги 450 минг туп дарахтларни рақамлаштириш орқали уларнинг паспортини яратиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ҳудудларда маҳаллий давлат ҳокимияти органларининг дарахтлар хатловини ўтказиш бўйича ишчи гуруҳ таркибини тасдиқлаш бўйича қарорларини қабул қилиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></span></p></td><td colspan="2" rowspan="4" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Вазирлик ва идораларнинг бюджетдан ташқари жамғармалари маблағлари,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">корхона ва ташкилотларнинг ўз маблағлари</span></span></span></span></span></p></td><td rowspan="4" style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Аэрокосмик тасвирлар ва дастурий воситалардан фойдаланган ҳолда мавжуд дарахтларни тўлиқ хатловдан ўтказиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил апрель — сентябрь</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ишчи гуруҳларга «Яшил макон» электрон платформасининг маълумотлар базасида дарахтларнинг тури, ёши, бўйи, ҳолати ва жойлашув координатаси бўйича хатловдан ўтказиши учун алоҳида модуллар яратиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил август</span></span></span></span></span></p></td></tr><tr><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">4.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Маълумотлар базаси асосида «Яшил макон» электрон платформасида ҳар бир дарахтнинг паспортини шакллантириш ҳамда ID рақам бериш (<i>якка тартибдаги уй-жойлар ҳудудидаги дарахтлар бундан мустасно</i>).</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил октябрь</span></span></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Савдо-саноат палатаси (Д. Вахабов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="50"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Биологик хилма-хилликни сақлаш доирасида асалари оиласи популяциясини тиклаш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Мамлакатимизда биологик хилма-хилликни сақлаш доирасида асалари оиласи популяциясини тиклаш бўйича чора-тадбирларни ишлаб чиқиш ва амалга ошириш ишларини йўлга қўйиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Абдурахмонов),</span></span></i></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">72-мақсад: Қаттиқ маиший чиқиндиларни тўплаш ва олиб чиқиш хизматлари сифатини яхшилаш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Экология, атроф муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="51"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маиший чиқиндиларни бошқариш инфратузилмасини такомиллаштириш</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> 3 та ҳудудда (Ангрен шаҳар — 1 та, Оққўрғонда — 1 та, Паркентда — 1 та) маиший чиқинди полигонларининг 30,9 гектар ер майдонида рекультивация ишларини бажариш ва фаолиятини тўхтатиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> 5 та (Ангрен, Олмалиқ, Бекобод шаҳарлари ва Оққўрғон, Қуйи Чирчиқ туманларида) қайта юклаш станцияларни ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:center"><span style="font-size:13pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 — 2027 йиллар</span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга кўра</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тошкент вилояти ҳокимлиги</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="52"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="tab-stops:83.0pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маиший, қурилиш, тиббиёт, саноат, хавфли ва заҳарли чиқиндиларни ташиш фаолиятини лицензиялаш тартибини жорий этиш.</span></span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Республикада чиқиндиларнинг атроф-муҳитга салбий таъсирини камайтириш ва уларни бошқаришни такомиллаштириш мақсадида маиший, қурилиш, тиббиёт, саноат, хавфли ва заҳарли чиқиндиларни ташишни самарали ташкил этиш фаолиятини лицензиялаш тартибини жорий этиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:center"><span style="font-size:13pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил ноябрь</span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Адлия вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(А. Ташкулов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="53"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="tab-stops:83.0pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Чиқиндиларни ҳосил бўлиш меъёри, морфологик таркиби ва углерод изини ўрганиш бўйича илмий-тадқиқот ишларини олиб бориш.</span></span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Чиқиндиларни ҳосил бўлиш меъёри, морфологик таркиби ва углерод изини ўрганиш бўйича илмий-тадқиқот ишлари учун 2 млрд сўм маблағ ажратиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:center"><span style="font-size:13pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология жамғармаси</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Олий таълим, фан ва инновациялар вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Қ. Шарипов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Иқтисодиёт ва молия вазирлиги (Г. Рахимова)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="54"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="tab-stops:83.0pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қайта ишланган иккиламчи хомашёдан фойдаланувчиларни рағбатлантириш.</span></span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Қайта ишланган иккиламчи хомашё асосида ва циркуляр иқтисодиёт доирасида ишлаб чиқарилган маҳсулотларга давлат харидларида устунликлар бериш бўйича таклифларни ишлаб чиқиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p class="a2" style="text-align:center"><span style="font-size:13pt"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил март</span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(И. Кутбиддинов)</span></span></i></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">73-мақсад: Атмосфера ҳавоси ифлосланишининг олдини олиш, унинг табиий таркибини сақлаш бўйича кескин чоралар кўриш</span></span></b></span></span></span></p></td></tr><tr><td colspan="8" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро учун асосий масъул</span></span></i></b><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></span></i></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="55"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳавони узоқ масофаларгача трансчегаравий ифлосланиши тўғрисидаги Конвенцияга (1979 йил 13 ноябрь, Женева) қўшилиш ишларини ташкиллаштириш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳавони узоқ масофаларгача трансчегаравий ифлосланиши тўғрисидаги Конвенция (1979 йил 13 ноябрь, Женева)га қўшилиш чораларини кўриш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда атмосфера ҳавосига зарарли ташламалар миқдорини камайтириш жараёнларини тезлаштиришга ёрдам берадиган энг яхши технологиялар (НДТ) мамлакатда татбиқ қилиб борилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил ноябрь</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">-</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ташқи ишлар вазирлиги</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">(Б. Саидов)</span></span></i><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:2%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><ol start="56"><li align="center" class="a" style="text-align:center"></li></ol></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республика ҳудудларида ҳаво сифати датчикларини ўрнатиш.</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Ҳаво сифати датчикларини ўрнатиладиган нуқталарни аниқлаш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> Тошкент шаҳрида қўшимча 7 та Атмосфера ҳавоси ифлосланиши мониторинги автоматлаштирилган станцияларни ўрнатиш.</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.1pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3. </span></span></b><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Атмосфера ҳавосининг ифлосланишини фон мониторинги учун 347 та автоматлаштирилган станцияни марказлашган ҳолда оператив сотиб олиш ва ўрнатиш ишларини ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2025 йил давомида</span></span></span></span></span></p></td><td colspan="2" style="border-bottom:1px solid black;width:16%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология жамғармаси,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Туризм жамғармаси,</span></span></span></span></span></p><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Гидрометеорология хизмати агентлигига ажратилган маблағлар доирасида</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:19%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши ва вилоятлар ҳокимликлари</span></span></span></span></span></p></td></tr></tbody></table></div></div><div class="FOOTNOTE"><div name="7372300" id="7372300">Изоҳ: Дастурда назарда тутилган тадбирларнинг амалга оширилиши жараёнида уларнинг молиялаштириш манбаларига ҳамда тадбирларни амалга ошириш муддатларига ўзгартиришлар «Ўзбекистон — 2030» <a href="https://lex.uz/ru/docs/6600413#6605157">стратегиясини</a> амалга ошириш бўйича Республика комиссияси раиси — Бош вазир томонидан киритилиши мумкин.</div></div><div class="BY_DEFAULT"><div name="7372027" id="7372027"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="7372030" id="7372030">Ўзбекистон Республикаси Президентининг 2025 йил 30 январдаги ПФ-16-сон <a href="https://lex.uz/ru/docs/7369703">Фармонига</a><br />8-ИЛОВА</div></div><div class="ACT_TITLE_APPL"><div name="7372302" id="7372302">«Ўзбекистон — 2030» стратегиясининг сув ресурсларини тежаш ва атроф-муҳитни муҳофаза қилиш йўналиши бўйича 2025 йилда ишлаб чиқиладиган норматив-ҳуқуқий ҳужжатлар лойиҳалари</div></div><div class="ACT_FORM"><div name="7372303" id="7372303">РЎЙХАТИ</div></div><div class="BY_DEFAULT"><div name="7562007" id="7562007"></div></div><div class="BY_DEFAULT"><div name="7562018" id="7562018"><table border="0" cellpadding="0" cellspacing="0" style="BORDER-COLLAPSE: collapse" width="100%"><tbody><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: black 1pt solid;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="1%"><p align="center"><a name="7372306"><b><span style="FONT-SIZE: 12pt">Т/р</span></b></a></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: black 1pt solid;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="22%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">Норматив-ҳуқуқий ҳужжат лойиҳаси</span></b></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: black 1pt solid;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="45%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">Норматив-ҳуқуқий ҳужжат лойиҳасида назарда тутилган тадбирлар</span></b></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: black 1pt solid;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="7%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">Ижро муддати</span></b></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: black 1pt solid;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="22%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">Ҳамижрочилар</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">СУВ РЕСУРСЛАРИНИ ТЕЖАШ ВА АТРОФ-МУҲИТНИ МУҲОФАЗА ҚИЛИШ</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">64-мақсад: Ирригация тизими ва сув тежовчи технологияларни ривожлантириш, соҳа бошқарувига хусусий сектор ва давлат-хусусий шериклик механизмларини кенг жорий этиш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Сув хўжалиги вазирлиги (Ш. Хамраев)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">1.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">«Ўзбекистон Республикасида сув ресурсларини бошқариш ва ирригация секторини ривожлантиришнинг 2025 — 2027 йилларга мўлжалланган стратегиясини тасдиқлаш тўғрисида»ги Ўзбекистон Республикаси Президенти қарори лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ирригация тизими каналларининг бетон қопламали қисмини ва ирригация тизими ва суғориш тармоқларининг фойдали иш коэффициентини ошириш чора-тадбирлари;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">сув таъминоти даражаси паст бўлган ва шўрланган суғориладиган майдонларни камайтириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">сувни тежайдиган суғориш технологияларини жорий қилишни жадаллаштириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">сув хўжалиги объектларини рақамлаштириш каби масалалар назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил март</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қишлоқ хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Абдурахмонов)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">66-мақсад: Республикада экологик вазиятни тубдан яхшилаш, инсон ҳаётига таъсир ўтказувчи экологик муаммоларни бартараф этиш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">2.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">2025 — 2027 йилларга мўлжалланган пластик билан ифлосланишни камайтириш бўйича Миллий дастур лойиҳаси. </span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">2027 йилдан бошлаб пластик пакетларни ишлаб чиқариш, олиб кириш ва улардан фойдаланишни тақиқлаш ҳамда экологик жиҳатдан зарарсиз (биопарчаланувчи) пакетлардан фойдаланишни рағбатлантириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">пластик маҳсулотларнинг кимёвий таркибидаги зарарли моддалардан фойдаланишни чеклаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">қадоқларда қайта ишланган пластикдан фойдаланиш коэффициентларини белгилаш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил ноябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Божхона қўмитаси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Мавлонов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Солиқ қўмитаси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Кудбиев)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Ўзбекистон техник жиҳатдан тартибга солиш агентлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Жуманазаров)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">3.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Тупроқнинг унумдор қатламини сақлаш, яшил ҳудудлар асраш, сув ресурсларидан самарасиз фойдаланиш ва исрофгарчиликка барҳам бериш мақсадида маъмурий жавобгарликни кескин кучайтириш бўйича қонун лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">тупроқ ва яшил қопламалар билан ўралган ҳудудларни ўзбошимчалик билан бетонлаштириш ҳамда қурилма ва конструкцияларни ўрнатиш учун жавобгарликни белгилаш; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">сув ресурсларидан самарасиз фойдаланиш ва исрофгарчиликка йўл қўйганлик учун жавобгарликни кучайтириш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июнь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Кадастр агентлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ф. Пулатов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Энергетика вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ж. Мирзамахмудов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Сув хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хамраев)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хидоятов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">4.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Дарё ва сойлар ўзанлари ва уларга туташган сув фонди ерларидан норуда материалларни қазиб олишга босқичма-босқич мораторий жорий қилишни назарда тутувчи норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">1.</span></b></span><span><span style="FONT-SIZE: 12pt"> Сув танқислигидан ва сувни ифлослантирилишидан кўпроқ азият чекаётган дарё ва сойларни хатловдан ўтказиш.</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">2.</span></b></span><span><span style="FONT-SIZE: 12pt"> Хатлов натижаларига кўра дарё ва сойлар ўзанлари ва уларга туташган сув фонди ерларидан норуда материалларни қазиб олишга босқичма-босқич мораторий жорий қилишни назарда тутувчи норматив ҳуқуқий ҳужжат лойиҳасини ишлаб чиқиш ва тегишли вазирлик ва идоралар билан келишиш.</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">3.</span></b></span><span><span style="FONT-SIZE: 12pt"> Ҳужжат лойиҳасини ўрнатилган тартибда Вазирлар Маҳкамасига киритиш.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил май</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Сув хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хамраев)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари</span></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">5.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Аҳолининг экологик маданиятни мустаҳкамлаш чора-тадбирлари бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада «Экологик маданиятни мустаҳкамлаш» концепциясини тасдиқлаш ва аниқ чора-тадбирлар назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил ноябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Ўзбекистон экологик партияси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(келишув асосида)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">6.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Иссиқхона газларини тартибга солишнинг компенсацион механизмларини жорий қилишнинг қонуний асосларини яратиш учун Ўзбекистон Республикасининг «Табиатни муҳофаза қилиш тўғрисида қонуни»га ўзгартириш ва қўшимчалар киритиш бўйича қонун лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада республикада иссиқхона газлари ташламаларини атроф табиий муҳитга ва иқлим ўзгаришига салбий таъсирини юмшатишга қаратилган компенсацион механизмларини жорий қилиш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июнь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">7.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Янги Тошкент ҳудудида Экология вазирлиги ва унинг тизимидаги ташкилотларни яшил бино талабларига мувофиқ ягона маъмурий мажмуа қурган ҳолда жойлаштиришни назарда тутувчи норматив-ҳуқуқий ҳужжат лойиҳаси. </span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада маъмурий бинолардан ташқари, «Санъат ва табиат» жамоатчилик маркази, турли галереялар ва экспозициялар ҳамда экомеҳмонхонани жойлаштириш, шунингдек, экологик тоза маҳсулотлар савдосига мўлжалланган савдо дўконлари фаолияти йўлга қўйиш каби масалалар жой олади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил октябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хидоятов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Соғлиқни сақлаш вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Худаяров),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">8.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Маҳаллаларда сув тежовчи дарахтларни суғориш тизимларини барпо этиш ишларини ташкил этиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">аҳоли хонадонлари эгалари томонидан дарахтларни ўз вақтида суғориши устидан жамоат назорати ўрнатилишини таъминлаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">камбағал оилалар хонадонларида ёмғир сувини йиғиш, сақлаш ва суғоришга фойдаланиш тизимларини маҳалланинг ижтимоий-иқтисодий муаммоларини ҳал этиш жамғармаси ҳисобига молиялаштиришни рухсат этувчи меъёрни ишлаб чиқиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">янги қуриладиган кўп хонадонли уй-жойларга туташ ҳудудларда ёмғир сувини йиғиш, сақлаш ва дарахтларни суғоришда фойдаланиш тизимини мажбурий ўрнатиш масалалари назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июль</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хидоятов)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Қурилиш ва уй-жой коммунал хўжалиги вазирлиги (Ш. Хидоятов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">9.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Қўп қаватли турар жойларни лойиҳалаш, қурилиш ва фойдаланишга қабул қилишда шаҳарсозлик ресурсларидан оқилона фойдаланиш ва хавфсиз муҳит яратиш </span></span><span><span style="FONT-SIZE: 12pt">назарда тутувчи норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">кўп қаватли турар жойларни лойиҳалаш, қурилиш ва фойдаланишга қабул қилишда:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ер ости автомобиль тураргоҳларини назарда тутиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">автомобиль тураргоҳларида нормативларга мувофиқ электромобилларни қувватлаш станцияларини ўрнатиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">оқова, ёмғир ва техник сувлардан суғоришда фойдаланиш тизимларини мажбурий этиб белгилаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">санитар қурилмаларнинг сув сиғимини 3 — 6 литр этиб белгилаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">биноларнинг деворларини базальт асосидаги иссиқликни сақловчи материаллар билан қоплаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ис газидан огоҳлантирувчи қурилмалар билан жиҳозлаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">икки манбадан иборат (техник ва ичимлик) сув таъминоти билан жиҳозлаш каби талаблар назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил сентябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Фавқулодда вазиятлар вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Қўлдошев),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">«Ўзсувтаъминот» АЖ</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Сувонқулов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Ўзбекистон техник жиҳатдан тартибга солиш агентлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Жуманазаров)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">67-мақсад: Экологик вазиятни барқарорлаштиришга қаратилган «Яшил макон» умуммиллий лойиҳасини кенгайтириш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">10.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">«Атроф-муҳит мониторинги тўғрисида»</span></b></span><span><span style="FONT-SIZE: 12pt">ги қонун лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Қонун лойиҳасида: </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">атроф-муҳитнинг ифлосланиш даражасини реал вақт режимида <b>аниқлаш</b>, унинг экологик ҳолатини <b>баҳолаш</b> бўйича фаолиятни <b>ҳуқуқий жиҳатдан тартибга солиш; </b></span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">атроф-муҳит <b>мониторинги</b> тизимини такомиллаштириш ва <b>самарадорлигини</b> ошириш ҳамда атроф-муҳитга салбий таъсир юзага келишини <b>прогнозлаштириш</b>; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">табиий ресурслардан фойдаланишни тизимли равишда <b>кузатиш</b>, атроф табиий муҳитни муҳофаза қилиш соҳасида <b>давлат назорати</b> юритилишини <b>баҳолаш; </b></span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">аҳолини атроф-муҳит ифлосланиши ҳолати тўғрисидаги ишончли <b>ахборот</b> билан таъминлаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">фуқароларнинг, фуқаролар ўзини ўзи бошқариш органларининг, нодавлат нотижорат ташкилотларнинг ҳамда фуқаролик жамияти бошқа институтларининг атроф-муҳит <b>мониторингидаги иштирокини </b>таъминлаш масалалари назарда тутилади. </span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил сентябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Манфаатдор вазирлик ва идоралар</span></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">11.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Атроф-муҳитга таъсир кўрсатишнинг I ва II тоифаларига кирувчи саноат корхоналарининг атроф табиий муҳитга таъсирини камайтириш бўйича саъй-ҳаракатларни рағбатлантиришни назарда тутувчи норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">1)</span></b></span><span><span style="FONT-SIZE: 12pt"> табиатга зарар келтириш бўйича энг хавфли I ва II корхоналарнинг экологик ишлаб чиқаришга ўтишдаги ҳаракатларини рағбатлантириш тизимини жорий қилиш:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">а)</span></b></span><span><span style="FONT-SIZE: 12pt"> I босқичда — мониторинг станциялари ўрнатган корхонага:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">табиатга зарар етказиш бўйича компенсация тўловларидан шаклланган қарздорликдан воз кечиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">табиатга зарар етказиш бўйича бюджетга йўналтириладиган компенсация тўловларининг 50 фоизигача бўлган қисмини икки йил давомида қайтариш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">б)</span></b></span><span><span style="FONT-SIZE: 12pt"> II босқичда — мониторинг станцияларини ўрнатган корхона келгусида чанг-газ ва локал сув тозалаш ускуналарини ўрнатса табиатга зарар етказиш бўйича бюджетга йўналтириладиган компенсация тўловларининг 70 фоизигача бўлган қисмини икки йил давомида қайтариш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">2)</span></b></span><span><span style="FONT-SIZE: 12pt"> табиатга зарар етказиш бўйича компенсациядан имтиёз беришни фақат Президент қарорлари билан амалга ошириш ҳамда шу давргача берилган имтиёзларни бекор қилиш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июль</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Манфаатдор вазирлик ва идоралар</span></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">12.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Маҳаллаларда сув тежовчи дарахтларни суғориш тизимларини барпо этиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада республиканинг <b>32 та</b> шаҳарлардаги <b>64 маҳаллада</b>: </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">хонадонларда ёмғир сувини йиғиш, сақлаш ва суғоришга фойдаланиш тизимларини маҳалланинг ижтимоий-иқтисодий муаммоларини ҳал этиш жамғармаси ҳисобига молиялаштириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">янги қуриладиган кўп хонадонли уй-жойларга туташ ҳудудларда ёмғир сувини йиғиш, сақлаш ва дарахтларни суғоришда фойдаланиш тизимини ўрнатиш назарда тутилади. </span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил август</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хидоятов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари</span></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">68-мақсад: Ўрмонлар майдонини кенгайтириш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">13.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Яйловларнинг ўсимлик ва ҳайвонот дунёсига бой бўлган ҳудудларига муҳофаза этиладиган табиий ҳудудлар мақомини бериш тўғрисидаги Вазирлар Маҳкамаси қарори лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада яйловларнинг ўсимлик ва ҳайвонот дунёсига бой бўлган ҳудудларига муҳофаза этиладиган табиий ҳудудлар мақомини бериш ва бошқа масалалар назарда тутилади.</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Бунда республикадаги яйлов ерларини хатловдан ўтказиш ва ўсимлик ва ҳайвонот дунёсига бой бўлган ҳудудларни аниқлаш ишлари ташкил этилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июнь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Қишлоқ хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Абдурахмонов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Ипакчилик ва жун саноатини ривожлантириш қўмитаси</span></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">14.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Ўрмон хўжалиги тизимини трансформация қилиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ўрмон хўжалиги тизимини трансформация қилиш, бунда ўрмонларни бошқариш, кўкаламзорлаштириш ва чўлланишга қарши курашиш фаолиятини қамраб олиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">янги тузилма таркибида қум ва чўл бўронларга қарши курашиш марказини ташкил этиш; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ўрмон хўжалиги тизимида «республика-ҳудуд-ўрмон хўжаликлари» тизимини шакллантириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">«Яшил макон» умуммиллий лойиҳаси доирасида янги тузилма таркибида шаҳар ва бошқа аҳоли пунктларини кўкаламзорлаштиришга ихтисослашган дирекция ва ижрочи корхоналарни ташкил этиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">кўчатчиликка ва дориворчиликка ихтисослашган ўрмон хўжаликларини алоҳида мақомини белгилаш.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил март</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Ўрмон хўжалиги агентлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Э. Муҳитдинов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Адлия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Ташкулов)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">69-мақсад: Оролбўйи минтақасида экологик вазиятни барқарорлаштириш, Орол денгизи қуриши натижасида юзага келган экологик муаммоларнинг салбий таъсирини юмшатиш.</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">15.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">«Орол водийси» иқлим технологиялари экспо-хабини ташкил этиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада: </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Мўйноқ шаҳри очиқ осмон остидаги иқлим ўзгариши музейи.</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">чўл технологиялари, иқлим ўзгаришига мослашиш ва оқибатларини юмшатиш технологиялари, сув тежаш технологияларини ўз ичига олган Орол экспо кўргазмасини ташкил этиш; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">қум тўсиқлари ва шамол муҳофаза йўллари ёрдамида қумни фиксация қилиш.</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Оролбўйи минтақаси учун кўп шериклик траст фонди маблағларини жалб этиш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил апрель</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Манфаатдор вазирлик ва идоралар</span></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">16.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">2026 — 2030 йилларда Ўзбекистон Республикасида атроф табиий муҳит мониторинги дастури тасдиқланишини кўзда тутувчи Ҳукумат қарори лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">атмосфера ҳавосининг ифлосланишини ва саноат тармоқларининг унга таъсирини баҳолаш натижалари; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">трансчегаравий ва ички аҳамиятга эга ер усти сувлари, ер ости сувлари қудуқларида сув ифлосланиши, қишлоқ хўжалиги ва саноат ривожини ҳисобга олган ҳолда ерларнинг ифлосланишини назорат қилиш механизмлари;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">республиканинг тоғ ва тоғолди минтақаларининг фаол геологик жараёнлар намоён бўладиган ҳудудларида хавфли экзоген геологик жараёнлар мониторинги масалалари;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">атмосфера ҳавоси, ер усти сувлари ва тупроқнинг ифлосланиши (эмиссия) манбалари мониторинги масалалари; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">экоаналитик лабораторияларнинг моддий-техника базасини янада мустаҳкамлаш каби тадбирлар назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил ноябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Манфаатдор вазирлик ва идоралар</span></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">70-мақсад: Иқлим ўзгариши салбий таъсирининг олдини олиш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">17.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">«Иқлим ўзгариши тўғрисида» қонун </span></b></span><span><span style="FONT-SIZE: 12pt">лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">иқлим ўзгаришининг салбий оқибатларини юмшатиш чоралари;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">қишлоқ хўжалиги ва бошқа соҳаларни иқлим ўзгаришига мослаштириш тадбирларининг қонуний механизмлари назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил октябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Сув хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хамраев)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қишлоқ хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Абдурахмонов)</span></i></span><span><span style="FONT-SIZE: 12pt">, </span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Соғлиқни сақлаш вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Худаяров),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Адлия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Ташкулов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">18.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Иқлим ўзгариши оқибатларини юмшатиш ва унга мослашиш бўйича миллий стратегияси лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада иқлим ўзгаришига соҳа ва тармоқларни, шунингдек, ҳудудларни тайёрлаш бўйича асосий стратегик йўналишларни назарда тутувчи узоқ муддатга мўлжалланган тадбирлар акс эттирилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил сентябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Сув хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хамраев)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қишлоқ хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Абдурахмонов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Соғлиқни сақлаш вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Худаяров)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">19.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университети фаолиятини такомиллаштириш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Университетнинг академик салоҳиятини ошириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ташкилий тузилмасини такомиллаштириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ўқув дастурини замонавий хорижий тажриба асосида такомиллаштириш каби масалалар назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил май</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Олий таълим, фан ва инновациялар вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Қ. Шарипов)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Гидрометеорология хизмати агентлиги (Ш. Хабибуллаев)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">20.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Ўзбекистон Республикаси Вазирлар Маҳкамасининг «Гидрометеорология хизмати инфратузилмасини ривожлантириш ва мониторинг юритиш тизимини такомиллаштириш чора-тадбирлари тўғрисида»ги қарори лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Бунда:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">тоғли ҳудудларда қор қоплами, қалинлиги, зичлиги, эриш жараёнларини таҳлил қилиш орқали тоғ олди ва тоғли ҳудудларда сув тошқинлари юз бериш эҳтимоли мавжудлигини прогноз қилиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">олинаётган маълумотларни Ўзгидрометнинг ягона геоахборот маълумотлар базасига интеграция қилиш, визуаллаштириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">расмий веб-сайтларда реал вақт режимида маълумотларни мунтазам янгилаб бориш билан давлат органлари ва кенг жамоатчиликка ахборот етказиш кўзда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил декабрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Абдухакимов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">21.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Ўзбекистон Республикаси Вазирлар Маҳкамасининг «Ўзбекистон Республикаси фуқаро авиацияси ҳаво кемалари парвозларининг хавфсизлигини метеорологик таъминлашга доир қўшимча чора-тадбирлар тўғрисида»ги қарори лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Бунда:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">2025-2026 йилларда 10 та аэропортда жойлашган автоматик авиация метеорология станцияларини янгилаш; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">парвозлар хавфсизлигини таъминлашга қаратилган чора-тадбирлар дастурини кўзда тутиш.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил декабрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Абдухакимов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">манфаатдор вазирлик ва идоралар</span></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">71-мақсад: Биологик хилма-хиллик ишончли сақланишини таъминлаш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Соғлиқни сақлаш вазирлиги (А. Худаяров)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">22.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">«Биологик хавфсизлик тўғрисида»</span></b></span><span><span style="FONT-SIZE: 12pt">ги қонуни лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Қонун лойиҳасида: </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">давлат органларининг биологик хавфсизлик соҳасидаги ваколатларини белгилаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">биологик хавфсизликни кучайтириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">табиий туркумлар ва қишлоқ хўжалиги экинларига зарар етказиши мумкин бўлган бегона турларни олиб кириш ва тарқатиш устидан назорат қилиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">таркибида жонли модификациялаштирилган организмлар ва генетик модификациялаштирилган организмлар бўлган организмларни ишлаб чиқариш, тайёрлаш, олиб кириш, сотиш ва тарқатиш устидан назорат қилиш механизмлари назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил апрель</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Абдухакимов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Фанлар академияси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Аюпов)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">23.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Ўзбекистон Республикаси ҳудудида атроф табиий муҳит ифлослантирилганлиги ва чиқиндилар жойлаштирилганлиги ҳамда давлат ўрмон фондига кирмайдиган дарахтлар ва буталарни кесиш, кўчириб ўтказиш билан боғлиқ бўлган мажбуриятлардан фақат қонун билан озод қилиш механизмларини жорий қилиш ҳамда шу пайтгача берилган имтиёзларни бекор қилишни кўзда тутувчи норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">1.</span></b></span><span><span style="FONT-SIZE: 12pt"> Тегишли норматив-ҳуқуқий ҳужжат лойиҳасини ишлаб чиқиш.</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">2.</span></b></span><span><span style="FONT-SIZE: 12pt"> Манфаатдор вазирлик ва идоралар билан келишиш.</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">3.</span></b></span><span><span style="FONT-SIZE: 12pt"> Лойиҳани белгиланган тартибда Вазирлар Маҳкамасига киритиш.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил апрель</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Манфаатдор вазирлик ва идоралар</span></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">24.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Давлат ўрмон фондига кирмайдиган дарахтлар ва буталарни кесиш ва кўчириб ўтказиш тизимини тартибга солиш тўғрисида Ҳукумат қарори лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Қарор лойиҳасида қуйидагиларни назарда тутиш:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">давлат ўрмон фондига кирмайдиган диаметри 15 смгача бўлган дарахтларни кўчириб ўтказишга тўлов асосида рухсат беришни жорий этиш; </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">дарахтлар ва буталарга шакл бериш (буталаш) тартибини белгилаш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">давлат ўрмон фондига кирмайдиган дарахтлар ва буталар қимматбаҳо навларининг рўйхатини қайта кўриб чиқиш.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил август</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Фанлар академияси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Аюпов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хидоятов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">25.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Ёввойи ҳолда ўсувчи ўсимликларни етиштириш бўйича питомниклар ва плантациялар давлат ҳисобини юритишни такомиллаштириш бўйича Ҳукумат қарори лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Вазирлар Маҳкамасининг 2019 йил 25 майдаги 430-сон қарори билан тасдиқланган Ёввойи ҳолда ўсувчи ўсимликларни етиштириш бўйича питомниклар ва плантацияларни барпо этиш ва уларнинг давлат ҳисобини юритиш тартиби тўғрисидаги низомга ўзгартириш ва қўшимчалар киритиш. Бунда:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ёввойи ҳолда ўсувчи ўсимликларни етиштириш бўйича питомниклар ва плантацияларни давлат ҳисобига қўйиш бўйича бериладиган аризаларни Ягона интерактив давлат хизматлари портали орқали жорий этиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ёввойи ҳолда ўсувчи ўсимликларни етиштириш бўйича питомниклар ва плантациялар мониторингини олиб боришни йўлга қўйиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ёввойи ҳолда ўсувчи ўсимликларни етиштириш бўйича питомниклар ва плантацияларни давлат ҳисобига қўйиш бўйича бериладиган аризаларни кўриб чиқиш муддатларини мақбуллаштириш.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июль</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Фанлар академияси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Аюпов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қишлоқ хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Абдурахмонов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Адлия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Ташкулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">26.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Ҳайвонот дунёси йўқотишларининг ўрнини қоплаш чораларини кучайтириш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада 2025 йил 1 сентябрдан 2028 йил 1 январга қадар Ҳукумат томонидан тасдиқланадиган рўйхатга мувофиқ айрим ҳудудларда ва (ёки) йўқолиб кетиши хавфи юқори бўлган ҳайвонларга нисбатан ов қилишга чеклов жорий қилиш назарда тутилади. Бунда:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">чеклов фермалар, питомниклар, инкубаторлар, балиқчилик питомниклари ва ҳовуз хўжаликларида сақланаётган ва (ёки) етиштириладиган ёввойи ҳайвонларни овлаш ҳамда санитар мақсадларда ов қилишга татбиқ этилмаслиги;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">овчиларга муқобил машғулот сифатида ҳудудларда ўқ отиш спортига ихтисослаштирилган махсус полигонларда хизмат кўрсатиш йўлга қўйилиши;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">шаҳарлардаги табиий сув ҳавзалари ихтиофаунасининг популяциясини қайта тиклаш мақсадида республиканинг марказий шаҳарларидан оқиб ўтувчи дарё ва сойларда ҳар йили 15 тоннадан кам бўлмаган чавоқлантириш ишларини амалга ошириш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июнь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Экологик партия</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(келишув асосида)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Фанлар академияси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Аюпов)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">72-мақсад: Қаттиқ маиший чиқиндиларни тўплаш ва олиб чиқиш хизматлари сифатини яхшилаш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">27.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><b><span style="FONT-SIZE: 12pt">«Чиқиндилар тўғрисида»ги Қонуннинг</span></b></span><span><span style="FONT-SIZE: 12pt"> янги таҳрири лойиҳаси. </span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Атроф-муҳитни асраш ва «яшил» иқтисодиётга босқичма-босқич ўтиш тамойилларини инобатга олган ҳолда «Чиқиндилар тўғрисида»ги қонунининг янги таҳрири лойиҳасини ишлаб чиқиш. Бунда:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ишлаб чиқарувчилар ва импорт қилувчилар учун «Ифлослантирувчи тўлайди» тамойили асосида кенгайтирилган мажбуриятларни белгиловчи тизимни ташкил этиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">юридик ва жисмоний шахсларнинг махсус техникаларида қаттиқ маиший, қурилиш, суюқ маиший, тиббиёт, саноат, хавфли ва заҳарли чиқиндиларни ташишни лицензиялаш тизимини ташкил этиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">тиббиёт чиқиндиларини йиғиш, зарарсизлантириш, утилизация қилиш ва кўмиб ташлаш тизимини ташкил этиш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил декабрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Соғлиқни сақлаш вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Худаяров)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">28.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Саноат ва электрон чиқиндиларни бошқариш тизимини такомиллаштиришга қаратилган комплекс чора-тадбирларни амалга ошириш тўғрисидаги норматив-ҳуқуқий ҳужжат лойиҳаси. </span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">саноат чиқиндилари билан боғлиқ ишларни амалга ошириш стратегиясини қабул қилиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">республика ҳудудига импорт қилувчиларнинг «кенгайтирилган мажбурияти» тизимини жорий этиш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">қурилиш чиқиндиларини босқичма босқич саралаш, қайта ишлаш тизимини жорий қилиш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил ноябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари</span></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">29.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Техник ва саноат мойларини ишлаб чиқарувчи ва импорт қилувчиларнинг кенгайтирилган мажбурияти тизимини жорий этиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада: </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">техник ва саноат мойларини ишлаб чиқарувчи ва импорт қилувчилар ўз маҳсулотларини утилизация қилиш учун тегишли операторларга топширилишини таъминлайди ёки утилизация йиғимини тўлайди;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">ишлаб чиқарувчи, импорт қилувчи, истеъмолчи, оператор ва қайта ишловчилар ўртасида ишлатилган техник мойларни утилизация қилиш тизимини тартибга солувчи онлайн платформа яратилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил сентябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Транспорт вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Махкамов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Туризм қўмитаси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(У. Шодиев)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">30.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Умумий овқатланиш корхоналарида ҳосил бўладиган озиқ-овқат чиқиндиларидан самарали фойдаланиш тизимини йўлга қўйиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада: </span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">озиқ-овқат чиқиндиларини компостлаш орқали қишлоқ хўжалиги ва озиқ-овқат маҳсулотлари етиштиришда органик ўғитларни қўллаш кенгайтирилади;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">умумий овқатланиш шохобчаларидаги сув оқава тизимларига ёғ тутгичлар ўрнатиш орқали ёғ ажратиб олиш натижасида иккиламчи хом ашё (хўжалик совунлари, ҳайвон озуқалари) ишлаб чиқарилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил август</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хидоятов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Соғлиқни сақлаш вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Худаяров),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Туризм қўмитаси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(У. Шодиев)</span></i></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><span style="FONT-SIZE: 12pt">73-мақсад: Атмосфера ҳавоси ифлосланишининг олдини олиш, унинг табиий таркибини сақлаш бўйича кескин чоралар кўриш</span></b></span></p></td></tr><tr><td colspan="5" style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="100%"><p align="center"><span><b><i><span style="FONT-SIZE: 12pt">Ижро учун асосий масъул</span></i></b></span><span><i><span style="FONT-SIZE: 12pt"> — Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (А. Абдухакимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">31.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Атмосферага чиқариладиган зарарли моддаларни тозалаш масалалари бўйича тадбиркорлик субъектларининг ҳуқуқлари ва қонуний манфаатларини ҳимоя қилишга оид қонунчилик ҳужжатларига ўзгартиришлар киритиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада, шу жумладан, Ўзбекистон Республикаси Президентининг 2024 йил 14 ноябрдаги «Тадбиркорлар ҳуқуқлари ва қонуний манфаатларини ишончли ҳимоя қилиш чора-тадбирлари тўғрисида»ги ПФ-184-сон Фармонига 2-илованинг 2-позициясини атмосферага чиқариладиган зарарли моддаларни тозалаш учун иншоотлар ўрнатиш, ускуналар, жиҳозлардан, шунингдек, атмосферага чиқариб ташланадиган зарарли моддалар миқдори ва тартибини назорат қилувчи воситалардан фойдаланиш қоидаларини бузиш ёки улардан фойдаланмаслик масалалари бўйича тезкор назорат тадбирини ўтказишга оид ўнинчи хатбоши билан тўлдириш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил апрель</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Савдо-саноат палатаси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Д. Вахобов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Адлия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Ташкулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">32.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Атмосфера ҳавосини муҳофаза қилиш бўйича узоқ муддатли стратегияни ишлаб чиқиш.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада:</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">саноат тармоқларида — I ва II тоифадаги саноат корхоналарида ифлослантирувчи моддаларни тозалаш технологияларини (чанг ва газни тозалаш қурилмалари ёрдамида) жорий этиш орқали ташламалар миқдорини 20 фоизга камайтириш;</span></span></p><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">транспорт соҳасида — жамоат транспортини яхшилаш орқали транспорт воситаларидан ташламаларни 20 фоизга камайтириш масалалари назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил сентябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Энергетика вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ж. Мирзамахмудов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Транспорт вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Махкамов)</span></i></span><span><span style="FONT-SIZE: 12pt">,</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Ички ишлар вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(П. Бобожонов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">33.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Умумий овқатланиш шохобчаларининг атмосфера ҳавосига салбий таъсирини камайтириш чора-тадбирлари бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада умумий овқатланиш шохобчаларида озиқ-овқат маҳсулотларини пишириш учун газ таъминоти, улар бўлмаганда ёғоч ёки тайёр кўмирдан фойдаланишида атмосфера ҳавосини <b>ифлослантирувчи моддалар </b>ва <b>ҳидларни ушлаб қолувчи қурилмалар</b> билан жиҳозлашга оид мажбурий талабларни белгилаш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил июнь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Соғлиқни сақлаш вазирлиги</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">(А. Худаяров),</span></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Қурилиш ва уй-жой коммунал хўжалиги вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Ш. Хидоятов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Савдо-саноат палатаси</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Д. Вахабов),</span></i></span></p><p align="center"><span><span style="FONT-SIZE: 12pt">Бизнес-омбудсман</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Д. Касимов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">34.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Атмосфера ҳавосини мониторинг қилиш тизимини назоратга олиш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада жисмоний ва юридик шахслар томонидан атмосфера ифлосланишини аниқловчи шахсий датчикларни ўрнатишга доир стандартларни ишлаб чиқиш ва уларни жойларга ўрнатаётганда Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги билан келишиш тизимини жорий этиш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил сентябрь</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Адлия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(А. Ташкулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">35.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Экология жамғармасининг молиявий барқарорлигини таъминлаш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада Жамғарманинг даромад манбаларини ошириш, жумладан, утилизация йиғимлари, экология, атроф-муҳитни муҳофаза қилиш ва ўрмончилик соҳасидаги жарималар, зарар, компенсация тўловлари ҳамда рухсатнома учун ундириладиган маблағларни Экология жамғармасига ўтказиш назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил февраль</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Иқтисодиёт ва молия вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(И. Норқулов)</span></i></span></p></td></tr><tr><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: black 1pt solid;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="1%"><p align="center"><span><span style="FONT-SIZE: 12pt">36.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Экологик ҳуқуқбузарликларнинг олдини олиш тизимини янада такомиллаштириш бўйича норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="45%"><p style="TEXT-INDENT: 15.25pt"><span><span style="FONT-SIZE: 12pt">Лойиҳада Тошкент шаҳрида синов-тажриба тариқасида Ички ишлар вазирлиги ва Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги тузилмаларида вазирликларнинг бюджетдан ташқари маблағлари ҳисобидан молиялаштириладиган экологик ҳуқуқбузарликка, шу жумладан атмосфера ҳавоси ифлосланишига қарши курашиш ва аниқланган ҳуқуқбузарликларни расмийлаштириш учун масъул бўлган қўшма бўлинмаларни ташкил этиш чоралари назарда тутилади.</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="7%"><p align="center"><span><span style="FONT-SIZE: 12pt">2025 йил май</span></span></p></td><td style="BORDER-RIGHT: black 1pt solid;PADDING-RIGHT: 4.3pt;BORDER-TOP: #d4d0c8;PADDING-LEFT: 4.3pt;PADDING-BOTTOM: 0cm;BORDER-LEFT: #d4d0c8;PADDING-TOP: 0cm;BORDER-BOTTOM: black 1pt solid" valign="top" width="22%"><p align="center"><span><span style="FONT-SIZE: 12pt">Ички ишлар вазирлиги</span></span></p><p align="center"><span><i><span style="FONT-SIZE: 12pt">(Б. Абдуллаев)</span></i></span></p></td></tr></tbody></table></div></div><div class="FOOTNOTE"><div name="7562020" id="7562020">Изоҳлар:</div></div><div class="FOOTNOTE"><div name="7562022" id="7562022">Дастурда назарда тутилган тадбирларни амалга ошириш учун қабул қилинадиган ҳужжатлар шакли заруратга қараб ўзгартирилиши, бошқа бандлардаги ҳужжатлар билан бирлаштирилиши ёки бир неча турдаги ҳужжатларга бўлиниши мумкин.</div></div><div class="FOOTNOTE"><div name="7562024" id="7562024">Норматив-ҳуқуқий ҳужжатлар лойиҳаларини ишлаб чиқиш жараёнида мутасадди вазирлик ва идораларнинг таклифлари асосида Дастурда белгиланган тадбирларнинг мазмунига мос келадиган бошқа масалалар ҳам назарда тутилади.</div></div><div class="FOOTNOTE"><div name="7562025" id="7562025">Дастурда назарда тутилган тадбирларнинг амалга оширилиши жараёнида уларнинг молиялаштириш манбаларига ҳамда тадбирларни амалга ошириш муддатларига ўзгартиришлар «Ўзбекистон — 2030» <a href="https://lex.uz/ru/docs/6600413#6605157">стратегиясини</a> амалга ошириш бўйича Республика комиссияси раиси — Бош вазир томонидан киритилиши мумкин.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7562029" id="7562029">(8-илова Ўзбекистон Республикаси Президентининг 2025 йил 30 майдаги ПФ-90-сонли <a href="https://lex.uz/ru/docs/7552003?ONDATE=02.06.2025 00#7554491">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 02.06.2025 й., 06/25/90/0486-сон)</div></div><div class="BY_DEFAULT"><div name="7372031" id="7372031"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="7372033" id="7372033">Ўзбекистон Республикаси Президентининг 2025 йил 30 январдаги ПФ-16-сон <a href="https://lex.uz/ru/docs/7369703">Фармонига</a><br />9-ИЛОВА</div></div><div class="ACT_TITLE_APPL"><div name="7372315" id="7372315">«Ўзбекистон — 2030» стратегиясининг Сув ресурсларини тежаш ва атроф-муҳитни муҳофаза қилиш йўналиши бўйича 2025 йилга мўлжалланган</div></div><div class="ACT_FORM"><div name="7372316" id="7372316">МАҚСАДЛИ КЎРСАТКИЧЛАР</div></div><div class="BY_DEFAULT"><div name="7372317" id="7372317"></div></div><div class="TABLE_STD2"><div name="7372318" id="7372318"><table class="Table" style="width:100.0%;border-collapse:collapse;border:none" width="100%"><tbody><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>Т/р</b></span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>2030 йилгача эришиладиган мақсадларнинг самарадорлик кўрсаткичлари</b></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>Ўлчов бирлиги</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>2025</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>I чорак</b></span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>II чорак</b></span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>III чорак</b></span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>IV чорак</b></span></span></p></td><td style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>Масъуллар</b></span></span></p></td></tr><tr><td colspan="9" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>3.1. Сув ресурсларини тежаш бўйича ислоҳотлар</b></span></span></p></td></tr><tr><td colspan="9" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>62-мақсад: Республикада сувдан оқилона фойдаланиш маданиятини ва сув ишлатиш самарадорлигини ошириш</b></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">1.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги экинларини суғоришда сув тежайдиган технологиялар билан қамраб олинган ерларнинг умумий майдонини <b>2 млн</b> гектаргача етказиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">минг гектар</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>300</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">100</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">100</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">100</span></span></p></td><td rowspan="3" style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлиги,</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Қишлоқ хўжалиги вазирлиги</span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">2.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Тупроқ қопламали каналларни бетон қопламага ҳамда ички суғориш тармоқларини ёпиқ қувурли суғориш тизимларига ўтказиш бўйича етти йиллик дастур доирасида ирригация тизими ва суғориш тармоқларининг фойдали иш коэффициенти кўрсаткичини 0,73 гача етказиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">коэффициент</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>0,68</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">0,68</span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">3.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Сув тежовчи технологияларни ишлаб чиқарувчи маҳаллий корхоналарнинг йиллик қувватини <b>300 минг</b> гектарга етказиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">минг гектар</span></span></p><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">фоиз</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>300</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">50</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">50</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">100</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">100</span></span></p></td></tr><tr><td colspan="9" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>63-мақсад: Қишлоқ хўжалиги соҳасида сув ресурсларидан оқилона фойдаланишни таъминлаш</b></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">4.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Мелиорация объектларини қуриш ва реконструкция қилиш натижасида суғориладиган ер майдонларида шўрланган майдонларни <b>1,7 миллион</b> гектаргача камайтириш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">минг гектар</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>46,4</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">10,4</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">12</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">12</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">12</span></span></p></td><td rowspan="3" style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлиги</span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">5.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Кучли ва ўрта шўрланган суғориладиган ер майдонларини <b>430,0 минг</b> гектаргача, ер ости сув сатҳи муаммоли ҳолатда бўлган ер майдонларини <b>773,4 минг</b> гектаргача камайтириш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">минг гектар</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>60/33,8</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">60/33,8</span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">6.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Тупроқ ўзанли бўлган магистрал ва хўжаликлараро каналларнинг бетон қопламали улушини <b>46</b> <b>фоиз</b>га етказиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">фоиз</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>40</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">-</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">40</span></span></p></td></tr><tr><td colspan="9" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>64-мақсад: Ирригация тизими ва сув тежовчи технологияларни ривожлантириш, соҳа бошқарувига хусусий сектор ва давлат-хусусий шериклик механизмларини кенг жорий этиш</b></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">7.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Камида <b>100 та</b> йирик сув хўжалиги объектларида автоматлаштирилган бошқарув тизимини жорий қилиш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">та</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>12</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">3</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">3</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">3</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">3</span></span></p></td><td style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлиги</span></span></p></td></tr><tr><td colspan="9" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>65-мақсад: «Яшил энергия» технологияларини кенг жорий қилиш доирасида насос станцияларининг электр энергияси истеъмолини камайтириш</b></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">8.</span></span></p></td><td style="border-bottom:1px solid black;width:44%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:12.2pt"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Насос станцияларидаги эскирган <b>1 069 та</b> насосларни энергия тежамкорларига алмаштириш.</span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">та</span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b>150</b></span></span></p></td><td style="border-bottom:1px solid black;width:5%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">30</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">40</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">40</span></span></p></td><td style="border-bottom:1px solid black;width:6%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">40</span></span></p></td>