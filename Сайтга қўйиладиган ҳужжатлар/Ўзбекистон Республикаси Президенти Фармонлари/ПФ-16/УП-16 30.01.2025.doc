ily:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="7372607" id="7372607">Указ</div></div><div class="ACCEPTING_BODY"><div name="7372608" id="7372608">Президента Республики Узбекистан</div></div><div class="ACT_TITLE"><div name="7372609" id="7372609">О Государственной программе по реализации Стратегии «Узбекистан — 2030» в «Год охраны окружающей среды и «зеленой экономики»</div></div><div class="BY_DEFAULT"><div name="7372611" id="7372611"></div></div><div class="ACT_TEXT"><div name="7372612" id="7372612">В целях организации неукоснительного исполнения задач, определенных в <a href="https://lex.uz/ru/docs/6600404#6605093">Стратегии</a> «Узбекистан — 2030» и на заседаниях палат Олий Мажлиса, осуществления комплексной «зеленой трансформации» отраслей и сфер при выполнении обязательств нашей страны, взятых на себя перед глобальным обществом в рамках Киотского протокола к Рамочной конвенции Организации Объединенных Наций об изменении климата и Парижского соглашения, обеспечения их конкурентоспособности и ресурсосбережения, а также смягчения последствий изменения климата и адаптации к нему, улучшения качества жизни населения и перехода экономического роста на новую «зеленую» модель развития:</div></div><div class="ACT_TEXT"><div name="7372613" id="7372613">1. Определить приоритетными подходами развития страны в «Год охраны окружающей среды и «зеленой экономики»:</div></div><div class="ACT_TEXT"><div name="7372614" id="7372614">улучшение экологического облика махаллей, повышение уровня озеленения улиц, формирование экологически благоприятной и благополучной среды для проживания;</div></div><div class="ACT_TEXT"><div name="7372615" id="7372615">укрепление здоровья населения, создание условий для формирования экологического образа жизни и реализации человеческого потенциала;</div></div><div class="ACT_TEXT"><div name="7372616" id="7372616">бережное отношение и рациональное использование природных ресурсов, обеспечение экологической устойчивости;</div></div><div class="ACT_TEXT"><div name="7372617" id="7372617">охрану, воспроизводство и сохранение для будущего поколения растительного и животного мира, сохранение биоразнообразия;</div></div><div class="ACT_TEXT"><div name="7372618" id="7372618">устойчивое финансирование проектов, направленных на широкое внедрение принципов «зеленой экономики», адаптацию экономики к изменению климата;</div></div><div class="ACT_TEXT"><div name="7372619" id="7372619">увеличение доли возобновляемой энергии в энергобалансе республики, включая строительство крупных «зеленых электростанций» на основе государственно-частного партнерства, расширение сети малых и микро гидроэлектростанций в регионах, стимулирование установки солнечных панелей в домохозяйствах населения;</div></div><div class="ACT_TEXT"><div name="7372620" id="7372620">сокращение «углеродного следа» в экономике путем широкого применения современных энергосберегающих технологий в отраслях экономики и социальной сфере;</div></div><div class="ACT_TEXT"><div name="7372621" id="7372621">обеспечение межрегиональной и межотраслевой координации, направленной на экологическую устойчивость.</div></div><div class="ACT_TEXT"><div name="7372622" id="7372622">Установить, что приоритетные подходы являются основанием для доведения до 2030 года годового роста валового внутреннего продукта минимум до 6 процентов, его объема — до 200 миллиардов долларов США, удержания инфляции на уровне 5 процентов, сохранения дефицита бюджета к валовому внутреннему продукту на уровне 3 процентов, сокращения бедности и повышения благосостояния населения путем перехода на модель экономического развития, предусматривающую экономное использование ресурсов.</div></div><div class="ACT_TEXT"><div name="7372623" id="7372623">2. Обеспечить в 2025 году в направлении устойчивого финансирования проектов, направленных на широкое внедрение принципов «зеленой экономики», декарбонизацию экономики, смягчение последствий изменения климата и адаптацию к нему:</div></div><div class="ACT_TEXT"><div name="7372624" id="7372624">разработку долгосрочной стратегии достижения углеродной нейтральности Узбекистана исходя из требований Парижского соглашения;</div></div><div class="ACT_TEXT"><div name="7372625" id="7372625">опубликование определенного на национальном уровне вклада нашей страны в сокращение выбросов парниковых газов (NDC) в глобальном масштабе в предстоящие 5 лет с учетом адаптации к изменению климата и трансферта «зеленых технологий»;</div></div><div class="ACT_TEXT"><div name="7372626" id="7372626">определение базового состояния эмиссии метана в таких областях, как природный газ, обращение с отходами и животноводство в рамках обязательства по сокращению эмиссии метана;</div></div><div class="ACT_TEXT"><div name="7372627" id="7372627">доведение доли возобновляемых источников энергии в генерации электроэнергии до 26 процентов и до 40 процентов в общей структуре мощностей генерации путем ввода в эксплуатацию крупных солнечных и ветряных станций суммарной мощностью 4,5 ГВт, установки солнечных панелей мощностью 785 мегаватт, строительства гидроэлектростанций мощностью 225 МВт;</div></div><div class="ACT_TEXT"><div name="7372628" id="7372628">внедрение сертификата «Зеленое здание» исходя из энергоэффективности строящихся новых зданий, сооружений и жилых домов.</div></div><div class="ACT_TEXT"><div name="7372629" id="7372629">Определить соответственно заместителя Премьер-министра — министра экономики и финансов Д. Кучкарова, а также министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова ответственными за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372630" id="7372630">3. Министерству энергетики (Ж. Мирзамахмудов) совместно с Советом Министров Республики Каракалпакстан, хокимиятами областей и города Ташкента внести в Кабинет Министров в месячный срок:</div></div><div class="ACT_TEXT"><div name="7372631" id="7372631">программу установки солнечных панелей и гелиоколлекторов в 2025 году в разрезе районов и городов;</div></div><div class="ACT_TEXT"><div name="7372632" id="7372632">программу строительства микро гидроэлектростанций в регионах республики в 2025-2026 годах.</div></div><div class="ACT_TEXT"><div name="7372633" id="7372633">4. В целях трансформации крупных предприятий с государственным участием и сокращения до 15 — 20 процентов их производственных расходов на основе принципа «бережливость и устойчивость» обеспечить до конца 2025 года:</div></div><div class="ACT_TEXT"><div name="7372634" id="7372634">разработку крупными стратегическими предприятиями корпоративных программ на основе принципов экологического, социального и корпоративного управления (ESG), внедрение практики формирования и раскрытия общественности национального отчета ESG не менее чем на 5 крупных промышленных предприятиях;</div></div><div class="ACT_TEXT"><div name="7372635" id="7372635">получение ESG-рейтинга АО «Узбекнефтегаз», АО «Навоийский горно-металлургический комбинат», АО «Алмалыкский горно-металлургический комбинат», АО «Uzbekistan Airports», АО «Uzbekistan Airways»;</div></div><div class="ACT_TEXT"><div name="7372636" id="7372636">образование в качестве эксперимента в Самаркандской и Ферганской областях промышленных зон, специализирующихся на производстве экологически чистой продукции.</div></div><div class="ACT_TEXT"><div name="7372637" id="7372637">Определить соответственно заместителей Премьер-министра Д. Кучкарова и Ж. Ходжаева, а также министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова ответственными за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372638" id="7372638">5. Обеспечить в 2025 году в направлении улучшения экологического облика махаллей, повышения уровня озеленения улиц, формирования экологически благоприятной и благополучной среды для проживания:</div></div><div class="ACT_TEXT"><div name="7372639" id="7372639">создание сети «Тенистых прогулочных улиц» путем высадки деревьев и растений вдоль пешеходных и отдельных велосипедных дорожек, строительство в прибрежных зонах и вдоль рек 80 инфраструктурных объектов и оздоровительных дорожек для населения протяженностью более 110 километров;</div></div><div class="ACT_TEXT"><div name="7372640" id="7372640">повышение уровня озеленения за счет эффективного использования дождевых и сточных вод, внедрения системы полива деревьев путем применения в махаллях современных водосберегающих технологий;</div></div><div class="ACT_TEXT"><div name="7372641" id="7372641">посадку в рамках Общенационального проекта «Яшил макон» и проекта «Мой сад» 200 миллионов саженцев деревьев и кустарников, использование в «зеленых садах» и «зеленых общественных парках» осветительных приборов, заряжающихся от солнечных панелей;</div></div><div class="ACT_TEXT"><div name="7372642" id="7372642">создание 100 тысяч гектаров «зеленых площадей» на дне Аральского моря и доведение площади лесонасаждений в регионе Приаралья до 2,1 миллиона гектаров;</div></div><div class="ACT_TEXT"><div name="7372643" id="7372643">доведение покрытых лесом площадей до 4,1 миллиона гектаров и расширение охраняемых природных территорий до 14,5 процента, выявление и задействование их неиспользованных резервов в таких направлениях, как экотуризм, питомничество и выращивание лекарственных растений, а также увеличение доходов населения;</div></div><div class="ACT_TEXT"><div name="7372644" id="7372644">создание садов из устойчивых к засолению и засухе растений (галофитов) на отобранных территориях в Республике Каракалпакстан, Бухарской, Джизакской и Кашкадарьинской областях;</div></div><div class="ACT_TEXT"><div name="7372645" id="7372645">привлечение средств международных финансовых институтов в размере не менее 30 миллионов долларов США для организации государственных лабораторий «in-vitro», а также выделения кредитов субъектам предпринимательства для создания частных лабораторий «in-vitro» в Республике Каракалпакстан, Бухарской, Сурхандарьинской, Джизакской, Ферганской и Ташкентской областях;</div></div><div class="ACT_TEXT"><div name="7372646" id="7372646">внедрение системы акселерации по поддержке инициатив общественности, экоактивистов и представителей бизнеса, направленных на охрану природы.</div></div><div class="ACT_TEXT"><div name="7372647" id="7372647">Определить соответственно заместителя Премьер-министра Ж. Ходжаева, министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова, министра сельского хозяйства И. Абдурахмонова, первого заместителя министра экономики и финансов И. Норкулова, а также Председателя Совета Министров Республики Каракалпакстан, хокимов областей и города Ташкента ответственными за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372648" id="7372648">6. В направлении укрепления здоровья населения, создания условий для формирования экологического образа жизни и реализации человеческого потенциала в 2025 году:</div></div><div class="ACT_TEXT"><div name="7372649" id="7372649">а) запустить в стране Общенациональное движение «Один миллион зеленых семей», направленное на популяризацию образа жизни «Эко-активного гражданина», путем внедрения экологических принципов в повседневную жизнь населения, а также организовать работу по популяризации данного движения среди граждан. При этом определить основными принципами движения:</div></div><div class="ACT_TEXT"><div name="7372650" id="7372650">пропаганду здорового образа жизни среди населения, в частности повышение медицинской культуры, здорового питания, ежедневной ходьбы и бега;</div></div><div class="ACT_TEXT"><div name="7372651" id="7372651">стимулирование передвижения на «зеленом транспорте», в том числе велосипедах;</div></div><div class="ACT_TEXT"><div name="7372652" id="7372652">сокращение использования пластиковой продукции;</div></div><div class="ACT_TEXT"><div name="7372653" id="7372653">предупреждение расточительного потребления пищи;</div></div><div class="ACT_TEXT"><div name="7372654" id="7372654">рациональное использование ресурсов воды, газа и электроэнергии;</div></div><div class="ACT_TEXT"><div name="7372655" id="7372655">внедрение сортировки отходов по их видам;</div></div><div class="ACT_TEXT"><div name="7372656" id="7372656">б) провести поэтапную трансформацию в первичном звене медицины, предусматривающую:</div></div><div class="ACT_TEXT"><div name="7372657" id="7372657">внедрение эффективной системы оказания первичной медико-санитарной помощи населению в семейных поликлиниках, пунктах семейного врача и медицинских пунктах махаллей;</div></div><div class="ACT_TEXT"><div name="7372658" id="7372658">организацию деятельности многопрофильных центральных поликлиник в качестве консультативно-диагностической поликлиники центральных больниц;</div></div><div class="ACT_TEXT"><div name="7372659" id="7372659">создание централизованных лабораторий, перевод полностью в электронную форму формирования очереди на прием к врачу, передачу на основе аутсорсинга стоматологических услуг частному сектору с усилением государственного контроля за соблюдением санитарно-гигиенических норм;</div></div><div class="ACT_TEXT"><div name="7372660" id="7372660">повышение квалификации медицинских работников, разработку показателей оценки эффективности труда медицинских работников, внедрение ежемесячной дополнительной надбавки к заработной плате работников, достигших высоких показателей эффективности;</div></div><div class="ACT_TEXT"><div name="7372661" id="7372661">реорганизацию специализированных медицинских учреждений областного уровня в многопрофильные клиники с современной формой управленческого, финансового и организационного обеспечения с созданием необходимого количества койко-мест;</div></div><div class="ACT_TEXT"><div name="7372662" id="7372662">в) с 2025/2026 учебного года в целях организации работ по повышению человеческого потенциала, созданию благоприятной образовательной среды:</div></div><div class="ACT_TEXT"><div name="7372663" id="7372663">определить Центрально-Азиатский Университет изучения окружающей среды и изменения климата ведущей высшей образовательной организацией по таким направлениям образования и специальностям, как экология, охрана окружающей среды и изменение климата;</div></div><div class="ACT_TEXT"><div name="7372664" id="7372664">внедрить практику подготовки кадров по направлению образования «Циркулярная экономика» в Центрально-Азиатском Университете изучения окружающей среды и изменения климата;</div></div><div class="ACT_TEXT"><div name="7372665" id="7372665">организовать в Республике Каракалпакстан, областях и городе Ташкенте деятельность «зеленых техникумов», закрепляемых за Центрально-Азиатским Университетом изучения окружающей среды и изменения климата;</div></div><div class="ACT_TEXT"><div name="7372666" id="7372666">ввести в государственных высших образовательных организациях по направлениям «естественные науки», «инженерно-техническое направление», «экономика и финансы» предмет и учебные программы «Охрана окружающей среды и зеленое развитие»;</div></div><div class="ACT_TEXT"><div name="7372667" id="7372667">довести в высшем образовании квоты государственного заказа по точным и естественным наукам, инженерно-техническим направлениям, сфере услуг и медицине до 25 тысяч за счет поэтапного увеличения грантовых мест;</div></div><div class="ACT_TEXT"><div name="7372668" id="7372668">выделять Фондом «Эл-юрт умиди» до 20 квот на конкурс стипендий для обучения на основе образовательных программ по экологии, охране окружающей среды и изменению климата;</div></div><div class="ACT_TEXT"><div name="7372669" id="7372669">поэтапно организовать деятельность не менее одной общеобразовательной школы в каждом районе (городе) республики, соответствующей требованиям инклюзивного образования;</div></div><div class="ACT_TEXT"><div name="7372670" id="7372670">организовать в рамках Программы «От бедности к благополучию» работу по подготовке и принятию на учебу в высшие образовательные организации в установленном порядке на грантовой основе 3,5 тысячи детей из малообеспеченных семей;</div></div><div class="ACT_TEXT"><div name="7372671" id="7372671">г) в срок до 1 марта 2025 года разработать программу по усилению пропаганды пользы правильного питания, занятий физической культурой и спортом для здоровья человека;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7709809" id="7709809">(подпункт «д» пункта 6 исключен <a href="https://lex.uz/ru/docs/7694884?ONDATE=15.08.2025 00#7698603">Указом </a>Президента Республики Узбекистан от 12 августа 2025 года № УП-130 — Национальная база данных законодательства, 15.08.2025 г., № 06/25/130/0762)</div></div><div class="ACT_TEXT"><div name="7709808" id="7709808">Определить соответственно министра здравоохранения А. Худаярова, министра спорта А. Икрамова, министра занятости и сокращения бедности Б. Захидова, министра высшего образования, науки и инноваций К. Шарипова, министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова, министра сельского хозяйства И. Абдурахмонова ответственными за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372674" id="7372674">7. Нижеследующим:</div></div><div class="ACT_TEXT"><div name="7372675" id="7372675">Министерству здравоохранения (А. Худаяров, Э. Адилов) в срок 1 июля 2025 года внести проект нормативно-правового акта с конкретными механизмами по поэтапному внедрению системы государственной регистрации деятельности медицинских и фармацевтических работников;</div></div><div class="ACT_TEXT"><div name="7372676" id="7372676">Министерству цифровых технологий (Ш. Шерматов) совместно с Министерством здравоохранения (А. Худаяров, Э. Адилов) в срок до 1 ноября 2025 года внедрить практику назначения лекарственных средств на основании системы «электронный рецепт» в регионах, в которых внедряются механизмы медицинского страхования.</div></div><div class="ACT_TEXT"><div name="7372677" id="7372677">8. Министерству экологии, охраны окружающей среды и изменения климата (А. Абдухакимов) и Министерству цифровых технологий (Ш. Шерматов) в срок до 1 июня 2025 года в рамках Общенационального движения «Один миллион зеленых семей» запустить платформу, предусматривающую:</div></div><div class="ACT_TEXT"><div name="7372678" id="7372678">присвоение статуса «Эко-активный гражданин» лицам, достигшим высоких показателей при внедрении в свою повседневную жизнь экологических принципов, а также предоставление 10-процентной скидки на получение государственных услуг, а также скидок на потребительские кредиты в банках с государственной долей более 50 процентов;</div></div><div class="ACT_TEXT"><div name="7372679" id="7372679">присвоение статуса «зеленая семья» и ежегодное предоставление посредством открытого конкурса 14 электромобилей семьям, в которых все совершеннолетние члены получили статус «Эко-активный гражданин»;</div></div><div class="ACT_TEXT"><div name="7372680" id="7372680">проведение конкурсов «Самая чистая махалля» и «Самая зеленая махалля» в махаллях, половина населения которых получила статус «зеленая семья», а также перечисление в фонд махаллей-победителей 500 миллионов сумов на финансирование мероприятий по дальнейшему улучшению внутренней инфраструктуры махаллей, в частности на ремонт дорог, установку энергоэффективных осветительных приборов, возведение детских площадок, создание «зеленых садов», установку скамеек, строительство мусоросборочных площадок, установку урн и контейнеров для отходов, с учетом предложений населения махаллей.</div></div><div class="ACT_TEXT"><div name="7372681" id="7372681">Определить соответственно министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова, министра цифровых технологий Ш. Шерматова, а также Председателя Совета Министров Республики Каракалпакстан, хокимов областей и города Ташкента ответственными за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372682" id="7372682">9. В целях дальнейшего расширения возможностей населения, особенно представителей молодого поколения, для использования санитарно-гигиенических средств реализовать с 1 мая 2025 года, с широким освещением среди населения, программу «Чистые руки», предусматривающую:</div></div><div class="ACT_TEXT"><div name="7372683" id="7372683">а) во всех учреждениях здравоохранения и образования:</div></div><div class="ACT_TEXT"><div name="7372684" id="7372684">обеспечение мест для мытья рук санитарно-гигиеническими средствами;</div></div><div class="ACT_TEXT"><div name="7372685" id="7372685">улучшение технического состояния санитарно-гигиенических помещений и размещение их во внутренней части зданий строящихся новых учреждений;</div></div><div class="ACT_TEXT"><div name="7372686" id="7372686">планирование в течение года в первую очередь приобретения средств для мытья рук и антисептических средств;</div></div><div class="ACT_TEXT"><div name="7372687" id="7372687">б) введение обязательства по обеспечению санитарно-гигиеническими средствами всех видов общественных санитарно-гигиенических помещений и организаций общественного питания.</div></div><div class="ACT_TEXT"><div name="7372688" id="7372688">Министерству экономики и финансов (И. Норкулов) при необходимости выделять бюджетным организациям на протяжении 2025 года дополнительные средства на мероприятия, предусмотренные настоящим пунктом, на основании обоснованных расчетов распорядителей бюджетных средств первого уровня.</div></div><div class="ACT_TEXT"><div name="7372689" id="7372689">Комитету санитарно-эпидемиологического благополучия и общественного здоровья (Б. Юсупалиев) в месячный срок пересмотреть нормативы выделения средств для поддержания санитарно-гигиенического состояния в предусмотренных настоящим пунктом учреждениях и установить строгий контроль за их фактическим исполнением.</div></div><div class="ACT_TEXT"><div name="7372690" id="7372690">10. Министерству здравоохранения (А. Худаяров), Министерству экономики и финансов (О. Фозилкаримов), Министерству дошкольного и школьного образования (Х. Умарова) совместно с Министерством строительства и жилищно-коммунального хозяйства (Ш. Хидоятов) в срок до 1 августа 2025 года с привлечением международных экспертов Всемирной организации здравоохранения и Организации Объединенных Наций внести в Кабинет Министров Программу улучшения санитарно-гигиенической системы во всех учреждениях социальной сферы республики, в том числе в точках общественного питания и санитарно-гигиенических местах вдоль межобластных автомобильных дорог.</div></div><div class="ACT_TEXT"><div name="7372691" id="7372691">11. В целях усиления системы контроля качества и безопасности продовольственной продукции и разработки санитарных правил, направленных на приведение нормативов в данной области в соответствие с высокими стандартами:</div></div><div class="ACT_TEXT"><div name="7372692" id="7372692">в срок до 1 июля 2025 года принять меры по оснащению лабораторий Комитета санитарно-эпидемиологического благополучия и общественного здоровья необходимым оборудованием по определению содержания трансжиров в составе пищевых продуктов;</div></div><div class="ACT_TEXT"><div name="7372693" id="7372693">в срок до 1 августа 2025 года обеспечить приведение санитарных правил и норм, устанавливающих предельные объемы использования трансжиров в производстве пищевых продуктов, в соответствие с требованиями Всемирной торговой организации, а также установить строгий контроль за их соблюдением.</div></div><div class="ACT_TEXT"><div name="7372694" id="7372694">Определить министра здравоохранения А. Худаярова ответственным за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372695" id="7372695">12. Обеспечить в 2025 году в направлении бережного отношения и рационального использования природных ресурсов, обеспечения экологической устойчивости:</div></div><div class="ACT_TEXT"><div name="7372696" id="7372696">достижение ежегодной экономии дополнительно 2,5 миллиарда кубических метров воды за счет перевода каналов протяженностью 1 тысяча километров на бетонное покрытие, включая доведение охвата водосберегающими технологиями до 1,6 миллиона гектаров;</div></div><div class="ACT_TEXT"><div name="7372697" id="7372697">сокращение потребления электроэнергии насосными станциями до 300 млн кВт путем замены устаревших насосов и электродвигателей на современные энергосберегающие, а также совершенствование учета водных ресурсов на насосных станциях;</div></div><div class="ACT_TEXT"><div name="7372698" id="7372698">улучшение водоснабжения 390 тысяч гектаров сельскохозяйственных земель путем строительства и реконструкции объектов систем ирригации и мелиорации;</div></div><div class="ACT_TEXT"><div name="7372699" id="7372699">внедрение системы ведения единого онлайн-учета воды на магистральных каналах и ключевых водных объектах в целях обеспечения наиболее полного учета и отчетности по используемым водным ресурсам;</div></div><div class="ACT_TEXT"><div name="7372700" id="7372700">строительство и реконструкцию сетей питьевого водоснабжения и канализации протяженностью 1,8 тысячи километров, а также 77 сооружений питьевого водоснабжения и канализации;</div></div><div class="ACT_TEXT"><div name="7372701" id="7372701">замену на энергосберегающие 746 единиц морально устаревших насосных установок системы питьевого водоснабжения, установку в регионах солнечных панелей мощностью 65,2 мегаватта, а также 955 единиц современных приборов учета воды на водных сооружениях и в сетях магистрального водопровода;</div></div><div class="ACT_TEXT"><div name="7372702" id="7372702">ведение мониторинга качества и создание центров управления данными на всех предприятиях питьевого водоснабжения;</div></div><div class="ACT_TEXT"><div name="7372703" id="7372703">усиление контроля за сбросом различных загрязняющих веществ в реки, озера и каналы.</div></div><div class="ACT_TEXT"><div name="7372704" id="7372704">Определить соответственно министра водного хозяйства Ш. Хамраева, министра строительства и жилищно-коммунального хозяйства Ш. Хидоятова, министра энергетики Ж. Мирзамахмудова, министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова ответственными за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372705" id="7372705">13. Принимая во внимание предложения широкой общественности, международных и отечественных экоактивистов, Экологической партии Узбекистана, Министерства экологии, охраны окружающей среды и изменения климата:</div></div><div class="ACT_TEXT"><div name="7372706" id="7372706">а) запретить с 1 мая 2025 года в городах Ташкенте и Нукусе, а также областных центрах реализацию новых проектов по следующим направлениям:</div></div><div class="ACT_TEXT"><div name="7372707" id="7372707">производство асбеста и цемента, шлам и шлаки;</div></div><div class="ACT_TEXT"><div name="7372708" id="7372708">кожевенно-дубильные, птицеводческие фабрики;</div></div><div class="ACT_TEXT"><div name="7372709" id="7372709">сжигание любого вида угля без оснащения высокоэффективными пылеулавливающими и газоочистными сооружениями;</div></div><div class="ACT_TEXT"><div name="7372710" id="7372710">заводы черной и цветной металлургии, работа со стеклом, в составе которого имеются ядовитые примеси, ядовитыми химическими веществами;</div></div><div class="ACT_TEXT"><div name="7372711" id="7372711">предприятия переработки и сжигания отходов, отнесенные по степени опасности к I и II классу;</div></div><div class="ACT_TEXT"><div name="7372712" id="7372712">б) мобилизовать все силы и средства для обеспечения исполнения до конца 2025 года следующих задач:</div></div><div class="ACT_TEXT"><div name="7372714" id="7372714">ограничение использования и реализации автомобильного топлива марки АИ — 80 с обеспечением населения качественным, экологически чистым и доступным топливом;</div></div><div class="ACT_TEXT"><div name="7372715" id="7372715">полный запрет использования мазута в качестве топлива предприятиями, производящими тепловую и электрическую энергию во всех регионах республики, за исключением случаев использования мазута в качестве аварийного топлива с уведомлением Министерства экологии, охраны окружающей среды и изменения климата и по согласованию с Кабинетом Министров;</div></div><div class="ACT_TEXT"><div name="7372716" id="7372716">в) Министерству экологии, охраны окружающей среды и изменения климата в срок до 1 ноября 2025 года разработать проект закона, предусматривающий внедрение следующих международно признанных механизмов сокращения пластиковых отходов:</div></div><div class="ACT_TEXT"><div name="7372724" id="7372724">организация сбора и утилизации такого вида отходов путем создания специальных мест приема пластиковых отходов и установки специального оборудования или оплата утилизационного сбора;</div></div><div class="ACT_TEXT"><div name="7372725" id="7372725">внедрение таких обязательств для производителей пластиковых упаковок либо продукции в пластиковой упаковке, а также их импортеров, как «возврат тары», создание возможностей для граждан по получению оплаты за каждую пластиковую тару, сдаваемую через специальное оборудование по приему отходов.</div></div><div class="ACT_TEXT"><div name="7372726" id="7372726">Министерству экологии, охраны окружающей среды и изменения климата (А. Абдухакимов) совместно с Министерством экономики и финансов (И. Норкулов), Министерством энергетики (Ж. Мирзамахмудов), Министерством инвестиций, промышленности и торговли (Л. Кудратов) и местными хокимиятами в срок до 1 октября 2025 года внести в Кабинет Министров обоснованные предложения о поэтапной передислокации с модернизацией из городов Ташкента и Нукуса, областных центров действующих мощностей по направлениям, указанным в <a href="https://lex.uz/ru/docs/7369745#7372706">подпункте «а»</a> данного пункта, а также имеющим высокое энергопотребление.</div></div><div class="ACT_TEXT"><div name="7372727" id="7372727">14. В целях сдерживания с внедрением достижений науки и современных технологий негативного воздействия на экологию производственной и градостроительной деятельности, оказания услуг:</div></div><div class="ACT_TEXT"><div name="7372728" id="7372728">установить с 1 августа 2025 года порядок приема экологических норм и правил, являющихся актами технического регулирования;</div></div><div class="ACT_TEXT"><div name="7372729" id="7372729">внедрить с 1 октября 2025 года практику применения отраслевого метода вместо метода индивидуального определения экологических нормативов в отрасли энергетики, сфере производства строительных материалов и химической промышленности;</div></div><div class="ACT_TEXT"><div name="7372730" id="7372730">наладить с 1 января 2026 года практику внедрения республиканскими органами исполнительной власти и предприятиями с государственной долей более 50 процентов в свою деятельность стандартов обнародования сведений в области устойчивого развития Совета по международным стандартам устойчивого развития (ISSB).</div></div><div class="ACT_TEXT"><div name="7372731" id="7372731">Министерству экологии, охраны окружающей среды и изменения климата (А. Абдухакимов) с привлечением ведущих международных и отечественных экспертов в трехмесячный срок внести в Кабинет Министров программу по разработке экологических норм и правил, направленных на сокращение загрязнения атмосферы, земельных, подземных и водных ресурсов.</div></div><div class="ACT_TEXT"><div name="7372732" id="7372732">Заместителям Премьер-министра Д. Кучкарову и Ж. Ходжаеву обеспечить перечисление Экологическому фонду средств в размере 25 миллиардов сумов за счет средств международных финансовых институтов и бюджетных средств для поддержки стартап-проектов по реализации мероприятий, направленных на охрану окружающей среды, в частности борьбу с опустыниванием, смягчение последствий изменения климата, рациональное использование водных ресурсов.</div></div><div class="ACT_TEXT"><div name="7372733" id="7372733">15. Принимая во внимание предложения широкой общественности, международных и отечественных экоактивистов, научного сообщества в сфере экологии, а также в целях сохранения плодородного слоя почвы и охраны зеленых территорий:</div></div><div class="ACT_TEXT"><div name="7372734" id="7372734">с 1 июля 2025 года усиливается ответственность за самовольное бетонирование, возведение построек и установку конструкций на территориях массивов многоэтажных домов, покрытых почвой и зелеными насаждениями;</div></div><div class="ACT_TEXT"><div name="7372735" id="7372735">с 1 августа 2025 года строительным организациям, которые от производства жженого кирпича перешли на производство стеновых материалов (пеноблоков, газоблоков), на платформе «Шаффоф қурилиш» предоставляется приоритет в целях стимулирования перехода на широкое использование альтернативных технологий;</div></div><div class="ACT_TEXT"><div name="7372736" id="7372736">с 1 января 2026 года при производстве жженого и сырого кирпича применяются ставки налога за пользование недрами с увеличением в 2 раза от установленной ставки на 2025 год, а с 2027 года дополнительно поэтапно повышаются;</div></div><div class="ACT_TEXT"><div name="7372737" id="7372737">с 1 января 2027 года запрещается деятельность песчаных карьеров на землях сельскохозяйственного назначения, землях природоохранного, оздоровительного и рекреационного назначения, землях историко-культурного назначения, лесного и водного фондов в целях охраны земельных ресурсов и недопущения утраты плодородного слоя почвы;</div></div><div class="ACT_TEXT"><div name="7372738" id="7372738">вводится обязательство по установке системы использования для полива сточной, дождевой и технической водой при проектировании, строительстве и приемке в эксплуатацию многоэтажных домов.</div></div><div class="ACT_TEXT"><div name="7372739" id="7372739">16. Министерству инвестиций, промышленности и торговли (Л. Кудратов), Министерству энергетики (Ж. Мирзамахмудов), Министерству экономики и финансов (И. Норкулов), Министерству строительства и жилищно-коммунального хозяйства (Ш. Хидоятов), Узбекскому агентству по техническому регулированию (А. Жуманазаров), Торгово-промышленной палате (Д. Вахабов) в двухмесячный срок внести в Кабинет Министров программу по увеличению объема производства и широкого использования в стране энергоэффективных материалов.</div></div><div class="ACT_TEXT"><div name="7372740" id="7372740">17. В направлении сохранения, воспроизводства и доведения до будущего поколения растительного и животного мира внедрить с 1 сентября 2025 года порядок предоставления утвержденных квот на сбор и заготовку дикорастущих растений и разрешений на специальное пользование объектами растительного мира посредством электронного аукциона. При этом:</div></div><div class="ACT_TEXT"><div name="7372741" id="7372741">квоты формируются Академией наук на основе ежегодно определяемых запасов растений;</div></div><div class="ACT_TEXT"><div name="7372744" id="7372744">квоты и разрешения утверждаются и выставляются на аукцион Министерством экологии, охраны окружающей среды и изменения климата.</div></div><div class="ACT_TEXT"><div name="7372745" id="7372745">Определить министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова ответственным за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372768" id="7372768">18. В целях стимулирования действий предприятий, относящихся к I и II категориям по воздействию на окружающую среду, по переходу к экологическому производству внедрить с 1 августа 2025 года порядок, предусматривающий:</div></div><div class="ACT_TEXT"><div name="7372770" id="7372770">а) на первом этапе — для предприятий, установивших станции фонового мониторинга загрязнения атмосферного воздуха:</div></div><div class="ACT_TEXT"><div name="7372772" id="7372772">отказ от задолженности, сформировавшейся от компенсационных платежей по нанесению ущерба природе;</div></div><div class="ACT_TEXT"><div name="7372780" id="7372780">возвращение в течение двух лет до 50 процентов компенсационных платежей по нанесению ущерба природе, направляемых в республиканский бюджет;</div></div><div class="ACT_TEXT"><div name="7372781" id="7372781">б) на втором этапе — для предприятий, установивших станции мониторинга, которые в течение следующего года установят пылеулавливающее, газоочистное и локальное водоочистное оборудование, возвращение в течение двух лет до 70 процентов компенсационных платежей по нанесению ущерба природе, направляемых в республиканский бюджет.</div></div><div class="ACT_TEXT"><div name="7372782" id="7372782">При этом льготы, предусмотренные настоящим пунктом, предоставляются на основе заключения, выдаваемого Министерством экологии, охраны окружающей среды и изменения климата посредством центров государственных услуг или Единого портала интерактивных государственных услуг;</div></div><div class="ACT_TEXT"><div name="7372783" id="7372783">в) Министерству экологии, охраны окружающей среды и изменения климата в срок до 1 ноября 2025 года разработать проект закона по поэтапному внедрению системы обязательного страхования экологического ущерба, причиненного предприятиями и организациями, ведущими хозяйственную деятельность.</div></div><div class="ACT_TEXT"><div name="7372784" id="7372784">Премьер-министру Республики Узбекистан А. Арипову в двухмесячный срок утвердить программу по предотвращению загрязнения атмосферного воздуха в республике, в частности поэтапной установке на промышленных предприятиях и в теплицах пылегазовых и локальных водных очистных сооружений, а также установить жесткий контроль за ее исполнением.</div></div><div class="ACT_TEXT"><div name="7372792" id="7372792">19. С 1 сентября 2025 года запустить платформу по присвоению субъектам предпринимательства статуса «зеленого предпринимателя», предусматривающую:</div></div><div class="ACT_TEXT"><div name="7372793" id="7372793">а) присвоение статуса «зеленого предпринимателя» субъектам предпринимательства, выполнившим показатели по следующим направлениям:</div></div><div class="ACT_TEXT"><div name="7372794" id="7372794">озеленение, в том числе создание вокруг предприятий «зеленых поясов», установление оросительных систем, внедрение системы капельного, дождевого и контейнерного (мешочного) орошения;</div></div><div class="ACT_TEXT"><div name="7372795" id="7372795">обеспечение энергосбережения, в том числе внедрение энергосберегающего оборудования и технологий;</div></div><div class="ACT_TEXT"><div name="7372796" id="7372796">снижение воздействия предприятий на окружающую среду, в том числе внедрение системы онлайн-мониторинга недопущения совершения экологических правонарушений, выбросов в атмосферу;</div></div><div class="ACT_TEXT"><div name="7372797" id="7372797">реализация в производстве принципа внедрения циркулярной экономики («7R»);</div></div><div class="ACT_TEXT"><div name="7372798" id="7372798">б) применение к субъектам предпринимательства, получившим статус «зеленого предпринимателя», следующих мер поддержки:</div></div><div class="ACT_TEXT"><div name="7372799" id="7372799">предоставление приоритета на платформе «Шаффоф курилиш»;</div></div><div class="ACT_TEXT"><div name="7372800" id="7372800">освобождение от экологических проверок на определенный период;</div></div><div class="ACT_TEXT"><div name="7372801" id="7372801">оказание поддержки в продвижении на международные рынки;</div></div><div class="ACT_TEXT"><div name="7372802" id="7372802">присуждение дополнительного балла в рамках Рейтинга устойчивости субъектов предпринимательства.</div></div><div class="ACT_TEXT"><div name="7372806" id="7372806">20. В целях стимулирования широкого использования населением и субъектами предпринимательства возобновляемых источников энергии внедрить с 1 апреля 2025 года «зеленые тарифы» на электрическую энергию, произведенную за счет утилизации отходов, а также посредством ветряных и солнечных источников. При этом льготные тарифы устанавливаются:</div></div><div class="ACT_TEXT"><div name="7372808" id="7372808">на электрическую энергию, производимую субъектами предпринимательства посредством утилизации отходов и биогаза, а также вырабатываемую ветряными и солнечными электроустройствами, установленными организациями на своих территориях;</div></div><div class="ACT_TEXT"><div name="7372810" id="7372810">на электрическую энергию, полученную населением от солнечных источников, излишки от потребления которой реализуются государству.</div></div><div class="ACT_TEXT"><div name="7372813" id="7372813">21. В направлении устойчивого финансирования проектов по декарбонизации и адаптации экономики к изменению климата:</div></div><div class="ACT_TEXT"><div name="7372815" id="7372815">а) до 1 декабря 2025 года разработать Национальную программу по формированию системы «зеленого финансирования» в Республике Узбекистан;</div></div><div class="ACT_TEXT"><div name="7372818" id="7372818">б) принять меры по привлечению начиная с 2025 года льготных кредитов и грантовых средств на поддержку проектов зеленого и низкоуглеродного развития за счет следующих источников:</div></div><div class="ACT_TEXT"><div name="7372820" id="7372820">от Европейского банка реконструкции и развития — до 200 миллионов евро поэтапно;</div></div><div class="ACT_TEXT"><div name="7372821" id="7372821">от Всемирного банка — 10 миллионов долларов США для снижения эмиссии метана в энергетическом секторе;</div></div><div class="ACT_TEXT"><div name="7372823" id="7372823">в рамках технического содействия Корейского агентства международного сотрудничества посредством Глобального института зеленого развития — 6,5 миллиона долларов США для укрепления зеленого сотрудничества между Узбекистаном и Кореей;</div></div><div class="ACT_TEXT"><div name="7372824" id="7372824">в рамках проекта Всемирного банка «iCRAFT» — 7,5 миллиона долларов США за счет реализации 500 тысяч тонн сокращенных парниковых газов;</div></div><div class="ACT_TEXT"><div name="7372826" id="7372826">от Германского общества по международному сотрудничеству — 20 миллионов евро для озеленения промышленности и сокращения вредных газов, выбрасываемых в атмосферу предприятиями по производству азотной кислоты;</div></div><div class="ACT_TEXT"><div name="7372828" id="7372828">в) внедрить до сентября 2025 года порядок оценки национальных проектов «зеленой экономики», направленных на обеспечение прозрачности при реализации проектов «зеленой экономики»;</div></div><div class="ACT_TEXT"><div name="7372830" id="7372830">г) до ноября 2025 года внедрить практику оценки соответствия проектов «зеленым компонентам» и целям устойчивого развития посредством включения новых проектов на основе государственно-частного партнерства стоимостью более 10 миллионов долларов США в международную платформу «Source»;</div></div><div class="ACT_TEXT"><div name="7372832" id="7372832">д) обеспечить при техническом содействии Европейского Союза разработку планов действий по низкоуглеродному развитию, а также повышение энергоэффективности 10 социальных объектов в городах Бухаре, Намангане, Нукусе, Ургенче и Гузарском районе.</div></div><div class="ACT_TEXT"><div name="7372836" id="7372836">Определить заместителя Премьер-министра Д. Кучкарова ответственным за обеспечение безусловного, качественного и своевременного исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372848" id="7372848">22. Установить, что в 2025 году в направлении обеспечения региональной и межотраслевой координации, служащей экологической стабильности:</div></div><div class="ACT_TEXT"><div name="7372849" id="7372849">начиная с 2025 года в 15 процентах формируемых инвестиционных программ, новых проектов по развитию отраслей, сфер и регионов должны иметься «зеленые компоненты», начиная с 2027 года — в 30 процентах, начиная с 2030 года — 55 процентах;</div></div><div class="ACT_TEXT"><div name="7372850" id="7372850">разрабатываемые государственными органами и организациями, а также органами государственной власти на местах «зеленые программы», направленные на достижение углеродной нейтральности, адаптацию к изменению климата, охрану окружающей среды, повышение уровня озеленения и реализацию «зеленых проектов», подлежат утверждению по согласованию с Министерством экологии, охраны окружающей среды и изменения климата;</div></div><div class="ACT_TEXT"><div name="7372851" id="7372851">ежегодно ведется экологический рейтинг по снижению негативного воздействия государственных органов и социальных объектов на окружающую среду, рациональному использованию ресурсов и внедрению «зеленых технологий».</div></div><div class="ACT_TEXT"><div name="7372852" id="7372852">23. В целях эффективной организации работ по охране окружающей среды в регионах, совершенствования деятельности территориальных государственных органов и организаций в этом направлении:</div></div><div class="ACT_TEXT"><div name="7372853" id="7372853">привлечь консультантов по вопросам экологии и «зеленого развития» Председателя Совета Министров Республики Каракалпакстан, хокимов областей и города Ташкента по согласованию с Министерством экологии, охраны окружающей среды и изменения климата за счет грантовых средств международных финансовых институтов;</div></div><div class="ACT_TEXT"><div name="7372854" id="7372854">внедрить начиная с 1 сентября 2025 года практику разработки экологических паспортов и экологических мастер-планов на уровне районов (городов), а также экологического рейтинга регионов с представлением их широкой общественности.</div></div><div class="ACT_TEXT"><div name="7372855" id="7372855">Определить министра экологии, охраны окружающей среды и изменения климата А. Абдухакимова ответственным за координацию деятельности привлекаемых консультантов.</div></div><div class="ACT_TEXT"><div name="7372856" id="7372856">24. Нижеследующим:</div></div><div class="ACT_TEXT"><div name="7372857" id="7372857">а) Ассоциации махаллей Узбекистана (К. Куранбаев) обеспечить:</div></div><div class="ACT_TEXT"><div name="7372859" id="7372859">в недельный срок — внесение в Кабинет Министров программы высадки в 2025 году саженцев деревьев в махаллях, а также цветов и черенков в домохозяйствах и на внутренних улицах в рамках Общенационального проекта «Яшил макон» в разрезе районов и городов;</div></div><div class="ACT_TEXT"><div name="7372860" id="7372860">в весенне-осенний сезон 2025 года — посадку и уход за 32 миллионами саженцев фруктовых и декоративных деревьев, саженцами кустарников, базиликом (райхоном), целозией, розами, а также черенками;</div></div><div class="ACT_TEXT"><div name="7372862" id="7372862">с 10 февраля по 10 марта 2025 года — слаженную организацию работ по благоустройству и озеленению каждого домохозяйства, улицы и кладбища в целях внедрения критериев «Благоустроенный дом», «Благоустроенная улица» и «Благоустроенная махалля»;</div></div><div class="ACT_TEXT"><div name="7372865" id="7372865">совместно с Советом Министров Республики Каракалпакстан, хокимиятами областей и города Ташкента — проведение среди махаллей в канун праздника Навруз конкурсов «Благоустроенный дом», «Благоустроенная улица» и «Благоустроенная махалля».</div></div><div class="ACT_TEXT"><div name="7372866" id="7372866">Определить, что мероприятия, предусмотренные настоящим пунктом, осуществляются за счет средств Фонда по решению социально-экономических проблем махалли, спонсорских и благотворительных пожертвований;</div></div><div class="ACT_TEXT"><div name="7372867" id="7372867">б) Генеральной прокуратуре (Ш. Тухтабаев) совместно с Ассоциацией махаллей Узбекистана (К. Куранбаев) обеспечить с выездом на места установление строгого контроля за своевременным и качественным осуществлением мер, предусмотренных настоящим пунктом.</div></div><div class="ACT_TEXT"><div name="7372883" id="7372883">25. Проводить с 1 сентября 2025 года при утверждении в должности и освобождении от должности Председателя Совета Министров Республики Каракалпакстан, хокимов областей, районов (городов) экологический аудит по следующим экологическим показателям:</div></div><div class="ACT_TEXT"><div name="7372889" id="7372889">уровень озеленения и покрытия территории лесами, а также площадь лесов и охраняемых природных территорий;</div></div><div class="ACT_TEXT"><div name="7372890" id="7372890">количество деревьев на территории;</div></div><div class="ACT_TEXT"><div name="7372891" id="7372891">уровень создания вокруг городов и крупных промышленных предприятий зеленых поясов;</div></div><div class="ACT_TEXT"><div name="7372892" id="7372892">состояние песков и гравия в водных бассейнах и руслах рек;</div></div><div class="ACT_TEXT"><div name="7372893" id="7372893">уровень выбросов в атмосферу и загрязнения воздуха;</div></div><div class="ACT_TEXT"><div name="7372894" id="7372894">состояние установки станций фонового мониторинга загрязнения атмосферного воздуха, пылеулавливающих, газоочистных и локальных водоочистных сооружений на предприятиях, отнесенных к I и II категориям воздействия на окружающую среду;</div></div><div class="ACT_TEXT"><div name="7372895" id="7372895">охват населения услугами в сфере обращения с отходами, состояние обеспеченности мусоросборочными пунктами и контейнерами, уровень качества оказания услуг.</div></div><div class="ACT_TEXT"><div name="7372896" id="7372896">26. Министерству экологии, охраны окружающей среды и изменения климата (А. Абдухакимов) в месячный срок внести в Кабинет Министров проект нормативно-правового акта по совершенствованию порядка государственного экологического контроля и проведения проверок, кардинальному повышению эффективности деятельности Государственной инспекции по экологическому контролю, обеспечению ее сотрудников специальной техникой и транспортными средствами.</div></div><div class="ACT_TEXT"><div name="7372897" id="7372897">27. В целях дальнейшего усиления парламентского контроля в эффективном и рациональном использовании средств Государственного бюджета наладить практику внесения в Законодательную палату Олий Мажлиса всех отчетов Правительства касательно Государственного бюджета вместе с заключением внешнего аудита Счетной палаты.</div></div><div class="ACT_TEXT"><div name="7372898" id="7372898">28. Заместителю Премьер-министра Ж. Ходжаеву, министру экологии, охраны окружающей среды и изменения климата А. Абдухакимову, первому заместителю министра экономики и финансов И. Норкулову принять меры по привлечению инвестиций в размере 500 миллионов долларов США на организацию туристических комплексов, состоящих из «апарт-отелей», «капсульных» домов и других аналогичных средств размещения, в горной местности с высоким туристским потенциалом, прибрежных зонах водохранилищ, водных бассейнов и рек.</div></div><div class="ACT_TEXT"><div name="7372899" id="7372899">29. В целях эффективного использования сельскохозяйственных земель и обеспечения населения постоянными источниками дохода:</div></div><div class="ACT_TEXT"><div name="7372900" id="7372900">до 1 марта 2025 года в порядке эксперимента выделить посредством аукционных торгов выбранные земельные участки размером от 3 до 50 гектаров без нарушения их контуров и поливной системы по новой системе, основанной на независимости арендатора и выращивании культур с высокой добавленной стоимостью;</div></div><div class="ACT_TEXT"><div name="7372901" id="7372901">обеспечить закупку 10 портативно-мобильных лабораторий для проведения агрохимического анализа почвы;</div></div><div class="ACT_TEXT"><div name="7372902" id="7372902">довести до 10 тысяч гектаров земельные площади, на которых выращивается органическая сельскохозяйственная продукция;</div></div><div class="ACT_TEXT"><div name="7372903" id="7372903">Определить министра сельского хозяйства И. Абдурахмонова ответственным за обеспечение исполнения настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372910" id="7372910">30. Министерству цифровых технологий (Ш. Шерматов) совместно с Министерством юстиции (А. Ташкулов) с 1 октября 2025 года обеспечить полный перевод в электронную форму бумажного документооборота при оказании государственных услуг.</div></div><div class="ACT_TEXT"><div name="7372912" id="7372912">31. В рамках Государственной программы по реализации <a href="https://lex.uz/ru/docs/6600404#6605093">Стратегии</a> «Узбекистан — 2030» в «Год охраны окружающей среды и «зеленой экономики» (далее — Государственная программа) согласно приложениям №№ 1 — 21<a href="https://lex.uz/ru/docs/7369745#7373269">*</a> утвердить:</div></div><div class="ACT_TEXT"><div name="7372914" id="7372914">План практических мер на 2025 год;</div></div><div class="ACT_TEXT"><div name="7372915" id="7372915">Перечень проектов нормативно-правовых актов, разрабатываемых в 2025 году;</div></div><div class="ACT_TEXT"><div name="7372917" id="7372917">Целевые показатели на 2025 год;</div></div><div class="ACT_TEXT"><div name="7372919" id="7372919">План мер, подлежащих первоочередной реализации министерствами и ведомствами в 2025 году в направлении охраны окружающей среды;</div></div><div class="ACT_TEXT"><div name="7372920" id="7372920">План по реализации мер в направлении международного сотрудничества по охране окружающей среды в 2025 году;</div></div><div class="ACT_TEXT"><div name="7372922" id="7372922">План мер по реализации Программы «Зеленый туризм» в Республике Узбекистан;</div></div><div class="ACT_TEXT"><div name="7372924" id="7372924">План внедрения устройств возобновляемых источников энергии в регионах в 2025 году;</div></div><div class="ACT_TEXT"><div name="7372926" id="7372926">План посадки деревьев в махаллях в весенне-осенний сезоны 2025 года в рамках Общенационального движения «Яшил макон»;</div></div><div class="ACT_TEXT"><div name="7372927" id="7372927">План посадки цветов и черенков в домохозяйствах и на внутренних улицах в махаллях в весенний сезон 2025 года.</div></div><div class="FOOTNOTE"><div name="7373269" id="7373269">* Приложения приводятся на <a href="https://lex.uz/ru/docs/7369703#7371982">узбекском языке</a>.</div></div><div class="ACT_TEXT"><div name="7372930" id="7372930">32. Генеральной прокуратуре (Ш. Аминов) осуществлять строгий контроль за обеспечением исполнения плана по установке устройств возобновляемых источников энергии малой мощности, а также безусловным соблюдением требований законодательства при установке солнечных панелей и гелиоколлекторов.</div></div><div class="ACT_TEXT"><div name="7372932" id="7372932">33. Определить, что:</div></div><div class="ACT_TEXT"><div name="7372934" id="7372934">безусловная, качественная и полная реализация Государственной программы является первоочередной приоритетной задачей государственных органов и организаций всех уровней;</div></div><div class="ACT_TEXT"><div name="7372936" id="7372936">руководители государственных органов и организаций несут персональную ответственность за достижение целевых показателей, определенных в Государственной программе в разрезе каждого квартала по соответствующим направлениям и регионам, эффективную реализацию предусмотренных мер, своевременную и тщательную разработку проектов необходимых нормативно-правовых актов.</div></div><div class="ACT_TEXT"><div name="7372939" id="7372939">34. Нижеследующим:</div></div><div class="ACT_TEXT"><div name="7372942" id="7372942">Министерству юстиции совместно со Счетной палатой в рамках Государственной программы проводить системный мониторинг выполнения планов практических мер по направлениям, достижения целевых показателей и разработки проектов соответствующих нормативно-правовых актов;</div></div><div class="ACT_TEXT"><div name="7372944" id="7372944">Центру «Стратегия развития» и движению «Юксалиш» критически изучать реализацию Государственной программы, в частности с выездом на места и с учетом мнения общественности, по результатам ежемесячно вносить информацию в Администрацию Президента Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="7372945" id="7372945">органам государственной власти, министерствам и ведомствам, органам исполнительной власти на местах оказывать всестороннее содействие деятельности Центра «Стратегия развития» и движения «Юксалиш» по исполнению настоящего пункта.</div></div><div class="ACT_TEXT"><div name="7372989" id="7372989">35. Кабинету Министров:</div></div><div class="ACT_TEXT"><div name="7372990" id="7372990">в недельный срок принять меры, направленные на исполнение настоящего Указа и утвержденной им Государственной программы;</div></div><div class="ACT_TEXT"><div name="7372991" id="7372991">по итогам каждого месяца обобщать информацию о ходе исполнения Государственной программы и вносить в Администрацию Президента Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="7372992" id="7372992">по итогам каждого квартала обсуждать на заседании Президиума Кабинета Министров своевременное, полное и качественное выполнение задач, определенных в Государственной программе;</div></div><div class="ACT_TEXT"><div name="7372993" id="7372993">каждые полгода вносить в Законодательную палату Олий Мажлиса отчеты о ходе исполнения Государственной программы.</div></div><div class="ACT_TEXT"><div name="7372994" id="7372994">36. Агентству информации и массовых коммуникаций (А. Ходжаев), Национальной телерадиокомпании Узбекистана (А. Джурабаев) и Национальному информационному агентству Узбекистана (А. Кучимов) совместно с другими средствами массовой информации обеспечить осуществление на регулярной основе:</div></div><div class="ACT_TEXT"><div name="7372997" id="7372997">широкого разъяснения результатов реализации Государственной программы, достижений при переходе к «зеленой экономике» в средствах массовой информации, в том числе сети Интернет и социальных сетях, а также доведения до общественности ее сути и содержания;</div></div><div class="ACT_TEXT"><div name="7372999" id="7372999">оперативного доведения до населения объективной и полной информации о ходе и результатах всех мероприятий, осуществляемых в рамках Государственной программы.</div></div><div class="ACT_TEXT"><div name="7373000" id="7373000">37. Возложить на руководителей министерств и ведомств, Председателя Совета Министров Республики Каракалпакстан, хокимов областей и города Ташкента персональную ответственность за эффективную организацию исполнения настоящего Указа.</div></div><div class="ACT_TEXT"><div name="7373001" id="7373001">Регулярное обсуждение хода исполнения настоящего Указа, осуществление координации и контроля за деятельностью организаций, ответственных за его исполнение, возложить на Республиканскую комиссию по реализации <a href="https://lex.uz/ru/docs/6600404#6605093">Стратегии</a> «Узбекистан — 2030».</div></div><div class="ACT_TEXT"><div name="7373002" id="7373002">Ежеквартально вносить Президенту Республики Узбекистан информацию об осуществленных мерах.</div></div><div class="SIGNATURE"><div name="7373003" id="7373003">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7373004" id="7373004">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7373005" id="7373005">30 января 2025 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="7373007" id="7373007">№ УП-16</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="7372610" id="7372610">(Национальная база данных законодательства, 09.02.2025 г., № 06/25/16/0119; 21.03.2025 г., № 06/25/51/0261; 03.05.2025 г., № 06/25/74/0404; 12.05.2025 г., № 06/25/84/0432; 20.05.2025 г., № 06/25/87/0451; 02.06.2025 г., № 06/25/90/0486; 15.08.2025 г., № 06/25/130/0762; 05.11.2025 г., № 06/25/206/1017; 07.02.2026 г., № 06/26/19/0118)</div></div></div>
</div></body></html>