ily:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="6481782" id="6481782">Указ</div></div><div class="ACCEPTING_BODY"><div name="6481784" id="6481784">Президента Республики Узбекистан</div></div><div class="ACT_TITLE"><div name="6481785" id="6481785">О мерах по трансформации сферы экологии и охраны окружающей среды и организации деятельности уполномоченного государственного органа</div></div><div class="BY_DEFAULT"><div name="6481791" id="6481791"></div></div><div class="ACT_TEXT"><div name="6481794" id="6481794">В последние годы в стране последовательно проводятся комплексные меры по обеспечению экологической безопасности, улучшению экологической ситуации, предупреждению вредного воздействия отходов на здоровье людей, рациональному использованию природных ресурсов, созданию благоприятных условий для повышения качества санитарной и экологической обстановки.</div></div><div class="ACT_TEXT"><div name="6481796" id="6481796">В масштабах страны реализуется общенациональный проект «Яшил макон», действует бессрочный мораторий на вырубку ценных видов деревьев, не входящих в государственный лесной фонд. </div></div><div class="ACT_TEXT"><div name="6481798" id="6481798">Вместе с тем вследствие невнимательности руководителей регионов, органов экологии и охраны окружающей среды, правоохранительных органов республики за прошедший период допущены серьезные недостатки в сфере, в отдельных случаях нанесен невосполнимый ущерб природе и обществу. В частности:</div></div><div class="ACT_TEXT"><div name="6481799" id="6481799">в регионах, особенно в городах, все более ухудшается ситуация по загрязнению воздуха в регионах, особенно в городах, не организована системная работа по снижению нагрузки выбросов в атмосферу;</div></div><div class="ACT_TEXT"><div name="6481800" id="6481800">в результате незаконной вырубки около 44 тысяч, в том числе почти 9,5 тысячи ценных видов деревьев, в период введенного моратория, объявленного на вырубку деревьев и кустарников, природе нанесен ущерб на 36 миллиардов сумов;</div></div><div class="ACT_TEXT"><div name="6481802" id="6481802">покрытие корневой системы деревьев бетоном и асфальтом, установка на них разных электрических ламп и рекламных приспособлений являются причиной серьезного повреждения деревьев;</div></div><div class="ACT_TEXT"><div name="6481804" id="6481804">в обществе увеличивается количество случаев жестокого обращения с животными, в том числе домашними и беспризорными животными, отсутствует современная система их идентификации, чипизации, вакцинации и стерилизации;</div></div><div class="ACT_TEXT"><div name="6481815" id="6481815">увеличение случаев бесконтрольного и бессистемного выпаса скота на охраняемых природных территориях, использование подземных вод без научного обоснования приводят к нарушению экосистем, росту деградации и опустыниванию больших земельных площадей, как следствие — усиливается воздействие изменения климата, возникает угроза жизни и здоровью людей;</div></div><div class="ACT_TEXT"><div name="6481817" id="6481817">в 2022 году по 27 фактам экологических правонарушений были возбуждены уголовные дела, по которым применены меры наказания всего лишь в виде легких финансовых штрафов;</div></div><div class="ACT_TEXT"><div name="6481820" id="6481820">несоответствие состояния действующих полигонов экологическим и санитарным требованиям, а также невнедрение в их деятельность технологий переработки и утилизации порождают угрозу их превращения в будущем в проблему на уровне экологической катастрофы.</div></div><div class="ACT_TEXT"><div name="6481822" id="6481822">В целях кардинального улучшения экологической обстановки путем создания современного механизма экологического мониторинга на основе цифровых технологий, дальнейшего повышения экологической культуры, сохранения биоразнообразия и регулирования деятельности по обращению с отходами, посадки деревьев и кустарников, создания зеленых зон, внедрения новых порядков их охраны, а также обеспечения исполнения <a href="https://lex.uz/uz/docs/6369999">Указа</a> Президента Республики Узбекистан от 25 января 2023 года № УП-14 «О первоочередных организационных мерах по эффективному налаживанию деятельности республиканских органов исполнительной власти»:</div></div><div class="ACT_TEXT"><div name="6481823" id="6481823">1. Учитывая новые задачи и функции, возлагаемые настоящим Указом, переименовать Министерство природных ресурсов в Министерство экологии, охраны окружающей среды и изменения климата (далее — Министерство).</div></div><div class="ACT_TEXT"><div name="6481824" id="6481824">2. Министерству совместно с Генеральной прокуратурой и Министерством внутренних дел в срок до 1 сентября 2023 года внести в Кабинет Министров проекты нормативно-правовых актов, предусматривающие:</div></div><div class="ACT_TEXT"><div name="6481825" id="6481825">а) отнесение преступлений, связанных с нанесением ущерба экологии и окружающей среде, уничтожением или нанесением повреждения объектам растительного и животного мира, к категории тяжких преступлений;</div></div><div class="ACT_TEXT"><div name="6481826" id="6481826">б) увеличение размера административных штрафов за нарушение требований введенного моратория на вырубку ценных видов деревьев и кустарников, не входящих в государственный лесной фонд, в 5 раз. При этом установление в дополнительном порядке обязательства по посадке вместо незаконно срубленного дерева саженцев компенсационного дерева именно в том месте, где прорастало срубленное дерево, а также введение применения финансовых санкций к юридическим лицам в размере от 100-кратного до 300-кратного размера базовой расчетной величины;</div></div><div class="ACT_TEXT"><div name="6481827" id="6481827">в) увеличение сумм взыскания за ущерб, нанесенный животному миру в результате незаконной охоты на животных, внесенных в Красную Книгу Республики Узбекистан, в 10 раз, а также сумм взыскания за ущерб, нанесенный путем повреждения растений до степени прекращения их роста или уничтожения, — в 5 раз; </div></div><div class="ACT_TEXT"><div name="6481828" id="6481828">г) применение административных штрафов за нарушение требований охраны природы в процессе сбора, транспортировки, размещения, обеззараживания, хранения, утилизации, переработки и реализации промышленных, бытовых и иных отходов, а также за выброс в неустановленных местах твердых бытовых и строительных отходов и сброс жидких бытовых отходов — с увеличением их размеров в 10 раз. </div></div><div class="ACT_TEXT"><div name="6481829" id="6481829">При этом введение в дополнительном порядке применения финансовых санкций к юридическим лицам в размере от 100-кратного до 300-кратного размера базовой расчетной величины;</div></div><div class="ACT_TEXT"><div name="6481830" id="6481830">д) увеличение размера административных штрафов за загрязнение или засорение вод, нарушение водоохранного режима на водосборах, а также нарушение требований об условиях допустимости сброса сточных вод в водные объекты в 5 раз; </div></div><div class="ACT_TEXT"><div name="6481831" id="6481831">е) по лесному фонду:</div></div><div class="ACT_TEXT"><div name="6481832" id="6481832">установление отдельной административной и уголовной ответственности за незаконное предоставление и использование земель;</div></div><div class="ACT_TEXT"><div name="6481833" id="6481833">включение отдельного состава преступления по незаконному строительству зданий, сооружений и построек на землях, а также приравнивание его санкций к санкциям, установленным за самовольный захват орошаемых земель;</div></div><div class="ACT_TEXT"><div name="6481834" id="6481834">ж) увеличение размера административных штрафов за жестокое обращение с животными в 10 раз и лишение лиц, совершивших данное правонарушение, права на содержание животных;</div></div><div class="ACT_TEXT"><div name="6481835" id="6481835">з) регулирование порядка определения и применения компенсационных платежей за загрязнение окружающей природной среды и размещение отходов на территории Республики Узбекистан на законодательном уровне, а также отмену предоставленных льгот;</div></div><div class="ACT_TEXT"><div name="6481836" id="6481836">и) регулирование вопроса установления квот на пользование всем растительным и животным миром на законодательном уровне.</div></div><div class="ACT_TEXT"><div name="6481837" id="6481837">3. Внедрить с 1 июля 2023 года в Республике Узбекистан систему «Общественный экологический контролер» и определить правами и обязанностями контролеров:</div></div><div class="ACT_TEXT"><div name="6481838" id="6481838">выявление экологических правонарушений, оформление и внесение в Платформу экоконтроля соответствующего акта;</div></div><div class="ACT_TEXT"><div name="6481839" id="6481839">получение бесплатного образования и повышение квалификации в целях овладения специальными знаниями и навыками в осуществлении деятельности;</div></div><div class="ACT_TEXT"><div name="6481840" id="6481840">получение информации о принятых мерах по отношению к выявленным правонарушениям, участие в процессах, связанных с назначением наказания правонарушителю;</div></div><div class="ACT_TEXT"><div name="6481841" id="6481841">получение вознаграждения за эффективную деятельность в порядке и в размере, установленных законодательством.</div></div><div class="ACT_TEXT"><div name="6481842" id="6481842">Общественные экологические контролеры обязаны обеспечивать прозрачность, противодействовать коррупции, а также объективно подготавливать достоверные данные в процессе выявления и оформления правонарушений.</div></div><div class="ACT_TEXT"><div name="6481843" id="6481843">4. Ввести должность заместителя Генерального прокурора, ответственного за соблюдение и надзор за исполнением законодательства в сфере экологии, охраны окружающей среды и лесного хозяйства.</div></div><div class="ACT_TEXT"><div name="6481844" id="6481844">5. Образовать в организационно-штатной структуре Генеральной прокуратуры Управление по надзору за исполнением законодательства в сфере экологии, охраны окружающей среды и лесного хозяйства (далее — Управление), состоящее из дополнительных 6 штатных единиц.</div></div><div class="ACT_TEXT"><div name="6481845" id="6481845">Установить, что:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853927" id="7853927">(абзац третий пункта 5 исключен <a href="https://lex.uz/uz/docs/7847356">Указом </a>Президента Республики Узбекистан от 18 ноября 2025 года № УП-217)</div></div><div class="BY_DEFAULT"><div name="7853939" id="7853939"></div></div><div class="ACT_TEXT"><div name="7853941" id="7853941">прокуратурам Республики Каракалпакстан, областей и города Ташкента выделяются всего 30 штатных единиц, в направлении надзора за исполнением законодательства в сфере экологии, охраны окружающей среды и лесного хозяйства;</div></div><div class="BY_DEFAULT"><div name="7853943" id="7853943"></div></div><div class="ACT_TEXT"><div name="7853945" id="7853945">вводимые в системе Генеральной прокуратуры 37 штатные единицы выделяются за счет оптимизации общей штатной численности системы Министерства.</div></div><div class="ACT_TEXT"><div name="6481851" id="6481851">6. Образовать в структуре Министерства Инспекцию государственного экологического контроля — (далее — Инспекция) без статуса обособленного юридического лица.</div></div><div class="ACT_TEXT"><div name="6481852" id="6481852">Передать штатные единицы работников охраны охраняемых природных территорий и государственных инспекторов лесных и лесоохотничьих хозяйств (лесных инспекторов) Инспекции.</div></div><div class="ACT_TEXT"><div name="6481853" id="6481853">7. Определить, что:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853928" id="7853928">(абзац второй пункта 7 исключен <a href="https://lex.uz/uz/docs/7847356">Указом </a>Президента Республики Узбекистан от 18 ноября 2025 года № УП-217)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853929" id="7853929">(абзац третий пункта 7 исключен <a href="https://lex.uz/uz/docs/7847356">Указом </a>Президента Республики Узбекистан от 18 ноября 2025 года № УП-217)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853937" id="7853937">(абзац четвертый пункта 7 исключен <a href="https://lex.uz/uz/docs/7847356">Указом </a>Президента Республики Узбекистан от 18 ноября 2025 года № УП-217)</div></div><div class="ACT_TEXT"><div name="6481857" id="6481857">Инспекция при осуществлении государственного экологического контроля на нее распространяются задачи, полномочия и права Министерства, определенные законодательством;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853938" id="7853938">(абзац шестой пункта 7 исключен <a href="https://lex.uz/uz/docs/7847356">Указом </a>Президента Республики Узбекистан от 18 ноября 2025 года № УП-217)</div></div><div class="ACT_TEXT"><div name="6481859" id="6481859">возложение республиканскими органами исполнительной власти, правоохранительными и контролирующими органами задач на работников Инспекции, не отнесенных к их полномочиям, запрещается;</div></div><div class="ACT_TEXT"><div name="6481862" id="6481862">автотранспортные средства, принадлежащие Инспекции, имеют специальную серию государственных номерных знаков — «ECO»;</div></div><div class="ACT_TEXT"><div name="6481863" id="6481863">республиканские органы исполнительной власти, правоохранительные и контролирующие органы обязаны всемерно содействовать Инспекции в выполнении возложенных на нее задач и функций;</div></div><div class="ACT_TEXT"><div name="6481864" id="6481864">информация, документы и иные материалы, необходимые для выполнения задач, возложенных на Инспекцию, предоставляются по ее законному требованию бесплатно.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7241479" id="7241479">(абзац одиннадцатый пункта 7 будет исключен с 1 января 2025 года <a href="https://lex.uz/uz/docs/7231783?ONDATE=23.11.2024 00#7235104">Указом </a>Президента Республики Узбекистан от 14 ноября 2024 года № УП-184 — Национальная база данных законодательства, 23.11.2024 г., № 06/24/184/0954)</div></div><div class="ACT_TEXT"><div name="6481866" id="6481866">8. Установить порядки механизма кардинального совершенствования системы государственного мониторинга окружающей природной среды, прогнозирования возникновения негативного воздействия в районах и городах республики, в соответствии с которыми:</div></div><div class="ACT_TEXT"><div name="6481867" id="6481867">а) в регионах республики:</div></div><div class="BY_DEFAULT"><div name="7140363" id="7140363"></div></div><div class="ACT_TEXT"><div name="7140364" id="7140364">в срок до 31 декабря 2024 года приобретаются и устанавливаются автоматизированные подстанции фонового мониторинга загрязнения атмосферного воздуха в районах (городах) согласно <a href="https://lex.uz/uz/docs/6479185#6482260">приложению № 1</a>.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7140365" id="7140365">(абзац второй подпункта «а» пункта 8 в редакции <a href="https://lex.uz/uz/docs/7128168?ONDATE=04.10.2024 00#7128851">Указа </a>Президента Республики Узбекистан от 26 сентября 2024 года № УП-149 — Национальная база данных законодательства, 04.10.2024 г., № 06/24/149/0772)</div></div><div class="ACT_TEXT"><div name="6481869" id="6481869">При этом:</div></div><div class="ACT_TEXT"><div name="6481870" id="6481870">подстанции устанавливаются Агентством гидрометеорологической службы на основе утвержденных Министерством технических требований и карт размещения на территориях;</div></div><div class="ACT_TEXT"><div name="6481871" id="6481871">закупки осуществляются за счет средств ссуды, выделяемых республиканскому бюджету Республики Каракалпакстан и местным бюджетам областей из республиканского бюджета;</div></div><div class="BY_DEFAULT"><div name="8112529" id="8112529"></div></div><div class="ACT_TEXT"><div name="8112530" id="8112530">б) до конца 2026 года в порядке эксперимента внедряется система прогнозирования и раннего предупреждения населения территорий с высоким уровнем природного загрязнения атмосферного воздуха по территории республики;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="8112532" id="8112532">(подпункт «б» пункта 8 в редакции <a href="https://lex.uz/uz/docs/8101212?ONDATE=30.03.2026 01#8104549">Указа </a>Президента Республики Узбекистан от 25 марта 2026 года № УП-46 — Национальная база данных законодательства, 30.03.2026 г., № 06/26/46/0290)</div></div><div class="BY_DEFAULT"><div name="8112536" id="8112536"></div></div><div class="ACT_TEXT"><div name="8112537" id="8112537">в) начиная с 1 января 2027 года сведения автоматизированных подстанций, устанавливаемых на территории Республики Каракалпакстан, областей и города Ташкента, визуализируются путем их интеграции в единую геоинформационную базу данных системы государственного мониторинга окружающей природной среды и регулярно обновляются на официальных веб-сайтах в режиме реального времени.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="8112538" id="8112538">(подпункт «в» пункта 8 в редакции <a href="https://lex.uz/uz/docs/8101212?ONDATE=30.03.2026 01#8104549">Указа </a>Президента Республики Узбекистан от 25 марта 2026 года № УП-46 — Национальная база данных законодательства, 30.03.2026 г., № 06/26/46/0290)</div></div><div class="BY_DEFAULT"><div name="6481874" id="6481874"></div></div><div class="BY_DEFAULT"><div name="7140367" id="7140367"></div></div><div class="ACT_TEXT"><div name="7140368" id="7140368">9. В целях качественного ведения мониторинга источников загрязнения окружающей природной среды на основании графика, утверждаемого Кабинетом Министров, возложить на хозяйствующие субъекты, отнесенные к I категории воздействия на окружающую среду, — в срок до 1 июля 2025 года, на хозяйствующие субъекты, отнесенные ко II категории воздействия на окружающую среду, — в срок до конца 2025 года следующие обязательства:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7140369" id="7140369">(абзац первый пункта 9 в редакции <a href="https://lex.uz/uz/docs/7128168?ONDATE=04.10.2024 00#7128852">Указа </a>Президента Республики Узбекистан от 26 сентября 2024 года № УП-149 — Национальная база данных законодательства, 04.10.2024 г., № 06/24/149/0772)</div></div><div class="ACT_TEXT"><div name="6481875" id="6481875">установку автоматизированных подстанций мониторинга анализа выбросов в атмосферный воздух из приоритетных стойких (организованных) источников загрязнения;</div></div><div class="ACT_TEXT"><div name="6481876" id="6481876">установку новых и модернизацию действующих высокоэффективных пыле- и газоочистных устройств и локальных водоочистных сооружений;</div></div><div class="ACT_TEXT"><div name="6481877" id="6481877">оснащение санитарно-защитных зон хозяйствующих субъектов автоматизированными стационарными наблюдательными постами.</div></div><div class="ACT_TEXT"><div name="6481878" id="6481878">Установить, что:</div></div><div class="ACT_TEXT"><div name="6481879" id="6481879">для установки пыле- и газоочистных устройств, локальных водоочистных сооружений и автоматических систем мониторинга хозяйствующим субъектам за счет средств международных финансовых институтов через коммерческие банки открывается кредитная линия в размере 100 млн долларов США;</div></div><div class="ACT_TEXT"><div name="6481880" id="6481880">начиная с 1 июля 2023 года предприятиям, установившим оборудование, предусмотренное настоящим пунктом (или осуществившим более 15 процентов платежей на основании договора), разрешается оплачивать компенсационные платежи за загрязнение окружающей природной среды и размещение отходов в рассрочку в равных долях в течение 36 месяцев;</div></div><div class="ACT_TEXT"><div name="6481881" id="6481881">в отношении хозяйствующих субъектов, не установивших оборудование, предусмотренное данным пунктом настоящего Указа, компенсационные платежи за загрязнение окружающей среды применяются с увеличением в 5 раз;</div></div><div class="ACT_TEXT"><div name="6481882" id="6481882">начиная с 1 января 2024 года запрещается проведение государственной экологической и градостроительной экспертиз проектов, в которых при проектировании новых объектов, отнесенных к I и II категориям воздействия на окружающую среду, не предусмотрена установка высокоэффективных пыле- и газоочистных устройств и (или) локальных водоочистных сооружений, а также приемка к эксплуатации объектов завершенного строительства без их установки.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6663894" id="6663894">(пункт 10 утратил силу <a href="https://lex.uz/uz/docs/6658631?ONDATE=11.11.2023 00#6660632">Указом </a>Президента Республики Узбекистан от 10 ноября 2023 года № УП-193 — Национальная база данных законодательства, 11.11.2023 г., № 06/23/193/0844)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="8112541" id="8112541">(пункт 11 утратил силу <a href="https://lex.uz/uz/docs/8101212?ONDATE=30.03.2026 01#8104552">Указом </a>Президента Республики Узбекистан от 25 марта 2026 года № УП-46 — Национальная база данных законодательства, 30.03.2026 г., № 06/26/46/0290)</div></div><div class="ACT_TEXT"><div name="6481898" id="6481898">12. Согласиться с предложением Министерства о формировании Перечня объектов национального природного наследия.</div></div><div class="ACT_TEXT"><div name="6481899" id="6481899">Министерству:</div></div><div class="ACT_TEXT"><div name="6481901" id="6481901">в срок до 1 января 2024 года провести инвентаризацию природных объектов республики, имеющих национальное значение, в том числе уникальных и неповторимых экосистем, видов биоразнообразия и природных ландшафтов, утвердить, опубликовать и постоянно обновлять Перечень объектов национального природного наследия;</div></div><div class="BY_DEFAULT"><div name="7056389" id="7056389"></div></div><div class="ACT_TEXT"><div name="7056390" id="7056390">начиная с 1 августа 2024 года принимать меры по представлению в список ЮНЕСКО номинаций объектов природного наследия Узбекистана на основании требований Международной конвенции ЮНЕСКО в установленном порядке.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7056396" id="7056396">(абзац четвертый пункта 12 в редакции <a href="https://lex.uz/uz/docs/7044892?ONDATE=03.08.2024 00#7047217">Указа </a>Президента Республики Узбекистан от 23 июля 2024 года № УП-106 — Национальная база данных законодательства, 03.08.2024 г., № 06/24/106/0571)</div></div><div class="ACT_TEXT"><div name="6481905" id="6481905">13. Одобрить предложение Министерства о внедрении следующей кардинально новой системы в организации мер по повышению уровня озеленения республики, эффективной реализации общенационального проекта «Яшил макон», а также развитии лесоводства и лесного питомничества:</div></div><div class="BY_DEFAULT"><div name="6481906" id="6481906"></div></div><div class="BY_DEFAULT"><div name="6677674" id="6677674"></div></div><div class="ACT_TEXT"><div name="6677676" id="6677676">а) в 2024 году из республиканского бюджета выделяются средства в размере 100 миллиардов сумов, в 2025 году и в последующие годы — по 500 миллиардов сумов, и данные средства через информационный портал «Открытый бюджет» и Инвестиционную программу адресного озеленения Республики Узбекистан направляются на:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6677683" id="6677683">(абзац первый подпункта «а» пункта 13 в редакции <a href="https://lex.uz/uz/docs/6673810?ONDATE=24.11.2023 00#6673982">Указа </a>Президента Республики Узбекистан от 23 ноября 2023 года № УП-199 — Национальная база данных законодательства, 24.11.2023 г., № 06/23/199/0882)</div></div><div class="ACT_TEXT"><div name="6481908" id="6481908">создание и содержание их до передачи постоянным пользователям защитных лесонасаждений «зеленый пояс», «зеленый сад», «зеленый общественный парк» и «зеленые покрытия»;</div></div><div class="ACT_TEXT"><div name="6481910" id="6481910">посадку саженцев деревьев вдоль основных железных дорог и магистральных автодорог исходя из природных условий;</div></div><div class="ACT_TEXT"><div name="6481912" id="6481912">создание садов на не менее 5 гектарах площади в каждом районе и городе;</div></div><div class="ACT_TEXT"><div name="6481914" id="6481914">проведение работ по посадке саженцев деревьев, подготовке и проектированию земельных участков;</div></div><div class="ACT_TEXT"><div name="6481915" id="6481915">расширение материнских плантаций в развитии семеноводства, посредством этого заготовку качественных семян и черенков;</div></div><div class="ACT_TEXT"><div name="6481917" id="6481917">развитие лесоводства и лесного питомничества, в том числе применение метода выращивания в горшках с закрытой корневой системой и уход в период не менее трех лет исходя из видов деревьев;</div></div><div class="ACT_TEXT"><div name="6481919" id="6481919">создание оросительных систем и установку водозаборных скважин;</div></div><div class="BY_DEFAULT"><div name="6677688" id="6677688"></div></div><div class="ACT_TEXT"><div name="6677690" id="6677690">б) реализуется ежегодно формируемая и утверждаемая Инвестиционная программа адресного озеленения Республики Узбекистан;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6677691" id="6677691">(подпункт «б» пункта 13 в редакции <a href="https://lex.uz/uz/docs/6673810?ONDATE=24.11.2023 00#6673985">Указа </a>Президента Республики Узбекистан от 23 ноября 2023 года № УП-199 — Национальная база данных законодательства, 24.11.2023 г., № 06/23/199/0882)</div></div><div class="ACT_TEXT"><div name="6481937" id="6481937">в) при осуществлении мер, определенных в Инвестиционной программе адресного озеленения:</div></div><div class="ACT_TEXT"><div name="6481938" id="6481938">заказчики, проектировщики и подрядчики определяются в порядке, установленном законодательством;</div></div><div class="ACT_TEXT"><div name="6481939" id="6481939">Министерством проводится экологическая экспертиза;</div></div><div class="ACT_TEXT"><div name="6481941" id="6481941">посадка, орошение, уход за саженцами деревьев, создание «зеленых садов», «зеленых общественных парков», «зеленого щита» и защитных лесонасаждений «зеленое покрытие» осуществляются в соответствии с законодательством о государственных закупках;</div></div><div class="ACT_TEXT"><div name="6481943" id="6481943">г) создание до конца 2023 года каждой государственной организацией и каждым хокимиятом своих садов, за которыми осуществляется уход в течение трех лет, за счет внебюджетных средств и средств местных бюджетов соответственно. При этом:</div></div><div class="ACT_TEXT"><div name="6481945" id="6481945">сады организаций создаются на центральных территориях районов (городов), площадью от 50 соток до 2 гектаров;</div></div><div class="ACT_TEXT"><div name="6481949" id="6481949">создание садов осуществляется на основании проектно-сметной документации, разрабатываемой Проектным институтом «Яшил лойиха» и Центром государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="6481951" id="6481951">определение земельных площадей и выделение средств для садов, создаваемых государственными организациями и хокимиятами, осуществляется Кабинетом Министров;</div></div><div class="ACT_TEXT"><div name="6481953" id="6481953">д) с 1 сентября 2023 года каждым крупным промышленным предприятием (отнесенным к I и II категориям воздействия на окружающую среду) создаются «зеленые пояса» на своей и прилегающей территориях на основе проекта, согласованного с Министерством, в течение трех лет;</div></div><div class="ACT_TEXT"><div name="6481954" id="6481954">е) Министерство и организации в его системе освобождаются от платежей за рассмотрение и утверждение заявлений (заявок) на полеты, а также иных платежей, связанных с запуском беспилотных летальных аппаратов, при использовании воздушного пространства республики.</div></div><div class="ACT_TEXT"><div name="6481957" id="6481957">14. В целях создания профессионального рынка труда, снижения безработицы и сокращения доли неофициальной занятости в сфере питомничества установить порядок, в соответствии с которым с 1 января 2024 года:</div></div><div class="ACT_TEXT"><div name="6481958" id="6481958">деятельность по выращиванию саженцев (рассады) деревьев и кустарников в домашних условиях или на основе надомничества является деятельностью (работой, услугами), которой могут заниматься самозанятые лица;</div></div><div class="ACT_TEXT"><div name="6481959" id="6481959">работы по выращиванию саженцев, уходу за посаженными саженцами, созданию лесополос на территории лесных хозяйств осуществляются в порядке эксперимента на основе аутсорсинга с привлечением физических и юридических лиц;</div></div><div class="ACT_TEXT"><div name="6481960" id="6481960">участки территорий хозяйств, передаваемые в долгосрочную аренду в целях создания в лесных хозяйствах питомников по выращиванию саженцев, определяются Министерством;</div></div><div class="ACT_TEXT"><div name="6481961" id="6481961">участки государственного лесного фонда передаются в аренду исключительно посредством платформы «E-auksion»;</div></div><div class="ACT_TEXT"><div name="6481965" id="6481965">на общественных экологических контролеров при оплате ими социального налога во внебюджетный Пенсионный фонд в размере 50 процентов базовой расчетной величины распространяется порядок исчисления стажа работы, необходимого для расчета пенсии, установленный законодательством для самозанятых лиц.</div></div><div class="ACT_TEXT"><div name="6481966" id="6481966">Определить, что лица, занятые в других сферах на основе трудового договора, одновременно могут заниматься деятельностью по выращиванию саженцев (рассады) в домашних условиях или Общественного экологического контролера.</div></div><div class="ACT_TEXT"><div name="6481967" id="6481967">15. Определить, что работа, связанная с обращением твердых бытовых отходов в республике, осуществляется посредством нового порядка и механизмов на основе принципов «ноль отходов» (Zero waste). При этом уделяется особое внимание:</div></div><div class="ACT_TEXT"><div name="6481970" id="6481970">раздельному сбору и вывозу отходов в зависимости от видов бытовых отходов;</div></div><div class="ACT_TEXT"><div name="6481972" id="6481972">переработке (Recycling) или сжиганию на максимальном уровне вновь образующихся отходов без направления их на полигоны, внедрению в сферу практики циркулярной экономики;</div></div><div class="ACT_TEXT"><div name="6481974" id="6481974">обеспечению поэтапной полной переработки и сжигания отходов на всех действующих полигонах; </div></div><div class="ACT_TEXT"><div name="6481975" id="6481975">направлению излишков тепловой или электрической энергии, получаемой в результате сжигания отходов, на удовлетворение потребностей населения и производства на действующие энергетические и коммуникационные сети в счет оплаты, в том числе с применением «зеленого тарифа»;</div></div><div class="ACT_TEXT"><div name="6481976" id="6481976">внедрение системы выделения «зеленых субсидий» из Государственного бюджета в целях повышения эффективности данной системы.</div></div><div class="ACT_TEXT"><div name="6481978" id="6481978">Министерству в срок до 1 сентября 2023 года внести в Кабинет Министров проект программы комплексного управления бытовыми отходами.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7056417" id="7056417">(пункт 16 утратил силу <a href="https://lex.uz/uz/docs/7044892?ONDATE=03.08.2024 00#7047221">Указом </a>Президента Республики Узбекистан от 23 июля 2024 года № УП-106 — Национальная база данных законодательства, 03.08.2024 г., № 06/24/106/0571)</div></div><div class="ACT_TEXT"><div name="6481983" id="6481983">17. Установить порядок, в соответствии с которым:</div></div><div class="ACT_TEXT"><div name="6481985" id="6481985">а) начиная с 1 августа 2023 года у новых строительных объектов, отнесенных к II — IV категориям уровня опасности:</div></div><div class="ACT_TEXT"><div name="6481987" id="6481987">архитектурная часть проектной документации согласовывается с территориальными подразделениями Министерства;</div></div><div class="ACT_TEXT"><div name="6481990" id="6481990">при формировании сметной стоимости также предусматриваются расходы по вывозу строительных отходов;</div></div><div class="ACT_TEXT"><div name="6481991" id="6481991">при регистрации в установленном порядке для начала строительно-монтажных работ определяется обязательство о составлении договора по вывозу и размещению на полигонах строительных отходов;</div></div><div class="ACT_TEXT"><div name="6481992" id="6481992">б) заключение государственной экологической экспертизы утверждается в установленном порядке руководителем Центра государственной экологической экспертизы, руководителями его филиалов в областях и городе Ташкенте, а также публикуется на официальном веб-сайте Министерства (за исключением специальных и военных объектов);</div></div><div class="ACT_TEXT"><div name="6481993" id="6481993">в) начиная с 1 января 2024 года все проекты новых строительных объектов III-IV категорий уровня опасности, в том числе проекты строительства гидротехнических сооружений, осуществляются на основании данных мониторинга по учету рисков, связанных с климатом в зоне строительства, выдаваемых Агентством гидрометеорологической службы;</div></div><div class="ACT_TEXT"><div name="6481994" id="6481994">г) начиная с 1 января 2024 года в процессе проведения в установленном порядке государственной экологической экспертизы деятельности хозяйствующих субъектов, отнесенных к I — IV категориям воздействия на окружающую среду, Министерством определяются целевые показатели обеспечения углеродной нейтральности. При этом: </div></div><div class="ACT_TEXT"><div name="6481998" id="6481998">исходя из вида деятельности конкретные показатели уменьшения объема парниковых газов и углеродного следа (carbon footprint), образующихся вследствие производства, в материалах оценки воздействия на окружающую среду, определяются паспортом проекта;</div></div><div class="ACT_TEXT"><div name="6482003" id="6482003">в заключении государственной экологической экспертизы по уменьшению углеродного следа на основе определенных показателей разрабатываются меры, подлежащие обязательному осуществлению хозяйствующими субъектами;</div></div><div class="ACT_TEXT"><div name="6482007" id="6482007">ведется мониторинг исполнения мер, определенных в заключении государственной экологической экспертизы, результаты которого являются основанием для применения штрафов и дополнительных компенсационных выплат в порядке, определенном законодательством;</div></div><div class="ACT_TEXT"><div name="6482010" id="6482010">информация о заключении государственной экологической экспертизы и работе, проведенной по его исполнению, публикуется на официальном веб-сайте Министерства;</div></div><div class="ACT_TEXT"><div name="6482015" id="6482015">д) начиная с 2024 года в установленном порядке проводится государственная экологическая экспертиза централизованных инвестиционных проектов и децентрализованных инвестиционных проектов по видам деятельности, отнесенным к I-II категориям воздействия на окружающую среду;</div></div><div class="ACT_TEXT"><div name="6482019" id="6482019">е) начиная с 1 января 2024 года в порядке эксперимента согласно порядку, определяемому Правительством, по проектам о видах деятельности, отнесенных к III-IV категориям воздействия на окружающую среду, негосударственными организациями может быть проведена экологическая экспертиза;</div></div><div class="ACT_TEXT"><div name="6482023" id="6482023">ж) начиная с 1 июля 2023 года запрещается приватизация полигонов отходов. При этом передача в аренду территорий полигонов отходов организациям, занимающимся переработкой отходов, их очистка и реализация высвобожденных земельных участков осуществляются Министерством. </div></div><div class="ACT_TEXT"><div name="6482035" id="6482035">18. Министерству в срок до 1 января 2024 года внести проект нормативно-правового акта, предусматривающий внедрение системы «зеленой сертификации», основанной на оценке соответствия технологических процессов экологическим нормам и требованиям, а также экологической маркировки продукции и услуг.</div></div><div class="ACT_TEXT"><div name="6482041" id="6482041">19. Поддержать предложения Министерства, Министерства энергетики и Министерства инвестиций, промышленности и торговли, направленные на ускорение строительства в республике с 1 декабря 2023 года станций быстрой зарядки электромобилей, об установлении обязательного порядка строительства станций зарядки минимум двухканальных электромобилей мощностью 60 кВт и более на территории:</div></div><div class="ACT_TEXT"><div name="6482046" id="6482046">автозаправочных станций, автостоянок вместимостью свыше 100 автомобилей и рынков в городе Нукусе, административных центрах областей и городах областного подчинения;</div></div><div class="ACT_TEXT"><div name="6482049" id="6482049">автозаправочных станций, торговых и развлекательных центров, расположенных на автомагистральных дорогах туристического транспортного коридора «Узбекистон туризм магистрали»,.</div></div><div class="ACT_TEXT"><div name="6482053" id="6482053">Установить, что для строительства первых 50 станций быстрой зарядки электромобилей с возведением солнечных электрических станций в пустынной и степной части туристического транспортного коридора «Узбекистон туризм магистрали» на каждый проект за счет Экологического фонда выделяется по 100 млн сумов в качестве субсидий.</div></div><div class="ACT_TEXT"><div name="6482089" id="6482089">20. Министерству начиная с 1 июля 2023 года организовать среди населения и широкой общественности Общенациональное движение «Массовый сбор отходов» (УзПлоггинг), направленное на защиту окружающей среды и пропаганду здорового образа жизни. При этом: </div></div><div class="ACT_TEXT"><div name="6482094" id="6482094">руководители сектора являются ответственными за организацию данных мероприятий на высоком уровне, привлечение к ним широкой общественности и экоактивистов;</div></div><div class="ACT_TEXT"><div name="6482098" id="6482098">в рамках благотворительных беговых марафонов, прогулок пешком (плалкинг) и на велосипеде (пликинг) в общественных парках, зеленых садах, на горных территориях и вокруг водных объектов и на других объектах с высокой степенью воздействия на окружающую среду республики проводятся дни раздельного сбора отходов;</div></div><div class="ACT_TEXT"><div name="6482102" id="6482102">в дни раздельного сбора проводятся соревнования, на основе пройденного расстояния и объема раздельно собранных отходов определяются победители, которые поощряются Министерством.</div></div><div class="ACT_TEXT"><div name="6482108" id="6482108">21. В целях пробуждения у молодежи любви к природе, ее воспитания в качестве защитников природы в образовательных учреждениях республики возложить на Министерство, Министерство высшего образования, науки и инноваций, Министерство дошкольного и школьного образования следующие задачи:</div></div><div class="ACT_TEXT"><div name="6482112" id="6482112">проведение в рамках движения «Молодых экологов» конкурса инновационных и интеллектуальных проектов «Любовь к природе» по проблемам окружающей среды на уровне районов, городов и республики;</div></div><div class="ACT_TEXT"><div name="6482115" id="6482115">объявление в средствах массовой информации конкурса «Гимн природы» (на музыку и текст) и определение его победителей; </div></div><div class="ACT_TEXT"><div name="6482116" id="6482116">организацию мероприятий, посвященных важным экологическим датам в сфере охраны природы, празднуемым во всем мире и в нашей стране, а также поощрение в его рамках активистов Движения молодых экологов;</div></div><div class="ACT_TEXT"><div name="6482118" id="6482118">организацию курултая движения «Молодых экологов» и проведение крупных форумов в исторических городах (Ташкент, Самарканд, Навои, Бухара, Хорезм) в целях расширения рядов молодых экологов;</div></div><div class="ACT_TEXT"><div name="6482120" id="6482120">формирование молодежной команды посредством учреждения нагрудного знака «Молодой эколог» для молодежи, обладающей потенциалом, инициирующей инновационные проекты и результативные предложения в сфере природы;</div></div><div class="ACT_TEXT"><div name="6482121" id="6482121">включение в Национальную учебную программу общеобразовательных школ всего 132 часов уроков «экочас» (в рамках предметов по естественным наукам, физике, биологии, географии, химии).</div></div><div class="ACT_TEXT"><div name="6482125" id="6482125">22. Министерству совместно с Министерством строительства и жилищно-коммунального хозяйства внедрить следующий порядок, направленный на рациональное использование питьевой воды, экономию воды и уменьшение ее загрязнения населением в городах, предусматривающий:</div></div><div class="ACT_TEXT"><div name="6482128" id="6482128">а) начиная с 1 января 2024 года в городе Нукусе: </div></div><div class="ACT_TEXT"><div name="6482132" id="6482132">запуск рейтинговой системы по использованию питьевой воды среди многоэтажных домов «Экономичный дом» и «Экономичная квартира»;</div></div><div class="ACT_TEXT"><div name="6482133" id="6482133">поощрение по итогам года 20 квартир, потребивших наименьший объем воды, и 20 многоэтажных домов, в которых более 50 процентов квартир использовали воду в объеме меньше установленной нормы;</div></div><div class="ACT_TEXT"><div name="6482136" id="6482136">бесплатную установку победившим квартирам и домам солнечных панелей или приборов освещения вокруг домов за счет средств внебюджетного фонда Министерства;</div></div><div class="ACT_TEXT"><div name="6482137" id="6482137">б) внедрение с 2025 года данного опыта в городе Ташкенте и во всех областных центрах за счет средств местных бюджетов.</div></div><div class="ACT_TEXT"><div name="6482141" id="6482141">23. Образовать Центрально-Азиатский Университет изучения окружающей среды и изменения климата (Green University).</div></div><div class="ACT_TEXT"><div name="6482147" id="6482147">При этом для финансирования приобретения учебной литературы, деятельности по проведению научных исследований и инновационных работ Университету регулярно выделяется не менее 5 процентов средств, поступающих во внебюджетный фонд Министерства.</div></div><div class="ACT_TEXT"><div name="6482152" id="6482152">24. Определить Министерство органом, ответственным за дальнейшее развитие сферы экотуризма, горного, охотничьего и сафари-туризма, эффективное использование возможностей лесных хозяйств и национальных природных парков (за исключением зон, преобразованных в заповедники), а также создание соответствующих инфраструктурных объектов, организацию достойных условий для иностранных и отечественных туристов и обеспечение оказания услуг.</div></div><div class="ACT_TEXT"><div name="6482153" id="6482153">Одобрить предложение Министерства, Министерства культуры и туризма о реализации Национальной программы развития экотуризма «Путешествие на природу» (далее — Национальная программа), предусматривающей:</div></div><div class="ACT_TEXT"><div name="6482156" id="6482156">расширение спектра и развитие инфраструктуры туристских услуг в буферных зонах каждого государственного заповедника, национальных природных парках, питомниках, лесных и лесоохотничьих хозяйствах, на горных и степных территориях, а также в водоохранных зонах водных объектов (далее — экотерритории);</div></div><div class="ACT_TEXT"><div name="6482158" id="6482158">создание бренда экотерриторий и организацию на его основе пропагандистских кампаний;</div></div><div class="ACT_TEXT"><div name="6482175" id="6482175">создание пикник-зон, живописных смотровых площадок, комплекса экодомов, юртовых, глэмпинг- и кемпинг-лагерей, а также визитных центров (visitor center) с привлечением инвестиций на экотерритории;</div></div><div class="ACT_TEXT"><div name="6482178" id="6482178">налаживание туристских услуг с привлечением субъектов предпринимательства, таких как канатные дороги, электромоторные лодки, специальные транспортные средства для передвижения на снегу и квадроциклы, аттракционы «банджи-джампинг» и «зиплайн», аэростаты, «рафтинг» и «флайбординг», дома на колесах и наземные транспортные средства;</div></div><div class="ACT_TEXT"><div name="6482183" id="6482183">создание специализированных питомников по содержанию и разведению диких животных;</div></div><div class="ACT_TEXT"><div name="6482188" id="6482188">развитие экстремального туризма в горной и пустынной местностях; </div></div><div class="ACT_TEXT"><div name="6482192" id="6482192">организацию новых туристских услуг (включая Planting Tour, Plogging Tour и другие) и экоакций на экотерриториях.</div></div><div class="ACT_TEXT"><div name="6482193" id="6482193">Определить, что Министерство имеет право на финансирование мероприятий, указанных в настоящем пункте, а также создания и разработки мастер-планов развития малых экотуристских кластеров на экотерриториях, разработки технико-экономического обоснования планируемых инвестиционных проектов за счет средств Экологического фонда.</div></div><div class="ACT_TEXT"><div name="6482202" id="6482202">25. Установить, что Министерство в целях поддержки деятельности негосударственных некоммерческих организаций в сфере экологии, охраны окружающей среды и изменения климата:</div></div><div class="ACT_TEXT"><div name="6482206" id="6482206">регулярно предоставляет в установленном порядке социальные заказы на реализацию проектов негосударственных некоммерческих организаций;</div></div><div class="ACT_TEXT"><div name="6482207" id="6482207">в рамках социальных заказов из Экологического фонда выделяет средства и размещает объявление об этом на своем официальном веб-сайте;</div></div><div class="ACT_TEXT"><div name="6482210" id="6482210">организует общее обсуждение результатов работы, проведенной в рамках выделенных средств, принимает меры по их внедрению в производственный процесс.</div></div><div class="ACT_TEXT"><div name="6482214" id="6482214">Министерству в трехмесячный срок разработать и утвердить Положение о выделении средств, предусмотренных в настоящем пункте.</div></div><div class="ACT_TEXT"><div name="6482217" id="6482217">26. Министерству в срок до 1 июля 2023 года запустить Специальную платформу экологических акций, организуемых в республике, предусматривающую: </div></div><div class="ACT_TEXT"><div name="6482220" id="6482220">размещение сведений о планируемых акциях и проектах по охране окружающей среды;</div></div><div class="ACT_TEXT"><div name="6482222" id="6482222">введение данных о содействии эковолонтеров в организации акций и проектов, о рассмотрении заявлений по их проведению, а также о содействии деятельности Министерства;</div></div><div class="ACT_TEXT"><div name="6482225" id="6482225">размещение порядка поощрения активных волонтеров и перечня направлений, к которым привлекаются волонтеры. </div></div><div class="ACT_TEXT"><div name="6482231" id="6482231">27. Внести изменения и дополнения в некоторые акты Президента Республики Узбекистан согласно <a href="https://lex.uz/uz/docs/6479185#6482330">приложению № 2</a>.</div></div><div class="ACT_TEXT"><div name="6482234" id="6482234">28. Признать утратившими силу некоторые акты Президента Республики Узбекистан согласно <a href="https://lex.uz/uz/docs/6479185#6482635">приложению № 3</a>. </div></div><div class="ACT_TEXT"><div name="6482238" id="6482238">29. Министерству совместно с Министерством юстиции в двухмесячный срок внести в Кабинет Министров проекты соответствующих нормативно-правовых актов, предусматривающих изменения и дополнения в акты законодательства, вытекающие из настоящего Указа.</div></div><div class="ACT_TEXT"><div name="6482241" id="6482241">30. Возложить на министра экологии, охраны окружающей среды и изменения климата персональную ответственность за эффективную организацию исполнения настоящего Указа. </div></div><div class="ACT_TEXT"><div name="6482244" id="6482244">Обсуждение хода исполнения настоящего Указа, осуществление координации и контроля за деятельностью ведомств, ответственных за его исполнение, возложить на Премьер-министра Республики Узбекистан А.Н. Арипова.</div></div><div class="SIGNATURE"><div name="6482247" id="6482247">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6482248" id="6482248">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6482250" id="6482250">31 мая 2023 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="6482251" id="6482251">№ УП-81</div></div><div class="BY_DEFAULT"><div name="6482260" id="6482260"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="6482262" id="6482262">ПРИЛОЖЕНИЕ № 1<br />к <a href="https://lex.uz/uz/docs/6479185">Указу</a> Президента Республики Узбекистан от 31 мая 2023 года № УП-81 </div></div><div class="ACT_FORM"><div name="6482264" id="6482264">АВТОМАТИЗИРОВАННЫЕ ПОДСТАНЦИИ</div></div><div class="ACT_TITLE_APPL"><div name="6482265" id="6482265">фонового мониторинга загрязнения атмосферного воздуха, устанавливаемые в районах (городах) в 2023 году</div></div><div class="BY_DEFAULT"><div name="6482266" id="6482266"></div></div><div class="BY_DEFAULT"><div name="6482278" id="6482278"><table style="BORDER-RIGHT: medium none;BORDER-TOP: medium none;BORDER-LEFT: medium none;BORDER-BOTTOM: medium none;BORDER-COLLAPSE: collapse" cellspacing="0" cellpadding="0" width="100%" border="1">
