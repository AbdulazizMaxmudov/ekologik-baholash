<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="8104453" id="8104453">Указ</div></div><div class="ACCEPTING_BODY"><div name="8104454" id="8104454">Президента Республики Узбекистан</div></div><div class="ACT_TITLE"><div name="8104455" id="8104455"><b>О мерах по реализации Общенационального проекта «Чистый воздух», направленного на улучшение качества атмосферного воздуха</b></div></div><div class="BY_DEFAULT"><div name="8104457" id="8104457"></div></div><div class="ACT_TEXT"><div name="8104458" id="8104458">В целях сокращения антропогенной нагрузки на окружающую среду в результате ускорения изменения климата, развития урбанизации, промышленности и транспорта, предупреждения загрязнения атмосферного воздуха, а также стимулирования внедрения экологически чистых и ресурсосберегающих технологий постановляю:</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104459" id="8104459">I. Цели</div></div><div class="ACT_TEXT"><div name="8104460" id="8104460">1. Определить основными целями Общенационального проекта «Чистый воздух», направленного на улучшение качества атмосферного воздуха, на 2026 — 2030 годы:</div></div><div class="ACT_TEXT"><div name="8104461" id="8104461">(а) сокращение объема выброса загрязняющих веществ в атмосферу на 10,5 процента;</div></div><div class="ACT_TEXT"><div name="8104462" id="8104462">(б) обеспечение установки автоматических станций мониторинга и пылегазоочистных установок на предприятиях, отнесенных к I и II категориям воздействия на окружающую среду;</div></div><div class="ACT_TEXT"><div name="8104463" id="8104463">(в) доведение доли задержки выбросов промышленных объектов до 32 процентов;</div></div><div class="ACT_TEXT"><div name="8104464" id="8104464">(г) уменьшение числа дней с превышением национальных нормативов по PM2,5;</div></div><div class="ACT_TEXT"><div name="8104465" id="8104465">(д) сокращение объема загрязняющих веществ, выбрасываемых в атмосферный воздух транспортными средствами, на 10 процентов.</div></div><div class="ACT_TEXT"><div name="8104466" id="8104466">2. Утвердить:</div></div><div class="ACT_TEXT"><div name="8104467" id="8104467">(а) Целевые показатели Общенационального проекта «Чистый воздух», направленного на улучшение качества атмосферного воздуха, согласно приложению № 1<a href="https://lex.uz/docs/8101212#8104471">*</a>;</div></div><div class="ACT_TEXT"><div name="8104468" id="8104468">(б) Программу реализации Общенационального проекта «Чистый воздух», направленного на улучшение качества атмосферного воздуха, в городе Ташкенте согласно приложению № 2<a href="https://lex.uz/docs/8101212#8104471">*</a>;</div></div><div class="ACT_TEXT"><div name="8104469" id="8104469">(в) Целевые показатели Программы реализации Общенационального проекта «Чистый воздух», направленного на улучшение качества атмосферного воздуха, в городе Ташкенте согласно приложению № 2а<a href="https://lex.uz/docs/8101212#8104471">*</a>;</div></div><div class="ACT_TEXT"><div name="8104470" id="8104470">(г) Целевые показатели развития системы зеленых зон в городе Ташкенте до 2030 года, а также обеспечения потребностей населения в данном направлении согласно приложению № 2б<a href="https://lex.uz/docs/8101212#8104471">*</a>.</div></div><div class="FOOTNOTE"><div name="8104471" id="8104471">* <a href="https://lex.uz/docs/8101201#8104285">Приложения №№ 1</a>, <a href="https://lex.uz/docs/8101201#8104292">2</a>, <a href="https://lex.uz/docs/8101201#8104298">2а</a> и <a href="https://lex.uz/docs/8101201#8104304">2б</a> приводятся на узбекском языке.</div></div><div class="ACT_TEXT"><div name="8104472" id="8104472">3. Согласиться с предложением Национального комитета по экологии и изменению климата (далее — Комитет по экологии) о продлении на срок до 1 марта 2027 года деятельности Специальной комиссии по реализации неотложных мер по улучшению экологической ситуации в городе Ташкенте, а также ее переименовании в Республиканскую специальную комиссию по реализации неотложных мер по улучшению экологической ситуации.</div></div><div class="ACT_TEXT"><div name="8104473" id="8104473">4. Комитету по экологии совместно с заинтересованными министерствами и ведомствами, а также Советом Министров Республики Каракалпакстан и хокимиятами областей разработать проекты нормативно-правовых актов, направленных на реализацию Общенационального проекта «Чистый воздух»:</div></div><div class="ACT_TEXT"><div name="8104474" id="8104474">(а) до 1 июля 2026 года — в Ферганской, Андижанской и Наманганской областях;</div></div><div class="ACT_TEXT"><div name="8104475" id="8104475">(б) до 1 августа 2026 года — в Ташкентской, Сырдарьинской, Джизакской и Самаркандской областях;</div></div><div class="ACT_TEXT"><div name="8104476" id="8104476">(в) до 1 октября 2026 года — в Кашкадарьинской, Сурхандарьинской, Навоийской и Бухарской областях;</div></div><div class="ACT_TEXT"><div name="8104477" id="8104477">(г) до 1 декабря 2026 года — в Республике Каракалпакстан и Хорезмской области.</div></div><div class="ACT_TEXT"><div name="8104478" id="8104478">5. Определить, что до разработки и принятия в установленном порядке проектов нормативно-правовых актов, предусмотренных <a href="https://lex.uz/docs/8101212#8104473">пунктом 4</a> настоящего Указа, реализация Общенационального проекта «Чистый воздух» в регионах осуществляется в соответствии с программами, утвержденными Жокаргы Кенесом Республики Каракалпакстан и кенгашами народных депутатов областей.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104479" id="8104479">II. Реализация экологических реформ в отраслях энергетики, промышленности и сельского хозяйства</div></div><div class="ACT_TEXT"><div name="8104480" id="8104480">6. Установить порядок, в соответствии с которым начиная с 1 апреля 2026 года внедряется бессрочный мораторий на создание новых промышленных зон (за исключением зон, специализированных на оказании сервисных или финансовых услуг) в городе Ташкенте.</div></div><div class="ACT_TEXT"><div name="8104481" id="8104481">7. Определить, что в целях производства тепловой и электрической энергии, а также установки пылегазоочистных и энергоэффективных установок на промышленных предприятиях принимаются следующие меры:</div></div><div class="ACT_TEXT"><div name="8104482" id="8104482">(а) с 1 октября 2026 года предприятиям, получившим международные сертификаты Международной организации стандартизации по экологическому менеджменту, управлению парниковыми газами, экологической безопасности и «зеленой» энергии, производящим 30 процентов продукции за счет альтернативной энергии, компенсируется до 50 процентов расходов по получению сертификатов за счет средств Государственного целевого фонда по устранению общенациональных экологических проблем при Комитете по экологии;</div></div><div class="ACT_TEXT"><div name="8104483" id="8104483">(б) до 1 мая 2026 года на предприятиях по производству тепловой и электрической энергии, расположенных в городе Ташкенте и прилегающих к нему районах, в обязательном порядке устанавливаются автоматические станции мониторинга и автоматические наблюдательные посты на приоритетных (стационарных) источниках и данные, получаемые посредством этих установок, интегрируются с Единой геоинформационной базой данных Комитета по экологии;</div></div><div class="ACT_TEXT"><div name="8104484" id="8104484">(в) в случае неосуществления интеграции установленных предприятиями, отнесенными к I и II категориям воздействия на окружающую среду, автоматических станций мониторинга с Единой геоинформационной базой данных Комитета по экологии в их отношении применяются компенсационные выплаты за загрязнение окружающей природной среды и размещение с увеличением в 10 раз;</div></div><div class="ACT_TEXT"><div name="8104485" id="8104485">(г) с 1 июля 2026 года отменяется практика эксплуатации котлов, не имеющих сертификата соответствия и не обеспечивающих контроль процесса горения, при обеспечении теплоснабжения теплиц.</div></div><div class="ACT_TEXT"><div name="8104486" id="8104486">8. Принять к сведению, что Министерством экономики и финансов, а также Национальным агентством по энергоэффективности достигнута договоренность о привлечении заемных средств Японского агентства международного сотрудничества (JICA) в размере 100 миллионов долларов США, а также кредита Европейского банка реконструкции и развития (ЕБРР) в размере 200 миллионов долларов США без государственной гарантии.</div></div><div class="ACT_TEXT"><div name="8104487" id="8104487">9. Определить, что средства, предусмотренные <a href="https://lex.uz/docs/8101212#8104486">пунктом 8 </a>настоящего Указа, направляются на выделение льготных кредитов промышленным предприятиям посредством коммерческих банков для приобретения «зеленых» технологий, пылегазоочистных установок, автоматических станций мониторинга, энергоэффективного оборудования и локальных водоочистных сооружений.</div></div><div class="ACT_TEXT"><div name="8104488" id="8104488">10. Кабинету Министров и Торгово-промышленной палате утвердить и обеспечить реализацию в период с 1 мая 2026 года по 1 декабря 2026 года Плана установки «зеленых» технологий, пылегазоочистных установок, автоматических станций мониторинга, энергоэффективного оборудования и локальных водоочистных сооружений на предприятиях, отнесенных к I и II категориям воздействия на окружающую среду.</div></div><div class="ACT_TEXT"><div name="8104489" id="8104489">11. Установить, что Комитет по экологии:</div></div><div class="ACT_TEXT"><div name="8104490" id="8104490">(а) осуществляет постоянный мониторинг эффективности пылегазоочистных установок на основе специальных лабораторных испытаний;</div></div><div class="ACT_TEXT"><div name="8104491" id="8104491">(б) по результатам мониторинга формирует реестр пылегазоочистных установок, получивших положительное заключение, и публикует его на своей официальной странице.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104492" id="8104492">III. Охрана атмосферного воздуха и усиление экологических требований в сфере строительства</div></div><div class="ACT_TEXT"><div name="8104493" id="8104493">12. Определить, что начиная с 1 июня 2026 года:</div></div><div class="ACT_TEXT"><div name="8104494" id="8104494">(а) вводятся обязательства внедрения следующих экологических требований на строительных объектах (за исключением индивидуального жилья):</div></div><div class="ACT_TEXT"><div name="8104495" id="8104495">(i) оснащение строительных объектов станциями фонового мониторинга и осуществление их интеграции с Единой геоинформационной базой данных Комитета по экологии;</div></div><div class="ACT_TEXT"><div name="8104496" id="8104496">(ii) установку онлайн-камер по периметру площади строительства и на точках выезда и осуществление их интеграции с Единой геоинформационной базой данных Комитета по экологии для ведения онлайн-контроля;</div></div><div class="ACT_TEXT"><div name="8104497" id="8104497">(iii) внедрение практики снижения рейтинговых баллов строительных организаций, совершивших правонарушение, на платформе «Прозрачное строительство»;</div></div><div class="ACT_TEXT"><div name="8104498" id="8104498">(б) внедряется порядок представления в обязательном порядке заключения экологической экспертизы при проведении экспертизы проектно-сметной и градостроительной документации строительных объектов;</div></div><div class="ACT_TEXT"><div name="8104499" id="8104499">(в) при проектировании подлежащих строительству новых зданий и сооружений (за исключением индивидуального жилья), высотой выше 12 метров от поверхности земли и (или) общей площадью более 500 квадратных метров, не допускается отведение площади для озеленения (посадки деревьев, кустарников, иных растений и саженцев) на прилегающих к ним территориях площадью менее 30 процентов от общей площади земельных участков, выделяемых для проекта.</div></div><div class="ACT_TEXT"><div name="8104500" id="8104500">13. Жокаргы Кенесу Республики Каракалпакстан, хокимиятам областей и города Ташкента в срок до 1 декабря 2026 года внедрить в каждом регионе систему сбора листьев деревьев минимум на одном гектаре площади, использования органических веществ, полученных путем разложения листьев деревьев биологическим методом (компостирования), в качестве компоста и в мульчировании.</div></div><div class="ACT_TEXT"><div name="8104501" id="8104501">14. Хокимияту города Ташкента, Комитету по экологии, Министерству строительства и жилищно-коммунального хозяйства принять меры по разработке в срок до 1 мая 2027 года мастер-плана управления и рационального использования экологических и водных ресурсов города Ташкента до 2035 года с привлечением зарубежных компаний и научно-исследовательских институтов.</div></div><div class="ACT_TEXT"><div name="8104502" id="8104502">15. Установить, что:</div></div><div class="ACT_TEXT"><div name="8104503" id="8104503">(а) при получении заключений экологической и строительной экспертиз учет перемещения коридоров «розы ветров» является обязательным;</div></div><div class="ACT_TEXT"><div name="8104504" id="8104504">(б) «ветровые коридоры» в проектах генеральных планов территорий утверждаются с учетом перемещения коридоров «розы ветров»;</div></div><div class="ACT_TEXT"><div name="8104505" id="8104505">(в) восстановление (работы по реабилитации, рекультивации и озеленению) земель водного фонда, разрушенных в процессе очистки русел рек и саев либо вследствие незаконной добычи песка и гравия физическими и юридическими лицами, осуществляется за счет средств лиц, совершивших нарушение закона.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104506" id="8104506">IV. Экологическая модернизация системы транспорта</div></div><div class="ACT_TEXT"><div name="8104507" id="8104507">16. Определить, что:</div></div><div class="ACT_TEXT"><div name="8104508" id="8104508">(а) с 1 мая 2026 года ежемесячно 10-го и 25-го числа проводятся акции «День без автомобиля», «Неделя без автомобиля». При этом:</div></div><div class="ACT_TEXT"><div name="8104509" id="8104509">(i) в рамках данных акций строго запрещается использование служебных автотранспортных средств государственными гражданскими служащими;</div></div><div class="ACT_TEXT"><div name="8104510" id="8104510">(ii) в случае совпадения указанных дат с рабочими днями заработная плата водителей сохраняется;</div></div><div class="ACT_TEXT"><div name="8104511" id="8104511">(б) с 1 августа 2026 года в целях создания дополнительных удобств для населения внедряется практика возмещения физическим и юридическим лицам, сдавшим изношенные автотранспортные средства в рамках программы «trade-in», части процентов по автокредитам на приобретение новых транспортных средств.</div></div><div class="ACT_TEXT"><div name="8104512" id="8104512">17. Министерству энергетики в срок до 1 ноября 2026 года обеспечить разработку и внесение на утверждение в Кабинет Министров Программы модернизации и развития всех нефтеперерабатывающих заводов республики, предусматривающей производство моторного топлива, соответствующего требованиям экологического класса «Евро-4», в срок до 1 ноября 2028 года, «Евро-5» — начиная с 1 марта 2030 года.</div></div><div class="ACT_TEXT"><div name="8104513" id="8104513">18. Комитету по экологии в срок до конца 2026 года в рамках системы «Экологический транспорт» обеспечить разделение территории города Ташкента на «красную», «желтую» и «зеленую» зоны.</div></div><div class="ACT_TEXT"><div name="8104514" id="8104514">19. Министерству внутренних дел в срок до конца 2026 года осуществить соответствующие меры по обеспечению выдачи экологических стикеров, подтверждающих экологическую категорию, всем автотранспортным средствам в городе Ташкенте.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104515" id="8104515">V. Оперативные меры, направленные на предупреждение природной пыли</div></div><div class="ACT_TEXT"><div name="8104516" id="8104516">20. Комитету по экологии:</div></div><div class="ACT_TEXT"><div name="8104517" id="8104517">(а) в месячный срок внести проект постановления о направлении части средств, предусмотренных в рамках проекта Всемирного банка «Восстановление устойчивых лесных ландшафтов в Узбекистане», на проект создания «зеленого пояса» вокруг города Ташкента;</div></div><div class="ACT_TEXT"><div name="8104518" id="8104518">(б) начиная с 1 апреля 2026 года приступить к созданию «зеленых стен» протяженностью в Сурхандарьинской и Сырдарьинской областях в целях предупреждения пыльных бурь.</div></div><div class="ACT_TEXT"><div name="8104519" id="8104519">21. Комитету по экологии совместно с хокимиятами города Ташкента и Ташкентской области начиная с 1 апреля 2026 года за счет средств Государственного целевого фонда по устранению общенациональных экологических проблем при Комитете по экологии, спонсорских средств и иных источников, не запрещенных законодательством, приступить к созданию следующих парков:</div></div><div class="ACT_TEXT"><div name="8104520" id="8104520">(а) дендрологического парка на 250 гектарах площади Института ядерной физики Академии наук и прилегающих к нему территориях (за исключением земельных площадей, предназначенных для создания Центра по переподготовке и повышению квалификации кадров сферы топливно-энергетической и химической промышленности, а также «Узбекско-Корейского центра инновационных химических технологий»);</div></div><div class="ACT_TEXT"><div name="8104521" id="8104521">(б) дендрологического парка на 83 гектарах площади Ташкентского и Кибрайского районов, расположенной напротив Центрально-Азиатского университета изучения окружающей среды и изменения климата (Green University).</div></div><div class="ACT_TEXT"><div name="8104522" id="8104522">22. Хокимияту города Ташкента совместно с Министерством строительства и жилищно-коммунального хозяйства, Комитетом по экологии в срок до конца 2026 года обеспечить создание зеленого общественного парка на 4,36 гектара площади на месте бывшей онкологической больницы города Ташкента по улице Богистон в махалле «Лутфи» Чиланзарского района.</div></div><div class="ACT_TEXT"><div name="8104523" id="8104523">23. Хокимияту города Ташкента совместно с Министерством водного хозяйства и Министерством строительства и жилищно-коммунального хозяйства в срок до конца 2026 года провести работы по созданию четырех искусственных озер и (или) водоемов в городе Ташкенте за счет средств Государственного целевого фонда по устранению общенациональных экологических проблем.</div></div><div class="ACT_TEXT"><div name="8104524" id="8104524">24. Хокимияту города Ташкента совместно с Министерством высшего образования, науки и инноваций, Министерством строительства и жилищно-коммунального хозяйства, Комитетом по экологии по принадлежности обеспечить начиная с 1 апреля 2026 года:</div></div><div class="ACT_TEXT"><div name="8104525" id="8104525">(а) выполнение работ по строительству не менее одного, всего до 15 фонтанов на территории государственных высших образовательных учреждений, осуществляющих деятельность в городе Ташкенте, за счет их внебюджетных средств;</div></div><div class="ACT_TEXT"><div name="8104526" id="8104526">(б) принятие мер по строительству не менее одного фонтана с учетом градостроительных норм в каждом районе города Ташкента за счет источников, не запрещенных законодательством.</div></div><div class="ACT_TEXT"><div name="8104527" id="8104527">25. Комитету по экологии совместно с Академией наук, Министерством высшего образования, науки и инноваций принять меры поэтапного внедрения в установленном порядке технологий искусственного вызывания дождя и искусственного ветра на основе изучения апробированного положительного зарубежного опыта. При этом в срок до 1 октября 2027 года в целях улучшения качества атмосферного воздуха в столице обеспечить установку необходимого оборудования на территориях с низкой влажностью города Ташкента и Ташкентской области.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104528" id="8104528">VI. Организация, обеспечение и контроль исполнения Указа</div></div><div class="ACT_TEXT"><div name="8104529" id="8104529">26. Национальному информационному агентству Узбекистана совместно с Национальной телерадиокомпанией Узбекистана организовать работу по широкому освещению в средствах массовой информации и сети интернет целей и задач настоящего Указа, хода реализации осуществляемых мер и их результатов.</div></div><div class="ACT_TEXT"><div name="8104530" id="8104530">27. Внести изменения и дополнения в некоторые акты Президента Республики Узбекистан согласно <a href="https://lex.uz/docs/8101212#8104538">приложению № 3</a>.</div></div><div class="ACT_TEXT"><div name="8104531" id="8104531">28. Национальному комитету Республики Узбекистан по статистике в двухмесячный срок внести изменения и дополнения в действующие нормативно-правовые акты, предусматривающие внедрение порядка согласования с Комитетом по экологии сбора статистических отчетов и распространения информации экологического характера.</div></div><div class="ACT_TEXT"><div name="8104532" id="8104532">29. Возложить на заместителей Премьер-министра А.Ж. Раматова и Д.А. Кучкарова, советника Президента Республики Узбекистан по вопросам экологии — председателя Национального комитета по экологии и изменению климата А.А. Абдухакимова, а также Председателя Совета Министров Республики Каракалпакстан, хокимов областей и города Ташкента персональную ответственность за эффективную организацию исполнения настоящего Указа.</div></div><div class="ACT_TEXT"><div name="8104533" id="8104533">30. Обсуждение хода исполнения настоящего Указа, осуществление координации и контроля за деятельностью ведомств, ответственных за его исполнение, возложить на Премьер-министра Республики Узбекистан А.Н. Арипова и руководителя Администрации Президента Республики Узбекистан С.Ш. Мирзиёеву.</div></div><div class="SIGNATURE"><div name="8104534" id="8104534">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="8104535" id="8104535">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="8104536" id="8104536">25 марта 2026 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="8104537" id="8104537">№ УП-<span translate="no">46</span></div></div><div class="BY_DEFAULT"><div name="8104538" id="8104538"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="8104539" id="8104539">ПРИЛОЖЕНИЕ № 3<br />к <a href="https://lex.uz/docs/8101212">Указу </a>Президента Республики Узбекистан от 25 марта 2026 года № УП-46</div></div><div class="ACT_TITLE_APPL"><div name="8104540" id="8104540"><b>Изменения и дополнения, вносимые в некоторые акты Президента Республики Узбекистан</b></div></div><div class="BY_DEFAULT"><div name="8104541" id="8104541"></div></div><div class="ACT_TEXT"><div name="8104542" id="8104542">1. <a href="https://lex.uz/docs/1309871?ONDATE=17.12.2007 00#1309931">Размеры </a>ежемесячных выплат за почетные звания, утвержденные Указом Президента Республики Узбекистан от 17 декабря 2007 года № УП-3942, дополнить позицией 36 следующего содержания:</div></div><div class="TABLE_STD2"><div name="8104572" id="8104572"><table class="Table" style="border-collapse:collapse" width="100%"><tbody><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:83%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p style="text-align:justify;text-indent:11.6pt"></p></td><td style="border-bottom:1px solid black;width:11%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">36.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:83%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-align:justify;text-indent:11.6pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«</span></span><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикасида хизмат кўрсатган эколог</span></span><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">» («Заслуженный эколог Республики Узбекистан»)</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:11%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1,6</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:none;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:none;width:83%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p style="text-align:justify;text-indent:11.6pt"></p></td><td style="border-bottom:none;width:11%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="right" style="text-align:right"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">».</span></span></span></span></span></p></td></tr></tbody></table></div></div><div class="ACT_TEXT"><div name="8104544" id="8104544">2. В <a href="https://lex.uz/docs/5664785">Указе </a>Президента Республики Узбекистан от 30 сентября 2021 года № УП-6318 «О дополнительных мерах по поддержке сферы услуг»:</div></div><div class="ACT_TEXT"><div name="8104545" id="8104545">(а) <a href="https://lex.uz/docs/5664785?ONDATE=30.09.2021 00#5668054">пункт 1 </a>изложить в следующей редакции:</div></div><div class="ACT_TEXT"><div name="8104546" id="8104546">«1. Применить на срок до 31 декабря 2027 года нулевую ставку таможенной пошлины при импорте в Республику Узбекистан автобусов, электробусов, троллейбусов и микроавтобусов, предназначенных для перевозки пассажиров и с момента выпуска которых прошло не более 2 лет, а также разрешить выплачивать утилизационный сбор в рассрочку на пять лет»;</div></div><div class="ACT_TEXT"><div name="8104547" id="8104547">(б) <a href="https://lex.uz/docs/5664785?ONDATE=30.09.2021 00#5668062">пункт 2 </a>признать утратившим силу.</div></div><div class="ACT_TEXT"><div name="8104548" id="8104548">3. В <a href="https://lex.uz/docs/6479185">Указе </a>Президента Республики Узбекистан от 31 мая 2023 года № УП-81 «О мерах по трансформации сферы экологии и охраны окружающей среды и организации деятельности уполномоченного государственного органа»:</div></div><div class="ACT_TEXT"><div name="8104549" id="8104549">(а) <a href="https://lex.uz/docs/6479185?ONDATE=02.06.2023 00#6481872">подпункты «б»</a> и <a href="https://lex.uz/docs/6479185?ONDATE=02.06.2023 00#6481873">«в»</a> пункта 8 изложить в следующей редакции:</div></div><div class="ACT_TEXT"><div name="8104550" id="8104550">«б) до конца 2026 года в порядке эксперимента внедряется система прогнозирования и раннего предупреждения населения территорий с высоким уровнем природного загрязнения атмосферного воздуха по территории республики;</div></div><div class="ACT_TEXT"><div name="8104551" id="8104551">в) начиная с 1 января 2027 года сведения автоматизированных подстанций, устанавливаемых на территории Республики Каракалпакстан, областей и города Ташкента, визуализируются путем их интеграции в единую геоинформационную базу данных системы государственного мониторинга окружающей природной среды и регулярно обновляются на официальных веб-сайтах в режиме реального времени»;</div></div><div class="ACT_TEXT"><div name="8104552" id="8104552">(б) <a href="https://lex.uz/docs/6479185?ONDATE=02.06.2023 00#6481887">пункт 11 </a>признать утратившим силу.</div></div><div class="ACT_TEXT"><div name="8104553" id="8104553">4. В тексте на государственном языке <a href="https://lex.uz/docs/7587464">Указа</a> Президента Республики Узбекистан от 19 июня 2025 года № УП-95 «О мерах по организации государственной гражданской службы на основе новых подходов и формированию профессионального и направленного на результативность корпуса государственных служащих»:</div></div><div class="ACT_TEXT"><div name="8104554" id="8104554">(а) в <a href="https://lex.uz/docs/7587464?ONDATE=23.06.2025 00#7590770">приложении № 4</a>:</div></div><div class="ACT_TEXT"><div name="8104555" id="8104555">(i) дополнить позицией 12<sup>1 </sup>следующего содержания:</div></div><div class="TABLE_STD2"><div name="8104573" id="8104573"><table class="Table" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:94%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p style="text-indent:17.0pt"></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">12<sup>1</sup>.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:94%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p style="text-indent:17.0pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span lang="UZ-CYR" style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси Экология ва иқлим ўзгариши миллий қўмитаси</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:none;width:3%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:none;width:94%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="right" style="text-align:right;text-indent:17.0pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">»</span></span><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">;</span></span></span></span></span></p></td></tr></tbody></table></div></div><div class="ACT_TEXT"><div name="8104557" id="8104557">(ii) позицию 23 исключить;</div></div><div class="ACT_TEXT"><div name="8104558" id="8104558">(iii) позиции 62 — 64 изложить в следующей редакции:</div></div><div class="TABLE_STD2"><div name="8104574" id="8104574"><tabl