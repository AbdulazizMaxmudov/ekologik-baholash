<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Cyrl-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="8102947" id="8102947">ЎЗБЕКИСТОН РЕСПУБЛИКАСИ ПРЕЗИДЕНТИНИНГ</div></div><div class="ACT_FORM"><div name="8102948" id="8102948">ФАРМОНИ</div></div><div class="ACT_TITLE"><div name="8102949" id="8102949">«Яшил макон» умуммиллий лойиҳаси самарадорлигини янада ошириш чора-тадбирлари тўғрисида</div></div><div class="BY_DEFAULT"><div name="8102951" id="8102951"></div></div><div class="ACT_TEXT"><div name="8102952" id="8102952">«Яшил макон» умуммиллий лойиҳаси доирасида республикада яшил майдонларни кенгайтириш, мамлакатимизнинг ҳар бир ҳудудида ботаника ва дендрология боғларини ташкил қилиш ҳамда мавжуд яшил боғларни самарали бошқариш тизимини жорий этиш орқали уларни сақлаш, зараркунандаларга қарши курашиш тизимини яратиш ҳамда маҳаллий иқлим шароитига мос кўчатларни илмий асосланган ҳолда етиштиришни ривожлантириш мақсадида қарор қиламан:</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8102953" id="8102953"><b>I. Мақсадлар</b></div></div><div class="ACT_TEXT"><div name="8102954" id="8102954">1. Қуйидагилар ушбу Фармоннинг асосий мақсадлари этиб белгилансин:</div></div><div class="ACT_TEXT"><div name="8102955" id="8102955">(а) 2028 йилга қадар Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида қўшимча равишда жами майдони 100 гектардан кам бўлмаган ботаника ва дендрология боғларини ташкил қилиш;</div></div><div class="ACT_TEXT"><div name="8102956" id="8102956">(б) халқаро стандартларга мувофиқ 2030-йилгача Ўзбекистонда умумий яшиллик даражасини 14,2 фоиздан 30 фоизгача ошириш, аҳоли жон бошига тўғри келадиган яшил ҳудуд майдонини 9-10 м<sup>2</sup>гача кенгайтириш;</div></div><div class="ACT_TEXT"><div name="8102957" id="8102957">(в) PM2.5 ва PM10 каби зарарли заррачаларнинг концентрациясини 20 — 25 фоизга камайтириш, иқлим шароити оғир ҳудудларда ҳаво ҳароратини ўртача 1,5 — 2°C гача пасайтириш имкониятини яратиш.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8102958" id="8102958"><b>II. Ботаника ва дендрология боғларини ташкил этиш ва уларни муҳофаза қилишга қаратилган амалий чора-тадбирлар</b></div></div><div class="ACT_TEXT"><div name="8102959" id="8102959">2. Қуйидагилар:</div></div><div class="ACT_TEXT"><div name="8102960" id="8102960">(а) Ўзбекистон Республикасининг 2025 йил 5 майдаги ЎРҚ-1061-сон <a href="https://lex.uz/ru/docs/7510549">Қонунига</a> асосан ботаника боғларига муҳофаза этиладиган табиий ҳудуд мақоми берилганлиги маълумот учун қабул қилинсин;</div></div><div class="ACT_TEXT"><div name="8102961" id="8102961">(б) Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида ботаника ва дендрология боғларини ташкил этиш учун ажратиладиган ер участкалари рўйхати <a href="https://lex.uz/ru/docs/8101199#8103042">1-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="8102962" id="8102962">(в) ботаника ва дендрология боғларини ташкил этишнинг асосий вазифалари <a href="https://lex.uz/ru/docs/8101199#8103048">2-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="8102963" id="8102963">3. Белгилансинки:</div></div><div class="ACT_TEXT"><div name="8102964" id="8102964">(а) дендрология боғлари мақомига кўра ботаника боғларига тенглаштирилади;</div></div><div class="ACT_TEXT"><div name="8102965" id="8102965">(б) ботаника ва дендрология боғларини ташкил этиш мақсадида ажратиладиган ер майдонлари, истисно тариқасида, қишлоқ хўжалиги ишлаб чиқариши нобудгарчилиги ўрнини қоплаш бўйича компенсация тўловларидан озод қилинади.</div></div><div class="ACT_TEXT"><div name="8102966" id="8102966">4. Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари Қишлоқ хўжалиги вазирлиги, Экология ва иқлим ўзгариши миллий қўмитаси (кейинги ўринларда — Экология қўмитаси), Ветеринария ва чорвачиликни ривожлантириш қўмитаси ҳамда Кадастр агентлиги билан биргаликда икки ой муддатда ушбу Фармоннинг <a href="https://lex.uz/ru/docs/8101199#8103042">1-иловасига</a> мувофиқ ер участкалари:</div></div><div class="ACT_TEXT"><div name="8102967" id="8102967">(а) маҳаллий ҳокимликлар захирасига қайтарилишини;</div></div><div class="ACT_TEXT"><div name="8102968" id="8102968">(б) белгиланган тартибда Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университетига (Green University) доимий фойдаланиш ҳуқуқи билан ажратилишини таъминласин.</div></div><div class="ACT_TEXT"><div name="8102969" id="8102969">5. Экология қўмитаси манфаатдор вазирлик ва идоралар билан биргаликда:</div></div><div class="ACT_TEXT"><div name="8102970" id="8102970">(а) икки ой муддатда ботаника ва дендрология боғларини ташкил этиш концепцияларини ишлаб чиқиб, тасдиқласин;</div></div><div class="ACT_TEXT"><div name="8102971" id="8102971">(б) уч ой муддатда дендрология боғларига муҳофаза этиладиган табиий ҳудуд мақомини беришни назарда тутувчи қонун лойиҳасини ишлаб чиқсин.</div></div><div class="ACT_TEXT"><div name="8102972" id="8102972">6. Белгилансинки:</div></div><div class="ACT_TEXT"><div name="8102973" id="8102973">(а) ботаника ва дендрология боғлари Экология қўмитаси тасарруфида бўлади ҳамда умумдавлат аҳамиятига молик объект ҳисобланади;</div></div><div class="ACT_TEXT"><div name="8102974" id="8102974">(б) ботаника ва дендрология боғлари Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университети (Green University) ва «яшил» техникумларнинг тажриба, экспериментал ва ўқув-тажриба, илмий ҳамда ўқув мақсадлари учун фойдаланиладиган объектлари ҳисобланади;</div></div><div class="ACT_TEXT"><div name="8102975" id="8102975">(в) ботаника ва дендрология боғларининг ер участкаларини хусусийлаштириш ёки бегоналаштириш, иккиламчи ижарага бериш, уларнинг ҳудудларини қисқартириш қатъий тақиқланади;</div></div><div class="ACT_TEXT"><div name="8102976" id="8102976">(г) ботаника ва дендрология боғларини лойиҳалаш, ташкил этиш ва уларни эксплуатация қилиш жараёнларида халқаро экологик стандартлар, атроф-муҳитни муҳофаза қилиш бўйича умумэътироф этилган экологик меъёрлар ва миллий қонунчилик талабларига қатъий риоя қилиниши таъминланади.</div></div><div class="ACT_TEXT"><div name="8102977" id="8102977">7. Ботаника ва дендрология боғларини ташкил этиш билан боғлиқ харажатлар қуйидаги манбалар ҳисобидан амалга оширилади:</div></div><div class="ACT_TEXT"><div name="8102978" id="8102978">(а) Умуммиллий экологик муаммоларни бартараф этиш давлат мақсадли жамғармаси (кейинги ўринларда — Махсус жамғарма);</div></div><div class="ACT_TEXT"><div name="8102979" id="8102979">(б) «Яшил макон» умуммиллий лойиҳаси учун Давлат бюджетидан ажратиладиган маблағлар;</div></div><div class="ACT_TEXT"><div name="8102980" id="8102980">(в) халқаро ва хорижий ташкилотларнинг грант маблағлари, жисмоний ва юридик шахсларнинг ҳомийлик хайриялари ҳамда қонунчилик ҳужжатлари билан тақиқланмаган бошқа манбалар. Бунда ботаника ва дендрология боғларини барпо этиш учун халқаро консультантлар, олимлар, экспертлар ва мутахассисларни жалб этиш харажатлари ҳам инобатга олинади.</div></div><div class="ACT_TEXT"><div name="8102981" id="8102981">8. Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари манфаатдор вазирлик ва идоралар билан биргаликда ботаника ва дендрология боғлари майдонининг чегараларига қадар ташқи муҳандислик тармоқлари ва транспорт коммуникацияларини ташкил этиш, жумладан, электр энергияси, газ ва сув таъминоти, йўллар ва телекоммуникация тармоқлари бўйича ишларни тегишлилиги бўйича Қорақалпоғистон Республикаси республика бюджети, вилоятлар ва Тошкент шаҳар маҳаллий бюджетлари маблағлари ҳисобидан амалга оширсин.</div></div><div class="ACT_TEXT"><div name="8102982" id="8102982">9. Белгилансинки:</div></div><div class="ACT_TEXT"><div name="8102983" id="8102983">(а) ботаника ва дендрология боғларини ташкил этиш мақсадида лойиҳаларни амалга ошириш доирасида импорт қилинган товарлар, дарахт, бута кўчатлари ва уруғлари, махсус ва технологик асбоб-ускуналар, бутловчи қисмлар:</div></div><div class="ACT_TEXT"><div name="8102984" id="8102984">(i) мажбурий мувофиқликни баҳолаш тартиботларидан ўтишдан;</div></div><div class="ACT_TEXT"><div name="8102985" id="8102985">(ii) божхона божи тўловларидан (божхона расмийлаштируви учун йиғимлар бундан мустасно);</div></div><div class="ACT_TEXT"><div name="8102986" id="8102986">(б) ботаника ва дендрология боғлари ҳудудида илмий ташкилотларнинг илмий тажриба, экспериментал ишлар ва янги навларнинг селекцияси билан боғлиқ тадбирларни ўтказиш ҳамда бошқа илмий ва ўқув мақсадлари учун фойдаланиладиган экин ва дарахтзорлар эгаллаган ер участкалари ер солиғидан озод қилинади.</div></div><div class="ACT_TEXT"><div name="8102987" id="8102987">10. Шундай тартиб ўрнатилсинки, унга мувофиқ, эксперимент тариқасида:</div></div><div class="ACT_TEXT"><div name="8102988" id="8102988">(а) ботаника ва дендрология боғларини ташкил этишда жисмоний ва юридик шахсларга ушбу боғлардаги участкалар ва (ёки) улар ҳудудидаги ноёб дарахтларни ўз номига шартнома асосида бириктириб қўйишга (тамғалашга) рухсат этилади;</div></div><div class="ACT_TEXT"><div name="8102989" id="8102989">(б) ботаника ва дендрология боғлари спортчи, санъаткор, тадбиркор ва бошқа ташаббускорлар маблағлари ҳисобига ташкил этилганда боғнинг кираверишида уни ташкил этишда иштирок этган шахслар номлари битилган лавҳа ўрнатилади;</div></div><div class="ACT_TEXT"><div name="8102990" id="8102990">(в) ботаника ва дендрология боғларини ташкил этишда молиявий ва амалий ёрдам кўрсатган шахсларга меценат мақоми берилади;</div></div><div class="ACT_TEXT"><div name="8102991" id="8102991">(г) кўчатчилик хизматлари билан шуғулланувчиларга ботаника ва дендрология боғларининг ер участкаларини ноёб дарахт кўчатларини экиш ва парвариш қилиш учун белгиланган тартибда ижара ҳуқуқи асосида беришга рухсат этилади. Бунда ижарачилар ер участкаларидан фақат дарахтларни реклама ва экспозиция сифатида намойиш қилиш учун фойдаланиш ҳамда келгусида дарахтларни ботаника ва дендрология боғларига қолдириш мажбуриятини олади.</div></div><div class="ACT_TEXT"><div name="8102992" id="8102992">11. Белгилансинки, 2027 йил 1 январдан бошлаб ботаника ва дендрология боғларининг самарали фаолият кўрсатиши ва барқарор ривожланишини таъминлаш мақсадида республиканинг ҳар бир ҳудудидан мазкур боғларга «яшиллик элчиси» сифатида бириктирилади.</div></div><div class="ACT_TEXT"><div name="8102993" id="8102993">12. «Яшиллик элчилари»нинг асосий вазифалари <a href="https://lex.uz/ru/docs/8101199#8103060">3-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="8102994" id="8102994">13. Вазирлар Маҳкамаси (А.Ж. Раматов, Ж.А. Ходжаев) Экология қўмитаси билан биргаликда 2028 йилга 1 ноябрга қадар Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари фаолиятини мувофиқлаштирган ҳолда мазкур Фармоннинг <a href="https://lex.uz/ru/docs/8101199#8103042">1-иловасида</a> назарда тутилган ботаника ва дендрология боғларининг ер майдонларини камида 100 гектаргача етказиш чораларини кўрсин.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8102995" id="8102995"><b>III. Яшил боғларни барпо этиш, уларни сақлаш ва парвариш қилиш тизимини такомиллаштириш</b></div></div><div class="ACT_TEXT"><div name="8102996" id="8102996">14. Ўрмон ва яшил ҳудудларни кўпайтириш, чўлланишга қарши курашиш агентлиги (кейинги ўринларда — Ўрмон агентлиги) тизимидаги «Яшил ҳудуд» давлат унитар корхонаси Ўрмон агентлиги ҳузуридаги «Яшил боғларни бошқариш ўрмон илмий-тажриба маркази» давлат муассасасига (кейинги ўринларда — Марказ) айлантириш орқали қайта ташкил этилсин. Бунда:</div></div><div class="ACT_TEXT"><div name="8102997" id="8102997">(а) «Яшил ҳудуд» давлат унитар корхонасининг ҳудудлардаги ташкилотлари негизида Марказнинг Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида юридик шахс мақомига эга бўлган ҳудудий бошқармалари фаолияти йўлга қўйилади;</div></div><div class="ACT_TEXT"><div name="8102998" id="8102998">(б) Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари Марказнинг ҳудудий бошқармаларига келгусида яшил боғларни сақлаш ва парвариш қилиш ишлари давомида нобуд бўлган кўчатлар ўрнини қоплаш мақсадида ташкил қилинадиган кўчатхона учун қишлоқ хўжалигига мўлжалланган суғориладиган ерлардан 3 — 5 гектар ер майдонлари ажратади;</div></div><div class="ACT_TEXT"><div name="8102999" id="8102999">(в) Марказ «Яшил ҳудуд» давлат унитар корхонасининг ҳуқуқ ва мажбуриятлари бўйича вориси ҳисобланади.</div></div><div class="ACT_TEXT"><div name="8103000" id="8103000">15. «Яшил боғларни бошқариш ўрмон илмий-тажриба маркази» давлат муассасасининг асосий вазифалари ва функциялари ҳамда фаолиятининг устувор йўналишлари <a href="https://lex.uz/ru/docs/8101199#8103070">4-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="8103001" id="8103001">16. Давлат активларини бошқариш агентлиги Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари билан биргаликда икки ойда муддатда Марказ ва унинг ҳудудий бошқармаларини бўш турган биноларга жойлаштиришни таъминласин.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8103002" id="8103002"><b>IV. Дарахт ва буталарнинг касаллик ва зараркунандаларига қарши курашиш тизимини яратиш</b></div></div><div class="ACT_TEXT"><div name="8103003" id="8103003">17. Белгилансинки:</div></div><div class="ACT_TEXT"><div name="8103004" id="8103004">(а) Марказ таркибида алоҳида юридик шахс ташкил этмаган ҳолда ҳудудлардаги Дарахт касалликлари ва зараркунандаларига қарши курашиш хизмати ташкил этилади. Бунда давлат ўрмон хўжаликларидаги мавжуд биолабораториялар Марказ балансига беғараз ўтказилади;</div></div><div class="ACT_TEXT"><div name="8103005" id="8103005">(б) Марказ ва унинг ҳудудий бошқармаларида фаолият олиб бораётган ходимлар меҳнатига ҳақ тўлаш, бириктирилган боғларни самарали бошқариш, сақлаш ва ривожлантириш харажатлари 2026 йил учун тегишлилиги бўйича Қорақалпоғистон Республикаси республика бюджети, вилоятлар ва Тошкент шаҳар маҳаллий бюджетларидан ушбу мақсадларга ажратилган маблағлар, Махсус жамғармага ажратилган маблағлар ҳамда қонунчиликда тақиқланмаган бошқа манбалар ҳисобидан қопланади.</div></div><div class="ACT_TEXT"><div name="8103006" id="8103006">18. Экология қўмитаси уч ой муддатда:</div></div><div class="ACT_TEXT"><div name="8103007" id="8103007">(а) Иқтисодиёт ва молия вазирлиги билан биргаликда 2027 йилда Марказ фаолиятини молиялаштириш бўйича умумлаштирилган таклифни Ўзбекистон Республикаси Президенти Администрациясига киритсин;</div></div><div class="ACT_TEXT"><div name="8103008" id="8103008">(б) Марказ ва унинг ҳудудий бошқармаларининг моддий-техника базасини мустаҳкамлаш мақсадида Махсус жамғармадан харид қилинадиган махсус ва қишлоқ хўжалиги техникалари рўйхатини тасдиқласин.</div></div><div class="ACT_TEXT"><div name="8103009" id="8103009">19. Қуйидагилар Марказ тасарруфига ўтказилади:</div></div><div class="ACT_TEXT"><div name="8103010" id="8103010">(а) Ўзбекистон Республикаси Президентининг 2021 йил 30 декабрдаги ПФ-46-сон Фармони билан тасдиқланган 2022 — 2024 йилларда Қорақалпоғистон Республикаси ва вилоятларда яшил боғларни барпо этиш <a href="https://lex.uz/ru/docs/5801444#5805446">дастурига</a> асосан ташкил этилган яшил боғлар;</div></div><div class="ACT_TEXT"><div name="8103011" id="8103011">(б) «Очиқ бюджет» ахборот портали орқали жамоатчилик фикри асосида шаклланган «Менинг боғим» лойиҳаси доирасида 2024-2025 йилларда барпо этилган ва келгуси йилларда барпо этиладиган яшил боғ ва яшил жамоат парклари;</div></div><div class="ACT_TEXT"><div name="8103012" id="8103012">(в) Давлат бюджети ва унга тенглаштирилган манбалар ҳисобидан ташкил этилган ва маҳаллий ҳокимликларнинг захирадаги ер участкаларида жойлашган яшил боғлар.</div></div><div class="ACT_TEXT"><div name="8103013" id="8103013">20. Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари тегишли вазирлик ва идоралар билан биргаликда:</div></div><div class="ACT_TEXT"><div name="8103014" id="8103014">(а) бир ой муддатда Марказ тасарруфига ўтказилиши белгиланган мавжуд боғларни хатловдан ўтказиш, балансда сақловчи ва парвариш учун масъуллар иштирокида лойиҳа-смета ҳужжатларида белгиланган тадбирларнинг тўлиқ ҳажмда амалга оширилишини таъминлаган ҳолда топшириш-қабул қилиш далолатномаларига асосан Марказга топширилишини;</div></div><div class="ACT_TEXT"><div name="8103015" id="8103015">(б) икки ой муддатда топшириш-қабул қилиш далолатномаларига асосан ўтказилган боғларга тегишли ер участкалари жамоат эҳтиёжлари учун доимий фойдаланиш ҳуқуқи билан Марказга ажратилишини;</div></div><div class="ACT_TEXT"><div name="8103016" id="8103016">(в) 2026 йил 1 майдан бошлаб Экология қўмитасининг талабига асосан Марказга келгусида барпо этиладиган боғларни белгиланган тартибда топшириш ва уларга тегишли ер участкалари ажратиб борилишини таъминласин.</div></div><div class="ACT_TEXT"><div name="8103017" id="8103017">21. Белгилансинки, Марказ тасарруфидаги боғлар ва кўчатхоналар ташкил этиш учун бириктирилган ер участкалари дарахтзорлар сифатида солиқ солиш объекти ҳисобланмайди.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8103018" id="8103018">V. Яшил майдонларни кенгайтириш бўйича янги ташаббуслар</div></div><div class="ACT_TEXT"><div name="8103019" id="8103019">22. Ҳудудларда ботаника ва дендрология боғларини ташкил қилиш, яшиллик даражасини ошириш ҳамда мавжуд яшил боғларни асраб қолиш бўйича чора-тадбирлар режаси <a href="https://lex.uz/ru/docs/8101199#8103094">5-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="8103020" id="8103020">23. Транспорт вазирлиги Экология қўмитаси, вазирлик ва идоралар билан биргаликда уч ой муддатда қуйидагиларни назарда тутувчи «Яшил чипта» тизимини жорий қилсин:</div></div><div class="ACT_TEXT"><div name="8103021" id="8103021">(а) самолёт, поезд, метро ва такси йўналишларида маршрутнинг карбон изини (таъсирини) аниқлаш ва фойдаланувчиларга маршрутнинг табиатга таъсирини «яшил чипта» сотиб олиш орқали компенсация қилиш имконини бериш;</div></div><div class="ACT_TEXT"><div name="8103022" id="8103022">(б) ишлаб чиқариладиган, сақланадиган, ички ва ташқи бозорда реализация қилинадиган маҳсулотлар учун ишлаб чиқариш, сақлаш ва логистика жараёнларидаги карбон изини ҳисоблаб, харидорга маҳсулотнинг атроф-муҳитга таъсирини ихтиёрий равишда компенсация қилиш имкониятини яратиш;</div></div><div class="ACT_TEXT"><div name="8103023" id="8103023">(в) карбон изини (таъсирини) Экология қўмитаси томонидан тасдиқланган қўлланмага мувофиқ автоматик равишда аниқлаш;</div></div><div class="ACT_TEXT"><div name="8103024" id="8103024">(г) «яшил чипта» олиш орқали табиатга етказилган зарар компенсациясидан тушган маблағларни Махсус жамғармага ўтказиш ҳамда фақат дарахт кўчатларини экиш ва уларни парваришлаш тадбирларига йўналтириш.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8103025" id="8103025"><b>VI. Амалий ва молиявий чора-тадбирлар</b></div></div><div class="ACT_TEXT"><div name="8103026" id="8103026">24. Экология қўмитасига «Яшил макон» умуммиллий лойиҳасини амалга оширишда ўз ҳиссасини қўшаётган шахсларни қуйидагича рағбатлантириш ваколатлари берилсин:</div></div><div class="ACT_TEXT"><div name="8103027" id="8103027">(а) камида 100 та дарахт кўчатларини эккан шахсга ёки дарахт экиш учун «Яшил хайрия жамғармаси» платформасига камида 10 миллион сўм ҳадя қилган шахсга «Экофаол фуқаро» мақомини бериш;</div></div><div class="ACT_TEXT"><div name="8103028" id="8103028">(б) камида мингта дарахт кўчатлари экилишини ташкил қилган ёки «Яшил хайрия жамғармаси» платформасига камида 100 миллион сўм ҳадя қилган тадбиркорлик субъектларига «Экоҳамкор» мақомини бериш. Бунда тадбиркорлик субъектлари:</div></div><div class="ACT_TEXT"><div name="8103029" id="8103029">(i) уларга ушбу мақомдан ўз фаолиятини реклама қилишда фойдаланиш ҳуқуқи берилади;</div></div><div class="ACT_TEXT"><div name="8103030" id="8103030">(ii) Экология қўмитаси томонидан тасдиқланмаган тақдирда экофаолият ва экоакцияларни ташкил қилиш ҳолатларини реклама қилиш реклама қонунчилигини бузиш деб ҳисобланади ва қонунчиликда белгиланган жавобгарликка сабаб бўлади;</div></div><div class="ACT_TEXT"><div name="8103031" id="8103031">(в) эллик мингдан кам бўлмаган дарахт кўчатлари экилишини таъминлаган ёки «Яшил хайрия жамғармаси» платформасига камида 5 миллиард сўм ҳадя қилган шахсларга меценат мақомини бериш;</div></div><div class="ACT_TEXT"><div name="8103032" id="8103032">(г) Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида камида 5 та яшил боғ ва яшил жамоат паркини ўз ҳисобидан барпо қилган шахсларга «Келажак бунёдкори» давлат мукофотини бериш бўйича таклиф киритиш.</div></div><div class="ACT_TEXT"><div name="8103033" id="8103033">25. Экология қўмитаси икки ой муддатда ботаника ва дендрология боғлари ҳамда яшил боғлар барпо этилишига давлат-хусусий шериклик асосида тадбиркорларни жалб қилиш механизмлари бўйича таклиф киритсин.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8103034" id="8103034">VII. Фармон ижросини ташкил этиш, таъминлаш ва назорат</div></div><div class="ACT_TEXT"><div name="8103035" id="8103035">26. Экология қўмитаси манфаатдор вазирлик ва идоралар билан биргаликда икки ой муддатда қонунчилик ҳужжатларига ушбу Фармондан келиб чиқадиган ўзгартириш ва қўшимчалар тўғрисида Вазирлар Маҳкамасига таклифлар киритсин.</div></div><div class="ACT_TEXT"><div name="8103036" id="8103036">27. Мазкур Фармоннинг ижросини самарали ташкил қилишга масъул ва шахсан жавобгар этиб Бош вазир ўринбосарлари А.Ж. Раматов ва Ж.А. Ходжаев, Қорақалпоғистон Республикаси Вазирлар Кенгаши Раиси, вилоятлар ва Тошкент шаҳар ҳокимлари ҳамда Ўзбекистон Республикаси Президентининг экология масалалари бўйича маслаҳатчиси — Экология ва иқлим ўзгариши миллий қўмитаси раиси А.А. Абдухакимов белгилансин.</div></div><div class="ACT_TEXT"><div name="8103037" id="8103037">28. Фармон ижросини муҳокама қилиб бориш, ижро учун масъул ташкилотлар фаолиятини мувофиқлаштириш ва назорат қилиш Ўзбекистон Республикаси Бош вазири А.Н. Арипов зиммасига юклансин.</div></div><div class="SIGNATURE"><div name="8103038" id="8103038">Ўзбекистон Республикаси Президенти Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="8103039" id="8103039">Тошкент ш.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="8103040" id="8103040">2026 йил 25 март,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="8103041" id="8103041">ПФ-<span translate="no">47</span>-сон</div></div><div class="BY_DEFAULT"><div name="8103042" id="8103042"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="8103043" id="8103043">Ўзбекистон Республикаси Президентининг 2026 йил 25 мартдаги ПФ-47-сон <a href="https://lex.uz/ru/docs/8101199">Фармонига</a><br />1-ИЛОВА</div></div><div class="ACT_TITLE_APPL"><div name="8103044" id="8103044">Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида ботаника ва дендрология боғларини ташкил этиш учун ажратиладиган ер участкалари</div></div><div class="ACT_FORM"><div name="8103045" id="8103045">РЎЙХАТИ</div></div><div class="BY_DEFAULT"><div name="8325292" id="8325292"></div></div><div class="TABLE_STD2"><div name="8325293" id="8325293"><table class="Table" style="width: 100.0%;border-collapse: collapse;border: none" width="100%"><tbody><tr><td rowspan="2" style="width: 3%;padding: 0cm 4px 0cm 4px;border: 1px solid black"><p align="center" style="text-align: center"><span style="font-size: 12pt"><span style="font-family: 'Times New Roman',serif"><strong><span lang="UZ-CYR" style="color: black">Т/р</span></strong></span></span></p></td><td rowspan="2" style="border-bottom: 1px solid black;width: 12%;padding: 0cm 4px 0cm 4px;border-top: 1px solid black;border-right: 1px solid black;border-left: none"><p align="center" style="text-align: center"><span style="font-size: 12pt"><span style="font-family: 'Times New Roman',serif"><strong><span lang="UZ-CYR" style="color: black">Фо