<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="8104357" id="8104357">УКАЗ</div></div><div class="ACCEPTING_BODY"><div name="8104358" id="8104358">ПРЕЗИДЕНТА РЕСПУБЛИКИ УЗБЕКИСТАН</div></div><div class="ACT_TITLE"><div name="8104359" id="8104359">О мерах по дальнейшему повышению эффективности Общенационального проекта «Яшил макон»</div></div><div class="BY_DEFAULT"><div name="8104361" id="8104361"></div></div><div class="ACT_TEXT"><div name="8104362" id="8104362">В целях расширения зеленых площадей в республике, сооружения ботанических садов и дендрологических парков в каждом регионе страны, внедрения системы эффективного управления действующими зелеными садами и создания таким путем системы их содержания, борьбы с вредителями, развития выращивания саженцев, соответствующих местным природным условиям, на научно обоснованной основе в рамках Общенационального проекта «Яшил макон» постановляю:</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104363" id="8104363"><b>I. Цели</b></div></div><div class="ACT_TEXT"><div name="8104364" id="8104364">1. Определить основными целями настоящего Указа:</div></div><div class="ACT_TEXT"><div name="8104365" id="8104365">(а) сооружение дополнительно ботанических садов и дендрологических парков минимум на 100 гектарах общей площади в Республике Каракалпакстан, областях и городе Ташкенте в период до 2028 года;</div></div><div class="ACT_TEXT"><div name="8104366" id="8104366">(б) повышение общего уровня озеленения в Узбекистане с 14,2 процента до 30 процентов, расширение площади зеленых территорий в расчете на душу населения — до 9-10 м² в соответствии с международными стандартами в период до 2030 года;</div></div><div class="ACT_TEXT"><div name="8104367" id="8104367">(в) сокращение концентрации вредных частиц, таких как PM2.5 и PM10, на 20 — 25 процентов, а также создание возможности снижения температуры воздуха на территориях с тяжелыми климатическими условиями в среднем до 1,5 — 2°C.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104368" id="8104368"><b>II. Практические меры, направленные на сооружение и охрану ботанических садов и дендрологических парков</b></div></div><div class="ACT_TEXT"><div name="8104369" id="8104369">2. Нижеследующие:</div></div><div class="ACT_TEXT"><div name="8104370" id="8104370">(а) принять к сведению, что на основании <a href="https://lex.uz/ru/docs/7514615">Закона</a> Республики Узбекистан от 5 мая 2025 года № ЗРУ-1061 ботаническим садам присвоен статус охраняемой природной территории;</div></div><div class="ACT_TEXT"><div name="8104371" id="8104371">(б) утвердить Перечень земельных участков, выделяемых для сооружения ботанических садов и дендрологических парков в Республике Каракалпакстан, областях и городе Ташкенте, согласно приложению № 1<a href="https://lex.uz/ru/docs/8101214#8104452">*</a>;</div></div><div class="ACT_TEXT"><div name="8104372" id="8104372">(в) утвердить Основные задачи сооружения ботанических садов и дендрологических парков согласно приложению № 2<a href="https://lex.uz/ru/docs/8101214#8104452">*</a>.</div></div><div class="ACT_TEXT"><div name="8104373" id="8104373">3. Определить, что:</div></div><div class="ACT_TEXT"><div name="8104374" id="8104374">(а) по статусу дендрологические парки приравниваются к ботаническим садам;</div></div><div class="ACT_TEXT"><div name="8104375" id="8104375">(б) земельные площади, выделяемые для сооружения ботанических садов и дендрологических парков, освобождаются в порядке исключения от компенсационных выплат по возмещению потерь сельскохозяйственного производства.</div></div><div class="ACT_TEXT"><div name="8104376" id="8104376">4. Совету Министров Республики Каракалпакстан, хокимиятам областей и города Ташкента совместно с Министерством сельского хозяйства, Национальным комитетом по экологии и изменению климата (далее — Комитет по экологии), Комитетом ветеринарии и развития животноводства, а также Агентством по кадастру в двухмесячный срок обеспечить:</div></div><div class="ACT_TEXT"><div name="8104377" id="8104377">(а) возврат в состав земель запаса местных хокимиятов земельных участков, указанных в приложении № 1<a href="https://lex.uz/ru/docs/8101214#8104452">*</a>;</div></div><div class="ACT_TEXT"><div name="8104378" id="8104378">(б) выделение в установленном порядке земельных участков, указанных в приложении № 1<a href="https://lex.uz/ru/docs/8101214#8104452">*</a>, Центрально-Азиатскому университету изучения окружающей среды и изменения климата (Green University) с правом постоянного пользования.</div></div><div class="ACT_TEXT"><div name="8104379" id="8104379">5. Комитету по экологии совместно с заинтересованными министерствами и ведомствами:</div></div><div class="ACT_TEXT"><div name="8104380" id="8104380">(а) в двухмесячный срок разработать и утвердить концепции сооружения ботанических садов и дендрологических парков;</div></div><div class="ACT_TEXT"><div name="8104381" id="8104381">(б) в трехмесячный срок разработать проект закона, предусматривающий присвоение дендрологическим паркам статуса охраняемой природной территории.</div></div><div class="ACT_TEXT"><div name="8104382" id="8104382">6. Установить, что:</div></div><div class="ACT_TEXT"><div name="8104383" id="8104383">(а) ботанические сады и дендрологические парки подведомственны Комитету по экологии и являются объектами общегосударственного значения;</div></div><div class="ACT_TEXT"><div name="8104384" id="8104384">(б) ботанические сады и дендрологические парки являются объектами, используемыми Центрально-Азиатским университетом изучения окружающей среды и изменения климата (Green University) и «зелеными» техникумами в опытных, экспериментальных, учебно-опытных, научных и учебных целях;</div></div><div class="ACT_TEXT"><div name="8104385" id="8104385">(в) приватизация либо отчуждение, передача в субаренду земельных участков, занятых ботаническими садами и дендрологическими парками, сокращение их территории категорически запрещаются;</div></div><div class="ACT_TEXT"><div name="8104386" id="8104386">(г) в процессах проектирования, сооружения и эксплуатации ботанических садов и дендрологических парков обеспечивается строгое соблюдение международных экологических стандартов, общепризнанных экологических норм и требований национального законодательства по охране окружающей среды.</div></div><div class="ACT_TEXT"><div name="8104387" id="8104387">7. Расходы, связанные с сооружением ботанических садов и дендрологических парков, производятся за счет следующих источников:</div></div><div class="ACT_TEXT"><div name="8104388" id="8104388">(а) Государственного целевого фонда по устранению общенациональных экологических проблем (далее — Специальный фонд);</div></div><div class="ACT_TEXT"><div name="8104389" id="8104389">(б) средств Государственного бюджета, выделяемых для Общенационального проекта «Яшил макон»;</div></div><div class="ACT_TEXT"><div name="8104390" id="8104390">(в) грантовых средств международных и зарубежных организаций, благотворительных пожертвований физических и юридических лиц, а также иных источников, не запрещенных актами законодательства. При этом учитываются также расходы по привлечению международных консультантов, ученых, экспертов и специалистов к сооружению ботанических садов и дендрологических парков.</div></div><div class="ACT_TEXT"><div name="8104391" id="8104391">8. Совету Министров Республики Каракалпакстан, хокимиятам областей и города Ташкента совместно с заинтересованными министерствами и ведомствами работы по подведению внешних инженерных сетей и транспортных коммуникаций, в частности сетей электроэнергии, газо- и водоснабжения, сетей дорог и телекоммуникаций до границ территории ботанических садов и дендрологических парков проводить за счет средств соответственно республиканского бюджета Республики Каракалпакстан, местных бюджетов областей и города Ташкента.</div></div><div class="ACT_TEXT"><div name="8104392" id="8104392">9. Определить, что:</div></div><div class="ACT_TEXT"><div name="8104393" id="8104393">(а) товары, саженцы и семена деревьев и кустарников, специальное и технологическое оборудование, комплектующие части, импортируемые в рамках реализации проектов в целях сооружения ботанических садов и дендрологических парков, освобождаются:</div></div><div class="ACT_TEXT"><div name="8104394" id="8104394">(i) от прохождения обязательных процедур оценки соответствия;</div></div><div class="ACT_TEXT"><div name="8104395" id="8104395">(ii) от оплаты таможенной пошлины (за исключением сборов за таможенное оформление);</div></div><div class="ACT_TEXT"><div name="8104396" id="8104396">(б) от уплаты земельного налога — по земельным участкам на территории ботанических садов и дендрологических парков, занятым культурами и древесными насаждениями, используемым научными организациями для проведения научно-опытных, экспериментальных работ и мероприятий, связанных с селекцией новых сортов, а также в иных научных и учебных целях.</div></div><div class="ACT_TEXT"><div name="8104397" id="8104397">10. Установить порядок, в соответствии с которым в порядке эксперимента:</div></div><div class="ACT_TEXT"><div name="8104398" id="8104398">(а) при сооружении ботанических садов и дендрологических парков физическим и юридическим лицам разрешается персонально привязывать (маркировать) на свое имя участки и (или) редкие виды деревьев, произрастающие на их территории, на договорной основе;</div></div><div class="ACT_TEXT"><div name="8104399" id="8104399">(б) у входа в ботанические сады и дендрологические парки, сооруженные за счет собственных средств спортсменов, деятелей искусства, предпринимателей и других инициаторов, устанавливается табличка с вписанными именами лиц, принявших участие в их сооружении;</div></div><div class="ACT_TEXT"><div name="8104400" id="8104400">(в) лицам, оказавшим финансовую и практическую помощь в сооружении ботанических садов и дендрологических парков, присваивается статус «меценат»;</div></div><div class="ACT_TEXT"><div name="8104401" id="8104401">(г) земельные участки на территории ботанических садов и дендрологических парков разрешается передавать в аренду в установленном порядке лицам, занимающимся услугами по питомничеству, для посадки и ухода за саженцами редких видов деревьев. При этом арендаторы принимают обязательство использования земельных участков только для рекламы и демонстрации в качестве экспозиции деревьев, в последующем — оставления деревьев в ботанических садах и дендрологических парках.</div></div><div class="ACT_TEXT"><div name="8104402" id="8104402">11. Определить, что начиная с 1 января 2027 года в целях обеспечения осуществления эффективной деятельности и устойчивого развития ботанических садов и дендрологических парков из каждого региона республики закрепляются за данными садами в качестве «посла озеленения» («яшиллик элчиси»).</div></div><div class="ACT_TEXT"><div name="8104403" id="8104403">12. Утвердить Основные задачи «послов озеленения» согласно приложению № 3<a href="https://lex.uz/ru/docs/8101214#8104452">*</a>.</div></div><div class="ACT_TEXT"><div name="8104404" id="8104404">13. Кабинету Министров (А.Ж. Раматов, Ж.А. Ходжаев) совместно с Комитетом по экологии в срок до 1 ноября 2028 года принять меры по доведению земельной площади ботанических садов и дендрологических парков, предусмотренных приложением № 1<a href="https://lex.uz/ru/docs/8101214#8104452">*</a> к настоящему Указу, минимум до 100 гектаров с осуществлением координации деятельности Совета Министров Республики Каракалпакстан, хокимиятов областей и города Ташкента.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104405" id="8104405"><b>III. Совершенствование системы сооружения и содержания зеленых садов, ухода за ними</b></div></div><div class="ACT_TEXT"><div name="8104406" id="8104406">14. Реорганизовать Государственное унитарное предприятие «Яшил худуд» в системе Агентства по лесоразведению и увеличению зеленых зон, борьбе с опустыниванием (далее — Агентство по лесу) путем преобразования в Государственное учреждение «Лесной научно-опытный центр по управлению зелеными садами при Агентстве по лесу (далее — Центр). При этом:</div></div><div class="ACT_TEXT"><div name="8104407" id="8104407">(а) на базе организаций Государственного унитарного предприятия «Яшил худуд» в регионах налаживается деятельность территориальных управлений Центра в Республике Каракалпакстан, областях и городе Ташкенте со статусом юридического лица;</div></div><div class="ACT_TEXT"><div name="8104408" id="8104408">(б) Совет Министров Республики Каракалпакстан, хокимияты областей и города Ташкента выделяют в последующем территориальным управлениям Центра по 3 — 5 гектаров земельной площади на орошаемых землях сельскохозяйственного назначения под питомники, сооружаемые в целях возмещения потерь за саженцы, погибшие при выполнении работ по сохранению зеленых садов и уходу за ними;</div></div><div class="ACT_TEXT"><div name="8104409" id="8104409">(в) Центр является правопреемником по правам и обязательствам Государственного унитарного предприятия «Яшил худуд».</div></div><div class="ACT_TEXT"><div name="8104410" id="8104410">15. Утвердить Основные задачи и функции, а также приоритетные направления деятельности Государственного учреждения «Лесной научно-опытный центр по управлению зелеными садами» согласно приложению № 4<a href="https://lex.uz/ru/docs/8101214#8104452">*</a>.</div></div><div class="ACT_TEXT"><div name="8104411" id="8104411">16. Агентству по управлению государственными активами совместно с Советом Министров Республики Каракалпакстан, хокимиятами областей и города Ташкента в двухмесячный срок обеспечить размещение Центра и его территориальных управлений в пустующих зданиях.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104412" id="8104412"><b>IV. Создание системы борьбы с болезнями и вредителями деревьев и кустарников</b></div></div><div class="ACT_TEXT"><div name="8104413" id="8104413">17. Установить, что:</div></div><div class="ACT_TEXT"><div name="8104414" id="8104414">(а) в регионах создается Служба по борьбе с болезнями и вредителями деревьев в составе Центра без образования отдельного юридического лица. При этом биолаборатории, действующие в государственных лесных хозяйствах, передаются на баланс Центра на безвозмездной основе;</div></div><div class="ACT_TEXT"><div name="8104415" id="8104415">(б) расходы на оплату труда работников, осуществляющих деятельность в Центре и его территориальных управлениях, эффективное управление, содержание и развитие прикрепленных садов покрываются соответственно за счет средств республиканского бюджета Республики Каракалпакстан, местных бюджетов областей и города Ташкента на 2026 год, выделенных на данные цели, средств, выделенных Специальному фонду, а также иных источников, не запрещенных законодательством.</div></div><div class="ACT_TEXT"><div name="8104416" id="8104416">18. Комитету по экологии в трехмесячный срок:</div></div><div class="ACT_TEXT"><div name="8104417" id="8104417">(а) совместно с Министерством экономики и финансов внести в Администрацию Президента Республики Узбекистан обобщенное предложение по финансированию деятельности Центра в 2027 году;</div></div><div class="ACT_TEXT"><div name="8104418" id="8104418">(б) утвердить Перечень специальной и сельскохозяйственной техники, приобретаемой в целях укрепления материально-технической базы Центра и его территориальных управлений за счет Специального фонда.</div></div><div class="ACT_TEXT"><div name="8104419" id="8104419">19. Передать в распоряжение Центра:</div></div><div class="ACT_TEXT"><div name="8104420" id="8104420">(а) зеленые сады, сооруженные на основании Программы создания в 2022 — 2024 годах «зеленых парков» в Республике Каракалпакстан и областях, утвержденной <a href="https://lex.uz/ru/docs/5801449">Указом</a> Президента Республики Узбекистан от 30 декабря 2021 года № УП-46;</div></div><div class="ACT_TEXT"><div name="8104421" id="8104421">(б) зеленые сады и зеленые общественные парки, сооруженные в 2024-2025 годах и создаваемые в последующие годы в рамках проекта «Мой сад», сформированного на основе общественного мнения посредством информационного портала «Открытый бюджет»;</div></div><div class="ACT_TEXT"><div name="8104422" id="8104422">(в) зеленые сады, сооруженные за счет Государственного бюджета и приравненных к нему источников, и расположенные на земельных участках, включенных в состав земель запаса местных хокимиятов.</div></div><div class="ACT_TEXT"><div name="8104423" id="8104423">20. Совету Министров Республики Каракалпакстан, хокимиятам областей и города Ташкента совместно с причастными министерствами и ведомствами обеспечить:</div></div><div class="ACT_TEXT"><div name="8104424" id="8104424">(а) в месячный срок — проведение инвентаризации действующих садов, определенных к передаче в распоряжение Центра, их передачу Центру на основании актов приема-передачи с участием ответственных лиц балансодержателя и ответственных за уход с обеспечением выполнения в полном объеме мероприятий, определенных проектно-сметной документацией;</div></div><div class="ACT_TEXT"><div name="8104425" id="8104425">(б) в двухмесячный срок — выделение Центру земельных участков, принадлежащих садам, переданным на основании актов приема-передачи, для общественных нужд с правом постоянного пользования;</div></div><div class="ACT_TEXT"><div name="8104426" id="8104426">(в) в срок до 1 мая 2026 года — передачу Центру в установленном порядке садов, подлежащих сооружению в последующий период, а также выделение принадлежащих им земельных участков на основании заявок Комитета по экологии.</div></div><div class="ACT_TEXT"><div name="8104427" id="8104427">21. Определить, что земельные участки, прикрепленные для сооружения садов и питомников, переданные в распоряжение Центра, в качестве древесных насаждений не являются объектом налогообложения.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104428" id="8104428"><b>V. Новые инициативы по расширению зеленых площадей</b></div></div><div class="ACT_TEXT"><div name="8104429" id="8104429">22. Утвердить План мер по сооружению ботанических садов и дендрологических парков, повышению уровня озеленения, а также сохранению действующих зеленых садов в регионах согласно приложению № 5<a href="https://lex.uz/ru/docs/8101214#8104452">*</a>.</div></div><div class="FOOTNOTE"><div name="8104452" id="8104452">* <a href="https://lex.uz/ru/docs/8101199#8103043">Приложения №№ 1 — 5</a> приводится на узбекском языке.</div></div><div class="ACT_TEXT"><div name="8104430" id="8104430">23. Министерству транспорта совместно с Комитетом по экологии, министерствами и ведомствами в трехмесячный срок внедрить систему «зеленый билет», предусматривающую:</div></div><div class="ACT_TEXT"><div name="8104431" id="8104431">(а) выявление карбонового следа (воздействия) маршрутов самолетов, поездов, метро и такси и предоставление их пользователям возможности компенсации воздействия маршрутов на природу путем приобретения «зеленого билета»;</div></div><div class="ACT_TEXT"><div name="8104432" id="8104432">(б) расчет карбонового следа (воздействия) для продукции, производимой, хранящейся и подлежащей реализации на внутреннем и внешнем рынках, в процессах ее производства, хранения и логистики, а также предоставление покупателям возможности компенсации воздействия продукции на окружающую среду в добровольном порядке;</div></div><div class="ACT_TEXT"><div name="8104433" id="8104433">(в) автоматическое выявление карбонового следа (воздействия) в соответствии с пособием, утвержденным Комитетом по экологии;</div></div><div class="ACT_TEXT"><div name="8104434" id="8104434">(г) перечисление средств, поступивших от компенсаций ущерба, причиненного природе, посредством «зеленого билета», в Специальный фонд и их направление исключительно на мероприятия по посадке саженцев деревьев и уходу за ними.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104435" id="8104435"><b>VI. Практические и финансовые меры</b></div></div><div class="ACT_TEXT"><div name="8104436" id="8104436">24. Предоставить Комитету по экологии следующие полномочия по стимулированию лиц, вносящих вклад в реализацию Общенационального проекта «Яшил макон», в частности по:</div></div><div class="ACT_TEXT"><div name="8104437" id="8104437">(а) присвоению статуса «Экоактивный гражданин» — лицам, посадившим не менее 100 саженцев деревьев либо пожертвовавшим минимум 10 миллионов сумов платформе «Яшил хайрия жамғармаси» для посадки деревьев;</div></div><div class="ACT_TEXT"><div name="8104438" id="8104438">(б) присвоению статуса «Экопартнер» — субъектам предпринимательства, организовавшим посадку не менее 1 000 саженцев деревьев или пожертвовавшим минимум 100 миллионов сумов платформе «Яшил хайрия жамғармаси». При этом:</div></div><div class="ACT_TEXT"><div name="8104439" id="8104439">(i) субъектам предпринимательства предоставляется право на использование данного статуса в рекламе своей деятельности;</div></div><div class="ACT_TEXT"><div name="8104440" id="8104440">(ii) реклама субъектами предпринимательства экологической деятельности и экологических акций без утверждения Комитетом по экологии рассматривается как нарушение законодательства о рекламе и является основанием для привлечения к ответственности, установленной законодательством;</div></div><div class="ACT_TEXT"><div name="8104441" id="8104441">(в) присвоению статуса «Меценат» — лицам, обеспечившим посадку не менее 50 тысяч саженцев деревьев либо пожертвовавшим минимум 5 миллиардов сумов платформе «Яшил хайрия жамғармаси»;</div></div><div class="ACT_TEXT"><div name="8104442" id="8104442">(г) присуждению Государственной премии «Келажак бунёдкори» — лицам, создавшим не менее 5 зеленых садов и зеленых общественных парков за счет собственных средств в Республике Каракалпакстан, областях и городе Ташкенте.</div></div><div class="ACT_TEXT"><div name="8104443" id="8104443">25. Комитету по экологии в двухмесячный срок внести предложение по механизмам привлечения предпринимателей к сооружению ботанических садов, дендрологических парков и зеленых садов на основе государственно-частного партнерства.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="8104444" id="8104444"><b>VII. Организация, обеспечение и контроль исполнения Указа</b></div></div><div class="ACT_TEXT"><div name="8104445" id="8104445">26. Комитету по экологии совместно с заинтересованными министерствами и ведомствами в двухмесячный срок внести в Кабинет Министров предложения об изменениях и дополнениях в акты законодательства, вытекающих из настоящего Указа.</div></div><div class="ACT_TEXT"><div name="8104446" id="8104446">27. Возложить на заместителей Премьер-министра А.Ж. Раматова и Ж.А. Ходжаева, Председателя Совета Министров Республики Каракалпакстан, хокимов областей и города Ташкента, а также советника Президента Республики Узбекистан по вопросам экологии — председателя Национального комитета по экологии и изменению климата А.А. Абдухакимова персональную ответственность за эффективную организацию исполнения настоящего Указа.</div></div><div class="ACT_TEXT"><div name="8104447" id="8104447">28. Обсуждение хода исполнения настоящего Указа, осуществление координации и контроля за деятельностью организаций, ответственных за его исполнение, возложить на Премьер-министра Республики Узбекистан А.Н. Арипова.</div></div><div class="SIGNATURE"><div name="8104448" id="8104448"><b>Президент Республики Узбекистан Ш. МИРЗИЁЕВ</b></div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="8104449" id="8104449">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="8104450" id="8104450">25 марта 2026 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="8104451" id="8104451">№ УП-<span translate="no">47</span></div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="8104360" id="8104360">(Национальная база данных законодательства, 30.03.2026 г., № 06/26/47/0291; 06.07.2026 г., № 06/26/123/0692)</div></div></div>
</div></body></html>