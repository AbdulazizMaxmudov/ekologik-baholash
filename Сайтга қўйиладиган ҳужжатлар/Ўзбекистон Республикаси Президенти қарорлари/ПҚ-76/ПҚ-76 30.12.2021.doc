<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Cyrl-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="5806572" id="5806572">Ўзбекистон Республикаси Президентининг</div></div><div class="ACT_FORM"><div name="5806574" id="5806574">Қарори</div></div><div class="ACT_TITLE"><div name="5806576" id="5806576">Атроф-муҳитни муҳофаза қилиш ҳамда экологик назорат соҳасидаги давлат органлари фаолиятини ташкил этиш чора-тадбирлари тўғрисида</div></div><div class="BY_DEFAULT"><div name="5806578" id="5806578"></div></div><div class="ACT_TEXT"><div name="5806580" id="5806580">Мамлакатда экологик хавфсизликни таъминлаш, экологик вазиятни яхшилаш, қулай экологик ҳолатни барқарор сақлаш, экология ва атроф-муҳитни муҳофаза қилиш соҳасида давлат бошқаруви самарадорлигини таъминлаш ҳамда соҳада содир этилаётган ҳуқуқбузарликларнинг олдини олиш бўйича амалга оширилаётган чора-тадбирларни янада жадаллаштириш мақсадида:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486721" id="6486721">(1 ва 2-бандлар Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481584">Фармонига </a>асосан ўз кучини йўқотган — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="BY_DEFAULT"><div name="6486726" id="6486726"></div></div><div class="ACT_TEXT"><div name="6486728" id="6486728">3. Белгилаб қўйилсинки: </div></div><div class="ACT_TEXT"><div name="6486729" id="6486729">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазири Ўзбекистон Республикаси Президенти ҳузуридаги Хавфсизлик кенгаши аъзоси ҳисобланади; </div></div><div class="ACT_TEXT"><div name="6486730" id="6486730">Қорақалпоғистон Республикаси Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазири Ўзбекистон Республикаси Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги билан келишилган ҳолда Қорақалпоғистон Республикаси Жўқорғи Кенгеси томонидан лавозимга тайинланади ва лавозимдан озод қилинади; </div></div><div class="ACT_TEXT"><div name="6486733" id="6486733">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги вилоятлар ва Тошкент шаҳар бошқармаларининг бошлиқлари Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазири томонидан бевосита лавозимга тайинланади ва лавозимдан озод қилинади; </div></div><div class="ACT_TEXT"><div name="6486734" id="6486734">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги Бирлашган Миллатлар Ташкилотининг Атроф-муҳит дастури, Халқаро табиатни муҳофаза қилиш иттифоқи ва Глобал экологик жамғармаси, Мослашиш жамғармаси ҳамда Яшил иқлим жамғармаси билан ўзаро ҳамкорлик қилиш ва мувофиқлаштириш бўйича ваколатли орган ҳисобланади; </div></div><div class="ACT_TEXT"><div name="6486736" id="6486736">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигининг ўз ваколатлари доирасида қабул қилган қарорлари, тақдимнома ҳамда кўрсатмалари давлат бошқаруви органлари, хўжалик бирлашмалари, маҳаллий ижро этувчи ҳокимият органлари, бошқа ташкилотлар ва уларнинг мансабдор шахслари, шунингдек юридик ва жисмоний шахслар томонидан бажарилиши мажбурийдир; </div></div><div class="ACT_TEXT"><div name="6486738" id="6486738">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги Экология ва атроф-муҳитни муҳофаза қилиш давлат қўмитасининг, Ўрмон хўжалиги агентлиги — Ўрмон хўжалиги давлат қўмитасининг, Гидрометеорология хизмати агентлиги — Гидрометеорология хизмати марказининг вазифа ва функцияларини бажаришга оид ҳуқуқлари, мажбуриятлари ва шартномалари бўйича ҳуқуқий вориси ҳисобланади; </div></div><div class="ACT_TEXT"><div name="6486739" id="6486739">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги томонидан қайта ташкил этилаётган, тугатилаётган, ўзгартирилаётган ва бошқа ташкилотлар тизимига ўтказилаётган ташкилотларга бириктирилган кўчмас мулк объектларига ва бошқа мол-мулкка бўлган ҳуқуқлар тегишли йиғимлар ва бошқа тўловлар ундирилмаган ҳолда қайта расмийлаштирилади. </div></div><div class="ACT_TEXT"><div name="6486740" id="6486740">4. Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирига: </div></div><div class="ACT_TEXT"><div name="6486743" id="6486743">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги таркибига кирувчи идоравий мансуб ташкилотларни (агентликлар бундан мустасно) ҳамда уларнинг таркибидаги ташкилотларни қайта ташкил этиш ва тугатиш; </div></div><div class="ACT_TEXT"><div name="6486744" id="6486744">муҳофаза этиладиган табиий ҳудудлар ва давлат ўрмон хўжаликлари тузилмаларини (намунавий тузилмаларини) тасдиқлаш; </div></div><div class="BY_DEFAULT"><div name="7304727" id="7304727"></div></div><div class="ACT_TEXT"><div name="7304728" id="7304728">Экология жамғармаси маблағлари ҳисобидан илмий ва таълим ташкилотлари, халқаро ташкилотлар, хорижий компанияларнинг юқори малакали мутахассислари ҳамда экспертларини маслаҳатчи сифатида жалб қилиш ҳуқуқи берилсин.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7304729" id="7304729">(4-банднинг тўртинчи хатбошиси Ўзбекистон Республикаси Президентининг 2024 йил 25 декабрдаги ПҚ-455-сонли <a href="https://lex.uz/uz/docs/7283107?ONDATE=01.01.2025 00#7290882">қарори </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 30.12.2024 й., 07/24/455/1092-сон. Кучга кириш санаси — 2025 йил 1 январь)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7304739" id="7304739">(Ўзбекистон Республикаси Президентининг 2024 йил 25 декабрдаги ПҚ-455-сонли <a href="https://lex.uz/uz/docs/7283107?ONDATE=01.01.2025 00#7290886">қарорига </a>асосан 4-банд бешинчи хатбошисининг чиқарилиш санаси 2025 йил 1 январь — Қонунчилик маълумотлари миллий базаси, 30.12.2024 й., 07/24/455/1092-сон)</div></div><div class="ACT_TEXT"><div name="5806615" id="5806615">5. Экология, атроф-муҳитни муҳофаза қилиш, табиий ресурслардан оқилона фойдаланиш ва уларни қайта тиклаш соҳасини ҳамда экологик назорат тизимини янада такомиллаштириш бўйича «йўл харитаси» <a href="https://lex.uz/uz/docs/5801426#5807046">6-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="5806619" id="5806619">6. Экология ва атроф-муҳитни муҳофаза қилиш соҳасидаги ҳуқуқбузарликлар профилактикаси ва уларга қарши курашиш тизимини янги даражага кўтариш мақсадида Ички ишлар вазирлиги, Миллий гвардия ва Давлат экология қўмитасининг қуйидагиларни назарда тутувчи «Экологик патруль» ишлаш тизимини жорий этиш тўғрисидаги таклифи қўллаб-қувватлансин:</div></div><div class="ACT_TEXT"><div name="5806620" id="5806620">ички ишлар органлари жамоат хавфсизлиги хизмати ва Миллий гвардиянинг патрулликка жалб этилган бўлинмаларининг экология, атроф-муҳитни муҳофаза қилиш ва табиатдан фойдаланиш соҳасидаги ҳуқуқбузарликларга қарши курашиш бўйича ваколатларини кенгайтириш;</div></div><div class="ACT_TEXT"><div name="5806621" id="5806621">экология, атроф-муҳитни муҳофаза қилиш ва табиатдан фойдаланиш соҳасидаги қонунчилик талаблари ижроси сўзсиз таъминланишини назорат қилишда экология ва атроф-муҳитни муҳофаза қилиш органларининг ички ишлар органлари ва Миллий гвардия бўлинмалари билан яқиндан ҳамкорлигини ўрнатиш ҳамда қўшма профилактик тадбирларни ўтказиш амалиётини йўлга қўйиш.</div></div><div class="ACT_TEXT"><div name="5806623" id="5806623">7.<strong> </strong>Ички ишлар вазирлиги Миллий гвардия ва Давлат экология қўмитаси билан биргаликда:</div></div><div class="ACT_TEXT"><div name="5806624" id="5806624">уч ой муддатда ички ишлар органлари ва Миллий гвардия бўлинмаларининг экология, атроф-муҳитни муҳофаза қилиш ва табиатдан фойдаланиш соҳасидаги ҳуқуқбузарликларга қарши курашиш бўйича ваколатларини кенгайтириш юзасидан тегишли қонун лойиҳасини ишлаб чиқсин ва белгиланган тартибда Вазирлар Маҳкамасига киритсин;</div></div><div class="ACT_TEXT"><div name="5806626" id="5806626">доимий равишда экология, атроф-муҳитни муҳофаза қилиш ва табиатдан фойдаланиш соҳасидаги қонунчилик талаблари ижроси сўзсиз таъминланишини назорат қилишда ўзаро яқиндан ҳамкорликни ўрнатсин ҳамда қўшма профилактик тадбирларни ўтказиш амалиётини йўлга қўйсин.</div></div><div class="BY_DEFAULT"><div name="6486752" id="6486752"></div></div><div class="ACT_TEXT"><div name="6486754" id="6486754">8.<strong> </strong>Маълумот учун қабул қилинсинки, Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигининг маъмурий ҳуқуқбузарликлар тўғрисидаги ишларни кўриб чиқиш ва жарима солиш ҳуқуқига эга ходимлари Маъмурий жавобгарлик тўғрисидаги кодекснинг <a href="https://lex.uz/uz/docs/97664#201296">285-моддасига </a>асосан ҳуқуқбузарни маъмурий йўл билан ушлаб туриш, шахсан кўрикдан ўтказиш, унинг ашёлари ва транспорт воситаларини кўздан кечириш ҳамда ашёлар ва ҳужжатларни олиб қўйиш ваколатларига эга.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486756" id="6486756">(8-банд Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481639">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="ACT_TEXT"><div name="5806659" id="5806659">9.<strong> </strong>2022 йил 1 мартдан бошлаб шундай тартиб ўрнатилсинки, унга мувофиқ:</div></div><div class="ACT_TEXT"><div name="5806662" id="5806662">а) давлат органлари, муассасалари ва корхоналари, фуқароларнинг ўзини ўзи бошқариш органлари ва кўп квартирали уй-жойлар мулкдорларига улар эгалигидаги бино ва иншоотларга туташ (чегарадош) бўлган ер участкалари қуйидаги шарт ва мажбуриятлар билан уларга доимий фойдаланиш ҳуқуқи билан ажратиб берилади:</div></div><div class="ACT_TEXT"><div name="5806666" id="5806666">ер участкаларини обод ҳолда сақлаш;</div></div><div class="ACT_TEXT"><div name="5806669" id="5806669">дарахтлар, буталар, бошқа ўсимликлар ва ниҳолларни парвариш қилиш ва суғориш;</div></div><div class="ACT_TEXT"><div name="5806672" id="5806672">йиғиштириш-тозалаш ишларини амалга ошириш ва чиқинди қутиларини ўрнатиш;</div></div><div class="ACT_TEXT"><div name="5806674" id="5806674">болалар майдончалари, ўтириш жойлари (скамейкалар), тунги ёритиш тизимини ўрнатиш, таъмирлаш ва сақлаш;</div></div><div class="ACT_TEXT"><div name="5806677" id="5806677">аҳоли учун пиёда йўлакларини барпо этиш, таъмирлаш ва лозим даражада сақлаш;</div></div><div class="ACT_TEXT"><div name="5806682" id="5806682">б) мазкур бандга асосан доимий фойдаланиш ҳуқуқи билан ажратиб бериладиган ер участкаларида бино, иншоот, ишлаб чиқариш ва ноишлаб чиқариш ҳамда енгил конструкцияли объектларни ўрнатиш ва қуриш тақиқланади;</div></div><div class="ACT_TEXT"><div name="5806685" id="5806685">в) давлат органлари, муассасалари ва корхоналари, фуқароларнинг ўзини ўзи бошқариш органлари ҳамда кўп квартирали уй-жойлар мулкдорларига тегишли ер участкаларини доимий фойдаланиш ҳуқуқи билан ажратиб бериш ушбу банднинг<a href="https://lex.uz/uz/docs/5801426#5806662"> «а»</a> ва <a href="https://lex.uz/uz/docs/5801426#5806682">«б» кичик бандларида</a> назарда тутилган талаблар асосида Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари томонидан белгиланган тартибда амалга оширилади;</div></div><div class="BY_DEFAULT"><div name="6486757" id="6486757"></div></div><div class="ACT_TEXT"><div name="6486760" id="6486760">г) мазкур бандга асосан доимий фойдаланиш ҳуқуқи билан ажратиб бериладиган ер участкаларида давлат органлари, муассасалари ва корхоналари, фуқароларнинг ўзини ўзи бошқариш органлари ва кўп квартирали уй-жойлар мулкдорлари томонидан белгиланган шарт ва мажбуриятлар бажарилиши устидан назорат ички ишлар органлари жамоат хавфсизлиги хизмати, Миллий гвардиянинг патрулликка жалб этилган бўлинмалари ҳамда экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши органлари томонидан амалга оширилади.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486762" id="6486762">(9-банднинг «г» кичик банди Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481640">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="ACT_TEXT"><div name="5806696" id="5806696">10. Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари:</div></div><div class="ACT_TEXT"><div name="5806700" id="5806700">2023 йил 1 январга қадар шаҳарлар ва бошқа аҳоли пунктларида жойлашган ҳамда бўш турган ободонлаштириш ва кўкаламзорлаштиришга мўлжалланган ер участкалари тегишли давлат органлари, муассасалари ва корхоналари, фуқароларнинг ўзини ўзи бошқариш органлари ва кўп квартирали уй-жойлар мулкдорларига ажратилишини;</div></div><div class="ACT_TEXT"><div name="5806703" id="5806703">доимий равишда шаҳарсозлик фаолияти натижасида шаклланган янги ободонлаштириш ва кўкаламзорлаштиришга мўлжалланган ер участкалари белгиланган тартибда тегишли давлат органлари, муассасалари ва корхоналари, фуқароларнинг ўзини ўзи бошқариш органлари ва кўп квартирали уй-жойлар мулкдорларига ажратилиб борилишини таъминласин.</div></div><div class="BY_DEFAULT"><div name="7141605" id="7141605"></div></div><div class="ACT_TEXT"><div name="7141608" id="7141608">11. Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши органларига қуйидаги бажарилиши мажбурий бўлган кўрсатмаларни киритиш ҳуқуқи берилсин:</div></div><div class="ACT_TEXT"><div name="7141612" id="7141612">давлат органлари, муассасалари ва корхоналари, фуқароларнинг ўзини ўзи бошқариш органлари ва кўп квартирали уй-жойлар мулкдорлари томонидан мазкур қарорнинг 9-10-бандларига асосан уларга доимий фойдаланиш ҳуқуқи билан ажратиб берилган ер участкаларида тегишли шарт ва мажбуриятлар бажарилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="7141614" id="7141614">2023 йил 1 январдан бошлаб Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимлари томонидан шаҳарлар ва бошқа аҳоли пунктларида жойлашган ҳамда бўш турган ер участкалари тегишли давлат органлари, муассасалари ва корхоналари, фуқароларнинг ўзини ўзи бошқариш органлари ва кўп квартирали уй-жойлар мулкдорларига ажратилиб борилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="7141617" id="7141617">янги қуриладиган, баландлиги ер юзасидан 12 метрдан баланд ва (ёки) умумий майдони 500 квадрат метрдан ортиқ бўлган бино ва иншоотларга туташ ҳудудлардаги ерларнинг камида 25 фоизи кўкаламзорлаштириш майдонларига ажратилишини ва уларда кўкаламзорлаштириш тадбирлари амалга оширилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="7141619" id="7141619">атроф-муҳитга таъсир кўрсатишнинг I ва II тоифаларига мансуб саноат корхоналари лойиҳа ҳужжатлари бўйича бериладиган давлат экологик экспертизаси хулосаларида ўз ҳудуди ва туташ ҳудудларда «яшил белбоғ»лар барпо этиш ва кўкаламзорлаштириш тадбирлари амалга оширилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="7141622" id="7141622">кўчатлар экиш ва уларни парваришлаш ҳамда суғориш тадбирларини молиялаштириш масалалари вазирлик, идора ва хўжалик бирлашмаларининг йиллик харажатлар сметасида ҳамда атроф-муҳитга таъсир кўрсатишнинг I ва II тоифаларига мансуб саноат корхоналари, махсус иқтисодий зоналар ҳудудларида жойлашган саноат корхоналарининг йиллик бизнес режаларида кўзда тутилишини таъминлаш.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7141628" id="7141628">(11-банд Ўзбекистон Республикаси Президентининг 2024 йил 26 сентябрдаги ПФ-149-сонли <a href="https://lex.uz/uz/docs/7128153?ONDATE=04.10.2024 00#7128778">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 04.10.2024 й., 06/24/149/0772-сон)</div></div><div class="ACT_TEXT"><div name="5806716" id="5806716">12.<strong> </strong>2022 йил 1 февралдан бошлаб:</div></div><div class="ACT_TEXT"><div name="5806718" id="5806718">вилоятлар ва туманлар (шаҳарлар) ҳокимларининг капитал қурилиш, коммуникациялар ва коммунал хўжалик масалалари бўйича ўринбосари лавозими тугатилиб, қурилиш, коммуникациялар, коммунал хўжалик, экология ва кўкаламзорлаштириш масалалари бўйича ўринбосари лавозими киритилсин;</div></div><div class="ACT_TEXT"><div name="5806720" id="5806720">Тошкент шаҳри ва унинг туманлари ҳокимларининг архитектура, капитал қурилиш, коммуникацияларни ривожлантириш масалалари бўйича биринчи ўринбосари лавозими тугатилиб, қурилиш, коммуникацияларни ривожлантириш, экология ва кўкаламзорлаштириш масалалари бўйича биринчи ўринбосари лавозими киритилсин.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6661186" id="6661186">(13-банд Ўзбекистон Республикаси Президентининг 2023 йил 31 октябрдаги ПФ-186-сонли Фармонига асосан ўз кучини йўқотган)</div></div><div class="ACT_TEXT"><div name="5806769" id="5806769">14. Давлат экология қўмитаси кенг жамоатчилик, илмий тадқиқот институтлари, фуқаролик жамияти институтлари ва оммавий ахборот воситалари вакилларини жалб этган ҳолда 2022 йил 1 декабрга қадар қуйидагиларни назарда тутувчи Экологик кодекс лойиҳасини ишлаб чиқсин ва белгиланган тартибда Вазирлар Маҳкамасига киритсин:</div></div><div class="ACT_TEXT"><div name="5806770" id="5806770">экологияга оид қонунчилик ҳужжатларини тизимлаштириш ва ихчамлаштириш;</div></div><div class="ACT_TEXT"><div name="5806771" id="5806771">атроф-муҳитни муҳофаза қилиш соҳасида жамоатчилик назоратининг роли ва таъсирини ошириш;</div></div><div class="ACT_TEXT"><div name="5806772" id="5806772">биохилмахилликни асраш, тиклаш ва кўпайтиришнинг аниқ механизмлари ва рағбатлантириш тизимини жорий этиш;</div></div><div class="ACT_TEXT"><div name="5806773" id="5806773">атроф-муҳитни муҳофаза қилишда давлат ташкилотлари ва фуқароларнинг ҳуқуқ ва мажбуриятлари;</div></div><div class="ACT_TEXT"><div name="5806775" id="5806775">экологик назорат ва мониторинг турларини амалга ошириш тартиби, шу жумладан «яшил иқтисодиётни» рағбатлантириш чоралари;</div></div><div class="ACT_TEXT"><div name="5806777" id="5806777">экологик экспертизани амалга ошириш тартиби.</div></div><div class="ACT_TEXT"><div name="5806786" id="5806786">15. Ўзбекистон Республикаси Президентининг 2018 йил 3 октябрдаги «Экология ва атроф-муҳитни муҳофаза қилиш соҳасида давлат бошқаруви тизимини такомиллаштириш бўйича қўшимча чора-тадбирлар тўғрисида»ги ПҚ-3956-сон қарори 3-бандининг <a href="https://lex.uz/uz/docs/3930219?ONDATE=05.10.2018 00#3966987">иккинчи — тўртинчи хатбошилари</a> ва <a href="https://lex.uz/uz/docs/3930219?ONDATE=05.10.2018 00#3966997">4-банди</a>, шунингдек, унга <a href="https://lex.uz/uz/docs/3930219?ONDATE=05.10.2018 00#3967210">1 — 5 иловалар</a> ўз кучини йўқотган деб ҳисоблансин.</div></div><div class="ACT_TEXT"><div name="5806790" id="5806790">16.<strong> </strong>Давлат экология қўмитаси икки ой муддатда қонунчилик ҳужжатларига ушбу қарордан келиб чиқадиган ўзгартириш ва қўшимчалар тўғрисида Вазирлар Маҳкамасига таклифлар киритсин.</div></div><div class="ACT_TEXT"><div name="5806792" id="5806792">17.<strong> </strong>Мазкур қарорнинг ижросини назорат қилиш Ўзбекистон Республикасининг Бош вазири А.Н. Арипов зиммасига юклансин.</div></div><div class="SIGNATURE"><div name="5806795" id="5806795">Ўзбекистон Республикаси Президенти Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="5806796" id="5806796">Тошкент ш.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="5806798" id="5806798">2021 йил 30 декабрь,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="5806802" id="5806802">ПҚ-76-сон</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486793" id="6486793">(1-илова Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481642">Фармонига </a>асосан ўз кучини йўқотган — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486795" id="6486795">(2-илова Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481642">Фармонига </a>асосан ўз кучини йўқотган — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486799" id="6486799">(3-илова Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481642">Фармонига </a>асосан ўз кучини йўқотган — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486801" id="6486801">(4-илова Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481642">Фармонига </a>асосан ўз кучини йўқотган — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6486803" id="6486803">(5-илова Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПФ-81-сонли <a href="https://lex.uz/uz/docs/6479180?ONDATE=02.06.2023 00#6481642">Фармонига </a>асосан ўз кучини йўқотган — Қонунчилик маълумотлари миллий базаси, 02.06.2023 й., 06/23/81/0320-сон)</div></div><div class="BY_DEFAULT"><div name="5807046" id="5807046"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="5807050" id="5807050"><p>Ўзбекистон Республикаси Президентининг 2021 йил 30 декабрдаги ПҚ-76-сон <a href="https://lex.uz/uz/docs/5801426">қарорига</a></p><p>6-ИЛОВА</p></div></div><div class="ACT_TITLE_APPL"><div name="5807054" id="5807054"><strong>Экология, атроф-муҳитни муҳофаза қилиш, табиий ресурслардан оқилона фойдаланиш ва уларни қайта тиклаш соҳасини ҳамда экологик назорат тизимини янада такомиллаштириш бўйича</strong></div></div><div class="ACT_FORM"><div name="5807056" id="5807056"><strong>«ЙЎЛ ХАРИТАСИ»</strong></div></div><div class="BY_DEFAULT"><div name="5807057" id="5807057"></div></div><div class="BY_DEFAULT"><div name="7454086" id="7454086"></div></div><div class="BY_DEFAULT"><div name="7454088" id="7454088"><table class="Table" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:1px solid black;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Т/р</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Чора-тадбирлар номи</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалга ошириш механизми</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Молиялаштириш манбалари</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ижро муддати</span></span></b></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:1px solid black;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Масъул ижрочилар</span></span></b></span></span></span></p></td></tr><tr><td colspan="6" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">I. Экология ва атроф-муҳитни муҳофаза қилиш соҳасини институционал ва ҳуқуқий жиҳатдан такомиллаштириш</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">1.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экологик кодекс</span></span></b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> лойиҳасини ишлаб чиқиш ва белгиланган тартибда Вазирлар Маҳкамасига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси кодекси лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">экологияга оид қонунчилик ҳужжатларини тизимлаштириш ва ихчамлаштириш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">атроф-муҳитни муҳофаза қилиш соҳасида жамоатчилик назоратининг роли ва таъсирини тубдан ошириш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">биохилмахилликни асраш, тиклаш ва кўпайтиришнинг аниқ механизмлари ва рағбатлантириш тизимини жорий этиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">атроф-муҳитни муҳофаза қилишда давлат ташкилотлари ҳамда фуқароларнинг ҳуқуқ ва мажбуриятлари;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">экологик назорат ва мониторинг турларини амалга ошириш тартиби, шу жумладан «яшил иқтисодиётни» рағбатлантириш чоралари;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">экологик экспертизани амалга ошириш тартиби назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил ноябрь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Илм-фан ва ишлаб чиқариш интеграциясини таъминлаш мақсадида атроф-муҳит ва табиатни муҳофаза қилиш технологиялари <b>илмий-тадқиқот институти фаолиятини</b> янада такомиллаштириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Вазирлар Маҳкамаси қарори лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада илмий-тадқиқот институти фаолиятини такомиллаштириш, моддий-техника таъминотини қайтадан кўриб чиқиш, соҳага ахборот технологиялари ва инновацияларни татбиқ этиш бўйича масалалар назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил апрель</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">3.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Муҳофаза этиладиган табиий ҳудудларда жараёнларнинг табиий кечиши мониторингини юритиш, инфратузилмасини шакллантириш ва илмий-тадқиқот фаолиятини олиб боришнинг <b>ягона методикасини</b> ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси қарори лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">қаттиқ режимли муҳофаза этиладиган табиий ҳудудларда илмий-тадқиқотлар ўтказиш тартибини шакллантириш, мазкур тартибда олинган маълумотларни таҳлил қилиш, маҳаллий ва республика даражасида ҳисоботлар, таклифлар, прогнозлар тайёрлаш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">қаттиқ режимли муҳофаза этиладиган табиий ҳудудларда мониторинг ўтказиш тартибини шакллантириш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">табиий мажмуалар мониторинги маълумотларини биохилмахилликнинг ягона маълумотлар базасига киритиш, ҳисоботлар, таклифлар, прогнозлар тайёрлаш бўйича барча давлат органлари, муассасалари ва юридик шахслар учун ягона бўлган тартибни белгилаш назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил июнь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">4.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«<b>Ўзбекистон Республикасида хизмат кўрсатган эколог</b>» фахрий унвонини таъсис этиш бўйича қонун лойиҳасини ишлаб чиқиш ва белгиланган тартибда Вазирлар Маҳкамасига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси қонуни лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада экология ва атроф-муҳитни муҳофаза қилиш тизимларида самарали меҳнат қилиб, ижобий натижаларга эришган ходимларни рағбатлантириш мақсадида «Ўзбекистон Республикасида хизмат кўрсатган эколог» фахрий унвонини таъсис этиш назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил май</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">5.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ёшларда экологик билим ва кўникмаларни рағбатлантириш мақсадида умумий ўрта таълим мактабларида <b>фаол эколог ўқувчиларни </b>маҳаллий бюджет маблағлари ҳисобидан бир марталик пул мукофотлари билан рағбатлантириш механизмларини жорий этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда: </span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">умумий ўрта таълим мактабларида фаол эколог ўқувчиларни очиқ ва шаффоф усулда танлаш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">экологик саналарга қадар фаол эколог ўқувчилар орасидан танлов ғолибларини аниқлаш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">танлов ғолибларини бир марталик пул мукофотлари билан рағбатлантириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллий бюджет маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">доимий</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллий ижро этувчи ҳокимият органлари, Давлат экология қўмитаси, Халқ таълими вазирлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td colspan="6" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">II. Экология ва атроф-муҳитни муҳофаза қилиш соҳасида халқаро ҳамкорликни ривожлантириш бўйича</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">6.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Атроф-муҳит билан боғлиқ бўлган масалалар бўйича қарорлар қабул қилиш жараёнида жамоатчиликнинг ахборот олиш имконияти, иштироки ва одил судловга эришиш имконияти тўғрисидаги Конвенцияга</span></span></b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> (Орхус конвенцияси, Орхус шаҳри, Дания, 1998 йил 25 июнь) қўшилишнинг мақсадга мувофиқлигини ўрганиб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, халқаро шартномаларни пухта таҳлил қилган ҳолда ўрганиб чиқиш, иқтисодий ва ҳуқуқий оқибатларини прогноз қилиш ва ўрганиш натижалари бўйича Вазирлар Маҳкамасига таклиф киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил апрель</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Ташқи ишлар вазирлиги, Адлия вазирлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">7.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Халқаро <b>Тоза сув ва саломатлик Женева протоколига</b> (2000 йил) аъзо бўлиб кириш масаласини кўриб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, халқаро шартномаларни пухта таҳлил қилган ҳолда ўрганиб чиқиш, иқтисодий ва ҳуқуқий оқибатларини прогноз қилиш ва ўрганиш натижалари бўйича Вазирлар Маҳкамасига таклиф киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил май</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Соғлиқни сақлаш вазирлиги, Ташқи ишлар вазирлиги, Адлия вазирлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">8.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳавони узоқ масофаларгача трансчегаравий ифлосланиши тўғрисидаги конвенция</span></span></b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> (1979 йил 13 ноябрь, Женева ш.) ва унинг асосий протоколларига қўшилишнинг мақсадга мувофиқлигини ўрганиб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, халқаро шартномаларни пухта таҳлил қилган ҳолда ўрганиб чиқиш, иқтисодий ва ҳуқуқий оқибатларини прогноз қилиш ва ўрганиш натижалари бўйича Вазирлар Маҳкамасига таклиф киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил июнь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Ташқи ишлар вазирлиги, Адлия вазирлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">9.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қушларнинг миграциясида ва яшаш жойлари сифатида муҳим аҳамиятга эга бўлган Судочье ва Жалтирбас кўлларини <b>Халқаро аҳамиятга эга, асосан сувда сузувчи қушларнинг яшаш жойлари ҳисобланган сув-ботқоқ ҳудудлари тўғрисидаги Конвенциянинг</b> (Рамсар конвенцияси) рўйхатига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, халқаро шартномаларни пухта таҳлил қилган ҳолда ўрганиб чиқиш, иқтисодий ва ҳуқуқий оқибатларини прогноз қилиш ва ўрганиш натижалари бўйича Вазирлар Маҳкамасига таклиф киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил сентябрь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Фанлар академияси, Қорақалпоғистон Республикаси Вазирлар Кенгаши, Ташқи ишлар вазирлиги, Адлия вазирлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">10.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикасида <b>Шанхай Ҳамкорлик Ташкилотига аъзо давлатларнинг </b>атроф-муҳитни муҳофаза қилиш соҳасидаги вазирлик ва идоралари раҳбарларининг учинчи йиғилишини ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Шанхай Ҳамкорлик Ташкилоти котибияти билан учинчи йиғилишни ўзбек томони раислигида ташкил этишни келишиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">учинчи йиғилиш кун тартиби, дастури ва бошқа ташкилий масалаларини ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳисоб-китобларга асосан</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил июнь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Ташқи ишлар вазирлиги, Молия вазирлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td colspan="6" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">III. Биохилмахиллик ва муҳофаза этиладиган табиий ҳудудлар масалалари бўйича</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">11.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўрмон хўжалиги давлат қўмитаси тасарруфида бўлган <b>«Зарафшон»</b> давлат миллий табиат боғини (2426,2 га) штат бирликлари ва моддий-техник базаси билан бирга ҳамда амалдаги молиялаштириш тартибини сақлаб қолган ҳолда Давлат экология қўмитаси тизимига ўтказиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Вазирлар Маҳкамаси қарори лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси тасарруфига ўтказиладиган «Зарафшон» давлат миллий табиат боғини қабул қилиш — топшириш ишларини ташкил этиш бўйича комиссия тузиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">топшириладиган «Зарафшон» давлат миллий табиат боғининг объектлари, моддий-техник бойликлари ва бошқа мулкларини хатловдан ўтказиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Зарафшон» давлат миллий табиат боғини штат бирликлари ва моддий-техник базаси билан бирга ҳамда амалдаги молиялаштириш тартибини сақлаб қолган ҳолда белгиланган тартибда қабул қилиниши — топширилишини таъминлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил май</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Ўрмон хўжалиги давлат қўмитаси, Молия вазирлиги, Самарқанд вилояти ҳокимлиги</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">12.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қуйи Амударё давлат биосфера резерватида Ўзбекистон Республикаси Қизил китобига киритилган <b>1 423 бош</b> Бухоро буғулари учун яшаш шароитларини яхшилаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, биосфера резерватининг Бадай-тўқай бўлимида дарахтларни қуриб қолишидан сақлаш учун 3 км узунликда канал барпо қилиш ва Амударё дарёсидан сув чиқариш учун СНП-500 электр насосини ўрнатиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси бюджети маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил июнь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, Давлат экология қўмитаси </span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">13.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Камёб ва йўқолиб кетиш хавфи остида турган, Ўзбекистон Республикаси <b>Қизил китобига киритилган ёввойи ҳайвон ва ўсимликлар</b> турларидан фойдаланишни <b>тақиқловчи ва чекловчи талабларни</b> белгилаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Норматив-ҳуқуқий ҳужжатлар лойиҳалари.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳаларда «Ўсимлик дунёсини муҳофаза қилиш ва ундан фойдаланиш тўғрисида»ги, «Ҳайвонот дунёсини муҳофаза қилиш ва ундан фойдаланиш тўғрисида»ги, «Ов қилиш ва овчилик хўжалиги тўғрисида»ги қонунларга ҳамда Вазирлар Маҳкамасининг 2014 йил 20 октябрдаги «Биологик ресурслардан фойдаланишни тартибга солиш ва табиатдан фойдаланиш соҳасида рухсат бериш тартиб-таомилларидан ўтиш тартиби тўғрисида»ги 290-сон қарорида белгиланган талабларни ўзгартириш назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил июнь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Ўрмон хўжалиги давлат қўмитаси, Фанлар Академияси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td colspan="6" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">IV. Атроф-муҳитни муҳофаза қилиш ва чиқиндиларни бошқариш амалиётини такомиллаштириш соҳасида</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">14.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикасининг <b>«Чиқиндилар тўғрисида»</b>ги қонун лойиҳасини янги таҳрирда қабул қилиш орқали такомиллаштириш. </span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси қонуни лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">бешта хавф-хатар тоифаси тизими ўрнига саноат тармоқлари ва/ёки кимё-физик параметрлар асосида чиқиндиларни таснифлаш тизимини жорий этиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ишлаб чиқаришда чиқитсиз ва кам чиқитли технологияларни, шунингдек, кончилик ва қайта ишлаш корхоналари чиқиндиларини қайта ишлаш технологияларини ишлаб чиқиш ва жорий этишни молиявий рағбатлантириш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">саноат объектларида хавфли чиқиндиларни экологик хавфсиз сақлашни ташкил этишни таъминлаш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ўзининг истеъмол хусусиятларини йўқотган ва таркибида хавфли моддалар мавжуд бўлган товарларни (симобли термометрлар, батарейкалар, таркибида симоб мавжуд лампалар ва бошқалар) йиғиш, фойдаланиш ва/ёки зарарсизлантириш тизимини ташкил этиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">тиббиёт чиқиндиларини йиғиш, зарарсизлантириш, утилизация қилиш ва кўмиб ташлаш тизимини ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил август</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Иқтисодий тараққиёт ва камбағалликни қисқартириш вазирлиги, Соғлиқни сақлаш вазирлиги, Инновацион ривожланиш вазирлиги, Саноат хавфсизлиги давлат қўмитаси, Фанлар академияси, вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">15.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Санитар тозалаш бўйича ихтисослаштирилган корхоналар республика бирлашмаси ва санитар тозалаш хизматларини ташкил этиш марказлари негизида унитар корхона шаклида <b>Санитар тозалаш бўйича республика маркази ва унинг ҳудудий филиалларини</b> ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси Президенти ҳужжати лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада Санитар тозалаш бўйича республика маркази ва унинг филиалларини молиялаштириш манбалари, асосий вазифалари ҳамда фаолиятини тартибга солиш бўйича нормалар назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил май</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">16.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Экология ва атроф-муҳитни муҳофаза қилиш бўйича янги касбларни</span></span></b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> (эко-таҳлилчи, эко-аудитор, эколог-логист ва бошқа) жорий этиш бўйича таклифлар тайёрлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, хорижий мамлакатларнинг тажрибасини пухта таҳлил қилган ҳолда <b>экология ва атроф-муҳитни муҳофаза қилиш бўйича янги касбларни</b> жорий этиш бўйича асослантирилган таклифларни ишлаб чиқиш ва Вазирлар Маҳкамасига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил август</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Олий ва ўрта-махсус таълим вазирлиги</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">17.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Табиий норуда материалларни <b>ноқонуний қазиб олишда табиий объектларга етказилган зарарни ҳисоблаш</b> тартибини такомиллаштириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Вазирлар Маҳкамаси қарори лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада табиий норуда материалларини ноқонуний қазиб олишда табиий объектларга етказилган зарарни ҳисоблаш тартибини тасдиқлаш назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил июль</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Давлат геология қўмитаси, Кадастр агентлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">18.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тиббиёт чиқиндиларини</span></span></b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> зарарсизлантириш, қайта ишлаш ва утилизация қилиш тизимини такомиллаштириш бўйича таклифлар ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, ҳудудларда ҳосил бўладиган хавфли тиббиёт чиқиндиларини зарарсизлантириш, қайта ишлаш ва утилизация қилиш бўйича жойлардаги ҳақиқий ҳолатни ўрганиш, ушбу йўналишда инфратузилмани ривожлантириш, марказлашган тизим жорий этиш бўйича асослантирилган таклифларни ишлаб чиқиш ва Вазирлар Маҳкамасига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил май</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Соғлиқни сақлаш вазирлиги</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">21.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Атроф-муҳитга таъсир кўрсатишнинг <b>I ва II тоифасига кирадиган фаолият турлари</b> билан шуғулланувчи ташкилотларнинг тегишли мутахассисларини экология ва атроф-муҳитга таъсир кўрсатишнинг олдини олиш бўйича <b>билим ва кўникмаларини</b> ошириш мақсадида <b>малака ошириш курсларини</b> жорий этиш масаласини ўрганиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, атроф-муҳитга таъсир кўрсатишнинг I ва II тоифасига кирадиган фаолият турлари билан шуғулланувчи ташкилотларнинг ходимларига малака ошириш курсларини жорий қилишнинг маъмурий ва ҳуқуқий асослари ўрганилиб чиқиш ҳамда асослантирилган таклифларни Вазирлар Маҳкамасига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил апрель</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси</span></span></span></span></span></p></td></tr><tr><td rowspan="2" style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">22.</span></span></span></span></span></p></td><td rowspan="2" style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Атмосфера ҳавосига ифлослантирувчи моддаларни ташланишини сезиларли даражада камайтириш</span></span></b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">, <b>автотранспорт воситалари</b> <b>ҳаракатланиши учун ёқилғи сарфини мақбуллаштириш</b> мақсадида тажриба синов тариқасида электромобиллар фойдаланиш амалиётини жорий этиш ва уларни қувватлантириш станцияларини ташкил этиш.</span></span></span></span></span></p></td><td style="border-bottom:none;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда: </span></span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">тажриба синов тариқасида Давлат экология қўмитаси ва ҳудудий таркибий бўлинмалари учун автотранспорт воситаларини бириктириш меъёрларига мувофиқ ажратилган хизмат автомобилларининг <b>20 фоизи</b>гача бўлган қисмини электродвигателга эга бўлган транспорт воситаларига алмаштириш ҳамда улар учун электромобилларни қувватлантириш станцияларини ташкил этиш;</span></span></span></span></span></span></p></td><td rowspan="2" style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Халқаро ташкилотлар ва молия институтларининг грантлари, ҳомийлик хайриялари, Экология, атроф-муҳитни муҳофаза қилиш ва чиқиндилар билан боғлиқ ишларни амалга ошириш жамғармаси маблағлари ҳисобидан</span></span></span></span></span></p></td><td style="border-bottom:none;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022-2023 йиллар давомида</span></span></span></span></span></p></td><td rowspan="2" style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">тажриба синов натижаларини танқидий таҳлил қилган ҳолда хизмат автомобилларини тўлиқ электродвигателга эга бўлган транспорт воситаларига алмаштириш бўйича асослантирилган таклиф киритиш.</span></span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2023 йил ноябрь</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">23.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қизилмия, каврак (қизил китобга киритилмаган турлари), ковул ва бошқа доривор ўсимликлар ёки уларнинг яшаш фаолияти натижасида ҳосил бўлган илдизлари, пиёзбошлари, таналари, поялари, новдалари, пўстлоғи, барглари, ғунчалари, гуллари, уруғлари, мевалари, шарбати (елими) ва бошқа маҳсулотларини <b>ўзбошимчалик билан йиғиш учун жавобгарлик</b> масаласини ўрганиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Таҳлилий маълумотнома.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, ҳуқуқни қўллаш амалиётини таҳлил қилиш, хорижий мамлакатлар тажрибасини ўрганиш, асослантирилган таклифларни ишлаб чиқиш ва Вазирлар Маҳкамасига киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил апрель</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">24.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«Давлат экологик сертификатлаштириш ва стандартлаштириш маркази» масъулияти чекланган жамиятини жойлаштириш чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="text-autospace:none"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, ер участкалари белгиланган тартибда Давлат экология қўмитасига давлат ва жамоат эҳтиёжлари учун ажратиш чоралари кўрилади.</span></span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил март</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тошкент шаҳар ҳокимлиги, Давлат активларини бошқариш агентлиги, Давлат экология қўмитаси</span></span></span></span></span></p></td></tr><tr><td colspan="6" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">V. Атмосфера ҳавосини, сув, ер ресурслари ва ер ости бойликларини муҳофаза қилиш бўйича</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">25.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Фавқулодда вазиятлар вазирлиги ҳузуридаги <b>«Хавфсиз дарё» давлат унитар корхонасини Геология ва минерал ресурслар давлат қўмитасига</b> ўтказиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Норматив-ҳуқуқий ҳужжат лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада «Хавфсиз дарё» давлат унитар корхонасини Геология ва минерал ресурслар давлат қўмитасига ўтказиш бўйича ташкилий ва ҳуқуқий механизмлар назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил апрель</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат геология қўмитаси, Фавқулодда вазиятлар вазирлиги</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">26.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Тажриба тариқасида атроф-муҳитга таъсир хавфи юқори бўлган 2 та корхонанинг <b>атмосфера ҳавосини ифлослантирувчи манбаларида намуналар олиш ва таҳлил қилиш</b> <b>бўйича автоматик станциялар</b> ўрнатиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, I-тоифага мансуб корхоналарда танлов асосида 2 дона автоматик станциялар ўрнатиш, уларни ягона геоахборот маълумотлар базасига интеграция қилиш ва амалга оширилган ишлар натижалари бўйича Вазирлар Маҳкамасига таклифлар киритиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитасининг жамғармаси маблағлари, халқаро ташкилотлар ва молия институтларининг грантлари, ҳомийлик хайриялари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил декабрь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, Иқтисодий тараққиёт ва камбағалликни қисқартириш вазирлиги</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">27.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Атмосфера ҳавосига <b>транспорт воситаларидан ташланадиган ифлослантирувчи моддаларни камайтириш</b> мақсадида электромобиллар ишлаб чиқариш ва улардан фойдаланишни ташкил этиш чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси Президенти қарори лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">хорижий мамлакатларнинг илғор тажрибаси асосида халқаро стандартларга мос келувчи энергия самарадорлиги ва экологик тавсифлари юқори электромобиллар ишлаб чиқаришни ташкил этиш ва улардан фойдаланишни кенгайтириш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">«яшил иқтисодиёт»ни ривожлантириш мақсадида қайта тикланувчи энергия манбалари маҳсулотларини лойиҳалаштирганлик, ишлаб чиқарганлик ва молиялаштирганлик учун юридик ва жисмоний шахсларга нисбатан рағбатлантириш чораларини кўриш назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил октябрь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Иқтисодий тараққиёт ва камбағалликни қисқартириш вазирлиги, Транспорт вазирлиги, Молия вазирлиги, «Ўзавтосаноат» АЖ, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">28.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Республика бўйича 50 та ер усти табиий сув объектлари (дарёлар, кичик дарёлар ва табиий кўллар)нинг <b>санитария-муҳофаза зоналари ва соҳил бўйи минтақаларини белгилаш</b> ишларини босқичма-босқич якунига етказиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда: </span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">сувни муҳофаза қилиш ва соҳил бўйи минтақаларини белгилаш бўйича 2022 йилда 12 та, 2023 йилда 10 та, 2024 йилда 10 та, 2025 йилда 10 та, 2026 йилда 8 та сув объектлари учун лойиҳа-смета ҳужжатларини ишлаб чиқиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">сув ҳавзаларининг сувни муҳофаза зоналари ва соҳил бўйи минтақаларини белгилаш бўйича ишлаб чиқилган лойиҳаларни амалга ошириш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллий бюджет маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 — 2026 йиллар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳар ҳокимликлари, Давлат экология қўмитаси </span></span></span></span></span></p></td></tr><tr><td colspan="6" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">VI. Экологик фожиаларни бартараф этиш бўйича</span></span></b></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">29.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Қорақалпоғистон Республикасидаги <b>табиий кўллар барқарор</b> ушлаб турилишини таъминлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда, Мўйноқ, Қўнғирот ва Тахтакўпир туманларидаги кўллар тизимини қўшимча сув билан таъминлаш чораларини кўриш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маҳаллий бюджет маблағлари</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022-2023 йиллар</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлиги, Давлат экология қўмитаси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">30.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Айдар-Арнасой кўллар тизими сув ҳажмининг</span></span></b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif"> <b>камайиши кузатилаётганлигини инобатга олиб,</b> сув сатҳининг 245 м кўрсаткич нуқтасида барқарор ушлаб турилишини таъминлаш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Вазирлар Маҳкамаси фармойиши лойиҳаси.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Лойиҳада:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Айдар-Арнасой кўллар тизимига қўшимча сув оқими билан таъминлаш масаласини кўриб чиқиш бўйича Идоралараро Ҳукумат ишчи комиссиясини тузиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Айдар-Арнасой кўллар тизими билан боғлиқ ҳолатни жойига чиққан ҳолда ўрганиб, оқибатларини таҳлил қилиш ва уларни олдини олиш бўйича таклиф киритиш назарда тутилади.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил апрель</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Сув хўжалиги вазирлиги, Давлат экология қўмитаси, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black;width:3%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:1px solid black" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">31.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:22%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Ҳудудларнинг ўзига хос жиҳатларини ҳисобга олган ҳолда, тўпланиб келаётган <b>экологик муаммоларни таҳлил қилиш</b>, келгусида <b>барқарор экологик вазиятни сақлаш</b> ва <b>экологик фожиаларнинг олдини олиш бўйича дастурларни</b> ишлаб чиқиш.</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:30%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Амалий чора-тадбирлар дастури.</span></span></b></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Бунда:</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">манфаатдор ташкилотлар ва жамоатчилик вакилларидан иборат ишчи гуруҳлар тузиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ҳудуддаги тўпланиб келаётган экологик муаммоларни таҳлил қилиш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">келгусида барқарор экологик вазиятни сақлаш ва экологик фожиаларни олдини олиш бўйича дастур лойиҳасини шакллантириш;</span></span></span></span></span></p><p style="text-align:justify;text-indent:15.7pt;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">ҳудудларнинг дастур лойиҳаларини умумлаштирилган ҳолда республика бўйича умумий дастур лойиҳасини шакллантириш ва тасдиқлаш. </span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:15%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Маблағ талаб этилмайди</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:10%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">2022 йил июнь</span></span></span></span></span></p></td><td style="border-bottom:1px solid black;width:18%;padding:0cm 4px 0cm 4px;height:.100px;border-top:none;border-right:1px solid black;border-left:none" valign="top"><p align="center" style="text-align:center;margin-bottom:11px"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:"Times New Roman",serif">Давлат экология қўмитаси, маҳаллий ижро этувчи ҳокимият органлари, Ўрмон хўжалиги давлат қўмитаси, Сув хўжалиги вазирлиги, Қишлоқ хўжалиги вазирлиги, манфаатдор вазирлик ва идоралар</span></span></span></span></span></p></td></tr></tbody></table></div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7454091" id="7454091">(6-илова Ўзбекистон Республикаси Президентининг 2025 йил 24 мартдаги ПФ-56-сонли <a href="https://lex.uz/uz/docs/7445858?ONDATE=26.03.2025 00#7449436">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 26.03.2025 й., 06/25/56/0274-сон)</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="5806577" id="5806577">(Қонунчилик маълумотлари миллий базаси, 30.12.2021 й., 07/21/76/1231-сон; 11.08.2022 й., 06/22/189/0734-сон; 02.06.2023 й., 06/23/81/0320-сон; 03.08.2024 й., 06/24/106/0571-сон; 04.10.2024 й., 06/24/149/0772-сон; 30.12.2024 й., 07/24/455/1092-сон; 26.03.2025 й., 06/25/56/0274-сон)</div></div></div>
</div></body></html>