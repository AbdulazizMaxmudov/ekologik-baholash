<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Cyrl-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="7850662" id="7850662">Ўзбекистон Республикаси Президентининг</div></div><div class="ACT_FORM"><div name="7850663" id="7850663">Фармони</div></div><div class="ACT_TITLE"><div name="7850664" id="7850664">Экология ва туризм соҳаларида аҳоли талабларига тезкор жавоб бера оладиган бошқарув тизимини яратиш чора-тадбирлари тўғрисида</div></div><div class="BY_DEFAULT"><div name="7850666" id="7850666"></div></div><div class="ACT_TEXT"><div name="7850668" id="7850668">Экология, атроф-муҳитни муҳофаза қилиш ва туризм соҳаларида белгиланган вазифаларни тезкор ҳамда янги ёндашув асосида сифатли ташкил этиш, шунингдек, мазкур йўналишдаги давлат бошқаруви ва назорати тизимини такомиллаштириш мақсадида қарор қиламан:</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7850670" id="7850670">I. Бошқарув тизимини такомиллаштириш</div></div><div class="ACT_TEXT"><div name="7850673" id="7850673">1. Қуйидагилар:</div></div><div class="ACT_TEXT"><div name="7850674" id="7850674">(а) Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги ҳузуридаги Туризм қўмитаси Ўзбекистон Республикаси Туризм қўмитаси сифатида қайта ташкил этилсин;</div></div><div class="ACT_TEXT"><div name="7850678" id="7850678">(б) Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги Вазирлар Маҳкамаси тизимидан чиқарилиб, унинг негизида амалдаги штат бирликлари сақланган ҳолда Экология ва иқлим ўзгариши миллий қўмитаси (кейинги ўринларда — Экология қўмитаси) ташкил этилсин.</div></div><div class="ACT_TEXT"><div name="7850679" id="7850679">2. Белгилансинки:</div></div><div class="ACT_TEXT"><div name="7850680" id="7850680">(а) Экология қўмитаси қулай экологик ҳолатни барқарор сақлаш, атроф-муҳитни муҳофаза қилиш, «Яшил макон» умуммиллий лойиҳасини амалга ошириш, ўрмонларни кўпайтириш, глобал иқлим ўзгариши оқибатларини юмшатиш ва чўлланишга қарши курашиш соҳаларида ягона давлат сиёсати ва назоратини амалга ошириш бўйича ваколатли орган ҳисобланади;</div></div><div class="ACT_TEXT"><div name="7850682" id="7850682">(б) Ўзбекистон Республикаси Президенти Администрацияси ташкилий тузилмасида 2 та штат бирлигидан иборат Ўзбекистон Республикаси Президентининг экология масалалари бўйича маслаҳатчиси бўлинмаси ташкил этилади;</div></div><div class="ACT_TEXT"><div name="7850684" id="7850684">(в) Ўрмон ва яшил ҳудудларни кўпайтириш, чўлланишга қарши курашиш агентлиги, Гидрометеорология хизмати агентлиги ҳамда Чиқиндиларни бошқариш ва циркуляр иқтисодиётни ривожлантириш агентлиги ўз фаолиятини Экология қўмитаси ҳузурида давом эттиради.</div></div><div class="ACT_TEXT"><div name="7850685" id="7850685">3. Белгилаб қўйилсинки, Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигининг асосий вазифаларидан ташқари, Экология қўмитаси <a href="https://lex.uz/docs/7847353#7850734">1-иловага</a> мувофиқ қуйидаги умуммиллий лойиҳаларни амалга ошириш учун масъул ҳисобланади:</div></div><div class="ACT_TEXT"><div name="7850687" id="7850687">(а) чиқиндиларни қайта ишлаш ва улар билан ишлаш тизимини такомиллаштиришга қаратилган «Чиқиндидан ҳоли ҳудуд» умуммиллий лойиҳаси;</div></div><div class="ACT_TEXT"><div name="7850690" id="7850690">(б) атмосфера ҳавоси сифатини яхшилашга қаратилган «Тоза ҳаво» умуммиллий лойиҳаси;</div></div><div class="ACT_TEXT"><div name="7850691" id="7850691">(в) 2028 йилга қадар Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида қўшимча равишда жами майдони 100 гектардан кам бўлмаган ботаника ва дендрология боғларини ташкил қилишга қаратилган «Яшил макон» умуммиллий лойиҳаси;</div></div><div class="ACT_TEXT"><div name="7850692" id="7850692">(г) аҳоли орасида эко-одатларни шакллантириш ва экологик ҳаёт тарзини кенг тарғиб қилишга қаратилган «Эко-маданият» умуммиллий лойиҳаси;</div></div><div class="ACT_TEXT"><div name="7850693" id="7850693">(д) биохилма-хилликни келажак авлод учун асрашга қаратилган «Био мерос» умуммиллий лойиҳаси.</div></div><div class="ACT_TEXT"><div name="7850696" id="7850696">4. Экология қўмитаси ҳузурида 15 нафаргача хорижий ва маҳаллий экспертларни фуқаровий-ҳуқуқий шартномалар асосида жалб қилган ҳолда экология соҳасидаги «Эколойиҳалар фабрикаси» (кейинги ўринларда — Лойиҳа офиси) ташкил этилсин.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7850697" id="7850697">II. Экологик назоратни кучайтириш</div></div><div class="ACT_TEXT"><div name="7850698" id="7850698">5. Белгилансинки, 2026 йил 1 апрелдан бошлаб <a href="https://lex.uz/docs/7847353#7850780">2-иловага</a> мувофиқ экология, атроф-муҳитни муҳофаза қилиш ва табиатдан фойдаланиш соҳасидаги қонунчиликни бузганлик учун юридик шахсларга нисбатан молиявий санкцияларни қўллаш тартиби жорий этилади, бунда:</div></div><div class="ACT_TEXT"><div name="7850699" id="7850699">(а) молиявий санкциялар пул ундириш (жарималар) тарзида фақат юридик шахсларга қўлланади;</div></div><div class="ACT_TEXT"><div name="7850700" id="7850700">(б) бир хил ҳуқуқбузарлик учун молиявий санкциялар қўлланган юридик шахсларнинг ходимларига маъмурий жазо чорасини қўллашга йўл қўйилмайди;</div></div><div class="ACT_TEXT"><div name="7850701" id="7850701">(в) ҳуқуқбузарликнинг такроран содир этилишига йўл қўймаслик ҳақида огоҳлантириш олиш ҳамда жаримани тўлаш экология, атроф-муҳитни муҳофаза қилиш ва табиатдан фойдаланиш соҳасидаги қонунчиликнинг бузилишига йўл қўйган шахсни Экология қўмитасининг қарорини (тақдимномасини, кўрсатмасини) бажариш ёки қонунчиликда назарда тутилган бошқа ҳаракатларни амалга ошириш мажбуриятидан озод этмайди.</div></div><div class="ACT_TEXT"><div name="7850702" id="7850702">6. Қуйидагилар негизида алоҳида юридик шахс бўлмаган Экология ва иқлим ўзгариши миллий қўмитасининг Давлат экологик назорат инспекцияси (Экополиция) (кейинги ўринларда — Экополиция) ташкил этилсин:</div></div><div class="ACT_TEXT"><div name="7850703" id="7850703">(а) Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигининг Давлат экологик назорат инспекцияси;</div></div><div class="ACT_TEXT"><div name="7850704" id="7850704">(б) Қорақалпоғистон Республикаси, Тошкент ва Жиззах вилоятларидаги табиатни муҳофаза қилиш бўйича ҳудудий махсус прокуратуралар;</div></div><div class="ACT_TEXT"><div name="7850705" id="7850705">(в) Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳри прокуратураларининг экология, атроф-муҳитни муҳофаза қилиш ва ўрмон хўжалиги соҳасидаги қонунчилик ижроси устидан назорат йўналишидаги бўлинмаларининг оптималлаштириладиган штат бирликлари.</div></div><div class="ACT_TEXT"><div name="7850706" id="7850706">7. Белгилансинки:</div></div><div class="ACT_TEXT"><div name="7850707" id="7850707">(а) Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳри прокуратураларига экология, атроф-муҳитни муҳофаза қилиш ва ўрмон хўжалиги соҳасидаги қонунчилик ижроси устидан назорат йўналишида ажратилган 40 та штат бирлиги Экополицияга ўтказилади;</div></div><div class="ACT_TEXT"><div name="7850708" id="7850708">(б) Экополиция Экология қўмитасининг экологик хавфсизликни таъминлаш ва бу борадаги ҳуқуқбузарликлар профилактикаси соҳасида ҳуқуқни муҳофаза қилишга доир айрим вазифаларга эга бўлган махсус бўлинмасидир;</div></div><div class="ACT_TEXT"><div name="7850709" id="7850709">(в) Экология қўмитаси раиси бир вақтнинг ўзида Экополиция бошлиғи ҳисобланади;</div></div><div class="ACT_TEXT"><div name="7850710" id="7850710">(г) Экополиция бошлиғининг ўринбосари бир вақтнинг ўзида Экология қўмитаси раиси ўринбосари ҳисобланади ва Экополициянинг тезкор штабига раҳбарлик қилади;</div></div><div class="ACT_TEXT"><div name="7850711" id="7850711">(д) Экополицияга унинг ҳудудий бўлинмаларини маъмурий-ҳудудий бирликлар чегараларини ҳисобга олмаган ҳолда табиий экологик ҳудудлар чегаралари доирасида ташкил этишга рухсат этилади.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7850713" id="7850713">III. Фармон ижросини ташкил этиш, таъминлаш ва назорат</div></div><div class="ACT_TEXT"><div name="7850715" id="7850715">8. Экология қўмитаси қуйидагилар юзасидан Ўзбекистон Республикаси Президентига мунтазам равишда ахборот киритиб борсин:</div></div><div class="ACT_TEXT"><div name="7850716" id="7850716">(а) йирик корхона ва тармоқлар томонидан экология ва атроф-муҳитни муҳофаза қилиш соҳасида содир этилган ҳуқуқбузарликлар, улар ва уларнинг мансабдор шахсларига нисбатан кўрилган чоралар;</div></div><div class="ACT_TEXT"><div name="7850718" id="7850718">(б) соҳадаги масъул бошқарув ва назорат органларининг ўз вазифаларини сифатли ва ўз вақтида бажариши ҳолати;</div></div><div class="ACT_TEXT"><div name="7850720" id="7850720">(в) давлат органларининг экология ва атроф-муҳитни муҳофаза қилиш соҳасидаги қонунчилик талабларига зид бўлган қарорларини бекор қилиш.</div></div><div class="ACT_TEXT"><div name="7850722" id="7850722">9. Экология қўмитаси Адлия вазирлиги ҳамда манфаатдор вазирлик ва идоралар билан биргаликда бир ой муддатда экология ва атроф-муҳитни муҳофаза қилиш соҳасидаги қонунчиликни бузганлик учун юридик шахсларга молиявий санкцияларни жорий этиш ва уларни қўллашни назарда тутувчи қонун лойиҳасини ишлаб чиқиб, Ўзбекистон Республикаси Президенти Администрациясига киритсин.</div></div><div class="ACT_TEXT"><div name="7850723" id="7850723">10. Экология қўмитаси манфаатдор вазирлик ва идоралар билан биргаликда икки ой муддатда қонунчилик ҳужжатларига ушбу Фармон талабларидан келиб чиқадиган ўзгартириш ва қўшимчалар тўғрисида таклифлар киритсин.</div></div><div class="ACT_TEXT"><div name="7850724" id="7850724">11. Ўзбекистон Республикаси Президентининг айрим ҳужжатларига <a href="https://lex.uz/docs/7847353#7850799">3-иловага</a> мувофиқ ўзгартириш ва қўшимчалар киритилсин.</div></div><div class="ACT_TEXT"><div name="7850727" id="7850727">12. Фармон ижросини назорат қилиш Ўзбекистон Республикаси Президенти Администрацияси раҳбари С.Ш. Мирзиёева зиммасига юклансин.</div></div><div class="SIGNATURE"><div name="7850728" id="7850728">Ўзбекистон Республикаси Президенти Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7850729" id="7850729">Тошкент ш.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7850730" id="7850730">2025 йил 18 ноябрь,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="7850731" id="7850731">ПФ-217-сон</div></div><div class="BY_DEFAULT"><div name="7850733" id="7850733"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="7850734" id="7850734">Ўзбекистон Республикаси Президентининг 2025 йил 18 ноябрдаги ПФ-217-сон <a href="https://lex.uz/docs/7847353">Фармонига</a><br />1-ИЛОВА</div></div><div class="ACT_TITLE_APPL"><div name="7850736" id="7850736">Экология, атроф-муҳитни муҳофаза қилиш соҳасидаги умуммиллий лойиҳаларнинг</div></div><div class="ACT_FORM"><div name="7850737" id="7850737">АСОСИЙ ВАЗИФАЛАРИ</div></div><div class="BY_DEFAULT"><div name="7850738" id="7850738"></div></div><div class="ACT_TEXT"><div name="7850740" id="7850740">1. «Чиқиндидан ҳоли ҳудуд» умуммиллий лойиҳаси доирасида:</div></div><div class="ACT_TEXT"><div name="7850741" id="7850741">(а) республиканинг барча ҳудудларини қамраб оладиган чиқиндиларни ёқиб, электр энергия ишлаб чиқариш корхоналарини қуриш;</div></div><div class="ACT_TEXT"><div name="7850742" id="7850742">(б) тиббиёт ва хавфли чиқиндиларни хавфсиз ва тўлақонли утилизация қилиш тизимини яратиш;</div></div><div class="ACT_TEXT"><div name="7850743" id="7850743">(в) чиқиндиларни олиб чиқиб кетиш бўйича юридик шахслар масъулиятини ошириш;</div></div><div class="ACT_TEXT"><div name="7850744" id="7850744">(г) чиқиндиларни тўплаш ва олиб чиқиб кетиш хизмати сифатини ошириш ва аҳоли талабларига мослаштириш, шу жумладан, техника ва контейнерлар сонини тубдан ошириш;</div></div><div class="ACT_TEXT"><div name="7850745" id="7850745">(д) полигонларни рекультивация қилиш ва улар сонини кескин камайтириш;</div></div><div class="ACT_TEXT"><div name="7850747" id="7850747">(ж) қайта юклаш станциялари фаолиятини йўлга қўйиш.</div></div><div class="ACT_TEXT"><div name="7850749" id="7850749">2. «Тоза ҳаво» умуммиллий лойиҳаси доирасида:</div></div><div class="ACT_TEXT"><div name="7850751" id="7850751">(а) марказий ва саноатга ихтисослаштирилган туман (шаҳар)ларнинг ҳаво сифатини яхшилаш;</div></div><div class="ACT_TEXT"><div name="7850752" id="7850752">(б) ҳаво сифати сурункали бузилаётган туман (шаҳар)да алоҳида махсус назорат тизимини жорий қилиш;</div></div><div class="ACT_TEXT"><div name="7850753" id="7850753">(в) саноат корхоналари томонидан автоматик мониторинг станциялари, чанг-газ тозалаш ускуналари ва сув тозалаш иншоотларининг ўрнатилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="7850755" id="7850755">(г) атмосфера ҳавосининг ифлосланиши кузатувларининг давлат тизимини ривожлантириш ва модернизация қилиш;</div></div><div class="ACT_TEXT"><div name="7850756" id="7850756">(д) ташламаларнинг умумий ҳажмини камайтириш.</div></div><div class="ACT_TEXT"><div name="7850757" id="7850757">3. «Яшил макон» умуммиллий лойиҳасига қуйидаги қўшимча вазифаларни киритиш:</div></div><div class="ACT_TEXT"><div name="7850759" id="7850759">(а) Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида қўшимча равишда жами майдони 100 гектардан кам бўлмаган ботаника ва дендрология боғларини ташкил қилиш;</div></div><div class="ACT_TEXT"><div name="7850760" id="7850760">(б) ҳар бир шаҳар ва туманда камида 2 тадан сояли сайр кўчаларини ташкил қилиш.</div></div><div class="ACT_TEXT"><div name="7850762" id="7850762">4. «Эко-маданият» умуммиллий лойиҳаси доирасида:</div></div><div class="ACT_TEXT"><div name="7850763" id="7850763">(а) мактабгача таълимнинг энг асосий самарадорлик кўрсаткичи сифатида болаларда эко-одатларни шакллантириш;</div></div><div class="ACT_TEXT"><div name="7850764" id="7850764">(б) болалар орасида экологик ҳаёт тарзини ташвиқот қилиш учун эко-контент базасини шакллантириш (бунда мультфильм, роликлар, қисқа метражли фильмлар яратиш, блоглар юритиш);</div></div><div class="ACT_TEXT"><div name="7850765" id="7850765">(в) Эковолонтёрлар миллий тармоғини яратиш ҳамда мактабларда ташаббускор мактаб ўқувчиларини тақдирлаш мақсадида уч даражали эко-аълочилар кўкрак нишонини жорий қилиш;</div></div><div class="ACT_TEXT"><div name="7850766" id="7850766">(г) Қорақалпоғистон Республикаси, вилоятлар ва Тошкент шаҳрида эко-оромгоҳлар ташкил қилиш. Бунда эко-аълочиларнинг оромгоҳларда имтиёзли равишда дам олишини ташкиллаштириш;</div></div><div class="ACT_TEXT"><div name="7850767" id="7850767">(д) ўқувчилар ва талабаларнинг стартап лойиҳалари учун мини-грантлар ажратиб бориш;</div></div><div class="ACT_TEXT"><div name="7850768" id="7850768">(ж) экологик краудфандинг фаолиятига ҳуқуқий мақом бериш ва қўллаб-қувватлаш;</div></div><div class="ACT_TEXT"><div name="7850769" id="7850769">(з) ҳар бир маҳаллада жамоатчилик экология назоратчиси тизимини жорий қилиш, бунда улар иштирокида амалга оширилган маъмурий жариманинг ўн фоиз миқдоридаги маблағларни жамоатчилик экология назоратчисини рағбатлантиришга йўналтириш;</div></div><div class="ACT_TEXT"><div name="7850771" id="7850771">(и) «Экофаол», «Яшил тадбиркор» платформаларини жорий қилиш.</div></div><div class="ACT_TEXT"><div name="7850772" id="7850772">5. «Био мерос» умуммиллий лойиҳаси доирасида:</div></div><div class="ACT_TEXT"><div name="7850773" id="7850773">(а) муҳофаза этиладиган табиий ҳудудларни бошқариш тизими самарадорлигини ошириш ва уларнинг ҳудудларини кенгайтириш;</div></div><div class="ACT_TEXT"><div name="7850774" id="7850774">(б) камёб ва йўқолиб кетиш хавфи бўлган ёввойи ҳайвон ва ўсимлик турлари бўйича алоҳида питомниклар ташкил қилиш ҳамда уларни қайта тиклаш (реинтродукция) чора-тадбирларини амалга ошириш;</div></div><div class="ACT_TEXT"><div name="7850775" id="7850775">(в) биологик ресурслардан барқарор фойдаланиш, шу жумладан, биологик хилма-хиллик ва экотизим хизматларининг қийматини иқтисодий баҳолаш механизмларини жорий этиш.</div></div><div class="BY_DEFAULT"><div name="7850779" id="7850779"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="7850780" id="7850780">Ўзбекистон Республикаси Президентининг 2025 йил 18 ноябрдаги ПФ-217-сон <a href="https://lex.uz/docs/7847353">Фармонига</a><br />2-ИЛОВА</div></div><div class="ACT_TITLE_APPL"><div name="7850781" id="7850781">Экология, атроф-муҳитни муҳофаза қилиш ва табиатдан фойдаланиш соҳасида юридик шахсларга нисбатан молиявий санкциялар жорий қилинадиган қонун бузарлик ҳолатлари</div></div><div class="ACT_FORM"><div name="7850783" id="7850783">РЎЙХАТИ</div></div><div class="BY_DEFAULT"><div name="7850784" id="7850784"></div></div><div class="ACT_TEXT"><div name="7850785" id="7850785">1. Дарёларнинг ўзанларини тозалашга ва қирғоқларини мустаҳкамлашга доир ишларни амалга ошириш тартибини бузиш.</div></div><div class="ACT_TEXT"><div name="7850787" id="7850787">2. Сув ресурсларини муҳофаза қилиш қоидаларини бузиш.</div></div><div class="ACT_TEXT"><div name="7850788" id="7850788">3. Дарахтлар ва буталарни ғайриқонуний равишда кесиш, йўқ қилиш ва уларни муҳофаза қилиш чораларини кўрмаслик.</div></div><div class="ACT_TEXT"><div name="7850789" id="7850789">4. Ифлослантирувчи моддаларни атмосфера ҳавосига чиқариб ташлаш ёки атмосфера ҳавосидан белгиланган талабларни бузган ҳолда фойдаланиш.</div></div><div class="ACT_TEXT"><div name="7850790" id="7850790">5. Қурилиш майдонларида атмосфера ҳавосини муҳофаза қилиш талабларига риоя этмаслик.</div></div><div class="ACT_TEXT"><div name="7850791" id="7850791">6. Ёқилғи, моддалар, материал ва чиқиндиларни ёқишда атмосфера ҳавосини муҳофаза қилиш талабларига риоя этмаслик.</div></div><div class="ACT_TEXT"><div name="7850792" id="7850792">7. Чиқиндилар билан муомалада бўлишда атроф-муҳитни муҳофаза қилиш талабларига риоя этмаслик.</div></div><div class="BY_DEFAULT"><div name="7850796" id="7850796"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="7850799" id="7850799">Ўзбекистон Республикаси Президентининг 2025 йил 18 ноябрдаги ПФ-217-сон <a href="https://lex.uz/docs/7847353">Фармонига</a><br />3-ИЛОВА</div></div><div class="ACT_TITLE_APPL"><div name="7850800" id="7850800">Ўзбекистон Республикаси Президентининг айрим ҳужжатларига киритилаётган ўзгартириш ва қўшимчалар</div></div><div class="BY_DEFAULT"><div name="7850802" id="7850802"></div></div><div class="ACT_TEXT"><div name="7850803" id="7850803">1. Ўзбекистон Республикаси Президентининг 2021 йил 7 апрелдаги «Кино санъати ва саноатини янги босқичга олиб чиқиш, соҳани давлат томонидан қўллаб-қувватлаш тизимини янада такомиллаштириш тўғрисида»ги ПФ-6202-сон Фармони 9-бандининг<a href="https://lex.uz/docs/5374440?ONDATE=08.04.2021 00#5375610">«а» кичик банди</a> қуйидаги таҳрирда баён этилсин:</div></div><div class="ACT_TEXT"><div name="7850805" id="7850805">«а) хорижий кинокомпаниялар учун, агар харажатлар суммаси:</div></div><div class="ACT_TEXT"><div name="7850807" id="7850807">3 миллиард сўмгача бўлса — 10 фоиз;</div></div><div class="ACT_TEXT"><div name="7850809" id="7850809">3 миллиард сўмдан 5 миллиард сўмгача бўлса — 15 фоиз;</div></div><div class="ACT_TEXT"><div name="7850810" id="7850810">5 миллиард сўмдан 10 миллиард сўмгача бўлса — 20 фоиз;</div></div><div class="ACT_TEXT"><div name="7850812" id="7850812">10 миллиард сўмдан ортиқ бўлса — 25 фоиз, бироқ битта фильм учун 4 миллиард сўмдан ошмаган миқдорда қоплаб берилади».</div></div><div class="ACT_TEXT"><div name="7850813" id="7850813">2. Ўзбекистон Республикаси Президентининг 2023 йил 25 январдаги «Республика ижро этувчи ҳокимият органлари фаолиятини самарали йўлга қўйишга доир биринчи навбатдаги ташкилий чора-тадбирлар тўғрисида»ги ПФ-14-сон <a href="https://lex.uz/docs/6369997">Фармонида</a>:</div></div><div class="ACT_TEXT"><div name="7850814" id="7850814">(а) <a href="https://lex.uz/docs/6369997?ONDATE=07.10.2025 00#7761851">1-иловада</a>:</div></div><div class="ACT_TEXT"><div name="7850815" id="7850815">«11. Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги» бўлими чиқариб ташлансин;</div></div><div class="ACT_TEXT"><div name="7850816" id="7850816">қуйидаги мазмундаги 39-бўлим билан тўлдирилсин:</div></div><div class="BY_DEFAULT"><div name="7850817" id="7850817"><table class="Table" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr><td colspan="5" nowrap="nowrap" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><span lang="UZ-CYR" style="color:#0d0d0d">«</span></span></span></p></td></tr><tr><td colspan="5" nowrap="nowrap" style="border-bottom:1px solid black;width:100%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><strong>39. Туризм қўмитаси</strong></span></span></p></td></tr><tr><td nowrap="nowrap" style="border-bottom:1px solid black;width:4%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black;width:56%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Туризм қўмитаси</span></span></p></td><td nowrap="nowrap" style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">275</span></span></p></td><td nowrap="nowrap" style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">275</span></span></p></td><td nowrap="nowrap" style="border-bottom:1px solid black;width:13%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td colspan="2" nowrap="nowrap" style="border-bottom:1px solid black;width:61%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><em style="font-family:"Times New Roman",serif">шу жумладан, раис ўринбосарлари сони</em></span></span></p></td><td nowrap="nowrap" style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><em style="font-family:"Times New Roman",serif">2</em></span></span></p></td><td nowrap="nowrap" style="border-bottom:1px solid black;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><em style="font-family:"Times New Roman",serif">2</em></span></span></p></td><td nowrap="nowrap" style="border-bottom:1px solid black;width:13%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td colspan="2" nowrap="nowrap" style="border-bottom:none;width:61%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td nowrap="nowrap" style="border-bottom:none;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td nowrap="nowrap" style="border-bottom:none;width:12%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td nowrap="nowrap" style="border-bottom:none;width:13%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="right" style="text-align:right"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><span style="color:#0d0d0d">»</span><span lang="UZ-CYR" style="color:#0d0d0d">;</span></span></span></p></td></tr></tbody></table></div></div><div class="ACT_TEXT"><div name="7850818" id="7850818">«Изоҳлар» қисмидан <a href="https://lex.uz/docs/6369997?ONDATE=28.10.2025 01#7805617">5.9</a>., <a href="https://lex.uz/docs/6369997?ONDATE=28.10.2025 01#7805618">5.10</a>. ва <a href="https://lex.uz/docs/6369997?ONDATE=28.10.2025 01#7805619">5.11.-кичик бандлар</a> ўз кучини йўқотган деб ҳисоблансин;</div></div><div class="ACT_TEXT"><div name="7850820" id="7850820">(б) <a href="https://lex.uz/docs/6369997?ONDATE=28.10.2024 00#7188616">2-иловада</a>:</div></div><div class="ACT_TEXT"><div name="7850821" id="7850821">11-банд ҳамда 11.1 — 11.4-кичик бандлар ўз кучини йўқотган деб ҳисоблансин;</div></div><div class="ACT_TEXT"><div name="7850822" id="7850822">қуйидаги мазмундаги 42-банд билан тўлдирилсин:</div></div><div class="ACT_TEXT"><div name="7850823" id="7850823">«42. Туризм қўмитаси»;</div></div><div class="ACT_TEXT"><div name="7850824" id="7850824">(в) <a href="https://lex.uz/docs/6369997?ONDATE=28.10.2024 00#7188665">2а-иловада</a>:</div></div><div class="ACT_TEXT"><div name="7850825" id="7850825">11 — 11.4.-позициялар чиқариб ташлансин;</div></div><div class="ACT_TEXT"><div name="7850826" id="7850826">қуйидаги мазмундаги 42-позиция билан тўлдирилсин:</div></div><div class="BY_DEFAULT"><div name="7850827" id="7850827"><table class="Table" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr><td style="border-bottom:1px solid black;width:4%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><span lang="UZ-CYR" style="color:#0d0d0d">«</span></span></span></p></td><td style="border-bottom:1px solid black;width:43%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p></p></td><td style="border-bottom:1px solid black;width:25%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:1px solid black;width:25%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black;width:4%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><strong><span lang="UZ-CYR" style="font-weight:normal">42.</span></strong></span></span></p></td><td style="border-bottom:1px solid black;width:43%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Ўзбекистон Республикаси<strong><span style="font-weight:normal"> Туризм қўмитаси</span></strong></span></span></p></td><td style="border-bottom:1px solid black;width:25%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Туризм қўмитаси</span></span></p></td><td style="border-bottom:1px solid black;width:25%;padding:0cm 4px 0cm 4px;border-top:none;border-right:1px solid black;border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Комитет по туризму</span></span></p></td></tr><tr><td style="border-bottom:none;width:4%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:none;width:43%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p></p></td><td style="border-bottom:none;width:25%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="center" style="text-align:center"></p></td><td style="border-bottom:none;width:25%;padding:0cm 4px 0cm 4px;border-top:none;border-right:none;border-left:none"><p align="right" style="text-align:right"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><span style="color:#0d0d0d">»</span><span lang="UZ-CYR" style="color:#0d0d0d">.</span></span></span></p></td></tr></tbody></table></div></div><div class="ACT_TEXT"><div name="7850828" id="7850828">3. Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги «Экология ва атроф-муҳитни муҳофаза қилиш соҳасини трансформация қилиш ва ваколатли давлат органи фаолиятини ташкил этиш чора-тадбирлари тўғрисида»ги ПФ-81-сон <a href="https://lex.uz/docs/6479180">Фармонида</a>:</div></div><div class="ACT_TEXT"><div name="7850829" id="7850829">(а) <a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480071">5-бандда</a>:</div></div><div class="ACT_TEXT"><div name="7850830" id="7850830"><a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480073">учинчи хатбоши</a> чиқариб ташлансин;</div></div><div class="ACT_TEXT"><div name="7850831" id="7850831"><a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480074">тўртинчи хатбошидаги</a> «70» рақами «30» рақами билан алмаштирилсин;</div></div><div class="ACT_TEXT"><div name="7850832" id="7850832"><a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480075">бешинчи хатбошидаги</a> «77» рақами «37» рақами билан алмаштирилсин;</div></div><div class="ACT_TEXT"><div name="7850833" id="7850833">(б) <a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480085">7-бандда</a>:</div></div><div class="ACT_TEXT"><div name="7850834" id="7850834"><a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480089">иккинчи — тўртинчи</a> ва <a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480095">олтинчи хатбошилар</a> чиқариб ташлансин;</div></div><div class="ACT_TEXT"><div name="7850835" id="7850835"><a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480093">бешинчи</a>, <a href="https://lex.uz/docs/6479180?ONDATE=02.06.2023 00#6480096">еттинчи — ўнинчи хатбошилар</a> тегишинча иккинчи — олтинчи хатбошилар деб ҳисоблансин.</div></div><div class="ACT_TEXT"><div name="7850836" id="7850836">4. Ўзбекистон Республикаси Президентининг 2025 йил 24 мартдаги «Чиқиндиларни қайта ишлаш соҳасини янада такомиллаштириш ҳамда комплекс тизимлаштириш чора-тадбирлари тўғрисида»ги ПФ-56-сон <a href="https://lex.uz/docs/7445858">Фармонида</a>:</div></div><div class="ACT_TEXT"><div name="7850837" id="7850837">(а) <a href="https://lex.uz/docs/7445858?ONDATE=26.03.2025 00#7449049">4-банд</a> қуйидаги мазмундаги «н» кичик банд билан тўлдирилсин:</div></div><div class="ACT_TEXT"><div name="7850838" id="7850838">«н) Экология ва иқлим ўзгариши миллий қўмитаси Энергетика вазирлиги, Қишлоқ хўжалиги вазирлиги, Иқтисодиёт ва молия вазирлиги билан биргаликда, заруратга кўра, Инвестиция лойиҳасини амалга ошириш учун экосаноат зоналарига туташ ҳудудларда ҳаво электр узатиш тармоқларини ва электр инфратузилмаси қурилмаларини қуриш учун зарур ер участкаларини танлаб олсин ҳамда уларнинг чегараларига аниқлик киритиб, тегишлилиги бўйича оммавий сервитут белгилаш ва ер фонди тоифасини ўзгартириш юзасидан Қишлоқ хўжалигига мўлжалланган ва ўрмон фонди ерларининг ер фонди тоифаларини ўзгартириш масалаларини кўриб чиқиш бўйича Ҳукумат комиссиясига таклифларни киритсин»;</div></div><div class="ACT_TEXT"><div name="7850839" id="7850839">(б) <a href="https://lex.uz/docs/7445858?ONDATE=26.03.2025 00#7449184">4-илованинг</a> 9-позицияси «I ва II тоифаларга мансуб корхоналар» сўзларидан кейин «ҳамда Ўзбекистон Республикаси Президентининг 2024 йил 4 январдаги «Чиқиндиларни бошқариш тизимини такомиллаштириш ва уларнинг экологик вазиятга салбий таъсирини камайтириш бўйича чора-тадбирлар тўғрисида»ги ПФ-5-сон Фармонига 2а-иловада келтирилган чиқиндиларни қайта ишлашни ёки экологик хавфсиз тарзда утилизация қилишни йўлга қўйган тадбиркорлар» сўзлари билан тўлдирилсин.</div></div><div class="ACT_TEXT"><div name="7850840" id="7850840">5. Ўзбекистон Республикаси Президентининг 2025 йил 30 майдаги «Яшил макон» умуммиллий лойиҳаси доирасида ҳамда ўрмонларни бошқариш тизимида ислоҳотларни изчил давом эттириш, яшил ҳудудларни кенгайтириш чора-тадбирлари тўғрисида»ги ПФ-90-сон Фармони 9-бандининг <a href="https://lex.uz/docs/7552003?ONDATE=02.06.2025 00#7554427">биринчи хатбошисидаги</a> «2025/2026» рақамлари «2026/2027» рақамлари билан алмаштирилсин.</div></div><div class="ACT_TEXT"><div name="7850841" id="7850841">6. Ўзбекистон Республикаси Президентининг 2020 йил 17 ноябрдаги «Ўзбекистон Республикаси гидрометеорология хизмати фаолиятини янада такомиллаштириш чора-тадбирлари тўғрисида»ги ПҚ-4896-сон қарори 9-бандининг <a href="https://lex.uz/docs/5108961?ONDATE=18.11.2020 00#5112401">олтинчи хатбошиси</a> қуйидаги таҳрирда баён этилсин:</div></div><div class="ACT_TEXT"><div name="7850842" id="7850842">«Белгилансинки, ушбу бандда белгиланган чора-тадбирларни амалга ошириш билан боғлиқ, шунингдек, Гидрометеорология илмий-тадқиқот институтини сақлаш, ходимлар меҳнатига ҳақ тўлаш бўйича харажатлар Давлат бюджети маблағлари ҳисобидан амалга оширилади».</div></div><div class="ACT_TEXT"><div name="7850843" id="7850843">7. Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги «Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги фаолиятини самарали ташкил этиш чора-тадбирлари тўғрисида»ги ПҚ-171-сон қарорига 1-илованинг <a href="https://lex.uz/docs/6479134?ONDATE=27.07.2023 00#6553489">«о»</a>, <a href="https://lex.uz/docs/6479134?ONDATE=27.07.2023 00#6553490">«п»</a> ва <a href="https://lex.uz/docs/6479134?ONDATE=27.07.2023 00#6553491">«р» кичик бандлари</a> ўз кучини йўқотган деб ҳисоблансин.</div></div><div class="ACT_TEXT"><div name="7850844" id="7850844">8. Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги «Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университети (Green University) фаолиятини ташкил этиш чора-тадбирлари тўғрисида»ги ПҚ-174-сон <a href="https://lex.uz/docs/6487227">қарори</a> қуйидаги мазмундаги 9<sup>1</sup>-банд билан тўлдирилсин:</div></div><div class="ACT_TEXT"><div name="7850845" id="7850845">«9<sup>1</sup>. Белгилансинки, Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университетининг халқаро ҳамкорлик ва алоқалар бўлими бошлиғи, режа-молия бўлими бошлиғи, бош аудитор, бош ҳисобчи лавозим маошлари олий таълим муассасасининг факультет декани базавий лавозим маошига, бошқа бўлим бошлиқлари, марказ ва дирекция раҳбарлари, катта юрисконсульт, матбуот котиби, илмий кенгаш котиби ва университет кенгаши котиби лавозим маошлари олий таълим муассасасининг факультет декани ўринбосари базавий лавозим маошига, бўлим бошлиғи ўринбосарлари, бош ҳисобчи ўринбосари, бош энергетик, бош муҳандис лавозим маошлари олий таълим муассасасининг катта ўқитувчи базавий лавозим маошига, бош мутахассис, бош иқтисодчи, психолог, олий маълумотли етакчи мутахассис, услубчи, илмий-тадқиқот ишлари бўйича муҳандис, кабинет мудири, бухгалтер, иқтисодчи ва кутубхоначи лавозим маошлари олий таълим муассасасининг ўқитувчи-стажёри базавий лавозим маошига тенглаштирилади».</div></div><div class="ACT_TEXT"><div name="7850846" id="7850846">9. Ўзбекистон Республикаси Президентининг 2023 йил 27 июлдаги «Туризм йўналишидаги ислоҳотларни янада жадаллаштириш ва соҳада давлат бошқаруви тизимини самарали ташкил қилиш чора-тадбирлари тўғрисида»ги ПҚ-238-сон қарори 2-бандининг <a href="https://lex.uz/docs/6549286?ONDATE=29.07.2023 00#6550303">«а» кичик банди</a> қуйидаги таҳрирда баён этилсин:</div></div><div class="ACT_TEXT"><div name="7850847" id="7850847">«а) 3 юлдузли тоифа учун 60 та хонадан кам бўлмаган, 4 ва 5 юлдузли тоифа учун 120 та хонадан кам бўлмаган хоналар фондига эга беш қаватдан паст бўлмаган меҳмонхона 2026 йил 31 декабрга қадар фойдаланишга топширилган тақдирда, меҳмонхона тоифаси тасдиқлангач, инвесторларнинг янги меҳмонхонани қуриш (реконструкция қилиш бундан мустасно) ва жиҳозлаш ҳамда 2026 йил 1 январдан бошлаб меҳмонхонани қўшимча бино ва иншоотлар қуриш орқали кенгайтириш ёки мавжуд бино ва иншоотларнинг ихтисослашишини меҳмонхона фаолиятига ўзгартириш учун кетган харажатларининг бир қисмини Ўзбекистон Республикаси Давлат бюджети маблағлари ҳисобидан қуйидаги миқдорларда қоплаб бериш тизими жорий қилинсин:</div></div><div class="ACT_TEXT"><div name="7850848" id="7850848">3 юлдузли тоифага эга меҳмонхоналардаги ҳар бир хона учун 40 миллион сўм;</div></div><div class="ACT_TEXT"><div name="7850849" id="7850849">4 ва 5 юлдузли тоифага эга меҳмонхоналардаги ҳар бир хона учун 65 миллион сўм.</div></div><div class="ACT_TEXT"><div name="7850850" id="7850850">Бунда республика бўйича тоифали (юлдузли) меҳмонхоналар мавжуд бўлмаган туман (шаҳар)ларда янгидан қуриладиган меҳмонхоналарга, мазкур харажатлар қуйидаги тартиб асосида 50 фоизга оширилган миқдорда қоплаб берилиши белгилансин:</div></div><div class="ACT_TEXT"><div name="7850851" id="7850851">дастлабки 2 та 4 ёки 5 юлдузли тоифага эга меҳмонхоналарга;</div></div><div class="ACT_TEXT"><div name="7850852" id="7850852">дастлабки 3 та 3 юлдузли тоифага эга меҳмонхоналарга;</div></div><div class="ACT_TEXT"><div name="7850853" id="7850853">Белгилансинки қаватлар сони билан боғлиқ талаблар ЮНЕСКОнинг Умумжаҳон маданий мероси рўйхатига киритилган ҳудудларда ёки тоғли ва тоғолди ҳудудларда янги қурилган меҳмонхоналарга татбиқ этилмайди».</div></div><div class="ACT_TEXT"><div name="7850854" id="7850854">10. Ўзбекистон Республикаси Президентининг 2025 йил 24 мартдаги «Тошкент шаҳри, Тошкент ва Андижон вилоятларида қаттиқ маиший чиқиндиларни ёқиш орқали электр энергияси ишлаб чиқариш» инвестиция лойиҳасини амалга ошириш чора-тадбирлари тўғрисида»ги ПҚ-116-сон қарорининг <a href="https://lex.uz/docs/7444387?ONDATE=25.03.2025 00#7445270">8-банди</a> қуйидаги мазмундаги «г» кичик банд билан тўлдирилсин:</div></div><div class="ACT_TEXT"><div name="7850855" id="7850855">«(г) Инвесторга барча солиқлар ва йиғимлар тўланган ҳолда, инвестиция лойиҳасини молиялаштириш доирасида қуйидаги ҳуқуқлар берилади:</div></div><div class="ACT_TEXT"><div name="7850856" id="7850856">кредит олиш, чет эл валютасида маблағлар олиш ва улардан фойдаланиш (шу жумладан, чет эл валютасида кредит тушумлари) учун чет элдаги хорижий банкларда банк ҳисобварақлари очиш;</div></div><div class="ACT_TEXT"><div name="7850858" id="7850858">Ўзбекистон Республикасидан ташқарида бўлган хорижий пудрат ташкилотлари, етказиб берувчилар ёки хорижий кредиторларга тўловларни Ўзбекистон Республикасидаги банк ҳисобварақлари орқали ўтказмасдан, тўғридан-тўғри амалга ошириш».</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="7850665" id="7850665">(Қонунчилик маълумотлари миллий базаси, 19.11.2025 й., 06/25/217/1060-сон)</div></div></div>
</div></body></html>