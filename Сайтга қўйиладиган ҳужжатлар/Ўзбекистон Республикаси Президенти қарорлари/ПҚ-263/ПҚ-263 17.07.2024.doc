			<p align="center" style="text-align:center"></p>
			</td>
			<td style="border-bottom:none;width:1%;padding:0cm 4px 0cm 4px;height:19px;border-top:none;border-right:1px solid black;border-left:none">
			<p align="center" style="text-align:center"></p>
			</td>
		</tr>
