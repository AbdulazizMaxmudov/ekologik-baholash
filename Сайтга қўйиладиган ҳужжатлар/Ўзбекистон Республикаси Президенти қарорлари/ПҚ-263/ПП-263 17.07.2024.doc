ily:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="7026165" id="7026165">Постановление</div></div><div class="ACCEPTING_BODY"><div name="7026166" id="7026166">Президента Республики Узбекистан</div></div><div class="ACT_TITLE"><div name="7026167" id="7026167">О мерах по реализации инвестиционного проекта «Производство альтернативной тепловой энергии из медицинских отходов»</div></div><div class="BY_DEFAULT"><div name="7026169" id="7026169"></div></div><div class="ACT_TEXT"><div name="7026171" id="7026171">В целях улучшения экологической обстановки в стране, снижения негативного воздействия отходов, в том числе медицинских, на окружающую среду и здоровье населения, а также внедрения современных решений и технологий в сфере их переработки:</div></div><div class="ACT_TEXT"><div name="7026173" id="7026173">1. Принять к сведению, что:</div></div><div class="ACT_TEXT"><div name="7026176" id="7026176">а) в рамках инвестиционного проекта «Производство альтернативной тепловой энергии из медицинских отходов» (далее — Инвестиционный проект) компанией «Sayar LLC» (Соединенные Штаты Америки) (далее — Инвестор) учреждено иностранное предприятие «Sayar green» в форме общества с ограниченной ответственностью (далее — Проектная компания);</div></div><div class="ACT_TEXT"><div name="7026178" id="7026178">б) между Инвестором, Проектной компанией и Правительством Республики Узбекистан в лице Министерства инвестиций, промышленности и торговли Республики Узбекистан 13 апреля 2024 года подписан инвестиционный договор, в соответствии с которым Инвестор и Проектная компания принимают обязательства:</div></div><div class="ACT_TEXT"><div name="7026182" id="7026182">привлечения на первом этапе в течение 2024-2025 годов прямых инвестиций в размере 7 миллионов долларов США, ежегодной термической переработки 6 тысяч тонн медицинских отходов, образующихся в медицинских учреждениях всех типов в городе Ташкенте, Самаркандской и Бухарской областях, а также запуска устройств мощностью 20 ГВт час/год;</div></div><div class="ACT_TEXT"><div name="7026184" id="7026184">привлечения на втором этапе в течение 2026 — 2030 годов прямых инвестиций в размере 108 миллионов долларов США, ежегодной термической переработки 90 тысяч тонн медицинских отходов, образующихся в медицинских учреждениях всех типов, расположенных в остальных регионах республики, а также запуска устройств мощностью 300 ГВт час/год;</div></div><div class="ACT_TEXT"><div name="7026185" id="7026185">исходя из предложений Инвестора организации соответствующих полигонов бытовых отходов в специально отводимых местах Министерства экологии, охраны окружающей среды и изменения климата (далее — Министерства экологии) и центров высокотемпературной термической переработки фармацевтических, биологических, ветеринарных отходов.</div></div><div class="ACT_TEXT"><div name="7026186" id="7026186">2. Утвердить Инвестиционный договор, заключенный между Правительством Республики Узбекистан в лице Министерства инвестиций, промышленности и торговли, Инвестором и Проектной компанией в рамках реализации Инвестиционного проекта.</div></div><div class="ACT_TEXT"><div name="7026189" id="7026189">3. Министерству здравоохранения совместно с Проектной компанией в месячный срок обеспечить заключение договора, предусматривающего:</div></div><div class="ACT_TEXT"><div name="7026191" id="7026191">полную поставку Проектной компании медицинских отходов, образующихся в медицинских учреждениях всех типов, расположенных в регионах реализации Инвестиционного проекта;</div></div><div class="ACT_TEXT"><div name="7026192" id="7026192">закупку государственными медицинскими учреждениями, в которых реализуется Инвестиционный проект, тепловой энергии, произведенной за счет термической переработки медицинских отходов;</div></div><div class="ACT_TEXT"><div name="7026194" id="7026194">передача на безвозмездной основе отечественным партнерским организациям оборудования, устройств и инвентаря, закупленного в рамках данного проекта, с согласованием с соответствующими республиканскими органами исполнительной власти после завершения срока реализации Инвестиционного проекта.</div></div><div class="ACT_TEXT"><div name="7026195" id="7026195">4. Установить, что с 1 августа 2024 года:</div></div><div class="ACT_TEXT"><div name="7026196" id="7026196">а) Министерством здравоохранения:</div></div><div class="ACT_TEXT"><div name="7026197" id="7026197">медицинские отходы, образующиеся в медицинских учреждениях всех типов, передаются Проектной компании в полном объеме для производства альтернативной тепловой энергии из медицинских отходов;</div></div><div class="ACT_TEXT"><div name="7026198" id="7026198">Проектной компании в срок до 2048 года обеспечивается передача в аренду земельных площадей на территории государственных медицинских учреждений, на которых реализуется Инвестиционный проект, для строительства устройств и сооружений термической переработки медицинских отходов и производства тепловой энергии для общественных нужд. При этом арендная плата за земельные участки рассчитывается в размере, приравненном земельному налогу;</div></div><div class="ACT_TEXT"><div name="7026199" id="7026199">обеспечивается закупка медицинскими учреждениями тепловой энергии, произведенной Проектной компанией, по тарифам, утвержденным в установленном порядке. При этом поставка тепловой энергии другим лицам может также осуществляться в установленном порядке;</div></div><div class="ACT_TEXT"><div name="7026201" id="7026201">б) несоблюдение требования полной поставки Проектной компании медицинских отходов, образующихся в медицинских учреждениях всех типов, расположенных в регионах реализации Инвестиционного проекта, считается нарушением требований санитарного благополучия и охраны природы в период сбора, транспортировки, размещения, обеззараживания, хранения, утилизации, переработки и реализации отходов.</div></div><div class="ACT_TEXT"><div name="7026202" id="7026202">5. Совету Министров Республики Каракалпакстан, хокимиятам областей и города Ташкента, Министерству здравоохранения, Министерству экономики и финансов совместно с Проектной компанией начиная с 1 сентября 2024 года внедрить согласно схеме, определенной приложением<a href="https://lex.uz/ru/docs/7025253#7026206">*</a> к настоящему постановлению, ежегодную практику пересмотра новых цен (тарифов) регулирования услуг теплового снабжения, оказываемых Проектной компанией, до утверждения параметров республиканского и местного бюджетов.</div></div><div class="FOOTNOTE"><div name="7026206" id="7026206">*Приложение приводится на <a href="https://lex.uz/ru/docs/7025206#7026136">узбекском языке</a>.</div></div><div class="ACT_TEXT"><div name="7026207" id="7026207">6. Министерству здравоохранения:</div></div><div class="ACT_TEXT"><div name="7026208" id="7026208">в двухмесячный срок совместно с Министерством экологии разработать и внести в установленном порядке в Кабинет Министров проект нормативно-правового акта, предусматривающего определение норм образования и морфологического состава медицинских отходов в медицинских учреждениях всех типов, а также включение требований по сдаче их предприятиям по утилизации в требования лицензирования медицинской деятельности;</div></div><div class="ACT_TEXT"><div name="7026209" id="7026209">в двухнедельный срок обеспечить передачу Проектной компании на основе арендны соответствующих мест на территории государственных медицинских учреждений, в которых реализуется Инвестиционный проект.</div></div><div class="ACT_TEXT"><div name="7026210" id="7026210">7. Разрешить Проектной компании выполнение строительно-монтажных работ параллельно с проектированием при соблюдении градостроительных норм и правил, определенных в рамках Инвестиционного проекта.</div></div><div class="ACT_TEXT"><div name="7026212" id="7026212">8. Министерству экономики и финансов совместно с Министерством здравоохранения начиная с 1 сентября 2024 года обеспечивать ежегодное предусмотрение в параметрах Государственного бюджета средств, уплачиваемых за полную поставку Проектной компании медицинских отходов, образующихся в медицинских учреждениях, и закупку государственными медицинскими учреждениями тепловой энергии.</div></div><div class="ACT_TEXT"><div name="7026214" id="7026214">9. В рамках Инвестиционного проекта обеспечить:</div></div><div class="ACT_TEXT"><div name="7026216" id="7026216">Министерству иностранных дел — оформление в установленном порядке въездных виз для привлекаемых зарубежных специалистов, при необходимости в международном аэропорту «Ташкент» имени Ислама Каримова;</div></div><div class="BY_DEFAULT"><div name="8280502" id="8280502"></div></div><div class="ACT_TEXT"><div name="8280503" id="8280503">Министерству внутренних дел — продление срока многоразовых виз зарубежным специалистам Проектной компании и привлекаемых подрядных организаций, и членам их семей, а также их регистрацию по месту  пребывания и продление ее срока;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="8280504" id="8280504">(абзац третий пункта 9 в редакции <a href="https://lex.uz/ru/docs/8260750?ONDATE=10.06.2026 00#8262100">Указа </a>Президента Республики Узбекистан от 9 июня 2026 года № УП-109 — Национальная база данных законодательства, 10.06.2026 г., № 06/26/109/0580)</div></div><div class="ACT_TEXT"><div name="7026219" id="7026219">Министерству занятости и сокращения бедности — по заявкам Проектной компании в установленном порядке выдачу (продление) привлеченным зарубежным специалистам подтверждений на право трудовой деятельности на территории Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="7026220" id="7026220">10. Предоставить Правительственной комиссии по вопросам развития и технического регулирования внешней торговли, инвестиций, отечественной промышленности право вносить при необходимости изменения и дополнения в целевые показатели и технико-экономические параметры Инвестиционного проекта по согласованию с Инвестором.</div></div><div class="ACT_TEXT"><div name="7026223" id="7026223">11. Возложить на министра экологии, охраны окружающей среды и изменения климата А.А. Абдухакимова и исполняющего обязанности министра здравоохранения А.А. Худоярова персональную ответственность за эффективную организацию исполнения настоящего постановления.</div></div><div class="ACT_TEXT"><div name="7026226" id="7026226">Обсуждение хода исполнения настоящего постановления, осуществление координации и контроля за деятельностью ответственных организаций возложить на Премьер-министра Республики Узбекистан А.Н. Арипова.</div></div><div class="SIGNATURE"><div name="7026227" id="7026227">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7026228" id="7026228">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7026232" id="7026232">17 июля 2024 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="7026233" id="7026233">№ ПП-263</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="7026168" id="7026168">(Национальная база данных законодательства, 18.07.2024 г., №07/24/263/0527; 10.06.2026 г., № 06/26/109/0580)</div></div></div>
</div></body></html>