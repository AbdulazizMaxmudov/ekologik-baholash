<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Cyrl-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="6482678" id="6482678">Ўзбекистон Республикаси Президентининг</div></div><div class="ACT_FORM"><div name="6482679" id="6482679">Қарори</div></div><div class="ACT_TITLE"><div name="6482680" id="6482680">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги фаолиятини самарали ташкил этиш чора-тадбирлари тўғрисида</div></div><div class="BY_DEFAULT"><div name="6482682" id="6482682"></div></div><div class="ACT_TEXT"><div name="6482683" id="6482683">Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги «Экология ва атроф-муҳитни муҳофаза қилиш соҳасини трансформация қилиш ва ваколатли давлат органи фаолиятини ташкил этиш чора-тадбирлари тўғрисида»ги ПФ-81-сон <a href="https://lex.uz/docs/6479180">Фармонига</a> мувофиқ:</div></div><div class="ACT_TEXT"><div name="6482684" id="6482684">1. Қуйидагилар:</div></div><div class="ACT_TEXT"><div name="6482685" id="6482685">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги фаолиятининг устувор йўналишлари <a href="https://lex.uz/docs/6479134#6482842">1-иловага </a>мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482686" id="6482686">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги тизимига ўтказилаётган ташкилотлар фаолиятини ташкил қилиш жадвали <a href="https://lex.uz/docs/6479134#6485232">2-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482687" id="6482687">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги тизимида янги ташкил қилинаётган тузилмалар фаолиятини йўлга қўйиш жадвали <a href="https://lex.uz/docs/6479134#6485237">2а-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482688" id="6482688">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги тизимидаги қайта ташкил қилинаётган тузилмалар фаолиятини йўлга қўйиш жадвали <a href="https://lex.uz/docs/6479134#6485243">2б-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482689" id="6482689">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигининг ташкилий тузилмаси <a href="https://lex.uz/docs/6479134#6485275">3-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482690" id="6482690">Экология ва атроф-муҳитни муҳофаза қилиш соҳасидаги ислоҳотларни чуқурлаштириш ва тизим фаолиятини трансформация қилиш бўйича «йўл харитаси» <a href="https://lex.uz/docs/6479134#6485287">4-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482691" id="6482691">Экология, атроф-муҳит муҳофазаси, ўрмон хўжалиги ва гидрометеорология соҳаларидаги норматив-ҳуқуқий ҳужжатларни ишлаб чиқиш режаси <a href="https://lex.uz/docs/6485299">5-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="6482692" id="6482692">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги (кейинги ўринларда — Вазирлик) томонидан қайта ташкил этилаётган, тугатилаётган, ўзгартирилаётган ва бошқа ташкилотлар тизимига ўтказилаётган ташкилотларга бириктирилган кўчмас мулк объектлари, транспорт воситаларига ва бошқа мол-мулкка бўлган ҳуқуқлар тегишли йиғимлар ва бошқа тўловлар ундирилмаган ҳолда қайта расмийлаштирилсин.</div></div><div class="ACT_TEXT"><div name="6482693" id="6482693">2. Атроф табиий муҳит давлат мониторинги ишларини амалга ошириш учун Вазирлик тузилмасида юридик шахс ташкил этмаган ҳолда Ситуацион марказ ташкил этилсин.</div></div><div class="ACT_TEXT"><div name="6482694" id="6482694">Белгилансинки, гидрометеорологик ахборотни олиш, тўплаш ва тарқатишда замонавий ахборот ҳамда сунъий йўлдош технологияларини жорий этиш учун Вазирликнинг бюджетдан ташқари жамғармасининг ҳар йили 3 фоиздан кўп бўлмаган миқдордаги маблағлари ажратиб борилади.</div></div><div class="BY_DEFAULT"><div name="7056623" id="7056623"></div></div><div class="ACT_TEXT"><div name="7056761" id="7056761">3. Вазирлик ҳузурида Париж битими (Париж, 2015 йил 12 декабрь) доирасида қабул қилинган мажбуриятлар, 2030 йилгача бўлган даврда барқарор ривожланиш соҳасидаги вазифаларни бажаришга масъул бўлган давлат муассасаси шаклидаги Иқлим ўзгариши миллий маркази ташкил этилсин.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7056765" id="7056765">(3-банд Ўзбекистон Республикаси Президентининг 2024 йил 23 июлдаги ПФ-106-сонли <a href="https://lex.uz/docs/7044889?ONDATE=03.08.2024 00#7046429">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 03.08.2024 й., 06/24/106/0571-сон)</div></div><div class="ACT_TEXT"><div name="6482698" id="6482698">4. Вазирликнинг қуйидаги таклифларига розилик берилсин:</div></div><div class="ACT_TEXT"><div name="6482699" id="6482699">а) 2023 йил 1 июлга қадар «Тоза ҳудуд» давлат унитар корхоналари ва ободонлаштириш бошқармаларига тегишли қаттиқ маиший чиқинди полигонлари Вазирлик тасарруфига ўтказилади ҳамда шу билан боғлиқ эгалик ҳуқуқини, шу жумладан, кадастр ҳужжатларини расмийлаштириш бепул амалга оширилади;</div></div><div class="ACT_TEXT"><div name="6482700" id="6482700">б) чиқинди чиқарувчи ташкилотлар бино ва иншоотларни қуриш, реконструкция ва (ёки) монтаж қилиш, таъмирлаш, ободонлаштириш, шунингдек, бузиш ишлари бошланган даврдан бошлаб ушбу тадбирлар тугаллангунга қадар қурилиш чиқиндилари бўйича ҳисоботни белгиланган тартибда кейинги ойнинг 5-санасига қадар Вазирликнинг ҳудудий бўлинмаларига топширади; </div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7056774" id="7056774">(4-банднинг «в» кичик банди Ўзбекистон Республикаси Президентининг 2024 йил 23 июлдаги ПФ-106-сонли <a href="https://lex.uz/docs/7044889?ONDATE=03.08.2024 00#7046580">Фармонига </a>асосан чиқарилган — Қонунчилик маълумотлари миллий базаси, 03.08.2024 й., 06/24/106/0571-сон)</div></div><div class="ACT_TEXT"><div name="6482704" id="6482704">г) 2026 йил 1 августдан бошлаб босқичма-босқич ушбу қарорнинг <a href="https://lex.uz/docs/6479134#6485312">6-7-иловаларида </a>белгиланган товарларга нисбатан фойдаланиш хусусиятини йўқотганидан сўнг атроф-муҳитга зарар етказувчи айрим қадоқлаш материаллари ва товарларни ишлаб чиқарувчи (экспорт қилинадиган товарлар бундан мустасно) ҳамда республика ҳудудига импорт қилувчиларнинг «кенгайтирилган мажбурияти» тизими жорий этилади;</div></div><div class="ACT_TEXT"><div name="6482705" id="6482705">д) 2023 йил 1 июлдан бошлаб қаттиқ маиший чиқиндиларни тўплаш, олиб чиқиб кетиш бўйича аҳолига кўрсатилган хизматлар учун вужудга келган дебитор қарздорликни мажбурий тартибда ундириш учун суд органларига даъво аризалари санитар тозалаш хизматларини кўрсатувчи корхоналар томонидан киритилади.</div></div><div class="ACT_TEXT"><div name="6482706" id="6482706">5. Вазирлик уч ой муддатда Андижон, Бухоро ва Сурхондарё вилоятларида экологик вазиятни яхшилаш, ресурслардан оқилона фойдаланиш ва чиқиндисиз ҳудудга айлантиришга қаратилган норматив-ҳуқуқий ҳужжатлар лойиҳаларини ишлаб чиқсин ва белгиланган тартибда киритсин.</div></div><div class="BY_DEFAULT"><div name="7567264" id="7567264"></div></div><div class="ACT_TEXT"><div name="7567265" id="7567265">6. 2026 йил 1 мартдан бошлаб Бўстонлиқ ва Зомин туманларидаги туристик-рекреацион зоналарда экологик тоза ҳудуд режими татбиқ этилсин.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7567266" id="7567266">(6-банд Ўзбекистон Республикаси Президентининг 2025 йил 30 майдаги ПФ-90-сонли <a href="https://lex.uz/docs/7552003?ONDATE=02.06.2025 00#7554502">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 02.06.2025 й., 06/25/90/0486-сон)</div></div><div class="ACT_TEXT"><div name="6482708" id="6482708">7. Вазирлик Бош прокуратура, бошқа манфаатдор вазирлик ва идоралар билан биргаликда уч ой муддатда қуйидагиларни назарда тутувчи қонун лойиҳасини ишлаб чиқсин ва белгиланган тартибда киритсин:</div></div><div class="ACT_TEXT"><div name="6482709" id="6482709">а) экологик тоза ҳудуд режимини жорий қилиш юзасидан:</div></div><div class="ACT_TEXT"><div name="6482710" id="6482710">бир марталик пластик маҳсулотлар, шу жумладан, стаканлар, пластик найчалар, музқаймоқ таёқчалари, пахта таёқчалари, қадоқлаш плёнкаси ва айрим турдаги полиэтилен пакетларини олиб кириш, сотиш ва ишлаб чиқаришни тақиқлаш;</div></div><div class="ACT_TEXT"><div name="6482711" id="6482711">қишлоқ хўжалигида органик ўғитлардан фойдаланишни рағбатлантириш;</div></div><div class="ACT_TEXT"><div name="6482714" id="6482714">фаолияти натижасида оқова сув ҳосил қилувчи хўжалик юритувчи субъектларни марказлаштирилган оқова сув тизимига улаш ёки муқобил тозалаш ускуналари билан жиҳозлаш мажбуриятини киритиш. Бунда, ушбу мажбуриятни бажармаган жисмоний шахсларга нисбатан базавий ҳисоблаш миқдорининг 50 бараваридан 100 бараваригача, юридик шахсларга нисбатан — базавий ҳисоблаш миқдорининг 100 бараваридан 300 бараваригача бўлган миқдорда молиявий жарималар қўллаш;</div></div><div class="ACT_TEXT"><div name="6482717" id="6482717">автотранспорт воситалари билан кириш учун экологик йиғим ундириш, бундан электромобиллар, махсус транспорт воситалари ва экологик тоза ҳудуд режими жорий қилинган ҳудудда яшовчи фуқароларнинг автотранспорт воситалари мустасно;</div></div><div class="ACT_TEXT"><div name="6482718" id="6482718">экологик тоза ҳудуд режими татбиқ этиладиган ҳудудларнинг ташкил этилиши ҳамда бошқа шартлари ва талабларини белгилаш;</div></div><div class="ACT_TEXT"><div name="6482720" id="6482720">б) республика ҳудудида қалинлиги 100 микрондан кам бўлган полимер плёнкали пакетларни (юқори зичликдаги полиэтилен (НDPE), ўрта зичликдаги полиэтилен (MDPE), паст зичликдаги полиэтилен (LDPE), ўрамли паст зичликдаги полиэтилен (LLDPE), кўп қаватли полиэтилен (COEX) ишлаб чиқариш ва реализация қилишни тақиқлаш юзасидан. Бунда:</div></div><div class="ACT_TEXT"><div name="6482725" id="6482725">ушбу тартиб экспорт учун ишлаб чиқариладиган, тутқичсиз ва товарларнинг ажралмас қисми ҳисобланган, хўжаликда фойдаланиш учун рулонларда сотиладиган полимер плёнкали пакетлар, шунингдек, биологик чирийдиган полимер материаллардан тайёрланган пакетларга татбиқ этилмайди;</div></div><div class="ACT_TEXT"><div name="6482727" id="6482727">мазкур кичик банд талабларини бузиш табиий муҳитга зарарли таъсир кўрсатиш оқибатларини бартараф этиш чораларини кўрмаганлик сифатида баҳоланади ҳамда маъмурий жавобгарликка тортишга сабаб бўлади. Бунда чиқиндиларнинг атроф-муҳитга зарари миқдори табиий муҳитга етказилган зарарни ҳисоблаш тартиби асосида аниқланади;</div></div><div class="ACT_TEXT"><div name="6482728" id="6482728">в) республикада сув, ер ресурслари ва ер ости бойликларини муҳофаза қилиш мақсадида Тошкент шаҳар ва вилоят марказларида сув айланма тизими мавжуд бўлмаган автомобиль ювиш шохобчалари фаолиятини ҳамда янги автомобиль ювиш янги шохобчаларини ташкил этишни тақиқлаш.</div></div><div class="ACT_TEXT"><div name="6482733" id="6482733">8. Белгилаб қўйилсинки, 2023 йил 1 июлдан бошлаб:</div></div><div class="ACT_TEXT"><div name="6482734" id="6482734">Вазирликнинг бюджетдан ташқари жамғармаси маблағлари <a href="https://lex.uz/docs/6479134#6485342">8-иловада</a> белгиланган манбалардан шакллантирилади;</div></div><div class="BY_DEFAULT"><div name="6737922" id="6737922"></div></div><div class="ACT_TEXT"><div name="6737925" id="6737925">транспорт воситаларини «эркин муомалага чиқариш (импорт)» божхона режимида расмийлаштирадиган жисмоний ва юридик шахслар томонидан тўланадиган утилизация йиғимининг 3 фоизи Вазирликнинг бюджетдан ташқари жамғармасига йўналтирилади.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6737943" id="6737943">(8-банднинг учинчи хатбошиси Ўзбекистон Республикаси Президентининг 2023 йил 29 декабрдаги ПҚ-422-сонли <a href="https://lex.uz/docs/6721144?ONDATE=01.01.2024 00#6724417">қарори </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 29.12.2023 й., 07/23/422/0994-сон — 2024 йил 1 январдан кучга киради)</div></div><div class="BY_DEFAULT"><div name="6737948" id="6737948"></div></div><div class="ACT_TEXT"><div name="6737955" id="6737955">2024 йил 1 июлдан бошлаб пневматик резина шиналар ва покришкалар учун утилизация йиғимининг 10 фоизи Вазирликнинг бюджетдан ташқари жамғармасига йўналтирилади.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6737968" id="6737968">(8-банд Ўзбекистон Ўзбекистон Республикаси Президентининг 2023 йил 29 декабрдаги ПҚ-422-сон <a href="https://lex.uz/docs/6721144?ONDATE=01.01.2024 00#6724422">қарорига</a> <a href="https://lex.uz/docs/6721144"> </a>асосан тўртинчи хатбоши билан тўлдирилган — Қонунчилик маълумотлари миллий базаси, 29.12.2023 й., 07/23/422/0994-сон — 2024 йил 1 январдан кучга киради)</div></div><div class="ACT_TEXT"><div name="6482738" id="6482738">9. Мамлакатимиз аҳолисининг орасида экологик онг ва экологик маданият тўғрисидаги тушунчаларни мустаҳкамлаш ва ривожлантириш мақсадида экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши масалаларига бағишланган муҳим саналар бўйича тадбирлар <a href="https://lex.uz/docs/6479134#6485353">9-иловага</a> мувофиқ календарь режа асосида республика бўйлаб юқори савияда ташкил этилсин.</div></div><div class="ACT_TEXT"><div name="6482740" id="6482740">Белгилансинки, ушбу тадбирларни ўтказишга тегишли республика ва маҳаллий ижро этувчи ҳокимият органларининг биринчи раҳбарлари шахсан масъул ҳисобланади.</div></div><div class="ACT_TEXT"><div name="6482741" id="6482741">10. Вазирлик <a href="https://lex.uz/docs/6479134#6485362">10-иловага</a> мувофиқ халқаро шартномалар ва халқаро ташкилотлар билан ўзаро ҳамкорлик қилиш ва мувофиқлаштириш бўйича ваколатли орган этиб белгилансин.</div></div><div class="ACT_TEXT"><div name="6482743" id="6482743">11. Экология, атроф-муҳитни муҳофаза қилиш, ўрмон хўжалиги ва гидрометеорология соҳаларида амалга ошириладиган истиқболли беғараз кўмак (грант) лойиҳалари рўйхати <a href="https://lex.uz/docs/6479134#6485372">11-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="6482744" id="6482744">Бунда, қўшимча келишувларсиз экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирига ҳамда унинг ўринбосарларига ушбу халқаро тадбирларда иштирок этишга рухсат берилади.</div></div><div class="ACT_TEXT"><div name="6482745" id="6482745">12. Қуйидагилар:</div></div><div class="ACT_TEXT"><div name="6482748" id="6482748">2023 — 2025 йилларда экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши соҳаларидаги тизимли равишда ўтказиладиган халқаро конференциялар, ассамблеялар ва тадбирлар рўйхати <a href="https://lex.uz/docs/6479134#6485381">12-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482750" id="6482750">Экология, атроф-муҳитни муҳофаза қилиш, ўрмон хўжалиги ва гидрометеорология соҳаларида тўғридан-тўғри инвестициялар ҳамда халқаро молия институтларининг кредитлари ҳисобидан молиялаштириладиган истиқболли лойиҳалар <a href="https://lex.uz/docs/6479134#6485394">12а-иловага</a> мувофиқ;</div></div><div class="ACT_TEXT"><div name="6482751" id="6482751">Экология, атроф-муҳитни муҳофаза қилиш, ўрмон хўжалиги ва гидрометеорология соҳаларида амалга ошириш тавсия қилинадиган инновацион бизнес ғоя ва стартап лойиҳалари рўйхати <a href="https://lex.uz/docs/6479134#6485404">12б-иловага</a> мувофиқ тасдиқлансин.</div></div><div class="ACT_TEXT"><div name="6482753" id="6482753">13. Вазирлик 2023 йил 1 июлга қадар умумий овқатланиш соҳасида озиқ-овқат чиқиндилари ҳосил бўлишини камайтириш ва ортиқча исрофгарчиликларнинг олдини олиш ҳамда БМТ Озиқ-овқат ва қишлоқ хўжалиги ташкилоти (ФАО) тавсияларини (Global Initiative on Food Loss and Waste Reduction) жорий этиш мақсадида қуйидагиларни назарда тутувчи «Оқилона истеъмол» дастурини ишлаб чиқиб, Вазирлар Маҳкамасига киритсин:</div></div><div class="ACT_TEXT"><div name="6482755" id="6482755">давлат органлари томонидан ташкил этиладиган тадбирларда озиқ-овқат истеъмолининг оқилона меъёрини белгилаш, ортиқча истеъмолни камайтириш, шу жумладан, бир шахсга бир марталик овқатланиш миқдорини белгилаш;</div></div><div class="ACT_TEXT"><div name="6482756" id="6482756">умумий овқатланиш соҳасида хўжалик юритувчи субъектлар ва истеъмолчиларнинг озиқ-овқат маҳсулотларига нисбатан масъулиятини ошириш;</div></div><div class="ACT_TEXT"><div name="6482758" id="6482758">аҳоли ўртасида тўғри овқатланиш одатларини шакллантириш ва ортиқча исрофгарчиликнинг олдини олиш ҳамда меъёридан ортиқ истеъмолни тарғиб қилишни чеклаш;</div></div><div class="ACT_TEXT"><div name="6482761" id="6482761">исрофгарчиликка йўл қўйган шахсларга нисбатан молиявий чоралар кўриш ва назорат механизмларини ўрнатиш.</div></div><div class="ACT_TEXT"><div name="6482765" id="6482765">14. Вазирлик Иқтисодиёт ва молия вазирлиги ҳамда Рақамли технологиялар вазирлиги билан биргаликда давлат органлари ва ташкилотларида қоғоздан фойдаланишни кескин камайтириш, айрим йўналишларда фаолиятни тўлиқ рақамлаштириш орқали қоғоздан тўлиқ воз кечиш бўйича назорат ўрнатишга масъул этиб белгилансин.</div></div><div class="ACT_TEXT"><div name="6482767" id="6482767">15. Вазирлик Қорақалпоғистон Республикаси Вазирлар Кенгаши, вилоятлар ва Тошкент шаҳри ҳокимликлари ҳамда Ички ишлар вазирлиги билан биргаликда волонтёрларни жалб қилган ҳолда 2023 йил 1 июлдан бошлаб бир ой давомида ҳудудларда дарахтларнинг илдиз тизимларини бетон ва асфальт қопламаларидан, уларни турли чироқ мосламаларидан, реклама баннери ва шитларидан бўшатишга қаратилган «Дарахтга нафас беринг» оммавий тадбирини ўтказсин.</div></div><div class="ACT_TEXT"><div name="6482769" id="6482769">Ахборот ва оммавий коммуникациялар агентлиги, Ўзбекистон Миллий телерадиокомпанияси, Ўзбекистон Миллий ахборот агентлиги Вазирлик билан биргаликда доимий равишда аҳоли ўртасида дарахтларга бундай зарар етказиш тегишли жавобгарликка тортишга асос бўлиши тўғрисидаги ижтимоий роликлар ва оммавий ахборот воситаларида чиқишлар орқали тушунтириш ишларини кучайтирсин. </div></div><div class="ACT_TEXT"><div name="6482771" id="6482771">16. Инвестициялар, саноат ва савдо вазирлиги Вазирлик билан биргаликда:</div></div><div class="ACT_TEXT"><div name="6482773" id="6482773">экология, ўрмон хўжалиги ва гидрометеорология соҳаларига 2023 йилда 20 млн АҚШ доллари, 2024 йилдан бошлаб ҳар йили 100 миллион АҚШ доллари миқдоридан кам бўлмаган хорижий инвестицияларни жалб қилсин. Бунда, Инвестициялар, саноат ва савдо вазирлигидан тегишли ходим Вазирликка амалий ёрдам бериш учун бириктирилади;</div></div><div class="ACT_TEXT"><div name="6482775" id="6482775">чанг-газ тозалаш ускуналари, локал сув тозалаш иншоотлари ва автоматик мониторинг тизимларини ўрнатиш учун хўжалик юритувчи субъектларга халқаро молиявий институтларнинг маблағлари ҳисобидан тижорат банклари орқали 100 млн АҚШ доллари миқдорида кредит линияси очилишини таъминласин.</div></div><div class="ACT_TEXT"><div name="6482777" id="6482777">17. Вазирлик бир ой муддатда 2022 — 2026 йилларда Оролбўйи минтақасини барқарор ривожлантириш, инновациялар ва яшил технологияларни кенг жорий этиш бўйича қуйидаги асосий йўналишларни белгилашни назарда тутувчи миллий дастур бўйича ахборот киритсин:</div></div><div class="ACT_TEXT"><div name="6482778" id="6482778">яшил қопламалар — ҳимоя ўрмонзорларини барпо этишни изчил давом эттириш ҳамда муҳофаза этиладиган табиий ҳудудларни тизимли ривожлантириш;</div></div><div class="ACT_TEXT"><div name="6482779" id="6482779">илмий ва инновацион фаолият учун замонавий инфратузилмани яратиш, илм-фан ва ишлаб чиқариш интеграциясини мустаҳкамлаш;</div></div><div class="ACT_TEXT"><div name="6482780" id="6482780">қишлоқ хўжалиги маҳсулотларини етиштириш, қайта ишлаш ва бошқа турдаги ишлаб чиқариш тармоқларини ривожлантириш, қайта тикланувчи ва муқобил энергия манбаларидан фойдаланиш;</div></div><div class="ACT_TEXT"><div name="6482782" id="6482782">аҳоли саломатлигини тиклаш, экологик туризмни ривожлантириш имкониятларини кенгайтириш;</div></div><div class="ACT_TEXT"><div name="6482783" id="6482783">донор мамлакатлар, халқаро ташкилотлар, молия институтлари, жамғармалар ва компаниялар маблағларини кенг жалб қилиш бўйича халқаро алоқаларни янада кучайтириш.</div></div><div class="ACT_TEXT"><div name="6482784" id="6482784">18. Вазирлик марказий аппарати ва унинг тизимидаги ташкилотларни юқори малакали ва рақобатбардош кадрлар билан тўлдириш ҳамда кадрлар қўнимсизлигининг олдини олиш мақсадида:</div></div><div class="ACT_TEXT"><div name="6482785" id="6482785">а) 2023 йил 1 июлдан бошлаб бюджетдан ташқари ҳамда иш ҳақи фонди доирасида бюджет маблағлари ҳисобидан:</div></div><div class="ACT_TEXT"><div name="6482786" id="6482786">халқаро рейтинг ташкилотларининг биринчи 500 талик рўйхатига кирган хорижий олий таълим ташкилотларини тамомлаган (нострификация бўлган дипломга эга) шахсларга — лавозим маошининг 30 фоизи;</div></div><div class="ACT_TEXT"><div name="6482787" id="6482787">илмий даражага (PhD, DSc) (тизимдаги илм-фан ва таълим соҳасидаги ташкилот ходимлари бундан мустасно) эга шахсларга — лавозим маошининг 60 фоизигача (PhD — 30 фоиз, DSc — 60 фоиз) миқдорида қўшимча устама тўлансин;</div></div><div class="ACT_TEXT"><div name="6482788" id="6482788">б) 2023 йил 1 июлдан бошлаб муҳофаза этиладиган табиий ҳудудлар илмий ходимларига, шунингдек, Доривор ўсимликларни етиштириш ва қайта ишлаш илмий-ишлаб чиқариш маркази илмий ходимларига Фанлар академияси илмий ташкилотларининг тегишли лавозимлари учун белгиланган меҳнатга ҳақ тўлаш миқдорлари ва шартлари татбиқ этилсин;</div></div><div class="ACT_TEXT"><div name="6482789" id="6482789">в) Вазирлик, Қорақалпоғистон Республикаси Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги ҳамда ҳудудий бошқармалари ходимларига чегара ҳудудларига кириш ҳуқуқини берувчи махсус гувоҳнома (давлат белгиси ва муҳрига эга бўлган — жетон ва ID карта) берилади.</div></div><div class="ACT_TEXT"><div name="6482790" id="6482790">Бунда, Давлат хавфсизлик хизмати ҳамда Иқтисодиёт ва молия вазирлиги ҳузуридаги Божхона қўмитаси махсус гувоҳномага эга бўлган Вазирлик тизимидаги ходимларнинг республика чегара ҳудудларига эркин кириб чиқишини таъминласин.</div></div><div class="BY_DEFAULT"><div name="6482792" id="6482792"></div></div><div class="BY_DEFAULT"><div name="7056777" id="7056777"></div></div><div class="ACT_TEXT"><div name="7056779" id="7056779">19. 2025 йил 1 июлдан бошлаб экологик тоза ҳудуд режими жорий қилинган ҳудудлардаги фуқаролар йиғинларига «экомаҳалла», «экоқишлоқ» ва «экоовул» мақоми берилади. Бунда, фуқаролар йиғинига тегишли ҳудудда:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7056783" id="7056783">(19-банднинг биринчи хатбошиси Ўзбекистон Республикаси Президентининг 2024 йил 23 июлдаги ПФ-106-сонли <a href="https://lex.uz/docs/7044889?ONDATE=03.08.2024 00#7046582">Фармони </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 03.08.2024 й., 06/24/106/0571-сон)</div></div><div class="ACT_TEXT"><div name="6482793" id="6482793">электр энергияси қуёш батареяларига алмаштирилади;</div></div><div class="ACT_TEXT"><div name="6482794" id="6482794">йўналишли электробус ҳаракатланиши йўлга қўйилади;</div></div><div class="ACT_TEXT"><div name="6482795" id="6482795">«яшил боғ» ва «яшил жамоат парк»лар ташкил этилади; </div></div><div class="ACT_TEXT"><div name="6482796" id="6482796">савдо шохобчаларида пластик пакетлар савдоси тақиқланади;</div></div><div class="ACT_TEXT"><div name="6482797" id="6482797">маиший чиқиндиларни саралаш, шунингдек, қайта ишланадиган чиқиндиларни қабул қилиш учун фондоматлар ўрнатилади;</div></div><div class="ACT_TEXT"><div name="6482799" id="6482799">«экомаҳалла», «экоқишлоқ» ва «экоовул» мақоми ҳудудда яшовчи фуқаролар розилиги билан Вазирлик томонидан берилади.</div></div><div class="ACT_TEXT"><div name="6482801" id="6482801">20. Ахборот ва оммавий коммуникациялар агентлиги, Ўзбекистон Миллий телерадиокомпанияси, Ўзбекистон Миллий ахборот агентлиги Вазирлик, маҳаллий давлат ҳокимияти органлари билан биргаликда экспертлар ва жамоатчилик вакилларини жалб қилган ҳолда экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши соҳаларида амалга оширилаётган кенг кўламли ислоҳотларнинг мазмуни ва аҳамиятини оммавий ахборот воситаларида кенг ёритиб борсин. Бунда:</div></div><div class="ACT_TEXT"><div name="6482802" id="6482802">а) аҳоли ва кенг жамоатчилик орасида:</div></div><div class="ACT_TEXT"><div name="6482803" id="6482803">атроф-муҳитга зарар етказмаслик, табиат ресурсларидан оқилона фойдаланиш, келажак авлодга экологик муаммолардан холи бўлган шарт-шароит яратиб бериш ҳар бир фуқаронинг бурчи эканлиги;</div></div><div class="ACT_TEXT"><div name="6482804" id="6482804">иқтисодиётнинг саноат, қурилиш, ишлаб чиқариш, хизмат кўрсатиш ва бошқа тармоқларида «яшил» технологияларни қўллаш орқали табиатга етказилаётган зарарни камайтириш имкониятлари;</div></div><div class="ACT_TEXT"><div name="6482805" id="6482805">жамоат транспортининг афзалликлари, шахсий автотранспортдан фойдаланишни камайтириш ва бунинг оқибатида келгусида экологик ҳолатнинг тубдан яхшиланиши;</div></div><div class="ACT_TEXT"><div name="6482806" id="6482806">маиший чиқиндиларни тўғри таснифлаш, саралаш ҳамда иккиламчи хомашё сифатида ажратган ҳолда қайта ишлаш учун топшириш, атроф-муҳит тозалигига ҳар бир фуқаронинг масъул эканлиги;</div></div><div class="ACT_TEXT"><div name="6482807" id="6482807">дарахтларни экиш, парваришлаш ва улар ноқонуний кесилишининг олдини олишга қаратилган амалий тадбирлар, «Яшил макон» умуммиллий лойиҳаси доирасида амалга оширилаётган ишларнинг натижаси;</div></div><div class="ACT_TEXT"><div name="6482808" id="6482808">она табиатга меҳр билан ёндашиш, уни асраб-авайлаш, умумий ва шахсий масъулият ҳиссини уйғотиш ҳамда шакллантиришга доир турли кўрсатув, анжуманлар, давра суҳбатлари кенг ёритиб борилишини таъминлашга;</div></div><div class="ACT_TEXT"><div name="6482809" id="6482809">б) вазирлик ва идораларда «Яшил макон» умуммиллий лойиҳасининг ижроси ва уларнинг қўшаётган амалий ҳиссаси, тадбиркорлик субъектларида сув ресурсларидан оқилона фойдаланиш учун «яшил» технологияларни жорий этиш, маиший, қурилиш ҳамда бошқа турдаги чиқиндиларни камайтириш ва қайта ишлаш орқали бизнеснинг жамият олдидаги ролини кучайтириш юзасидан брифинглар ўтказилишига алоҳида эътибор қаратилсин.</div></div><div class="ACT_TEXT"><div name="6482810" id="6482810">21. Вазирлик мамлакатимизда атроф-муҳитни муҳофаза қилиш, она табиат ресурсларидан самарали ва оқилона фойдаланиш, кундалик ва иш фаолияти давомида уларга зарар етказмаслик зарурлиги, ушбу соҳадаги ҳуқуқбузарликлар учун қўлланиладиган жавобгарлик чораларининг мазмун-моҳиятини акс эттирувчи Ўзбекистоннинг «Экологик бренди»ни яратсин ҳамда қисқа метражли роликлар ва ҳужжатли фильмлар яратиш ишларини ташкил этсин.</div></div><div class="ACT_TEXT"><div name="6482811" id="6482811">Белгилансинки, телерадиоканалларда эфирга узатиладиган мазкур роликлар ижтимоий реклама сифатида таснифланади ҳамда қонунчиликда белгиланган меъёрларга мувофиқ намойиш этилади.</div></div><div class="ACT_TEXT"><div name="6482812" id="6482812">22. Ўзбекистон Республикасининг ягона ташқи экология сиёсатини юритиш, экологик брендини тарғиб қилиш, халқаро ташкилотлар ва хорижий мамлакатлар билан самарали ҳамкорликни ўрнатиш мақсадида мавжуд штат бирликлари доирасида: </div></div><div class="ACT_TEXT"><div name="6482813" id="6482813">Ташқи ишлар вазирлигида 3 та штат бирлигидан иборат бўлган Экологик дипломатия бўлими;</div></div><div class="ACT_TEXT"><div name="6482814" id="6482814">Вазирлик, Сув хўжалиги вазирлиги, Қишлоқ хўжалиги вазирлиги ҳамда Тоғ-кон саноати ва геология вазирлигида 1 — 3 та штат бирлигидан иборат бўлган экологик дипломатияга масъул тузилмалар ташкил қилинсин.</div></div><div class="ACT_TEXT"><div name="6482815" id="6482815">23. Шундай тартиб ўрнатилсинки, унга кўра:</div></div><div class="ACT_TEXT"><div name="6482816" id="6482816">а) 2024 йил 1 январдан бошлаб инвесторларнинг йўловчи ташувчи янги дор йўлларини тегишли хавфсизлик даражасини таъминлаган ҳолда қуриш ва жиҳозлаш учун йўналтирилган харажатларининг бир қисми уларни 2025 йил 31 декабрга қадар фойдаланишга топшириш ва узунлиги бир томонга камида 500 метр бўлиши шарти билан ҳар бир 500 метр йўл учун Ўзбекистон Республикаси Давлат бюджети маблағлари ҳисобидан 1 миллиард сўм миқдорида қопланади. Бунда, йўловчи ташувчи янги дор йўлларини қуриш ва жиҳозлаш бўйича дастлабки 20 та лойиҳага йўналтирилган инвесторлар харажатларининг бир қисми қопланади;</div></div><div class="ACT_TEXT"><div name="6482817" id="6482817">б) 2026 йил 1 январга қадар:</div></div><div class="ACT_TEXT"><div name="6482818" id="6482818">республика ҳудудига олиб кириладиган дор (осма) йўлларни, тоғ-чанғи кўтаргичлар, фуникулёрлар ва бошқа ўхшаш объектлар ва иншоотларни қуриш, қайта таъмирлаш ва жиҳозлаш учун асбоб-ускуналар, механизмлар ва эҳтиёт қисмлар, шунингдек, фондомат, «банжи-жампинг» ва «зиплайн» аттракционлари, «рафтинг» ва «флайбординг» учун ускуналар, фотоовлашда қўлланиладиган жиҳоз ва асбоб-ускуналар, бошқариладиган (дирижабль, ҳаво шари) ва бошқарилмайдиган (эркин учиш) аэростатлар, гондолалар, «buggy car», фаэтон ҳамда электромоторли қайиқ, қорда ҳаракатланишга мўлжалланган махсус транспорт воситалари (ТИФ ТН коди 8703 10) ва квадроцикллар божхона тўловларини тўлашдан (қўшилган қиймат солиғи ва божхона расмийлаштируви учун йиғимидан ташқари) озод қилинади;</div></div><div class="ACT_TEXT"><div name="6482819" id="6482819">тиббиёт чиқиндилари билан боғлиқ ишларни амалга ошириш соҳасида фаолият юритаётган ташкилотлар республикада ишлаб чиқарилмайдиган, ўрнатилган тартибда тасдиқланадиган рўйхатлар асосида олиб кириладиган махсус техника, технологик ускуналар, эҳтиёт қисмлар ва бутловчи буюмлар учун божхона тўловларини тўлашдан (қўшилган қиймат солиғи ва божхона расмийлаштируви йиғимидан ташқари) озод қилинади;</div></div><div class="ACT_TEXT"><div name="6482820" id="6482820">2024 йил 1 январдан бошлаб экоҳудудларда Вазирлик ҳамда Қурилиш ва уй-жой коммунал хўжалиги вазирлигининг намунавий лойиҳалари бўйича санитария-гигиена шохобчаларини қуриш ва уларнинг фаолиятини ташкил этишни амалга оширувчи юридик шахсларга мазкур фаолият тури бўйича юридик шахслар томонидан тўланган фойда солиғи, ер солиғи ва мол-мулк солиғининг 75 фоизи тегишли бюджетлардан қайтариб берилади.</div></div><div class="ACT_TEXT"><div name="6482821" id="6482821">Вазирлик Иқтисодиёт ва молия вазирлиги ҳамда Маданият ва туризм вазирлиги билан биргаликда 2024 йил 1 январга қадар инвесторларнинг йўловчи ташувчи янги дор йўлларини тегишли хавфсизлик даражасини таъминлаган ҳолда қуриш ва жиҳозлаш учун йўналтирилган харажатларининг бир қисмини қоплаб бериш тартибини ишлаб чиқсин.</div></div><div class="ACT_TEXT"><div name="6482822" id="6482822">24. Давлат экологик назорати ва кўрсатилаётган давлат хизматлари сифатини яхшилаш ҳамда коррупциявий хавфларни барвақт аниқлаш ва камайтириш чораларини кўриш мақсадида табиатни муҳофаза қилиш соҳасида «сирли мижоз» институти жорий этилсин.</div></div><div class="ACT_TEXT"><div name="6482823" id="6482823">Вазирлик бир ой муддатда ушбу тизимни жорий этиш чораларини кўрсин.</div></div><div class="ACT_TEXT"><div name="6482824" id="6482824">25. Вазирлик Қурилиш ва уй-жой коммунал хўжалиги вазирлиги, Иқтисодиёт ва молия вазирлиги, Давлат активларини бошқариш агентлиги ва Тошкент шаҳри ҳокимлиги билан биргаликда уч ой муддатда Янги Тошкент ҳудудида Вазирлик ва унинг тизимидаги ташкилотлар, шу жумладан, Марказий Осиё атроф-муҳит ва иқлим ўзгаришини ўрганиш университетини ягона маъмурий мажмуа қурган ҳолда жойлаштиришни назарда тутувчи норматив-ҳуқуқий ҳужжат лойиҳасини киритсин. Бунда:</div></div><div class="ACT_TEXT"><div name="6482825" id="6482825">а) Вазирлик биносининг лойиҳалаштирилиши Экология жамғармаси маблағлари ҳисобидан амалга оширилади;</div></div><div class="ACT_TEXT"><div name="6482826" id="6482826">б) Вазирлик биносини фойдаланишга тайёр ҳолда топшириш билан боғлиқ қурилиш харажатлари қуйидаги манбалар ҳисобидан қопланади:</div></div><div class="ACT_TEXT"><div name="6482827" id="6482827">ижтимоий ва ишлаб чиқариш инфратузилмасини ривожлантириш дастурида белгиланадиган маблағлар;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6750717" id="6750717">(25-банд «б» кичик бандининг учинчи хатбошиси Ўзбекистон Республикаси Президентининг 2024 йил 4 январдаги ПФ-5-сонли <a href="https://lex.uz/docs/6732832?ONDATE=06.01.2024 00#6738399">Фармонига </a>асосан чиқарилган — Қонунчилик маълумотлари миллий базаси, 06.01.2024 й., 06/24/5/0008-сон)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6750718" id="6750718">(25-банд «б» кичик бандининг тўртинчи хатбошиси Ўзбекистон Республикаси Президентининг 2024 йил 4 январдаги ПФ-5-сонли <a href="https://lex.uz/docs/6732832?ONDATE=06.01.2024 00#6738399">Фармонига </a>асосан чиқарилган — Қонунчилик маълумотлари миллий базаси, 06.01.2024 й., 06/24/5/0008-сон)</div></div><div class="ACT_TEXT"><div name="6482830" id="6482830">Экология жамғармаси маблағлари ва қонунчиликда тақиқланмаган бошқа манбалар;</div></div><div class="ACT_TEXT"><div name="6482831" id="6482831">в) Университет ва Ўзбекистон давлат табиат музейи биноларини фойдаланишга тайёр ҳолда топшириш билан боғлиқ қурилиш харажатлари 2024 йилга мўлжалланган Ўзбекистон Республикасининг ижтимоий ва ишлаб чиқариш инфратузилмасини ривожлантириш дастурига киритилган ҳолда молиялаштирилади;</div></div><div class="ACT_TEXT"><div name="6482832" id="6482832">г) мажмуа билан боғлиқ шаҳарсозлик ҳужжатлари Янги Тошкент ҳудудининг бош режаси лойиҳаси доирасида ва у билан тўлиқ уйғунлаштирган ҳолда ишлаб чиқилади;</div></div><div class="ACT_TEXT"><div name="6482833" id="6482833">д) Университет ётоқхонаси биносини фойдаланишга тайёр ҳолда топшириш билан боғлиқ харажатлар давлат-хусусий шериклик шартлари асосида молиялаштирилади; </div></div><div class="ACT_TEXT"><div name="6482834" id="6482834">е) мажмуада «Санъат ва табиат» жамоатчилик маркази, турли галереялар ва экспозициялар ҳамда экомеҳмонхона жойлаштирилади, шунингдек, экологик тоза маҳсулотлар савдосига мўлжалланган савдо дўконлари фаолияти йўлга қўйилади.</div></div><div class="BY_DEFAULT"><div name="6750720" id="6750720"></div></div><div class="ACT_TEXT"><div name="6750721" id="6750721">25<sup>1</sup>. Белгилансинки, Вазирлик ва унинг тизимидаги ташкилотлар биноларини аукцион савдолари орқали сотишдан тушган маблағларнинг 100 фоизи (баҳолаш ва савдога чиқариш харажатларидан ташқари) Экология жамғармасига йўналтирилади.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6750722" id="6750722">(25<sup>1</sup>-банд Ўзбекистон Республикаси Президентининг 2024 йил 4 январдаги ПФ-5-сонли <a href="https://lex.uz/docs/6732832?ONDATE=06.01.2024 00#6738402">Фармонига </a>асосан киритилган — Қонунчилик маълумотлари миллий базаси, 06.01.2024 й., 06/24/5/0008-сон)</div></div><div class="ACT_TEXT"><div name="6482835" id="6482835">26. Вазирлик манфаатдор вазирликлар ва идоралар билан биргаликда икки ой муддатда қонунчилик ҳужжатларига ушбу қарордан келиб чиқадиган ўзгартириш ва қўшимчаларни назарда тутувчи тегишли норматив-ҳуқуқий ҳужжатлар лойиҳаларини Вазирлар Маҳкамасига киритсин.</div></div><div class="ACT_TEXT"><div name="6482836" id="6482836">27. Мазкур қарорнинг ижросини самарали ташкил қилишга масъул ва шахсий жавобгар этиб экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазири белгилансин.</div></div><div class="ACT_TEXT"><div name="6482837" id="6482837">Қарор ижросини муҳокама қилиб бориш, ижро учун масъул идоралар фаолиятини мувофиқлаштириш ва назорат қилиш Ўзбекистон Республикаси Бош вазири А.Н. Арипов зиммасига юклансин.</div></div><div class="SIGNATURE"><div name="6482838" id="6482838">Ўзбекистон Республикаси Президенти Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6482839" id="6482839">Тошкент ш.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6482840" id="6482840">2023 йил 31 май,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="6482841" id="6482841">ПҚ-171-сон</div></div><div class="BY_DEFAULT"><div name="6482842" id="6482842"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="6482843" id="6482843">Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПҚ-171-сон <a href="https://lex.uz/docs/6479134">қарорига</a> <br />1-ИЛОВА </div></div><div class="ACT_TITLE_APPL"><div name="6482950" id="6482950">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги фаолиятининг устувор йўналишлари</div></div><div class="BY_DEFAULT"><div name="6482951" id="6482951"></div></div><div class="ACT_TEXT"><div name="6482952" id="6482952">Қуйидагилар Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги фаолиятининг устувор йўналишлари ҳисобланади:</div></div><div class="ACT_TEXT"><div name="6482953" id="6482953">а) табиатни муҳофаза қилиш, табиий ресурслардан оқилона фойдаланиш, уларни қайта тиклаш, чиқиндилар билан боғлиқ ишларни амалга ошириш ва иқлим ўзгариши соҳасида ягона давлат сиёсатини ишлаб чиқиш ва амалга ошириш;</div></div><div class="ACT_TEXT"><div name="6482954" id="6482954">б) табиатни муҳофаза қилиш, жумладан, атмосфера ҳавоси, ер, ер ости бойликлари, сув, ўрмонлар, муҳофаза этиладиган табиий ҳудудлар, ҳайвонот ва ўсимлик дунёсини муҳофаза қилиш, чиқиндилар билан боғлиқ ишларни амалга оширишда давлат экологик назоратини юритиш;</div></div><div class="ACT_TEXT"><div name="6484489" id="6484489">в) ўрмонларни муҳофаза қилиш, ҳимоя қилиш, кўпайтириш, қайта тиклаш, уларнинг маҳсулдорлигини ошириш ва улардан оқилона фойдаланилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="6484491" id="6484491">г) гидрометеорология хизматини ташкил этиш, иқлим ўзгариши ва атроф табиий муҳит ифлосланиши мониторингини юритиш;</div></div><div class="ACT_TEXT"><div name="6484493" id="6484493">д) табиатни муҳофаза қилиш борасида фуқаролик жамияти институтлари ҳамда жамоатчилик билан ҳамкорликни ривожлантириш, экологик тарбия, тарғибот, таълим ва илмий тадқиқотларни қўллаб-қувватлаш ишларини тизимли ташкил этиш;</div></div><div class="ACT_TEXT"><div name="6484495" id="6484495">е) «яшил» ўсиш тамойилларини жорий этиш, атроф-муҳитга зарарли ташланмаларни қисқартириш ҳамда инсон фаолиятининг табиатга салбий таъсирини камайтириш;</div></div><div class="ACT_TEXT"><div name="6484498" id="6484498">ж) табиатни муҳофаза қилишга рақамли технологияларни жорий этиш, мониторинг юритишда инсон омилини қисқартириш ва автоматлаштириш тизимини йўлга қўйиш;</div></div><div class="ACT_TEXT"><div name="6484501" id="6484501">з) экотуризм, ов ва сафари туризм соҳасини янада ривожлантириш, ўрмон хўжаликлари ва миллий табиат боғларининг (қўриқхонага айлантирилган зоналар бундан мустасно) имкониятларидан самарали фойдаланиш ҳамда тегишли инфратузилма объектларини яратиш, хорижий ва ички сайёҳларга муносиб шарт-шароит яратиш ва уларга хизмат кўрсатилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="6484502" id="6484502">и) табиатни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги қонунчилик талаблари бузилишининг олдини олиш, уни аниқлаш ва унга чек қўйиш учун таъсирчан чораларни қўллаш;</div></div><div class="ACT_TEXT"><div name="6484505" id="6484505">к) атроф-муҳит ҳолатини кузатиб бориш, атроф-муҳитнинг ифлосланишига, табиий ресурслардан нооқилона фойдаланилишига олиб келиши, фуқароларнинг ҳаёти ва соғлиғига таҳдид солиши мумкин бўлган вазиятларни аниқлаш; </div></div><div class="ACT_TEXT"><div name="6484506" id="6484506">л) амалга оширилаётган хўжалик фаолияти ва бошқа фаолиятнинг табиатни муҳофаза қилиш стандартлари, нормалари, қоидалари ва бошқа норматив-ҳуқуқий ҳужжатлар талабларига мувофиқлигини назорат қилиш ва қонуний чоралар кўриш;</div></div><div class="ACT_TEXT"><div name="6484507" id="6484507">м) юридик ва жисмоний шахсларнинг табиатни муҳофаза қилиш ҳамда табиий ресурслардан оқилона фойдаланиш соҳасидаги ҳуқуқлари ва қонуний манфаатларига риоя этилишини, улар томонидан мажбуриятлар бажарилишини таъминлаш;</div></div><div class="ACT_TEXT"><div name="6484511" id="6484511">н) ўрмонлардан оқилона фойдаланиш устидан назоратни ўрнатиш, табиатни муҳофаза қилиш соҳасидаги муносабатларни тартибга солиш, ўрмонларнинг ер устида ва авиация ёрдамида қўриқланишини ташкил этишни назорат қилиш;</div></div><div class="BY_DEFAULT"><div name="6553488" id="6553488"></div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853264" id="7853264">(«о» кичик банди Ўзбекистон Республикаси Президентининг 2025 йил 18 ноябрдаги ПФ-217-сонли <a href="https://lex.uz/docs/7847353?ONDATE=19.11.2025 00#7850843">Фармонига</a> асосан чиқарилган — Қонунчилик маълумотлари миллий базаси, 19.11.2025 й., 06/25/217/1060-сон)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853265" id="7853265">(«п» кичик банди Ўзбекистон Республикаси Президентининг 2025 йил 18 ноябрдаги ПФ-217-сонли <a href="https://lex.uz/docs/7847353?ONDATE=19.11.2025 00#7850843">Фармонига</a> асосан чиқарилган — Қонунчилик маълумотлари миллий базаси, 19.11.2025 й., 06/25/217/1060-сон)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7853267" id="7853267">(«р» кичик банди Ўзбекистон Республикаси Президентининг 2025 йил 18 ноябрдаги ПФ-217-сонли <a href="https://lex.uz/docs/7847353?ONDATE=19.11.2025 00#7850843">Фармонига</a> асосан чиқарилган — Қонунчилик маълумотлари миллий базаси, 19.11.2025 й., 06/25/217/1060-сон)</div></div><div class="BY_DEFAULT"><div name="6485232" id="6485232"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="6485233" id="6485233">Ўзбекистон Республикаси Президентининг 2023 йил 31 майдаги ПҚ-171-сон <a href="https://lex.uz/docs/6479134">қарорига</a> <br />2-ИЛОВА </div></div><div class="ACT_TITLE_APPL"><div name="6485234" id="6485234">Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги тизимига ўтказилаётган ташкилотлар фаолиятини ташкил қилиш жадвали</div></div><div class="BY_DEFAULT"><div name="6485235" id="6485235"></div></div><div class="BY_DEFAULT"><div name="6921741" id="6921741"></div></div><div class="BY_DEFAULT"><div name="6921744" id="6921744"><table border="0" cellpadding="0" cellspacing="0" class="MsoNormalTable" style="width: 100.0%;border-collapse: collapse;mso-yfti-tbllook: 1184;mso-padding-alt: 0cm 0cm 0cm 0cm" width="100%">
