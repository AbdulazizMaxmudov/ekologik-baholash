<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="5333521" id="5333521">Закон</div></div><div class="ACCEPTING_BODY"><div name="5333531" id="5333531">Республики Узбекистан</div></div><div class="ACT_TITLE"><div name="5333534" id="5333534">Об экологическом аудите</div></div><div class="GRIF_PARLAMENT"><div name="5333541" id="5333541">Принят Законодательной палатой 26 декабря 2020 года<br />Одобрен Сенатом 12 марта 2021 года </div></div><div class="BY_DEFAULT"><div name="5333551" id="5333551"></div></div><div class="CLAUSE_DEFAULT"><div name="5333555" id="5333555">Статья 1. Цель настоящего Закона</div></div><div class="ACT_TEXT"><div name="5333581" id="5333581">Целью настоящего Закона является регулирование отношений в области экологического аудита.</div></div><div class="CLAUSE_DEFAULT"><div name="5333582" id="5333582">Статья 2. Законодательство об экологическом аудите</div></div><div class="ACT_TEXT"><div name="5333583" id="5333583">Законодательство об экологическом аудите состоит из настоящего Закона и иных актов законодательства.</div></div><div class="ACT_TEXT"><div name="5333584" id="5333584">Если международным договором Республики Узбекистан установлены иные правила, чем те, которые предусмотрены законодательством Республики Узбекистан об экологическом аудите, то применяются правила международного договора.</div></div><div class="CLAUSE_DEFAULT"><div name="5333585" id="5333585">Статья 3. Основные понятия</div></div><div class="ACT_TEXT"><div name="5333586" id="5333586">В настоящем Законе применяются следующие основные понятия:</div></div><div class="ACT_TEXT"><div name="5333587" id="5333587"><strong>экологический аудит</strong> — систематическая, документированная, независимая оценка хозяйственной и иной деятельности субъекта экологического аудита, проводимая экологической аудиторской организацией на предмет соблюдения требований нормативных документов в области технического регулирования и нормативно-правовых актов в области охраны окружающей среды и рационального использования природных ресурсов;</div></div><div class="ACT_TEXT"><div name="5333588" id="5333588"><strong>экологический аудитор</strong> — физическое лицо, имеющее квалификационный сертификат экологического аудитора;</div></div><div class="ACT_TEXT"><div name="5333589" id="5333589"><strong>заказчик экологического аудита</strong> — хозяйствующий субъект, его собственник, участники и (или) акционеры, инициирующие проведение экологического аудита;</div></div><div class="ACT_TEXT"><div name="5333590" id="5333590"><strong>квалификационный сертификат экологического аудитора</strong> — документ, подтверждающий квалификацию экологического аудитора и предоставляющий право на осуществление экологической аудиторской деятельности;</div></div><div class="ACT_TEXT"><div name="5333591" id="5333591"><strong>объект экологического аудита</strong> — хозяйственная и иная деятельность субъекта экологического аудита, оказывающая воздействие на окружающую среду, а также его система управления окружающей средой;</div></div><div class="ACT_TEXT"><div name="5333592" id="5333592"><strong>субъект экологического аудита</strong> — хозяйствующий субъект и иные организации, осуществляющие производство продукции, выполняющие работы и оказывающие услуги, подвергаемые экологическому аудиту; </div></div><div class="ACT_TEXT"><div name="5333593" id="5333593"><strong>экологическая аудиторская организация</strong> — юридическое лицо, осуществляющее экологическую аудиторскую деятельность;</div></div><div class="ACT_TEXT"><div name="5333625" id="5333625"><strong>экологическая аудиторская деятельность</strong> — предпринимательская деятельность экологической аудиторской организации, включающая в себя проведение экологического аудита и оказание сопутствующих услуг;</div></div><div class="ACT_TEXT"><div name="5333630" id="5333630"><strong>заключение экологического аудита</strong> — документ, адресованный заказчику экологического аудита, содержащий подробные сведения о ходе проведенного экологического аудита, выявленных нарушениях требований нормативных документов в области технического регулирования и нормативно-правовых актов в области охраны окружающей среды и рационального использования природных ресурсов, результатах проведенных лабораторных испытаний и другую информацию, полученную в результате проведения экологического аудита.</div></div><div class="CLAUSE_DEFAULT"><div name="5333645" id="5333645">Статья 4. Основные принципы экологического аудита</div></div><div class="ACT_TEXT"><div name="5333648" id="5333648">Основными принципами экологического аудита являются независимость, объективность, конфиденциальность и достоверность.</div></div><div class="CLAUSE_DEFAULT"><div name="5333650" id="5333650">Статья 5. Стандарты экологического аудита</div></div><div class="ACT_TEXT"><div name="5333652" id="5333652">Стандарты экологического аудита определяют порядок проведения экологического аудита, оказания сопутствующих услуг и организации системы контроля качества работы экологических аудиторов.</div></div><div class="ACT_TEXT"><div name="5333653" id="5333653">Национальные стандарты экологического аудита устанавливают единые требования к осуществлению экологической аудиторской деятельности.</div></div><div class="ACT_TEXT"><div name="5333654" id="5333654">Экологические аудиторские организации при проведении экологического аудита в соответствии с договором могут применять международные стандарты экологического аудита.</div></div><div class="CLAUSE_DEFAULT"><div name="5333655" id="5333655">Статья 6. Основные задачи экологического аудита</div></div><div class="ACT_TEXT"><div name="5333656" id="5333656">Основными задачами экологического аудита являются:</div></div><div class="ACT_TEXT"><div name="5333657" id="5333657">сбор достоверной информации об экологических аспектах хозяйственной и иной деятельности субъекта экологического аудита;</div></div><div class="ACT_TEXT"><div name="5333659" id="5333659">определение соответствия хозяйственной и иной деятельности субъекта экологического аудита требованиям нормативных документов в области технического регулирования и нормативно-правовых актов в области охраны окружающей среды и рационального использования природных ресурсов;</div></div><div class="ACT_TEXT"><div name="5333661" id="5333661">оценка воздействия деятельности субъекта экологического аудита на состояние окружающей среды;</div></div><div class="ACT_TEXT"><div name="5333662" id="5333662">оценка эффективности природоохранных мероприятий, реализуемых субъектом экологического аудита;</div></div><div class="ACT_TEXT"><div name="5333664" id="5333664">снижение риска возникновения чрезвычайных ситуаций, связанных с загрязнением окружающей среды;</div></div><div class="ACT_TEXT"><div name="5333665" id="5333665">оценка эффективности системы управления окружающей средой;</div></div><div class="ACT_TEXT"><div name="5333670" id="5333670">составление заключения экологического аудита, разработка рекомендаций, направленных на повышение эффективности природоохранных мероприятий, а также совершенствование системы управления окружающей средой, осуществляемых субъектом экологического аудита.</div></div><div class="CLAUSE_DEFAULT"><div name="5333675" id="5333675">Статья 7. Особенности проведения экологического аудита</div></div><div class="ACT_TEXT"><div name="5333679" id="5333679">Экологический аудит не подменяет экологический контроль, осуществляемый в соответствии с законодательством.</div></div><div class="ACT_TEXT"><div name="5333681" id="5333681">Экологический аудит проводится на основании договора, заключаемого между экологической аудиторской организацией и заказчиком экологического аудита, в котором определяются сроки и другие условия проведения экологического аудита.</div></div><div class="ACT_TEXT"><div name="5333684" id="5333684">Экологический аудит может проводиться в отношении всей деятельности субъекта экологического аудита в области охраны окружающей среды и рационального использования природных ресурсов или ее отдельной части.</div></div><div class="ACT_TEXT"><div name="5333687" id="5333687">В случае соответствия деятельности субъекта экологического аудита требованиям нормативных документов в области технического регулирования и нормативно-правовых актов в области охраны окружающей среды и рационального использования природных ресурсов субъект экологического аудита не подлежит проверке Государственным комитетом Республики Узбекистан по экологии и охране окружающей среды (далее — Госкомэкологии) в течение одного года, за исключением случаев, предусмотренных <a href="https://lex.uz/docs/5331135#5333692">частью шестой </a>настоящей статьи.</div></div><div class="ACT_TEXT"><div name="5333689" id="5333689">В случае несоответствия деятельности субъекта экологического аудита требованиям нормативных документов в области технического регулирования и нормативно-правовых актов в области охраны окружающей среды и рационального использования природных ресурсов субъект экологического аудита обязан в месячный срок устранить выявленные нарушения. </div></div><div class="ACT_TEXT"><div name="5333692" id="5333692">При возникновении аварий и чрезвычайных ситуаций, а также в связи с проведением расследования уголовных дел либо поручением Президента Республики Узбекистан или Кабинета Министров Республики Узбекистан Госкомэкологии может проводиться проверка деятельности субъекта экологического аудита независимо от факта и результатов проведенного экологического аудита.</div></div><div class="CLAUSE_DEFAULT"><div name="5333702" id="5333702">Статья 8. Формы экологического аудита</div></div><div class="ACT_TEXT"><div name="5333705" id="5333705">Экологический аудит может проводиться в добровольной или обязательной форме.</div></div><div class="ACT_TEXT"><div name="5333707" id="5333707">Экологический аудит в отношении деятельности субъектов экологического аудита с низким или незначительным (локальным воздействием) риском воздействия на окружающую среду проводится в добровольном порядке. </div></div><div class="ACT_TEXT"><div name="5333710" id="5333710">Субъекты экологического аудита, относящиеся к высокому и среднему риску воздействия на окружающую среду, подлежат обязательному ежегодному экологическому аудиту.</div></div><div class="ACT_TEXT"><div name="5333711" id="5333711">Перечень видов деятельности по степени риска воздействия на окружающую среду устанавливается Кабинетом Министров Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="5333712" id="5333712">Добровольный экологический аудит проводится по инициативе заказчика экологического аудита.</div></div><div class="ACT_TEXT"><div name="5333713" id="5333713">Обязательный экологический аудит проводится в отношении всей деятельности субъекта экологического аудита в области охраны окружающей среды и рационального использования природных ресурсов.</div></div><div class="CLAUSE_DEFAULT"><div name="5333726" id="5333726">Статья 9. Заключение экологического аудита</div></div><div class="ACT_TEXT"><div name="5333729" id="5333729">По итогам проведения экологического аудита составляется заключение экологического аудита.</div></div><div class="ACT_TEXT"><div name="5333730" id="5333730">Заключение экологического аудита должно содержать рекомендации по устранению выявленных нарушений, а также рекомендации и предложения по повышению эффективности природоохранных мероприятий, осуществляемых субъектом экологического аудита.</div></div><div class="ACT_TEXT"><div name="5333731" id="5333731">Заключение экологического аудита является конфиденциальным документом и без разрешения заказчика экологического аудита не подлежит разглашению.</div></div><div class="ACT_TEXT"><div name="5333732" id="5333732">Заключение экологического аудита должно быть подписано постранично экологическим аудитором (экологическими аудиторами), осуществлявшим экологический аудит, и руководителем экологической аудиторской организации.</div></div><div class="ACT_TEXT"><div name="5333733" id="5333733">Форма и содержание заключения экологического аудита определяются стандартами экологического аудита.</div></div><div class="CLAUSE_DEFAULT"><div name="5333737" id="5333737">Статья 10. Организация деятельности экологических аудиторских организаций</div></div><div class="ACT_TEXT"><div name="5333740" id="5333740">Экологические аудиторские организации при осуществлении своей деятельности являются независимыми.</div></div><div class="ACT_TEXT"><div name="5333742" id="5333742">Договор об оказании экологических аудиторских услуг заключается исключительно при наличии полиса страхования гражданской ответственности экологической аудиторской организации.</div></div><div class="ACT_TEXT"><div name="5333744" id="5333744">Вмешательство в деятельность и воздействие в какой бы то ни было форме на экологические аудиторские организации, а также на их работников с целью воспрепятствования осуществлению независимого экологического аудита не допускаются.</div></div><div class="ACT_TEXT"><div name="5333745" id="5333745">Должностные лица органов государственной власти и управления, а также иные лица, которым запрещено заниматься предпринимательской деятельностью в соответствии с законодательством, не могут быть учредителями экологических аудиторских организаций.</div></div><div class="ACT_TEXT"><div name="5333888" id="5333888">Экологические аудиторские организации могут создаваться и осуществлять свою деятельность в любой организационно-правовой форме, за исключением акционерного общества.</div></div><div class="ACT_TEXT"><div name="5333891" id="5333891">Руководителем экологической аудиторской организации может быть экологический аудитор, для которого данная экологическая аудиторская организация является основным местом работы.</div></div><div class="BY_DEFAULT"><div name="6778523" id="6778523"></div></div><div class="ACT_TEXT"><div name="6778526" id="6778526">Экологические аудиторские организации подлежат государственной регистрации в центрах государственных услуг.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6778529" id="6778529">(часть седьмая статьи 10 в редакции <a href="https://lex.uz/docs/6756677?ONDATE=16.01.2024 00#6762621">Закона </a>Республики Узбекистан от 16 января 2024 года № ЗРУ-896 — Национальная база данных законодательства, 16.01.2024 г., № 03/24/896/0037)</div></div><div class="ACT_TEXT"><div name="5333895" id="5333895">Экологические аудиторские организации не могут создаваться органами государственного и хозяйственного управления, а также органами государственной власти на местах.</div></div><div class="ACT_TEXT"><div name="5333898" id="5333898">Экологическая аудиторская организация не может быть учредителем (участником) другой экологической аудиторской организации и не вправе заниматься какой-либо предпринимательской деятельностью, связанной с воздействием на окружающую среду и использованием природных ресурсов.</div></div><div class="CLAUSE_DEFAULT"><div name="5333902" id="5333902">Статья 11. Права и обязанности экологической аудиторской организации</div></div><div class="ACT_TEXT"><div name="5333905" id="5333905">Экологическая аудиторская организация имеет право:</div></div><div class="ACT_TEXT"><div name="5333908" id="5333908">предварительно ознакомиться с учредительными и иными документами субъекта экологического аудита для принятия решения о проведении в отношении него экологического аудита;</div></div><div class="ACT_TEXT"><div name="5333912" id="5333912">проводить инвентаризацию оборудования и иного имущества субъекта экологического аудита, а также изучение фактического состояния и эффективности их работы;</div></div><div class="ACT_TEXT"><div name="5333914" id="5333914">проводить необходимые замеры, отбирать пробы и проводить лабораторные испытания в собственной аккредитованной лаборатории либо сторонней аккредитованной лаборатории;</div></div><div class="ACT_TEXT"><div name="5333917" id="5333917">получать разъяснения от лиц, ответственных за проведение природоохранных мероприятий, по возникшим в ходе проведения экологического аудита вопросам и дополнительные сведения, необходимые для проведения экологического аудита;</div></div><div class="ACT_TEXT"><div name="5333920" id="5333920">привлекать иных специалистов в качестве эксперта к участию в проведении экологического аудита;</div></div><div class="ACT_TEXT"><div name="5333924" id="5333924">давать консультации по правовым вопросам, связанным с экологическим аудитом.</div></div><div class="ACT_TEXT"><div name="5333928" id="5333928">Экологическая аудиторская организация также может оказывать следующие сопутствующие услуги:</div></div><div class="ACT_TEXT"><div name="5333930" id="5333930">а) проверку правильности расчета платы за отрицательное воздействие на окружающую среду;</div></div><div class="ACT_TEXT"><div name="5333933" id="5333933">б) анализ и консультирование по следующим вопросам:</div></div><div class="ACT_TEXT"><div name="5333934" id="5333934">осуществление деятельности, связанной с использованием природных ресурсов и (или) воздействием на окружающую среду;</div></div><div class="ACT_TEXT"><div name="5333935" id="5333935">составление отчетности о воздействии на окружающую среду;</div></div><div class="ACT_TEXT"><div name="5333936" id="5333936">планирование, осуществление и оценка результатов природоохранной деятельности и мероприятий;</div></div><div class="ACT_TEXT"><div name="5333937" id="5333937">организация и проведение производственного экологического контроля, составление отчетов о его результатах;</div></div><div class="ACT_TEXT"><div name="5333939" id="5333939">внедрение передовых технологий и методов по снижению отрицательного воздействия на окружающую среду;</div></div><div class="ACT_TEXT"><div name="5333941" id="5333941">в) определение размера вреда, нанесенного окружающей среде.</div></div><div class="ACT_TEXT"><div name="5333942" id="5333942">Экологическая аудиторская организация обязана:</div></div><div class="ACT_TEXT"><div name="5333944" id="5333944">соблюдать при осуществлении экологической аудиторской деятельности требования законодательства об экологическом аудите;</div></div><div class="ACT_TEXT"><div name="5333945" id="5333945">обеспечивать наличие в штате не менее четырех экологических аудиторов, для которых экологическая аудиторская организация является основным местом работы;</div></div><div class="ACT_TEXT"><div name="5333946" id="5333946">иметь полис страхования гражданской ответственности экологической аудиторской организации;</div></div><div class="ACT_TEXT"><div name="5333947" id="5333947">отражать в заключении экологического аудита рекомендации по устранению факта нарушения требований нормативных документов в области технического регулирования и нормативно-правовых актов в области охраны окружающей среды и рационального использования природных ресурсов;</div></div><div class="ACT_TEXT"><div name="5333948" id="5333948">предъявлять по требованию заказчика экологического аудита соответствующие документы на осуществление экологической аудиторской деятельности;</div></div><div class="ACT_TEXT"><div name="5333953" id="5333953">обеспечивать конфиденциальность информации, полученной при оказании экологических аудиторских услуг;</div></div><div class="ACT_TEXT"><div name="5333954" id="5333954">оформлять результаты экологического аудита согласно стандартам экологического аудита и хранить в экологической аудиторской организации экземпляры заключений экологического аудита не менее пяти лет; </div></div><div class="ACT_TEXT"><div name="5333956" id="5333956">обеспечивать контроль качества работы экологических аудиторов.</div></div><div class="CLAUSE_DEFAULT"><div name="5334012" id="5334012">Статья 12. Ответственность экологической аудиторской организации</div></div><div class="ACT_TEXT"><div name="5334013" id="5334013">Экологическая аудиторская организация несет ответственность перед заказчиком экологического аудита за причинение ущерба вследствие составления заведомо ложного заключения экологического аудита.</div></div><div class="ACT_TEXT"><div name="5334014" id="5334014">Заключение экологического аудита, составленное без проведения экологического аудита либо составленное по результатам экологического аудита, но не соответствующее содержанию документов, полученных и изученных экологическим аудитором (экологическими аудиторами), считается заведомо ложным.</div></div><div class="ACT_TEXT"><div name="5334016" id="5334016">Убытки, включая упущенную выгоду, причиненные заказчику экологического аудита в результате некачественного или ненадлежащего проведения экологического аудита, подлежат возмещению в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="5334018" id="5334018">Статья 13. Ограничения при проведении экологического аудита</div></div><div class="ACT_TEXT"><div name="5334023" id="5334023">Проведение экологического аудита запрещается:</div></div><div class="ACT_TEXT"><div name="5334024" id="5334024">лицу, состоящему в близких родственных отношениях с должностными лицами субъекта экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334025" id="5334025">лицу, имеющему имущественные или личные неимущественные интересы в отношении субъекта экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334027" id="5334027">должностным лицам Госкомэкологии;</div></div><div class="ACT_TEXT"><div name="5334028" id="5334028">работнику субъекта экологического аудита.</div></div><div class="ACT_TEXT"><div name="5334032" id="5334032">Экологический аудит также не проводится экологическими аудиторскими организациями и экологическими аудиторами:</div></div><div class="ACT_TEXT"><div name="5334038" id="5334038">в отношении хозяйствующих субъектов, являющихся собственниками, участниками, кредиторами, страховщиками данной экологической аудиторской организации, а также тех хозяйствующих субъектов, собственниками, участниками, акционерами которых являются эти экологические аудиторские организации и экологические аудиторы;</div></div><div class="ACT_TEXT"><div name="5334039" id="5334039">в отношении хозяйствующего субъекта, собственник, участник, акционер, а также несущее ответственность за организацию и ведение природоохранной деятельности лицо которого является одновременно собственником, участником данной экологической аудиторской организации;</div></div><div class="ACT_TEXT"><div name="5334040" id="5334040">в отношении субъекта экологического аудита, работник которого является одновременно работником данной экологической аудиторской организации.</div></div><div class="ACT_TEXT"><div name="5334045" id="5334045">Экологическая аудиторская организация не вправе проводить экологический аудит одного и того же субъекта экологического аудита более трех раз подряд.</div></div><div class="CLAUSE_DEFAULT"><div name="5334064" id="5334064">Статья 14. Требования, предъявляемые к экологическому аудитору</div></div><div class="ACT_TEXT"><div name="5334147" id="5334147">К экологическому аудитору предъявляются следующие требования:</div></div><div class="ACT_TEXT"><div name="5334153" id="5334153">наличие гражданства Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="5334154" id="5334154">наличие соответствующего профильного высшего образования;</div></div><div class="ACT_TEXT"><div name="5334157" id="5334157">опыт работы в сфере охраны окружающей среды или смежных сферах не менее трех лет подряд;</div></div><div class="ACT_TEXT"><div name="5334159" id="5334159">наличие квалификационного сертификата экологического аудитора.</div></div><div class="ACT_TEXT"><div name="5334162" id="5334162">Экологический аудитор вправе осуществлять заявленную деятельность только в одной экологической аудиторской организации.</div></div><div class="ACT_TEXT"><div name="5334164" id="5334164">Порядок подготовки экологических аудиторов, а также выдачи квалификационного сертификата экологического аудитора определяется Кабинетом Министров Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="5334178" id="5334178">Статья 15. Права и обязанности экологического аудитора</div></div><div class="ACT_TEXT"><div name="5334179" id="5334179">Экологический аудитор имеет право:</div></div><div class="ACT_TEXT"><div name="5334181" id="5334181">получать сведения и материалы, необходимые для проведения экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334183" id="5334183">отклонять представленные на экологический аудит материалы, не отвечающие требованиям законодательства об экологическом аудите.</div></div><div class="ACT_TEXT"><div name="5334185" id="5334185">Экологический аудитор обязан:</div></div><div class="ACT_TEXT"><div name="5334187" id="5334187">соблюдать при осуществлении экологической аудиторской деятельности требования законодательства об экологическом аудите;</div></div><div class="ACT_TEXT"><div name="5334190" id="5334190">оформлять результаты экологического аудита согласно стандартам экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334193" id="5334193">обеспечивать своевременное, комплексное, объективное, качественное проведение экологического аудита, а также оформление и выдачу заключения экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334195" id="5334195">заявлять самоотвод при наличии личной заинтересованности в отношении конкретного объекта экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334197" id="5334197">обеспечивать конфиденциальность информации, полученной при оказании экологических аудиторских услуг.</div></div><div class="CLAUSE_DEFAULT"><div name="5334203" id="5334203">Статья 16. Помощник экологического аудитора</div></div><div class="ACT_TEXT"><div name="5334205" id="5334205">Помощником экологического аудитора является физическое лицо, не имеющее квалификационного сертификата экологического аудитора, работающее в экологической аудиторской организации и участвующее в экологическом аудите по поручению экологической аудиторской организации без права подписи на заключении экологического аудита.</div></div><div class="ACT_TEXT"><div name="5334208" id="5334208">На помощника экологического аудитора распространяется обязанность неразглашения сведений, полученных при проведении экологического аудита.</div></div><div class="ACT_TEXT"><div name="5334211" id="5334211">Время работы в качестве помощника экологического аудитора включается в стаж работы, необходимый для получения квалификационного сертификата экологического аудитора.</div></div><div class="CLAUSE_DEFAULT"><div name="5334218" id="5334218">Статья 17. Права и обязанности заказчика экологического аудита</div></div><div class="ACT_TEXT"><div name="5334222" id="5334222">Заказчик экологического аудита имеет право:</div></div><div class="ACT_TEXT"><div name="5334223" id="5334223">самостоятельно выбирать экологическую аудиторскую организацию для проведения экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334226" id="5334226">определять направление и объем работы экологического аудита при добровольном экологическом аудите;</div></div><div class="ACT_TEXT"><div name="5334227" id="5334227">получать от экологической аудиторской организации необходимую информацию о нормах актов законодательства, на которых основывается заключение экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334228" id="5334228">получать заключение экологического аудита.</div></div><div class="ACT_TEXT"><div name="5334229" id="5334229">Заказчик экологического аудита обязан:</div></div><div class="ACT_TEXT"><div name="5334230" id="5334230">создать для экологических аудиторов соответствующие условия для проведения экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334231" id="5334231">предоставить сведения и материалы, необходимые для проведения экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334232" id="5334232">утвердить план экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334234" id="5334234">оплачивать услуги по проведению экологического аудита в соответствии с договором об оказании экологических аудиторских услуг.</div></div><div class="CLAUSE_DEFAULT"><div name="5334238" id="5334238">Статья 18. Права и обязанности субъекта экологического аудита</div></div><div class="ACT_TEXT"><div name="5334242" id="5334242">Субъект экологического аудита имеет право:</div></div><div class="ACT_TEXT"><div name="5334247" id="5334247">ознакомиться с направлением, объемом работы и планом экологического аудита;</div></div><div class="ACT_TEXT"><div name="5334250" id="5334250">получать от экологических аудиторов консультации и рекомендации по разработке и проведению природоохранных мероприятий, устранению обнаруженных в ходе экологического аудита недостатков и нарушений.</div></div><div class="ACT_TEXT"><div name="5334252" id="5334252">Субъект экологического аудита обязан:</div></div><div class="ACT_TEXT"><div name="5334253" id="5334253">обеспечить экологическим аудиторам соответствующие условия для проведения экологического аудита в сроки, определенные в договоре об оказании экологических аудиторских услуг;</div></div><div class="ACT_TEXT"><div name="5334254" id="5334254">предоставить экологическим аудиторам возможность для осмотра технологического оборудования на предмет определения его работоспособности и эффективности, изучения территории в целях обследования мест сбора и хранения отходов, источников загрязнения атмосферного воздуха, вод и земельных ресурсов, сохранения биологических ресурсов, а также отбора проб и образцов, необходимых для проведения лабораторных испытаний;</div></div><div class="ACT_TEXT"><div name="5334255" id="5334255">устранить обнаруженные в ходе экологического аудита нарушения требований нормативных документов в области технического регулирования, нормативно-правовых актов в области охраны окружающей среды и рационального использования природных ресурсов.</div></div><div class="CLAUSE_DEFAULT"><div name="5334257" id="5334257">Статья 19. Реестр экологических аудиторских организаций и Реестр экологических аудиторов</div></div><div class="ACT_TEXT"><div name="5334260" id="5334260">Реестр экологических аудиторских организаций включает список экологических аудиторских организаций и размещается на официальном веб-сайте Госкомэкологии. </div></div><div class="ACT_TEXT"><div name="5334266" id="5334266">Реестр экологических аудиторов включает список экологических аудиторов, имеющих квалификационный сертификат экологического аудитора, и размещается на официальном веб-сайте Госкомэкологии.</div></div><div class="ACT_TEXT"><div name="5334275" id="5334275">Порядок, форма и требования к ведению Реестра экологических аудиторских организаций и Реестра экологических аудиторов определяются Кабинетом Министров Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="5334281" id="5334281">Статья 20. Общественные объединения экологических аудиторов </div></div><div class="ACT_TEXT"><div name="5334284" id="5334284">Общественные объединения экологических аудиторов представляют собой негосударственные некоммерческие организации, объединяющие на добровольной основе экологических аудиторов. </div></div><div class="ACT_TEXT"><div name="5334287" id="5334287">Деятельность общественных объединений экологических аудиторов призвана содействовать развитию и поддержанию профессионального уровня экологических аудиторов, защите их профессиональных интересов.</div></div><div class="ACT_TEXT"><div name="5334291" id="5334291">Общественные объединения экологических аудиторов:</div></div><div class="ACT_TEXT"><div name="5334296" id="5334296">ведут учет членов общественных объединений экологических аудиторов и размещают информацию о них на своих веб-сайтах;</div></div><div class="ACT_TEXT"><div name="5334301" id="5334301">участвуют в разработке программ обучения экологических аудиторов;</div></div><div class="ACT_TEXT"><div name="5334306" id="5334306">участвуют в организации и проведении квалификационных экзаменов на получение квалификационного сертификата экологического аудитора;</div></div><div class="ACT_TEXT"><div name="5334309" id="5334309">подготавливают предложения по совершенствованию законодательства об экологическом аудите.</div></div><div class="CLAUSE_DEFAULT"><div name="5334316" id="5334316">Статья 21. Разрешение споров</div></div><div class="ACT_TEXT"><div name="5334317" id="5334317">Споры, возникающие при осуществлении экологической аудиторской деятельности, разрешаются в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="5334319" id="5334319">Статья 22. Ответственность за нарушение законодательства об экологическом аудите</div></div><div class="ACT_TEXT"><div name="5334320" id="5334320">Лица, виновные в нарушении законодательства об экологическом аудите, несут ответственность в установленном порядке.</div></div><div class="CLAUSE_DEFAULT"><div name="5334321" id="5334321">Статья 23. Обеспечение исполнения, доведения, разъяснения сути и значения настоящего Закона</div></div><div class="ACT_TEXT"><div name="5334323" id="5334323">Госкомэкологии и заинтересованным организациям обеспечить исполнение, доведение до исполнителей и разъяснение среди населения сути и значения настоящего Закона.</div></div><div class="CLAUSE_DEFAULT"><div name="5334325" id="5334325">Статья 24. Приведение законодательства в соответствие с настоящим Законом</div></div><div class="ACT_TEXT"><div name="5334327" id="5334327">Кабинету Министров Республики Узбекистан:</div></div><div class="ACT_TEXT"><div name="5334328" id="5334328">привести решения правительства в соответствие с настоящим Законом;</div></div><div class="ACT_TEXT"><div name="5334331" id="5334331">обеспечить пересмотр и отмену органами государственного управления их нормативно-правовых актов, противоречащих настоящему Закону.</div></div><div class="CLAUSE_DEFAULT"><div name="5334332" id="5334332">Статья 25. Вступление в силу настоящего Закона</div></div><div class="ACT_TEXT"><div name="5334333" id="5334333">Настоящий Закон вступает в силу по истечении двенадцати месяцев со дня его официального опубликования.</div></div><div class="SIGNATURE"><div name="5334335" id="5334335">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="5334336" id="5334336">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="5334337" id="5334337">15 марта 2021 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="5334338" id="5334338">№ ЗРУ-678</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="5333545" id="5333545">(Национальная база данных законодательства, 16.03.2021 г., № 03/21/678/0205; 16.01.2024 г., № 03/24/896/0037)</div></div></div>
</div></body></html>