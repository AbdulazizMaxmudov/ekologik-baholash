<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Cyrl-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="5332517" id="5332517">Ўзбекистон Республикасининг</div></div><div class="ACT_FORM"><div name="5332519" id="5332519">Қонуни</div></div><div class="ACT_TITLE"><div name="5332678" id="5332678">Экологик аудит тўғрисида</div></div><div class="GRIF_PARLAMENT"><div name="5332691" id="5332691">Қонунчилик палатаси томонидан 2020 йил 26 декабрда қабул қилинган<br /> Сенат томонидан 2021 йил 12 мартда маъқулланган </div></div><div class="BY_DEFAULT"><div name="5332693" id="5332693"></div></div><div class="CLAUSE_DEFAULT"><div name="5332697" id="5332697">1-модда. Ушбу Қонуннинг мақсади</div></div><div class="ACT_TEXT"><div name="5332698" id="5332698">Ушбу Қонуннинг мақсади экологик аудит соҳасидаги муносабатларни тартибга солишдан иборат.</div></div><div class="CLAUSE_DEFAULT"><div name="5332699" id="5332699">2-модда. Экологик аудит тўғрисидаги қонунчилик</div></div><div class="ACT_TEXT"><div name="5332700" id="5332700">Экологик аудит тўғрисидаги қонунчилик ушбу Қонун ва бошқа қонунчилик ҳужжатларидан иборатдир.</div></div><div class="ACT_TEXT"><div name="5332702" id="5332702">Агар Ўзбекистон Республикасининг халқаро шартномасида Ўзбекистон Республикасининг экологик аудит тўғрисидаги қонунчилигида назарда тутилганидан бошқача қоидалар белгиланган бўлса, халқаро шартнома қоидалари қўлланилади.</div></div><div class="CLAUSE_DEFAULT"><div name="5332731" id="5332731">3-модда. Асосий тушунчалар</div></div><div class="ACT_TEXT"><div name="5332739" id="5332739">Ушбу Қонунда қуйидаги асосий тушунчалар қўлланилади:</div></div><div class="ACT_TEXT"><div name="5332758" id="5332758"><strong>экологик аудит</strong> — экологик аудит субъекти амалга оширадиган хўжалик ва бошқа фаолиятни техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги норматив-ҳуқуқий ҳужжатлар талабларига риоя этиш юзасидан экологик аудиторлик ташкилоти томонидан ўтказиладиган тизимли, ҳужжатлаштирилган, мустақил баҳолаш; </div></div><div class="ACT_TEXT"><div name="5332779" id="5332779"><strong>экологик аудитор</strong> — экологик аудиторнинг малака сертификатига эга бўлган жисмоний шахс;</div></div><div class="ACT_TEXT"><div name="5332780" id="5332780"><strong>экологик аудитнинг буюртмачиси</strong> — экологик аудит ўтказиш ташаббуси билан чиқувчи хўжалик юритувчи субъект, унинг мулкдори иштирокчилари ва (ёки) акциядорлари;</div></div><div class="ACT_TEXT"><div name="5332781" id="5332781"><strong>экологик аудиторнинг малака сертификати</strong> — экологик аудиторнинг малакасини тасдиқловчи ва экологик аудиторлик фаолиятини амалга ошириш ҳуқуқини берувчи ҳужжат;</div></div><div class="ACT_TEXT"><div name="5332782" id="5332782"><strong>экологик аудит объекти</strong> — экологик аудит субъектининг атроф-муҳитга таъсир кўрсатадиган хўжалик ва бошқа фаолияти, шунингдек унинг атроф-муҳитни бошқариш тизими;</div></div><div class="ACT_TEXT"><div name="5332784" id="5332784"><strong>экологик аудит субъекти</strong> — маҳсулот ишлаб чиқаришни амалга оширувчи, ишларни бажарувчи ва хизматлар кўрсатувчи, ўзида экологик аудит ўтказиладиган хўжалик юритувчи субъект ва бошқа ташкилотлар;</div></div><div class="ACT_TEXT"><div name="5332786" id="5332786"><strong>экологик аудиторлик ташкилоти</strong> — экологик аудиторлик фаолиятини амалга оширувчи юридик шахс;</div></div><div class="ACT_TEXT"><div name="5332791" id="5332791"><strong>экологик аудиторлик фаолияти</strong> — экологик аудиторлик ташкилотининг экологик аудит ўтказишни ва турдош хизматлар кўрсатишни ўз ичига олган тадбиркорлик фаолияти;</div></div><div class="ACT_TEXT"><div name="5332794" id="5332794"><strong>экологик аудит хулосаси</strong> — экологик аудит буюртмачисига йўлланган, ўтказилган экологик аудит жараёни, техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги норматив-ҳуқуқий ҳужжатлар талабларининг аниқланган бузилишлари, ўтказилган лаборатория синовларининг натижалари тўғрисидаги батафсил маълумотларни ҳамда экологик аудит ўтказиш натижасида олинган бошқа ахборотни ўз ичига олган ҳужжат.</div></div><div class="CLAUSE_DEFAULT"><div name="5332805" id="5332805">4-модда. Экологик аудитнинг асосий принциплари </div></div><div class="ACT_TEXT"><div name="5332809" id="5332809">Экологик аудитнинг асосий принциплари мустақиллик, холислик, махфийлик ва ишончлиликдан иборатдир.</div></div><div class="CLAUSE_DEFAULT"><div name="5332813" id="5332813">5-модда. Экологик аудит стандартлари</div></div><div class="ACT_TEXT"><div name="5332816" id="5332816">Экологик аудит стандартлари экологик аудитни ўтказиш, турдош хизматлар кўрсатиш ва экологик аудиторлар ишининг сифатини назорат қилиш тизимини ташкил этиш тартибини белгилайди.</div></div><div class="ACT_TEXT"><div name="5332821" id="5332821">Миллий экологик аудит стандартлари экологик аудиторлик фаолиятини амалга оширишга доир ягона талабларни белгилайди.</div></div><div class="ACT_TEXT"><div name="5332825" id="5332825">Экологик аудиторлик ташкилотлари экологик аудитни ўтказиш чоғида шартномага мувофиқ халқаро экологик аудит стандартларини қўллаши мумкин.</div></div><div class="CLAUSE_DEFAULT"><div name="5332842" id="5332842">6-модда. Экологик аудитнинг асосий вазифалари </div></div><div class="ACT_TEXT"><div name="5332844" id="5332844">Экологик аудитнинг асосий вазифалари қуйидагилардан иборат:</div></div><div class="ACT_TEXT"><div name="5332846" id="5332846">экологик аудит субъекти хўжалик ва бошқа фаолиятининг экологик жиҳатлари тўғрисидаги ишончли ахборотни тўплаш;</div></div><div class="ACT_TEXT"><div name="5332848" id="5332848">экологик аудит субъектининг хўжалик ва бошқа фаолияти техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги норматив-ҳуқуқий ҳужжатлар талабларига мувофиқлигини аниқлаш;</div></div><div class="ACT_TEXT"><div name="5332853" id="5332853">экологик аудит субъекти фаолиятининг атроф-муҳит ҳолатига таъсирини баҳолаш;</div></div><div class="ACT_TEXT"><div name="5332854" id="5332854">экологик аудит субъекти томонидан амалга ошириладиган табиатни муҳофаза қилишга оид тадбирларнинг самарадорлигини баҳолаш;</div></div><div class="ACT_TEXT"><div name="5332856" id="5332856">атроф-муҳитнинг ифлосланиши билан боғлиқ фавқулодда вазиятларнинг юзага келиши хавфини камайтириш;</div></div><div class="ACT_TEXT"><div name="5332858" id="5332858">атроф-муҳитни бошқариш тизимининг самарадорлигини баҳолаш;</div></div><div class="ACT_TEXT"><div name="5332860" id="5332860">экологик аудит хулосасини тузиш, экологик аудит субъекти томонидан амалга ошириладиган табиатни муҳофаза қилишга оид тадбирлар самарадорлигини оширишга, шунингдек атроф-муҳитни бошқариш тизимини такомиллаштиришга қаратилган тавсиялар ишлаб чиқиш.</div></div><div class="CLAUSE_DEFAULT"><div name="5332869" id="5332869">7-модда. Экологик аудит ўтказишнинг ўзига хос хусусиятлари</div></div><div class="ACT_TEXT"><div name="5332871" id="5332871">Экологик аудит қонунчиликка мувофиқ амалга ошириладиган экологик назоратнинг ўрнини босмайди.</div></div><div class="ACT_TEXT"><div name="5332872" id="5332872">Экологик аудит экологик аудиторлик ташкилоти ва экологик аудит буюртмачиси ўртасида тузиладиган, экологик аудит ўтказиш муддатлари ва бошқа шартлари белгиланадиган шартнома асосида ўтказилади.</div></div><div class="ACT_TEXT"><div name="5332873" id="5332873">Экологик аудит экологик аудит субъектининг атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги бутун фаолиятига ёки унинг алоҳида қисмига нисбатан ўтказилиши мумкин.</div></div><div class="ACT_TEXT"><div name="5332876" id="5332876">Экологик аудит субъектининг фаолияти техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги норматив-ҳуқуқий ҳужжатлар талабларига мувофиқ бўлган тақдирда Ўзбекистон Республикаси Экология ва атроф-муҳитни муҳофаза қилиш давлат қўмитаси (бундан буён матнда Давлат экология қўмитаси деб юритилади) томонидан бир йил давомида текширилмайди, бундан ушбу модданинг <a href="https://lex.uz/docs/5331133#5332879">олтинчи қисмида </a>назарда тутилган ҳоллар мустасно. </div></div><div class="ACT_TEXT"><div name="5332878" id="5332878">Экологик аудит субъектининг фаолияти техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги норматив-ҳуқуқий ҳужжатлар талабларига мувофиқ бўлмаган тақдирда экологик аудит субъекти аниқланган қоидабузарликларни бир ойлик муддатда бартараф этиши шарт.</div></div><div class="ACT_TEXT"><div name="5332879" id="5332879">Авариялар ва фавқулодда вазиятлар юзага келганда, шунингдек жиноят ишларини тергов қилиш ёхуд Ўзбекистон Республикаси Президентининг ёки Ўзбекистон Республикаси Вазирлар Маҳкамасининг топшириғи муносабати билан Давлат экология қўмитаси томонидан ўтказилган экологик аудитнинг факти ва натижаларидан қатъи назар текширув ўтказилиши мумкин.</div></div><div class="CLAUSE_DEFAULT"><div name="5332887" id="5332887">8-модда. Экологик аудит шакллари</div></div><div class="ACT_TEXT"><div name="5332889" id="5332889">Экологик аудит ихтиёрий ёки мажбурий шаклда ўтказилиши мумкин.</div></div><div class="ACT_TEXT"><div name="5332890" id="5332890">Атроф-муҳитга таъсир кўрсатиш хавфи кам бўлган ёки унчалик кўп бўлмаган (локал таъсирга эга) экологик аудит субъектларининг фаолиятига нисбатан экологик аудит ихтиёрий тартибда ўтказилади.</div></div><div class="ACT_TEXT"><div name="5332892" id="5332892">Атроф-муҳитга юқори ва ўртача таъсир кўрсатиш хавфига эга бўлган экологик аудит субъектлари ҳар йилги мажбурий экологик аудитдан ўтказилиши лозим.</div></div><div class="ACT_TEXT"><div name="5332893" id="5332893">Атроф-муҳитга таъсир кўрсатиш хавфи даражаси бўйича фаолият турларининг рўйхати Ўзбекистон Республикаси Вазирлар Маҳкамаси томонидан белгиланади.</div></div><div class="ACT_TEXT"><div name="5332894" id="5332894">Ихтиёрий экологик аудит экологик аудит буюртмачисининг ташаббусига кўра ўтказилади.</div></div><div class="ACT_TEXT"><div name="5332897" id="5332897">Мажбурий йиллик экологик аудит экологик аудит субъектининг атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги бутун фаолиятига нисбатан ўтказилади.</div></div><div class="CLAUSE_DEFAULT"><div name="5332922" id="5332922">9-модда. Экологик аудит хулосаси</div></div><div class="ACT_TEXT"><div name="5332923" id="5332923">Экологик аудит ўтказиш якунлари бўйича экологик аудит хулосаси тузилади.</div></div><div class="ACT_TEXT"><div name="5332924" id="5332924">Экологик аудит хулосаси аниқланган камчиликларни бартараф этишга доир тавсияларни, шунингдек экологик аудит субъекти томонидан амалга оширилаётган табиатни муҳофаза қилишга оид тадбирлар самарадорлигини ошириш бўйича тавсиялар ва таклифларни ўз ичига олиши керак. </div></div><div class="ACT_TEXT"><div name="5332925" id="5332925">Экологик аудит хулосаси махфий ҳужжатдир ва у экологик аудит буюртмачисининг розилигисиз ошкор қилинишига йўл қўйилмайди. </div></div><div class="ACT_TEXT"><div name="5332926" id="5332926">Экологик аудит хулосасининг ҳар бир саҳифаси экологик аудитни амалга оширган экологик аудитор (экологик аудиторлар) ва экологик аудиторлик ташкилотининг раҳбари томонидан имзоланган бўлиши керак.</div></div><div class="ACT_TEXT"><div name="5332927" id="5332927">Экологик аудит хулосасининг шакли ва мазмуни экологик аудит стандартларида белгиланади.</div></div><div class="CLAUSE_DEFAULT"><div name="5332928" id="5332928">10-модда. Экологик аудиторлик ташкилотлари </div></div><div class="ACT_TEXT"><div name="5332929" id="5332929">Экологик аудиторлик ташкилотлари ўз фаолиятини амалга ошириш чоғида мустақилдир.</div></div><div class="ACT_TEXT"><div name="5332930" id="5332930">Экологик аудиторлик хизматлари кўрсатиш тўғрисидаги шартнома фақат экологик аудиторлик ташкилотининг фуқаролик жавобгарлиги суғурта полиси мавжуд бўлган тақдирда тузилади.</div></div><div class="ACT_TEXT"><div name="5332931" id="5332931">Экологик аудиторлик ташкилотларининг, шунингдек улар ходимларининг фаолиятига мустақил экологик аудитни амалга оширишга монелик қилиш мақсадида аралашишга ҳамда қандай шаклда бўлмасин таъсир ўтказишга йўл қўйилмайди. </div></div><div class="ACT_TEXT"><div name="5332932" id="5332932">Давлат ҳокимияти ва бошқаруви органларининг мансабдор шахслари, шунингдек қонунчиликка мувофиқ тадбиркорлик фаолияти билан шуғулланиши тақиқланган бошқа шахслар экологик аудиторлик ташкилотларининг муассислари бўлиши мумкин эмас.</div></div><div class="ACT_TEXT"><div name="5332933" id="5332933">Экологик аудиторлик ташкилотлари ҳар қандай ташкилий-ҳуқуқий шаклда тузилиши ва ўз фаолиятини амалга ошириши мумкин, бундан акциядорлик жамияти мустасно.</div></div><div class="ACT_TEXT"><div name="5332934" id="5332934">Экологик аудиторлик ташкилотига ушбу экологик аудиторлик ташкилоти ўзи учун асосий иш жойи бўлган экологик аудитор раҳбар бўлиши мумкин.</div></div><div class="BY_DEFAULT"><div name="6778511" id="6778511"></div></div><div class="ACT_TEXT"><div name="6778513" id="6778513">Экологик аудиторлик ташкилотлари давлат хизматлари марказларида давлат рўйхатидан ўтказилиши лозим.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6778514" id="6778514">(10-модданинг еттинчи қисми Ўзбекистон Республикасининг 2024 йил 16 январдаги ЎРҚ-896-сонли <a href="https://lex.uz/docs/6756667?ONDATE=16.01.2024 00#6761683">Қонуни </a>таҳририда — Қонунчилик маълумотлари миллий базаси, 16.01.2024 й., 03/24/896/0037-сон)</div></div><div class="ACT_TEXT"><div name="5332936" id="5332936">Экологик аудиторлик ташкилотлари давлат ва хўжалик бошқаруви органлари, шунингдек маҳаллий давлат ҳокимияти органлари томонидан ташкил этилиши мумкин эмас.</div></div><div class="ACT_TEXT"><div name="5332937" id="5332937">Экологик аудиторлик ташкилоти бошқа экологик аудиторлик ташкилотининг муассиси (иштирокчиси) бўлиши мумкин эмас ҳамда атроф-муҳитга таъсир кўрсатиш ва табиий ресурслардан фойдаланиш билан боғлиқ бирор-бир тадбиркорлик фаолияти билан шуғулланишга ҳақли эмас.</div></div><div class="CLAUSE_DEFAULT"><div name="5332938" id="5332938">11-модда. Экологик аудиторлик ташкилотининг ҳуқуқ ва мажбуриятлари</div></div><div class="ACT_TEXT"><div name="5332939" id="5332939">Экологик аудиторлик ташкилоти қуйидаги ҳуқуқларга эга:</div></div><div class="ACT_TEXT"><div name="5332940" id="5332940">экологик аудит субъектига нисбатан экологик аудит ўтказиш тўғрисида қарор қабул қилиш учун унинг таъсис ҳужжатлари ва бошқа ҳужжатлари билан олдиндан танишиш; </div></div><div class="ACT_TEXT"><div name="5332941" id="5332941">экологик аудит субъектининг асбоб-ускуналари ва бошқа мол-мулкини инвентаризациядан ўтказиш, шунингдек уларнинг ҳақиқий ҳолати ва иш самарадорлигини ўрганиш;</div></div><div class="ACT_TEXT"><div name="5332942" id="5332942">зарур ўлчовлар ўтказиш, намуналар олиш ва ўзининг аккредитациядан ўтган лабораториясида ёки бошқа аккредитациядан ўтган лабораторияда лаборатория синовларини ўтказиш;</div></div><div class="ACT_TEXT"><div name="5332943" id="5332943">экологик аудит ўтказиш давомида юзага келган масалалар бўйича табиатни муҳофаза қилишга оид тадбирларни ўтказиш учун масъул бўлган шахслардан тушунтиришлар ва экологик аудит ўтказиш учун зарур бўлган қўшимча маълумотлар олиш;</div></div><div class="ACT_TEXT"><div name="5332944" id="5332944">экологик аудит ўтказишда иштирок этишга бошқа мутахассисларни эксперт сифатида жалб қилиш;</div></div><div class="ACT_TEXT"><div name="5332945" id="5332945">экологик аудит билан боғлиқ ҳуқуқий масалалар юзасидан маслаҳатлар бериш.</div></div><div class="ACT_TEXT"><div name="5332946" id="5332946">Экологик аудиторлик ташкилоти қуйидаги турдош хизматларни ҳам кўрсатиши мумкин:</div></div><div class="ACT_TEXT"><div name="5332947" id="5332947">а) атроф-муҳитга салбий таъсир кўрсатганлик учун тўлов ҳисоб-китобининг тўғрилигини текшириш;</div></div><div class="ACT_TEXT"><div name="5332948" id="5332948">б) қуйидаги масалалар юзасидан таҳлил қилиш ва маслаҳат бериш:</div></div><div class="ACT_TEXT"><div name="5332949" id="5332949">табиий ресурслардан фойдаланиш ва (ёки) атроф-муҳитга таъсир кўрсатиш билан боғлиқ фаолиятни амалга ошириш;</div></div><div class="ACT_TEXT"><div name="5332950" id="5332950">атроф-муҳитга таъсир кўрсатиш тўғрисида ҳисоботлар тузиш;</div></div><div class="ACT_TEXT"><div name="5332951" id="5332951">табиатни муҳофаза қилишга оид фаолиятни ва тадбирларни режалаштириш, амалга ошириш ҳамда натижаларини баҳолаш;</div></div><div class="ACT_TEXT"><div name="5332952" id="5332952">ишлаб чиқаришга доир экологик назоратни ташкил этиш ва ўтказиш, унинг натижалари тўғрисида ҳисоботлар тузиш;</div></div><div class="ACT_TEXT"><div name="5332953" id="5332953">атроф-муҳитга салбий таъсирни камайтириш бўйича илғор технологиялар ва усулларни жорий этиш;</div></div><div class="ACT_TEXT"><div name="5332955" id="5332955">в) атроф-муҳитга етказилган зарарнинг миқдорини аниқлаш.</div></div><div class="ACT_TEXT"><div name="5332956" id="5332956">Экологик аудиторлик ташкилоти:</div></div><div class="ACT_TEXT"><div name="5332957" id="5332957">экологик аудиторлик фаолиятини амалга ошириш чоғида экологик аудит тўғрисидаги қонунчилик талабларига риоя этиши;</div></div><div class="ACT_TEXT"><div name="5332958" id="5332958">штатида асосий иш жойи экологик аудиторлик ташкилоти бўлган камида тўрт нафар экологик аудитор мавжуд бўлишини таъминлаши;</div></div><div class="ACT_TEXT"><div name="5332959" id="5332959">экологик аудиторлик ташкилотининг фуқаролик жавобгарлиги суғурта полисига эга бўлиши;</div></div><div class="ACT_TEXT"><div name="5332960" id="5332960">экологик аудит хулосасида техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги норматив-ҳуқуқий ҳужжатлар талабларининг бузилиши ҳолатини бартараф этиш бўйича тавсияларни акс эттириши; </div></div><div class="ACT_TEXT"><div name="5332961" id="5332961">экологик аудиторлик фаолиятини амалга оширишга доир тегишли ҳужжатларни экологик аудит буюртмачисининг талабига кўра тақдим этиши;</div></div><div class="ACT_TEXT"><div name="5332962" id="5332962">экологик аудиторлик хизматларини кўрсатиш чоғида олинган ахборотнинг махфийлигини таъминлаши;</div></div><div class="ACT_TEXT"><div name="5332963" id="5332963">экологик аудит натижаларини экологик аудит стандартларига биноан расмийлаштириши ва экологик аудит хулосаларининг нусхаларини экологик аудиторлик ташкилотида камида беш йил сақлаши;</div></div><div class="ACT_TEXT"><div name="5332964" id="5332964">экологик аудиторлар иши сифатининг назоратини таъминлаши шарт.</div></div><div class="CLAUSE_DEFAULT"><div name="5332970" id="5332970">12-модда. Экологик аудиторлик ташкилотининг жавобгарлиги </div></div><div class="ACT_TEXT"><div name="5332973" id="5332973">Экологик аудиторлик ташкилоти била туриб сохта тузилган экологик аудит хулосасини тузиши оқибатида етказилган зарар учун экологик аудит буюртмачиси олдида жавобгар бўлади.</div></div><div class="ACT_TEXT"><div name="5332975" id="5332975">Экологик аудитнинг экологик аудит ўтказмасдан тузилган ёки экологик аудит натижалари бўйича тузилган, аммо экологик аудитор (экологик аудиторлар) томонидан олинган ва ўрганилган ҳужжатлар мазмунига мувофиқ бўлмаган хулосаси била туриб сохта тузилган ҳисобланади.</div></div><div class="ACT_TEXT"><div name="5332977" id="5332977">Сифатсиз ўтказилган ёки лозим даражада ўтказилмаган экологик аудит натижасида экологик аудит буюртмачисига етказилган зарарларнинг, шу жумладан бой берилган фойданинг ўрни қонунчиликда белгиланган тартибда қопланиши лозим.</div></div><div class="CLAUSE_DEFAULT"><div name="5333061" id="5333061">13-модда. Экологик аудит ўтказиш чоғидаги чекловлар</div></div><div class="ACT_TEXT"><div name="5333065" id="5333065">Қуйидагиларга экологик аудит ўтказиш тақиқланади:</div></div><div class="ACT_TEXT"><div name="5333070" id="5333070">экологик аудит субъектининг мансабдор шахслари билан яқин қариндошлик муносабатларида бўлган шахсга;</div></div><div class="ACT_TEXT"><div name="5333072" id="5333072">экологик аудит субъектига нисбатан мулкий ёки шахсий номулкий манфаатлари бор шахсга;</div></div><div class="ACT_TEXT"><div name="5333074" id="5333074">Давлат экология қўмитасининг мансабдор шахсларига;</div></div><div class="ACT_TEXT"><div name="5333078" id="5333078">экологик аудит субъектининг ходимига.</div></div><div class="ACT_TEXT"><div name="5333080" id="5333080">Экологик аудит экологик аудиторлик ташкилотлари ва экологик аудиторлар томонидан қуйидагиларга нисбатан ҳам ўтказилмайди:</div></div><div class="ACT_TEXT"><div name="5333081" id="5333081">ушбу экологик аудиторлик ташкилотининг мулкдорлари, иштирокчилари, кредиторлари, суғуртачилари бўлган хўжалик юритувчи субъектларга, шунингдек ушбу экологик аудиторлик ташкилотлари ва экологик аудиторлар ўзига нисбатан мулкдор, иштирокчи, акциядор бўлган хўжалик юритувчи субъектларга нисбатан;</div></div><div class="ACT_TEXT"><div name="5333085" id="5333085">ўз мулкдори, иштирокчиси, акциядори, шунингдек табиатни муҳофаза қилишга оид фаолиятни ташкил этиш ва юритиш учун жавобгар бўлган шахси бир вақтнинг ўзида мазкур экологик аудиторлик ташкилотининг мулкдори, иштирокчиси бўлган хўжалик юритувчи субъектга нисбатан;</div></div><div class="ACT_TEXT"><div name="5333087" id="5333087">ўз ходими бир вақтнинг ўзида мазкур экологик аудиторлик ташкилотининг ходими бўлган экологик аудит субъектига нисбатан.</div></div><div class="ACT_TEXT"><div name="5333090" id="5333090">Экологик аудиторлик ташкилоти айни бир экологик аудит субъектида кетма-кет уч мартадан ортиқ экологик аудит ўтказишга ҳақли эмас.</div></div><div class="CLAUSE_DEFAULT"><div name="5333101" id="5333101">14-модда. Экологик аудиторга қўйиладиган талаблар</div></div><div class="ACT_TEXT"><div name="5333102" id="5333102">Экологик аудиторга қуйидаги талаблар қўйилади:</div></div><div class="ACT_TEXT"><div name="5333103" id="5333103">Ўзбекистон Республикаси фуқаролигининг мавжудлиги;</div></div><div class="ACT_TEXT"><div name="5333104" id="5333104">тегишли соҳага оид олий маълумотнинг мавжудлиги;</div></div><div class="ACT_TEXT"><div name="5333105" id="5333105">атроф-муҳитни муҳофаза қилиш соҳасида ёки турдош соҳаларда кетма-кет камида уч йиллик иш тажрибасига эга бўлиш;</div></div><div class="ACT_TEXT"><div name="5333107" id="5333107">экологик аудитор малака сертификатининг мавжудлиги.</div></div><div class="ACT_TEXT"><div name="5333108" id="5333108">Экологик аудитор аризасида кўрсатилган фаолиятни фақат битта экологик аудиторлик ташкилотида амалга оширишга ҳақли.</div></div><div class="ACT_TEXT"><div name="5333111" id="5333111">Экологик аудиторларни тайёрлаш, шунингдек экологик аудиторнинг малака сертификатини бериш тартиби Ўзбекистон Республикаси Вазирлар Маҳкамаси томонидан белгиланади. </div></div><div class="CLAUSE_DEFAULT"><div name="5333116" id="5333116">15-модда. Экологик аудиторнинг ҳуқуқ ва мажбуриятлари</div></div><div class="ACT_TEXT"><div name="5333120" id="5333120">Экологик аудитор қуйидаги ҳуқуқларга эга:</div></div><div class="ACT_TEXT"><div name="5333121" id="5333121">экологик аудит ўтказиш учун зарур бўлган маълумотлар ва материалларни олиш;</div></div><div class="ACT_TEXT"><div name="5333122" id="5333122">экологик аудитга тақдим қилинган, экологик аудит тўғрисидаги қонунчилик талабларига жавоб бермайдиган материалларни рад этиш.</div></div><div class="ACT_TEXT"><div name="5333124" id="5333124">Экологик аудитор:</div></div><div class="ACT_TEXT"><div name="5333127" id="5333127">экологик аудиторлик фаолиятини амалга ошириш чоғида экологик аудит тўғрисидаги қонунчилик талабларига риоя этиши;</div></div><div class="ACT_TEXT"><div name="5333129" id="5333129">экологик аудит натижаларини экологик аудит стандартларига биноан расмийлаштириши;</div></div><div class="ACT_TEXT"><div name="5333132" id="5333132">экологик аудит ўз вақтида, комплекс тарзда, холисона, сифатли ўтказилишини, шунингдек экологик аудит хулосаси расмийлаштирилиши ва берилишини таъминлаши;</div></div><div class="ACT_TEXT"><div name="5333134" id="5333134">экологик аудитнинг муайян объектига нисбатан шахсий манфаатдорлиги мавжуд бўлган тақдирда ўзини ўзи рад этиш ҳақида арз қилиши;</div></div><div class="ACT_TEXT"><div name="5333137" id="5333137">экологик аудиторлик хизматларини кўрсатиш чоғида олинган ахборотнинг махфийлигини таъминлаши шарт. </div></div><div class="CLAUSE_DEFAULT"><div name="5333150" id="5333150">16-модда. Экологик аудитор ёрдамчиси</div></div><div class="ACT_TEXT"><div name="5333152" id="5333152">Экологик аудитор ёрдамчиси экологик аудиторнинг малака сертификатига эга бўлмаган, экологик аудиторлик ташкилотида ишлайдиган ҳамда экологик аудит хулосасига имзо қўйиш ҳуқуқисиз, экологик аудиторлик ташкилотининг топшириғига кўра экологик аудитда иштирок этадиган жисмоний шахсдир.</div></div><div class="ACT_TEXT"><div name="5333157" id="5333157">Экологик аудитор ёрдамчисига нисбатан экологик аудит ўтказиш чоғида олинган маълумотларни ошкор қилмаслик мажбурияти татбиқ этилади.</div></div><div class="ACT_TEXT"><div name="5333160" id="5333160">Экологик аудитор ёрдамчиси сифатида ишлаш вақти экологик аудиторнинг малака сертификатини олиш учун зарур бўлган иш стажига киритилади.</div></div><div class="CLAUSE_DEFAULT"><div name="5333163" id="5333163">17-модда. Экологик аудит буюртмачисининг ҳуқуқ ва мажбуриятлари</div></div><div class="ACT_TEXT"><div name="5333165" id="5333165">Экологик аудит буюртмачиси қуйидаги ҳуқуқларга эга:</div></div><div class="ACT_TEXT"><div name="5333167" id="5333167">экологик аудит ўтказиш учун экологик аудиторлик ташкилотини мустақил равишда танлаш;</div></div><div class="ACT_TEXT"><div name="5333170" id="5333170">ихтиёрий экологик аудит чоғида экологик аудитнинг йўналиши ва иш ҳажмини белгилаш; </div></div><div class="ACT_TEXT"><div name="5333172" id="5333172">экологик аудиторлик ташкилотидан экологик аудит хулосаси қайси қонунчилик ҳужжатлари нормаларига асосланганлиги тўғрисидаги зарур ахборотни олиш;</div></div><div class="ACT_TEXT"><div name="5333174" id="5333174">экологик аудит хулосасини олиш.</div></div><div class="ACT_TEXT"><div name="5333177" id="5333177">Экологик аудит буюртмачиси:</div></div><div class="ACT_TEXT"><div name="5333179" id="5333179">экологик аудиторларга экологик аудитни ўтказиш учун тегишли шарт-шароитлар яратиши;</div></div><div class="ACT_TEXT"><div name="5333181" id="5333181">экологик аудитни ўтказиш учун зарур бўлган маълумотлар ва материалларни тақдим этиши;</div></div><div class="ACT_TEXT"><div name="5333184" id="5333184">экологик аудит режасини тасдиқлаши;</div></div><div class="ACT_TEXT"><div name="5333188" id="5333188">экологик аудиторлик хизматлари кўрсатиш тўғрисидаги шартномага мувофиқ экологик аудит ўтказиш хизматлари учун ҳақ тўлаши шарт.</div></div><div class="CLAUSE_DEFAULT"><div name="5333251" id="5333251">18-модда. Экологик аудит субъектининг ҳуқуқ ва мажбуриятлари</div></div><div class="ACT_TEXT"><div name="5333255" id="5333255">Экологик аудит субъекти қуйидаги ҳуқуқларга эга:</div></div><div class="ACT_TEXT"><div name="5333258" id="5333258">экологик аудитнинг йўналиши, иш ҳажмлари ва режаси билан танишиш; </div></div><div class="ACT_TEXT"><div name="5333260" id="5333260">экологик аудиторлардан табиатни муҳофаза қилишга оид тадбирларни ишлаб чиқиш ва ўтказиш, экологик аудит ўтказиш чоғида аниқланган камчиликлар ҳамда қоидабузарликларни бартараф этиш бўйича маслаҳатлар ва тавсиялар олиш.</div></div><div class="ACT_TEXT"><div name="5333263" id="5333263">Экологик аудит субъекти:</div></div><div class="ACT_TEXT"><div name="5333265" id="5333265">экологик аудиторларни экологик аудитни экологик аудиторлик хизматлари кўрсатиш тўғрисидаги шартномада белгиланган муддатларда ўтказиши учун тегишли шарт-шароитлар билан таъминлаши;</div></div><div class="ACT_TEXT"><div name="5333267" id="5333267">экологик аудиторларга технологик асбоб-ускуналарнинг ишга яроқлилиги ва самарадорлигини аниқлаш нуқтаи назаридан кўздан кечириши, чиқиндилар тўпланадиган ва сақланадиган жойларни, атмосфера ҳавосини, сув ва ер ресурсларини ифлослантирувчи манбаларни текшириш, биологик ресурсларни сақлаш мақсадида ҳудудни ўрганиши, шунингдек лаборатория синовларини ўтказиш учун зарур бўлган намуна ва нусхалар олиши учун имконият бериши;</div></div><div class="ACT_TEXT"><div name="5333269" id="5333269">экологик аудит жараёнида аниқланган техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар, атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги норматив-ҳуқуқий ҳужжатлар талабларининг бузилишларини бартараф этиши шарт. </div></div><div class="CLAUSE_DEFAULT"><div name="5333274" id="5333274">19-модда. Экологик аудиторлик ташкилотларининг реестри ва Экологик аудиторларнинг реестри </div></div><div class="ACT_TEXT"><div name="5333276" id="5333276">Экологик аудиторлик ташкилотларининг реестри экологик аудиторлик ташкилотларининг рўйхатини ўз ичига олади ва Давлат экология қўмитасининг расмий веб-сайтига жойлаштирилади.</div></div><div class="ACT_TEXT"><div name="5333279" id="5333279">Экологик аудиторларнинг реестри экологик аудиторнинг малака сертификатига эга бўлган экологик аудиторларнинг рўйхатини ўз ичига олади ва Давлат экология қўмитасининг расмий веб-сайтига жойлаштирилади.</div></div><div class="ACT_TEXT"><div name="5333282" id="5333282">Экологик аудиторлик ташкилотларининг реестри ва Экологик аудиторларнинг реестрини юритиш тартиби, унинг шакли ҳамда унга доир талаблар Ўзбекистон Республикаси Вазирлар Маҳкамаси томонидан белгиланади. </div></div><div class="CLAUSE_DEFAULT"><div name="5333286" id="5333286">20-модда. Экологик аудиторларнинг жамоат бирлашмалари</div></div><div class="ACT_TEXT"><div name="5333288" id="5333288">Экологик аудиторларнинг жамоат бирлашмалари экологик аудиторларни ихтиёрий асосда бирлаштирадиган нодавлат нотижорат ташкилотларидан иборатдир. </div></div><div class="ACT_TEXT"><div name="5333289" id="5333289">Экологик аудиторлар жамоат бирлашмаларининг фаолияти экологик аудиторларнинг касбий даражасини ривожлантиришга ва қўллаб-қувватлашга, уларнинг касбий манфаатларини ҳимоя қилишга қаратилган.</div></div><div class="ACT_TEXT"><div name="5333291" id="5333291">Экологик аудиторларнинг жамоат бирлашмалари:</div></div><div class="ACT_TEXT"><div name="5333295" id="5333295">экологик аудиторларнинг жамоат бирлашмалари аъзоларининг ҳисобини юритади ва улар ҳақидаги маълумотларни ўзининг веб-сайтларига жойлаштиради; </div></div><div class="ACT_TEXT"><div name="5333297" id="5333297">экологик аудиторларни ўқитиш дастурларини ишлаб чиқишда иштирок этади;</div></div><div class="ACT_TEXT"><div name="5333298" id="5333298">экологик аудиторнинг малака сертификатини олиш учун малака имтиҳонларини ташкил этиш ва ўтказишда иштирок этади;</div></div><div class="ACT_TEXT"><div name="5333301" id="5333301">экологик аудит тўғрисидаги қонунчиликни такомиллаштириш бўйича таклифлар тайёрлайди. </div></div><div class="CLAUSE_DEFAULT"><div name="5333315" id="5333315">21-модда. Низоларни ҳал этиш</div></div><div class="ACT_TEXT"><div name="5333318" id="5333318">Экологик аудиторлик фаолиятини амалга ошириш чоғида юзага келадиган низолар қонунчиликда белгиланган тартибда ҳал этилади.</div></div><div class="CLAUSE_DEFAULT"><div name="5333323" id="5333323">22-модда. Экологик аудит тўғрисидаги қонунчиликни бузганлик учун жавобгарлик</div></div><div class="ACT_TEXT"><div name="5333328" id="5333328">Экологик аудит тўғрисидаги қонунчиликни бузганликда айбдор шахслар белгиланган тартибда жавобгар бўлади.</div></div><div class="CLAUSE_DEFAULT"><div name="5333333" id="5333333">23-модда. Ушбу Қонуннинг ижросини, етказилишини, моҳияти ва аҳамияти тушунтирилишини таъминлаш</div></div><div class="ACT_TEXT"><div name="5333335" id="5333335">Давлат экология қўмитаси ва манфаатдор ташкилотлар ушбу Қонуннинг ижросини, ижрочиларга етказилишини ҳамда моҳияти ва аҳамияти аҳоли ўртасида тушунтирилишини таъминласин. </div></div><div class="CLAUSE_DEFAULT"><div name="5333340" id="5333340">24-модда. Қонунчиликни ушбу Қонунга мувофиқлаштириш</div></div><div class="ACT_TEXT"><div name="5333345" id="5333345">Ўзбекистон Республикаси Вазирлар Маҳкамаси:</div></div><div class="ACT_TEXT"><div name="5333346" id="5333346">ҳукумат қарорларини ушбу Қонунга мувофиқлаштирсин;</div></div><div class="ACT_TEXT"><div name="5333349" id="5333349">давлат бошқаруви органлари ушбу Қонунга зид бўлган ўз норматив-ҳуқуқий ҳужжатларини қайта кўриб чиқишлари ва бекор қилишларини таъминласин.</div></div><div class="CLAUSE_DEFAULT"><div name="5333353" id="5333353">25-модда. Ушбу Қонуннинг кучга кириши</div></div><div class="ACT_TEXT"><div name="5333368" id="5333368">Ушбу Қонун расмий эълон қилинган кундан эътиборан ўн икки ой ўтгач кучга киради.</div></div><div class="SIGNATURE"><div name="5333377" id="5333377">Ўзбекистон Республикасининг Президенти Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="5333379" id="5333379">Тошкент ш.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="5333392" id="5333392">2021 йил 15 март,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="5333396" id="5333396">ЎРҚ-678-сон</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="5332692" id="5332692">(Қонун ҳужжатлари маълумотлари миллий базаси, 16.03.2021 й., 03/21/678/0205-сон; Қонунчилик маълумотлари миллий базаси, 16.01.2024 й., 03/24/896/0037-сон)</div></div></div>
