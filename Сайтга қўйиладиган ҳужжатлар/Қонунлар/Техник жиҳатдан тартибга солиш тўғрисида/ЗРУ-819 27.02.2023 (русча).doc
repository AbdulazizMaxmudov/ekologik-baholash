<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="6393628" id="6393628">Закон Республики Узбекистан</div></div><div class="ACT_TITLE"><div name="6393630" id="6393630">О техническом регулировании</div></div><div class="GRIF_PARLAMENT"><div name="6393632" id="6393632">Принят Законодательной палатой 15 июля 2022 года<br />Одобрен Сенатом 27 декабря 2022 года</div></div><div class="BY_DEFAULT"><div name="6393636" id="6393636"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="6393637" id="6393637">Глава 1. Общие положения</div></div><div class="CLAUSE_DEFAULT"><div name="6393639" id="6393639">Статья 1. Цель настоящего Закона</div></div><div class="ACT_TEXT"><div name="6393643" id="6393643">Целью настоящего Закона является регулирование отношений в области технического регулирования.</div></div><div class="CLAUSE_DEFAULT"><div name="6393645" id="6393645">Статья 2. Сфера применения настоящего Закона</div></div><div class="ACT_TEXT"><div name="6393647" id="6393647">Действие настоящего Закона распространяется на отношения, возникающие при разработке, принятии и применении технических регламентов, оценке соответствия и осуществлении государственного контроля в области технического регулирования.</div></div><div class="ACT_TEXT"><div name="6393648" id="6393648">Действие настоящего Закона не распространяется на отношения, связанные:</div></div><div class="ACT_TEXT"><div name="6393650" id="6393650">с санитарными, фитосанитарными и ветеринарными мерами;</div></div><div class="ACT_TEXT"><div name="6393652" id="6393652">с мерами в области охраны труда;</div></div><div class="ACT_TEXT"><div name="6393653" id="6393653">со стандартами бухгалтерского учета;</div></div><div class="ACT_TEXT"><div name="6393656" id="6393656">со стандартами эмиссии ценных бумаг и проспектами эмиссии ценных бумаг, стандартами оценочной деятельности;</div></div><div class="ACT_TEXT"><div name="6393657" id="6393657">со стандартами медицинской помощи;</div></div><div class="ACT_TEXT"><div name="6393659" id="6393659">с государственными образовательными стандартами.</div></div><div class="CLAUSE_DEFAULT"><div name="6393661" id="6393661">Статья 3. Законодательство о техническом регулировании</div></div><div class="ACT_TEXT"><div name="6393662" id="6393662">Законодательство о техническом регулировании состоит из настоящего Закона и иных актов законодательства.</div></div><div class="ACT_TEXT"><div name="6393664" id="6393664">Если международным договором Республики Узбекистан установлены иные правила, чем те, которые предусмотрены законодательством Республики Узбекистан о техническом регулировании, то применяются правила международного договора.</div></div><div class="CLAUSE_DEFAULT"><div name="6393666" id="6393666">Статья 4. Основные понятия</div></div><div class="ACT_TEXT"><div name="6393667" id="6393667">В настоящем Законе применяются следующие основные понятия:</div></div><div class="ACT_TEXT"><div name="6393668" id="6393668"><strong>заявитель</strong> — физическое или юридическое лицо, предоставившее продукцию для проведения оценки соответствия;</div></div><div class="ACT_TEXT"><div name="6393669" id="6393669"><strong>орган государственного контроля</strong> — орган государственного управления, уполномоченный на осуществление государственного контроля за соблюдением требований нормативных документов в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393670" id="6393670"><strong>уполномоченный представитель производителя</strong> — субъект предпринимательства, который на основании договора с производителем (с иностранным производителем) осуществляет от его имени действия при оценке соответствия и выпуске продукции в обращение на территории Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="6393671" id="6393671"><strong>продукция</strong> — результат деятельности, представленный в материально-вещественной форме и предназначенный для использования в хозяйственных и иных целях;</div></div><div class="ACT_TEXT"><div name="6393673" id="6393673"><strong>выпуск продукции в обращение</strong> — поставка (реализация) или ввоз продукции (отправка со склада производителя или отгрузка без складирования) в целях распространения на территории Республики Узбекистан в рамках осуществления предпринимательской деятельности;</div></div><div class="ACT_TEXT"><div name="6393675" id="6393675"><strong>декларация о соответствии</strong> — документ, которым производитель, уполномоченный представитель производителя, продавец или импортер удостоверяют соответствие выпускаемой в обращение продукции требованиям нормативных документов в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393676" id="6393676"><strong>декларирование соответствия</strong> — форма обязательного подтверждения соответствия продукции требованиям нормативных документов в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393678" id="6393678"><strong>технический барьер в торговле</strong> — препятствие, возникающее в торговле между странами вследствие различного применения обязательных требований к продукции и процедурам оценки соответствия в зависимости от страны (места) происхождения продукции;</div></div><div class="ACT_TEXT"><div name="6393680" id="6393680"><strong>испытательная лаборатория</strong> — юридическое лицо или его структурное подразделение, осуществляющее испытание;</div></div><div class="ACT_TEXT"><div name="6393681" id="6393681"><strong>продавец</strong> — субъект предпринимательства — резидент Республики Узбекистан, реализующий продукцию;</div></div><div class="ACT_TEXT"><div name="6393684" id="6393684"><strong>техническое регулирование</strong> — установление, применение и исполнение требований к безопасности продукции, процессам и методам ее производства, а также проверка их соблюдения путем оценки соответствия и осуществления государственного контроля;</div></div><div class="ACT_TEXT"><div name="6393685" id="6393685"><strong>нормативные документы в области технического регулирования</strong> — технические регламенты и стандарты;</div></div><div class="ACT_TEXT"><div name="6393687" id="6393687"><strong>технический регламент</strong> — документ, в котором определены обязательные к применению характеристики безопасности продукции или связанные с ними процессы и методы производства, правила;</div></div><div class="ACT_TEXT"><div name="6393688" id="6393688"><strong>услуга</strong> — деятельность, направленная на удовлетворение потребностей физических и юридических лиц, результаты которой не имеют вещественной формы.</div></div><div class="CLAUSE_DEFAULT"><div name="6393690" id="6393690">Статья 5. Основные принципы технического регулирования</div></div><div class="ACT_TEXT"><div name="6393696" id="6393696">Основными принципами технического регулирования являются:</div></div><div class="ACT_TEXT"><div name="6393728" id="6393728">единство применения технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393731" id="6393731">недопустимость дискриминации субъектов предпринимательства и недобросовестной конкуренции в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393732" id="6393732">единство и целостность технического регулирования и оценки соответствия;</div></div><div class="ACT_TEXT"><div name="6393734" id="6393734">независимость органов оценки соответствия от производителей, продавцов и покупателей (потребителей);</div></div><div class="ACT_TEXT"><div name="6393737" id="6393737">единство правил и методов испытания и измерения при проведении процедур обязательной оценки соответствия;</div></div><div class="ACT_TEXT"><div name="6393753" id="6393753">недопустимость совмещения одним органом полномочий по государственному контролю и подтверждению соответствия;</div></div><div class="ACT_TEXT"><div name="6393755" id="6393755">недопустимость дублирования одних и тех же полномочий двумя и более органами государственного контроля.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="6393759" id="6393759">Глава 2. Государственное регулирование в области технического регулирования</div></div><div class="CLAUSE_DEFAULT"><div name="6393761" id="6393761">Статья 6. Государственная система технического регулирования</div></div><div class="ACT_TEXT"><div name="6393762" id="6393762">Государственную систему технического регулирования составляют:</div></div><div class="ACT_TEXT"><div name="6394788" id="6394788">Кабинет Министров Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="6394792" id="6394792">Узбекское агентство по техническому регулированию;</div></div><div class="ACT_TEXT"><div name="6394793" id="6394793">уполномоченные органы государственного управления в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6394796" id="6394796">органы государственного и хозяйственного управления, осуществляющие деятельность в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6394797" id="6394797">национальный орган по стандартизации;</div></div><div class="ACT_TEXT"><div name="6394800" id="6394800">орган по аккредитации;</div></div><div class="ACT_TEXT"><div name="6394801" id="6394801">экспертные комиссии в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6394805" id="6394805">органы по оценке соответствия, испытательные лаборатории.</div></div><div class="CLAUSE_DEFAULT"><div name="6393783" id="6393783">Статья 7. Основные направления государственной политики в области технического регулирования</div></div><div class="ACT_TEXT"><div name="6393786" id="6393786">Основными направлениями государственной политики в области технического регулирования являются:</div></div><div class="ACT_TEXT"><div name="6393788" id="6393788">обеспечение соответствия технического регулирования уровню развития экономики, материально-технической базы, а также уровню научно-технического развития; </div></div><div class="ACT_TEXT"><div name="6393791" id="6393791">разработка и реализация программ развития данной области;</div></div><div class="ACT_TEXT"><div name="6393794" id="6393794">гармонизация данной области с международными (региональными) стандартами;</div></div><div class="ACT_TEXT"><div name="6393796" id="6393796">внедрение передовых инновационных и информационно-коммуникационных технологий;</div></div><div class="ACT_TEXT"><div name="6393797" id="6393797">совершенствование системы подготовки, переподготовки и повышения квалификации кадров;</div></div><div class="ACT_TEXT"><div name="6393799" id="6393799">развитие международного сотрудничества.</div></div><div class="CLAUSE_DEFAULT"><div name="6393801" id="6393801">Статья 8. Полномочия Кабинета Министров Республики Узбекистан в области технического регулирования</div></div><div class="ACT_TEXT"><div name="6393803" id="6393803">Кабинет Министров Республики Узбекистан:</div></div><div class="ACT_TEXT"><div name="6393805" id="6393805">определяет уполномоченные органы государственного управления в области технического регулирования и координирует их деятельность;</div></div><div class="ACT_TEXT"><div name="6393807" id="6393807">координирует деятельность по оценке соответствия органов государственного и хозяйственного управления;</div></div><div class="ACT_TEXT"><div name="6393808" id="6393808">утверждает программу разработки технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393809" id="6393809">утверждает технические регламенты, вносит изменения и дополнения в них, а также отменяет данные регламенты;</div></div><div class="ACT_TEXT"><div name="6393812" id="6393812">определяет орган, назначающий (нотифицирующий) орган по оценке соответствия, утверждает область его деятельности и задачи;</div></div><div class="ACT_TEXT"><div name="6393814" id="6393814">принимает решение о создании информационного центра, устанавливает порядок уведомлений о технических регламентах, стандартах, процедурах оценки соответствия;</div></div><div class="ACT_TEXT"><div name="6393815" id="6393815">утверждает порядок признания в Республике Узбекистан результатов оценки соответствия, проведенной за пределами Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="6393816" id="6393816">утверждает перечень продукции с высоким уровнем риска, подлежащей обязательной государственной регистрации;</div></div><div class="ACT_TEXT"><div name="6393817" id="6393817">устанавливает правила оценки соответствия, порядок регистрации, приостановления, возобновления, прекращения действия деклараций о соответствии;</div></div><div class="ACT_TEXT"><div name="6393831" id="6393831">устанавливает порядок ведения деятельности экспертных комиссий в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393833" id="6393833">утверждает полномочия органов государственного контроля, порядок координации их деятельности по государственному контролю, а также порядок взаимодействия органов государственного контроля с органом по аккредитации;</div></div><div class="ACT_TEXT"><div name="6393836" id="6393836">утверждает порядок принятия соответствующих ограничительных мер, критерии оценки риска; </div></div><div class="ACT_TEXT"><div name="6393838" id="6393838">утверждает порядок функционирования системы оперативного взаимного оповещения о продукции, представляющей высокий риск.</div></div><div class="ACT_TEXT"><div name="6393842" id="6393842">Кабинет Министров Республики Узбекистан может осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6393843" id="6393843">Статья 9. Полномочия Узбекского агентства по техническому регулированию в области технического регулирования</div></div><div class="ACT_TEXT"><div name="6393844" id="6393844">Узбекское агентство по техническому регулированию является специально уполномоченным государственным органом в области технического регулирования (далее — специально уполномоченный государственный орган).</div></div><div class="ACT_TEXT"><div name="6393845" id="6393845">Специально уполномоченный государственный орган:</div></div><div class="ACT_TEXT"><div name="6393847" id="6393847">вносит в Кабинет Министров Республики Узбекистан обобщенные предложения по проектам программ разработки технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393848" id="6393848">координирует деятельность органов государственного и хозяйственного управления по разработке технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393849" id="6393849">вносит в Кабинет Министров Республики Узбекистан предложения об утверждении технических регламентов, о внесении в них изменений и дополнений, а также об отмене указанных регламентов;</div></div><div class="ACT_TEXT"><div name="6393851" id="6393851">создает экспертную комиссию в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393852" id="6393852">проводит экспертизу соответствующих технических регламентов, разработанных органами государственного и хозяйственного управления;</div></div><div class="ACT_TEXT"><div name="6393854" id="6393854">утверждает перечни стандартов, обеспечивающих соблюдение требований технических регламентов и определяющих методы отбора проб, испытаний и измерений, необходимых для оценки соответствия продукции, установленной в технических регламентах;</div></div><div class="ACT_TEXT"><div name="6393855" id="6393855">формирует перечень продукции с высоким уровнем риска, подлежащей обязательной государственной регистрации, а также обеспечивает проведение государственной регистрации данной продукции;</div></div><div class="BY_DEFAULT"><div name="6687801" id="6687801"></div></div><div class="ACT_TEXT"><div name="6687804" id="6687804">осуществляет координацию внедрения международных (региональных) стандартов и технических регламентов министерствами и ведомствами;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="6687806" id="6687806">(абзац девятый части второй статьи 9 в редакции <a href="https://lex.uz/uz/docs/6678809?ONDATE=29.11.2023 01#6680432">Закона </a>Республики Узбекистан от 28 ноября 2023 года № ЗРУ-880 — Национальная база данных законодательства, 29.11.2023 г., № 03/23/880/0905)</div></div><div class="ACT_TEXT"><div name="6393858" id="6393858">осуществляет государственный контроль за соблюдением требований нормативных документов в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393859" id="6393859">обращается в суд по применению финансовых санкций к производителям, уполномоченному представителю производителя, продавцам, импортерам или исполнителям, виновным в нарушении обязательных требований нормативных документов в области технического регулирования; </div></div><div class="ACT_TEXT"><div name="6393862" id="6393862">ведет реестр сведений о продукции, признанной не соответствующей нормативным документам в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393864" id="6393864">ведет реестр сертификатов соответствия и деклараций о соответствии;</div></div><div class="ACT_TEXT"><div name="6393866" id="6393866">утверждает перечень стандартов на продукцию, процессы или методы ее производства, обеспечивающих презумпцию соответствия требованиям технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393869" id="6393869">утверждает методические рекомендации по применению технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393871" id="6393871">формирует и ведет базу данных технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393874" id="6393874">готовит предложения по заключению международных договоров Республики Узбекистан о взаимном признании результатов оценки соответствия и по другим вопросам в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393875" id="6393875">осуществляет международное сотрудничество в области технического регулирования.</div></div><div class="ACT_TEXT"><div name="6393878" id="6393878">Специально уполномоченный государственный орган может осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6393880" id="6393880">Статья 10. Уполномоченные органы государственного управления в области технического регулирования</div></div><div class="ACT_TEXT"><div name="6393883" id="6393883">Уполномоченные органы государственного управления в области технического регулирования (далее — уполномоченные органы государственного управления) в пределах своих полномочий:</div></div><div class="ACT_TEXT"><div name="6393886" id="6393886">вносят предложения специально уполномоченному государственному органу по проектам программ разработки технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393887" id="6393887">обеспечивают разработку технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393890" id="6393890">обеспечивают разработку методических рекомендаций по применению технических регламентов и утверждают их в установленном порядке;</div></div><div class="ACT_TEXT"><div name="6393892" id="6393892">создают экспертные комиссии в области технического регулирования;</div></div><div class="ACT_TEXT"><div name="6393894" id="6393894">проводят экспертизу технических регламентов, разработанных органами государственного и хозяйственного управления;</div></div><div class="ACT_TEXT"><div name="6393952" id="6393952">подготавливают предложения по внесению в технические регламенты изменений и дополнений, а также по отмене указанных регламентов;</div></div><div class="ACT_TEXT"><div name="6393968" id="6393968">осуществляют государственный контроль за соблюдением требований технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393971" id="6393971">участвуют в формировании базы данных технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393972" id="6393972">осуществляют международное сотрудничество в области технического регулирования.</div></div><div class="ACT_TEXT"><div name="6393974" id="6393974">Уполномоченные органы государственного управления могут осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6393976" id="6393976">Статья 11. Полномочия органов государственного и хозяйственного управления в области технического регулирования</div></div><div class="ACT_TEXT"><div name="6393979" id="6393979">Органы государственного и хозяйственного управления в пределах своих полномочий:</div></div><div class="ACT_TEXT"><div name="6393981" id="6393981">вносят предложения в специально уполномоченный государственный орган по проектам программ разработки технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393982" id="6393982">осуществляют разработку технических регламентов и методических рекомендаций по их применению;</div></div><div class="ACT_TEXT"><div name="6393984" id="6393984">подготавливают предложения о внесении в технические регламенты изменений и дополнений, а также об отмене указанных регламентов;</div></div><div class="ACT_TEXT"><div name="6393986" id="6393986">участвуют в формировании базы данных технических регламентов;</div></div><div class="ACT_TEXT"><div name="6393988" id="6393988">осуществляют контроль за соблюдением технических регламентов в порядке, установленном законодательством.</div></div><div class="ACT_TEXT"><div name="6393990" id="6393990">Органы государственного и хозяйственного управления могут осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6393992" id="6393992">Статья 12. Экспертные комиссии в области технического регулирования</div></div><div class="ACT_TEXT"><div name="6393995" id="6393995">Экспертные комиссии в области технического регулирования формируются при специально уполномоченном государственном органе и уполномоченных органах государственного управления.</div></div><div class="ACT_TEXT"><div name="6393996" id="6393996">В состав экспертной комиссии в области технического регулирования входят представители государственных органов, субъектов предпринимательства соответствующих отраслей экономики, специалисты научно-исследовательских институтов, лабораторий, а также другие специалисты, необходимые для экспертизы технических регламентов.</div></div><div class="ACT_TEXT"><div name="6393998" id="6393998">Экспертные комиссии в области технического регулирования проводят экспертизу проектов технических регламентов, изменений и дополнений в них, а также готовят предложения по отмене действующих технических регламентов и заключения по ним. </div></div><div class="ACT_TEXT"><div name="6394000" id="6394000">Деятельность экспертных комиссий в области технического регулирования осуществляется в порядке, установленном Кабинетом Министров Республики Узбекистан.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="6394002" id="6394002">Глава 3. Технические регламенты</div></div><div class="CLAUSE_DEFAULT"><div name="6394003" id="6394003">Статья 13. Цели технических регламентов </div></div><div class="ACT_TEXT"><div name="6394004" id="6394004">Технические регламенты принимаются в целях:</div></div><div class="ACT_TEXT"><div name="6394006" id="6394006">охраны жизни или здоровья граждан путем установления требований безопасности продукции;</div></div><div class="ACT_TEXT"><div name="6394008" id="6394008">охраны окружающей среды, животного и растительного мира;</div></div><div class="ACT_TEXT"><div name="6394010" id="6394010">предупреждения действий, вводящих в заблуждение покупателей (потребителей);</div></div><div class="ACT_TEXT"><div name="6394011" id="6394011">обеспечения энергетической эффективности и рационального использования природных ресурсов;</div></div><div class="ACT_TEXT"><div name="6394013" id="6394013">предотвращения технических барьеров в торговле;</div></div><div class="ACT_TEXT"><div name="6394015" id="6394015">повышения конкурентоспособности продукции на внутреннем и внешнем рынках.</div></div><div class="CLAUSE_DEFAULT"><div name="6394017" id="6394017">Статья 14. Содержание технических регламентов</div></div><div class="ACT_TEXT"><div name="6394019" id="6394019">Технические регламенты с учетом степени риска причинения вреда и опасности продукции могут устанавливать требования, обеспечивающие:</div></div><div class="ACT_TEXT"><div name="6394021" id="6394021">биологическую безопасность;</div></div><div class="ACT_TEXT"><div name="6394022" id="6394022">механическую безопасность;</div></div><div class="ACT_TEXT"><div name="6394024" id="6394024">химическую безопасность;</div></div><div class="ACT_TEXT"><div name="6394026" id="6394026">ядерную и радиационную безопасность;</div></div><div class="ACT_TEXT"><div name="6394028" id="6394028">пожарную безопасность;</div></div><div class="ACT_TEXT"><div name="6394029" id="6394029">электрическую безопасность;</div></div><div class="ACT_TEXT"><div name="6394031" id="6394031">безопасность эксплуатации (использования) и утилизации машин и оборудования;</div></div><div class="ACT_TEXT"><div name="6394033" id="6394033">электромагнитную совместимость;</div></div><div class="ACT_TEXT"><div name="6394034" id="6394034">экологическую безопасность;</div></div><div class="ACT_TEXT"><div name="6394036" id="6394036">промышленную и производственную безопасность;</div></div><div class="ACT_TEXT"><div name="6394038" id="6394038">взрывобезопасность;</div></div><div class="ACT_TEXT"><div name="6394044" id="6394044">информационную безопасность;</div></div><div class="ACT_TEXT"><div name="6394046" id="6394046">единство методов испытаний и измерений, а также другие требования по обеспечению безопасности продукции.</div></div><div class="ACT_TEXT"><div name="6394048" id="6394048">Технические регламенты должны содержать:</div></div><div class="ACT_TEXT"><div name="6394049" id="6394049">полный перечень продукции, в отношении которой устанавливаются требования безопасности;</div></div><div class="ACT_TEXT"><div name="6394051" id="6394051">правила, формы и процедуры оценки соответствия, определяемые с учетом степени риска.</div></div><div class="ACT_TEXT"><div name="6394053" id="6394053">Технические регламенты могут содержать схемы подтверждения соответствия, порядок продления срока действия выданного сертификата соответствия, требования к терминологии, упаковке, маркировке или этикеткам и правилам их нанесения.</div></div><div class="ACT_TEXT"><div name="6394055" id="6394055">В технических регламентах не должны содержаться требования к конструкции продукции и ее выполнению, за исключением случаев, когда из-за отсутствия требований к ее конструкции и выполнению с учетом степени риска причинения вреда жизни и здоровью человека не обеспечивается безопасность продукции.</div></div><div class="ACT_TEXT"><div name="6394056" id="6394056">В технических регламентах могут содержаться требования, касающиеся информирования покупателей (потребителей) о возможном вреде и факторах, от которых зависит риск причинения вреда жизни и здоровью человека, окружающей среде, животному и растительному миру.</div></div><div class="ACT_TEXT"><div name="6394058" id="6394058">В технических регламентах могут содержаться следующие специальные требования к безопасности продукции:</div></div><div class="ACT_TEXT"><div name="6394060" id="6394060">требования по охране жизни и здоровья отдельных категорий граждан, установленные законодательством;</div></div><div class="ACT_TEXT"><div name="6394061" id="6394061">требования к сохранению жизни и здоровья человека при чрезвычайных ситуациях природного и техногенного характера, уменьшению вреда окружающей среде и материального ущерба, а также требования относительно трансграничных опасных производственных объектов, создающих угрозу имуществу физических и юридических лиц, государственному имуществу.</div></div><div class="ACT_TEXT"><div name="6394063" id="6394063">Технические регламенты, содержащие сведения, составляющие государственные секреты и иную охраняемую законом тайну, разрабатываются и принимаются в порядке, установленном законодательством.</div></div><div class="ACT_TEXT"><div name="6394065" id="6394065">Технические регламенты являются исчерпывающими, имеют прямое действие на всей территории Республики Узбекистан и могут быть изменены и дополнены только путем внесения в них изменений и дополнений.</div></div><div class="CLAUSE_DEFAULT"><div name="6394067" id="6394067">Статья 15. Порядок разработки и принятия технических регламентов</div></div><div class="ACT_TEXT"><div name="6394069" id="6394069">Технические регламенты разрабатываются в соответствии с утвержденной программой разработки технических регламентов.</div></div><div class="ACT_TEXT"><div name="6394070" id="6394070">Международные (региональные) стандарты должны использоваться полностью или частично в качестве основы при разработке проектов технических регламентов, за исключением случаев, когда международные (региональные) стандарты или их разделы являются неэффективными либо несоответствующими для достижения целей технических регламентов, установленных <a href="https://lex.uz/uz/docs/6392314#6394003">статьей 13</a> настоящего Закона, в том числе в силу климатических и географических особенностей.</div></div><div class="ACT_TEXT"><div name="6394072" id="6394072">Национальные стандарты, гармонизированные с международными (региональными) стандартами, также могут быть использованы полностью или частично при разработке проектов технических регламентов.</div></div><div class="ACT_TEXT"><div name="6394074" id="6394074">Требования технических регламентов не должны создавать больше технических препятствий, чем цели технического регламента, установленные <a href="https://lex.uz/uz/docs/6392314#6394003">статьей 13</a> настоящего Закона.</div></div><div class="ACT_TEXT"><div name="6394075" id="6394075">Разработчики технических регламентов публикуют на своих официальных веб-сайтах сообщения о разработке технических регламентов не позднее десяти рабочих дней со дня их разработки и уведомляют об этом заинтересованные стороны.</div></div><div class="ACT_TEXT"><div name="6394077" id="6394077">Если разработка технических регламентов или внесение изменений и дополнений в технические регламенты может существенно повлиять на импорт или экспорт продукции и Республикой Узбекистан заключены двусторонние либо многосторонние договоры с иностранными государствами, по запросу этих государств орган, разрабатывающий технические регламенты, должен разъяснить причины разработки технических регламентов.</div></div><div class="ACT_TEXT"><div name="6394079" id="6394079">Разработчики технических регламентов обеспечивают обсуждение проекта технического регламента в течение двух месяцев со дня их размещения на официальном веб-сайте.</div></div><div class="ACT_TEXT"><div name="6394080" id="6394080">После получения заключения экспертной комиссии в области технического регулирования разработчик технического регламента вносит проект технического регламента на утверждение в Кабинет Министров Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6394082" id="6394082">Технические регламенты вводятся в действие не ранее чем через шесть месяцев с момента их официального опубликования.</div></div><div class="CLAUSE_DEFAULT"><div name="6394084" id="6394084">Статья 16. Пересмотр или отмена технических регламентов</div></div><div class="ACT_TEXT"><div name="6394087" id="6394087">Разработчики технических регламентов пересматривают их на предмет актуальности и соответствия целям, установленным <a href="https://lex.uz/uz/docs/6392314#6394003">статьей 13</a> настоящего Закона.</div></div><div class="ACT_TEXT"><div name="6394088" id="6394088">В случае, если обстоятельств или причин, вызвавших принятие технических регламентов, больше не существует либо если изменившиеся обстоятельства или причины позволяют использовать способы, оказывающие менее ограничивающее воздействие на торговлю, в технические регламенты вносятся соответствующие изменения и (или) дополнения или технические регламенты отменяются.</div></div><div class="ACT_TEXT"><div name="6394089" id="6394089">Технические регламенты пересматриваются начиная со дня:</div></div><div class="ACT_TEXT"><div name="6394090" id="6394090">вступления их в силу;</div></div><div class="ACT_TEXT"><div name="6394091" id="6394091">вступления в силу изменений и (или) дополнений в них, которые были внесены по результатам предварительного пересмотра технических регламентов;</div></div><div class="ACT_TEXT"><div name="6394092" id="6394092">предоставления соответствующими уполномоченными государственными органами информации об оставлении их без изменения по результатам предварительного пересмотра не реже одного раза в пять лет.</div></div><div class="CLAUSE_DEFAULT"><div name="6394093" id="6394093">Статья 17. Презумпция соответствия стандартов техническим регламентам</div></div><div class="ACT_TEXT"><div name="6394094" id="6394094">Продукция, процессы или методы ее производства признаются соответствующими требованиям технического регламента, если они соответствуют требованиям стандартов, на которые ссылается технический регламент.</div></div><div class="ACT_TEXT"><div name="6394095" id="6394095">Перечень стандартов на продукцию, процессы или методы ее производства, обеспечивающих презумпцию соответствия требованиям технических регламентов, публикуется специально уполномоченным государственным органом на своем официальном веб-сайте.</div></div><div class="CLAUSE_DEFAULT"><div name="6394097" id="6394097">Статья 18. Применение технических регламентов и переходный период</div></div><div class="ACT_TEXT"><div name="6394099" id="6394099">Технические регламенты применяются одинаковым образом и в равной мере независимо от страны и (или) места происхождения продукции, а также формы собственности производителя, уполномоченного представителя производителя, продавца и импортера продукции.</div></div><div class="ACT_TEXT"><div name="6394101" id="6394101">В случае, если технический регламент содержит ссылку на стандарт или его отдельную часть, данный стандарт или его отдельная часть являются обязательными для исполнения. </div></div><div class="ACT_TEXT"><div name="6394102" id="6394102">Технический регламент должен предусматривать срок и условия введения его в действие, устанавливающие время переходного периода, в течение которого должны быть учтены вопросы, связанные с введением в действие технического регламента и выпуском продукции. </div></div><div class="ACT_TEXT"><div name="6394104" id="6394104">Если продукция, включенная в технический регламент, выпускается в обращение и не соответствует требованиям данного технического регламента, в течение переходного периода ее использование не может быть запрещено или ограничено.</div></div><div class="ACT_TEXT"><div name="6394106" id="6394106">Переходный период не устанавливается, если по итогам пересмотра технического регламента технические требования к продукции не изменились или изменились незначительно. </div></div><div class="ACT_TEXT"><div name="6394107" id="6394107">Техническими регламентами или нормативно-правовыми актами, которыми они утверждены, могут быть установлены также иные условия переходного периода применения технических регламентов.</div></div><div class="ACT_TEXT"><div name="6394110" id="6394110">Производитель имеет право применить требования технического регламента, не вступившего в силу, в течение переходного периода, а также использовать документы, подтверждающие соответствие продукции.</div></div><div class="CLAUSE_DEFAULT"><div name="6394114" id="6394114">Статья 19. Методические рекомендации по применению технических регламентов</div></div><div class="ACT_TEXT"><div name="6394120" id="6394120">Разработчики технических регламентов одновременно разрабатывают методические рекомендации по применению технических регламентов, которые разъясняют установленные в них положения и обеспечивают последовательное применение данных регламентов.</div></div><div class="ACT_TEXT"><div name="6394122" id="6394122">Методические рекомендации по применению технических регламентов размещаются на официальных веб-сайтах разработчиков технических регламентов и уполномоченных органов государственного управления, утвердивших соответствующие методические рекомендации, не позднее пяти рабочих дней со дня их утверждения.</div></div><div class="CLAUSE_DEFAULT"><div name="6394124" id="6394124">Статья 20. Информирование</div></div><div class="ACT_TEXT"><div name="6394126" id="6394126">В случае разработки нового технического регламента или внесения изменений в действующие разработчики технических регламентов информируют заинтересованные стороны через информационный центр о:</div></div><div class="ACT_TEXT"><div name="6394127" id="6394127">начале разработки технического регламента;</div></div><div class="ACT_TEXT"><div name="6394129" id="6394129">продукции, на которую может распространяться технический регламент, с описанием и объяснением цели, в соответствии с которой он разрабатывается;</div></div><div class="ACT_TEXT"><div name="6394131" id="6394131">предоставлении двухмесячного срока для получения замечаний по проекту технического регламента.</div></div><div class="ACT_TEXT"><div name="6394132" id="6394132">Порядок и процедуры уведомления о технических регламентах, стандартах, процедурах оценки соответствия устанавливаются Кабинетом Министров Республики Узбекистан.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="6394133" id="6394133">Глава 4. Оценка и подтверждение соответствия</div></div><div class="CLAUSE_DEFAULT"><div name="6394135" id="6394135">Статья 21. Оценка соответствия</div></div><div class="ACT_TEXT"><div name="6394137" id="6394137">Оценкой соответствия является деятельность по определению соответствия продукции, производственных процессов, услуг, систем менеджмента, персонала требованиям нормативных документов в области технического регулирования.</div></div><div class="ACT_TEXT"><div name="6394139" id="6394139">Органом по оценке соответствия является юридическое лицо, выполняющее процедуры оценки соответствия.</div></div><div class="ACT_TEXT"><div name="6394140" id="6394140">Процедурой оценки соответствия является процедура, применяемая прямо или косвенно с целью определения соблюдения соответствующих требований, содержащихся в нормативных документах в области технического регулирования. К процедурам оценки соответствия относятся отбор образцов, испытание и проверка, оценка и подтверждение соответствия, государственная регистрация, а также их комбинация.</div></div><div class="CLAUSE_DEFAULT"><div name="6394142" id="6394142">Статья 22. Объекты оценки соответствия</div></div><div class="ACT_TEXT"><div name="6394143" id="6394143">Объектами оценки соответствия являются продукция, производственные процессы, услуги, система менеджмента и персонал.</div></div><div class="ACT_TEXT"><div name="6394144" id="6394144">Объекты оценки соответствия определяются нормативными документами в области технического регулирования.</div></div><div class="CLAUSE_DEFAULT"><div name="6394145" id="6394145">Статья 23. Формы подтверждения соответствия</div></div><div class="ACT_TEXT"><div name="6394146" id="6394146">Подтверждение соответствия осуществляется путем применения процедур оценки соответствия, которые определены в технических регламентах или правилах оценки соответствия.</div></div><div class="ACT_TEXT"><div name="6394148" id="6394148">Подтверждение соответствия может быть обязательным или добровольным.</div></div><div class="ACT_TEXT"><div name="6394150" id="6394150">Обязательное подтверждение соответствия, установленное в технических регламентах, осуществляется в форме:</div></div><div class="ACT_TEXT"><div name="6394151" id="6394151">декларирования соответствия;</div></div><div class="ACT_TEXT"><div name="6394153" id="6394153">обязательной сертификации.</div></div><div class="ACT_TEXT"><div name="6394155" id="6394155">Добровольное подтверждение соответствия осуществляется в форме добровольной сертификации.</div></div><div class="CLAUSE_DEFAULT"><div name="6394157" id="6394157">Статья 24. Обязательное подтверждение соответствия</div></div><div class="ACT_TEXT"><div name="6394158" id="6394158">Обязательное подтверждение соответствия обеспечивается путем подтверждения соответствия продукции требованиям технических регламентов.</div></div><div class="ACT_TEXT"><div name="6394160" id="6394160">Объектом обязательного подтверждения соответствия может быть только продукция, выпускаемая в обращение на территории Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6394162" id="6394162">Декларация о соответствии и сертификат соответствия имеют равную юридическую силу и действуют на всей территории Республики Узбекистан в отношении продукции, выпускаемой в обращение во время действия декларации о соответствии или сертификата соответствия, в течение срока годности либо срока службы продукции. </div></div><div class="ACT_TEXT"><div name="6394163" id="6394163">Стоимость работ по обязательному подтверждению соответствия определяется независимо от страны и (или) места происхождения продукции, а также статуса заявителя.</div></div><div class="CLAUSE_DEFAULT"><div name="6394165" id="6394165">Статья 25. Добровольное подтверждение соответствия</div></div><div class="ACT_TEXT"><div name="6394166" id="6394166">Добровольное подтверждение соответствия осуществляется по инициативе заявителя на условиях договора между заявителем и органом по оценке соответствия.</div></div><div class="ACT_TEXT"><div name="6394168" id="6394168">Объектами добровольного подтверждения соответствия могут быть продукция, производственные процессы, услуги, система менеджмента и другие объекты, требования к которым установлены стандартами и условиями договоров.</div></div><div class="ACT_TEXT"><div name="6394170" id="6394170">Добровольное подтверждение соответствия может осуществляться для установления соответствия стандартам, условиям договоров.</div></div><div class="CLAUSE_DEFAULT"><div name="6394171" id="6394171">Статья 26. Декларация о соответствии</div></div><div class="ACT_TEXT"><div name="6394173" id="6394173">Декларация о соответствии оформляется в отношении продукции, подлежащей обязательному подтверждению соответствия, если это предусмотрено техническими регламентами.</div></div><div class="ACT_TEXT"><div name="6394175" id="6394175">Декларация о соответствии оформляется в двух экземплярах.</div></div><div class="ACT_TEXT"><div name="6394177" id="6394177">Декларирование соответствия осуществляется по одной из следующих схем:</div></div><div class="ACT_TEXT"><div name="6394179" id="6394179">принятие декларации о соответствии на основании собственных доказательств;</div></div><div class="ACT_TEXT"><div name="6394181" id="6394181">принятие декларации о соответствии на основании собственных доказательств и доказательств, полученных с участием органа по оценке соответствия и (или) аккредитованной испытательной лаборатории (далее — третья сторона).</div></div><div class="ACT_TEXT"><div name="6394183" id="6394183">Лицами, принимающими декларацию о соответствии, являются производитель, уполномоченный представитель производителя, продавец или импортер.</div></div><div class="ACT_TEXT"><div name="6394184" id="6394184">Действие декларации о соответствии на серийно выпускаемую продукцию и на партию продукции устанавливается схемой подтверждения соответствия.</div></div><div class="ACT_TEXT"><div name="6394186" id="6394186">Оформленная декларация о соответствии подлежит регистрации в реестре сертификатов соответствия и деклараций о соответствии органом по оценке соответствия, область аккредитации которого включает данный вид продукции, по заявлению лиц, предусмотренных в <a href="https://lex.uz/uz/docs/6392314#6394184">части пятой</a> настоящей статьи. Декларация о соответствии считается действительной с момента ее регистрации в реестре сертификатов соответствия и деклараций о соответствии.</div></div><div class="ACT_TEXT"><div name="6394188" id="6394188">Круг заявителей устанавливается соответствующим техническим регламентом. Схема декларирования соответствия с участием третьей стороны устанавливается в техническом регламенте в случае, если отсутствие третьей стороны приводит к недостижению целей подтверждения соответствия.</div></div><div class="ACT_TEXT"><div name="6394190" id="6394190">В качестве доказательств используются техническая документация, результаты собственных испытаний и измерений и (или) другие документы, послужившие основанием для подтверждения соответствия продукции требованиям, установленным техническими регламентами.</div></div><div class="ACT_TEXT"><div name="6394191" id="6394191">При декларировании соответствия на основании собственных доказательств и доказательств, полученных с участием органа по оценке соответствия, заявитель по своему выбору, кроме собственных доказательств, вправе использовать протоколы испытаний и измерений, проведенных в лаборатории, представить сертификат системы менеджмента качества.</div></div><div class="ACT_TEXT"><div name="6394193" id="6394193">Сертификат системы менеджмента качества может использоваться в составе доказательств при принятии декларации о соответствии, за исключением случая, если для такой продукции техническими регламентами предусмотрена иная форма подтверждения соответствия.</div></div><div class="ACT_TEXT"><div name="6394308" id="6394308">Срок действия декларации о соответствии устанавливается техническим регламентом.</div></div><div class="ACT_TEXT"><div name="6394309" id="6394309">После окончания срока действия декларации о соответствии один экземпляр декларации о соответствии и материалы, использованные в качестве доказательств, хранятся у заявителя, а другой экземпляр хранится в органе по оценке соответствия, зарегистрировавшем ее, в течение пяти лет.</div></div><div class="ACT_TEXT"><div name="6394310" id="6394310">Регистрация, приостановление, возобновление, прекращение действия деклараций о соответствии осуществляются в порядке, установленном Кабинетом Министров Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="6394311" id="6394311">Статья 27. Сертификат соответствия</div></div><div class="ACT_TEXT"><div name="6394312" id="6394312">Сертификатом соответствия является документ, подтверждающий соответствие объектов оценки соответствия требованиям, установленным нормативными документами в области технического регулирования.</div></div><div class="ACT_TEXT"><div name="6394313" id="6394313">Орган по оценке соответствия осуществляет сертификацию на основании договора с заявителем.</div></div><div class="ACT_TEXT"><div name="6394314" id="6394314">Сертификацией является процедура подтверждения соответствия объектов оценки соответствия органом по оценке соответствия требованиям, установленным нормативными документами в области технического регулирования.</div></div><div class="ACT_TEXT"><div name="6394315" id="6394315">Схемы сертификации, применяемые для сертификации определенных видов продукции, круг заявителей устанавливаются соответствующими техническими регламентами.</div></div><div class="ACT_TEXT"><div name="6394316" id="6394316">Сертификат соответствия выдается заявителю органом по оценке соответствия при условии положительных результатов выполнения всех процедур согласно выбранной схеме подтверждения соответствия.</div></div><div class="ACT_TEXT"><div name="6394317" id="6394317">Заявителями при получении сертификата соответствия могут быть производитель, уполномоченный представитель производителя, продавец или импортер.</div></div><div class="ACT_TEXT"><div name="6394318" id="6394318">Формы сертификата соответствия и порядок их оформления утверждаются специально уполномоченным государственным органом.</div></div><div class="ACT_TEXT"><div name="6394331" id="6394331">Сертификат соответствия подлежит регистрации в реестре сертификатов соответствия и деклараций о соответствии.</div></div><div class="ACT_TEXT"><div name="6394332" id="6394332">Срок действия сертификата соответствия устанавливается техническими регламентами или правилами оценки соответствия исходя из схемы подтверждения соответствия.</div></div><div class="CLAUSE_DEFAULT"><div name="6394333" id="6394333">Статья 28. Знак соответствия</div></div><div class="ACT_TEXT"><div name="6394335" id="6394335">Знак соответствия служит для информирования покупателей о том, что объекты оценки соответствия прошли процедуру подтверждения соответствия требованиям, установленным нормативными документами в области технического регулирования.</div></div><div class="ACT_TEXT"><div name="6394336" id="6394336">Знак соответствия применяется при маркировке продукции, прошедшей процедуру подтверждения соответствия.</div></div><div class="ACT_TEXT"><div name="6394337" id="6394337">Форма знака соответствия, технические требования к нему и порядок маркировки определяются национальными стандартами.</div></div><div class="ACT_TEXT"><div name="6394338" id="6394338">Производитель, уполномоченный представитель производителя, продавец или импортер, владеющий сертификатом соответствия, вправе применять знак соответствия любыми удобными для себя способами, установленными национальными стандартами.</div></div><div class="ACT_TEXT"><div name="6394339" id="6394339">Не допускается маркировка знаком соответствия продукции, подлежащей обязательному подтверждению соответствия и не прошедшей подтверждения соответствия по требованиям, установленным техническими регламентами.</div></div><div class="ACT_TEXT"><div name="6394340" id="6394340">При сертификации продукции отечественными производителями и импортерами право применения знака соответствия предоставляется им на основании соглашения с органом по сертификации, выдавшим сертификат соответствия, и взимается плата за использование знака соответствия.</div></div><div class="CLAUSE_DEFAULT"><div name="6394341" id="6394341">Статья 29. Права и обязанности заявителя при обязательном подтверждении соответствия</div></div><div class="ACT_TEXT"><div name="6394342" id="6394342">Заявитель имеет право:</div></div><div class="ACT_TEXT"><div name="6394343" id="6394343">выбирать форму и схему подтверждения соответствия, предусмотренные для определенных видов продукции соответствующим техническим регламентом;</div></div><div class="ACT_TEXT"><div name="6394344" id="6394344">обращаться для осуществления обязательной сертификации в любой орган по оценке соответствия, область аккредитации которого распространяется на продукцию, которую заявитель намеревается сертифицировать;</div></div><div class="ACT_TEXT"><div name="6394345" id="6394345">использовать техническую документацию для подтверждения соответствия продукции требованиям технических регламентов;</div></div><div class="ACT_TEXT"><div name="6394346" id="6394346">получать от органа по оценке соответствия, выдавшего ему сертификат соответствия, документы и материалы, которые подтверждают результаты сертификации и условия, срок предоставления которых определяется договором о сертификации.</div></div><div class="ACT_TEXT"><div name="6394347" id="6394347">Заявитель обязан:</div></div><div class="ACT_TEXT"><div name="6394348" id="6394348">обеспечить соответствие продукции требованиям технических регламентов;</div></div><div class="ACT_TEXT"><div name="6394349" id="6394349">выпускать в обращение продукцию, подлежащую обязательному подтверждению соответствия, после осуществления работ по подтверждению соответствия;</div></div><div class="ACT_TEXT"><div name="6394350" id="6394350">указать в сопроводительной документации сведения о сертификате соответствия или декларации о соответствии;</div></div><div class="ACT_TEXT"><div name="6394351" id="6394351">предъявлять в органы государственного контроля, а также заинтересованным лицам документы, свидетельствующие о подтверждении соответствия продукции требованиям технических регламентов (сертификат соответствия, декларацию о соответствии или их копии) либо информацию о регистрационном номере сертификата соответствия или декларации о соответствии;</div></div><div class="ACT_TEXT"><div name="6394353" id="6394353">приостанавливать или прекращать реализацию продукции, если действие сертификата соответствия или декларации о соответствии приостановлено либо прекращено;</div></div><div class="ACT_TEXT"><div name="6394355" id="6394355">извещать орган по оценке соответствия об изменениях, вносимых в техническую документацию или технологические процессы производства сертифицированной продукции;</div></div><div class="ACT_TEXT"><div name="6394357" id="6394357">приостанавливать на десять рабочих дней производство продукции, прошедшей подтверждение соответствия и не соответствующей требованиям технических регламентов, на основании решений органов государственного контроля;</div></div><div class="ACT_TEXT"><div name="6394359" id="6394359">приостанавливать или прекращать реализацию продукции в случае истечения срока действия сертификата соответствия или декларации о соответствии, за исключением продукции, выпущенной во время действия сертификата соответствия или декларации о соответствии, в течение срока годности или срока службы продукции, установленных в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6394365" id="6394365">Статья 30. Цели испытания продукции</div></div><div class="ACT_TEXT"><div name="6394366" id="6394366">Испытание продукции проводится в целях:</div></div><div class="ACT_TEXT"><div name="6394367" id="6394367">определения характеристик подтверждения соответствия образца продукции, указанных в технических регламентах и стандартах;</div></div><div class="ACT_TEXT"><div name="6394370" id="6394370">обеспечения проведения подтверждения соответствия, если испытание является процедурой в рамках подтверждения соответствия.</div></div><div class="ACT_TEXT"><div name="6394371" id="6394371">Испытание является процедурой в рамках оценки соответствия, если это предусмотрено схемой подтверждения соответствия, применяемой при сертификации или декларировании соответствия. Испытание является самостоятельной формой оценки соответствия, если это предусмотрено техническими регламентами.</div></div><div class="ACT_TEXT"><div name="6394372" id="6394372">Испытание проводится аккредитованной лабораторией в соответствии с областью аккредитации, если это предусмотрено схемой подтверждения соответствия, применяемой при сертификации или декларировании соответствия.</div></div><div class="CLAUSE_DEFAULT"><div name="6394373" id="6394373">Статья 31. Требования, предъявляемые к органам по оценке соответствия, и их обязанности</div></div><div class="ACT_TEXT"><div name="6394374" id="6394374">Орган по оценке соответствия и его персонал не должны быть ответственными за проектирование, производство, поставку, установку, эксплуатацию или техническое обслуживание продукции, которую они оценивают.</div></div><div class="ACT_TEXT"><div name="6394375" id="6394375">При осуществлении обязательной сертификации испытания и измерения продукции должны проводиться аккредитованными испытательными лабораториями, и их результаты оформляются в виде протоколов. </div></div><div class="ACT_TEXT"><div name="6394376" id="6394376">Органы по оценке соответствия не вправе предоставлять испытательным лабораториям сведения о заявителе.</div></div><div class="ACT_TEXT"><div name="6394377" id="6394377">Орган по оценке соответствия принимает решение о выдаче или об отказе в выдаче сертификата соответствия на основании протоколов, выданных испытательной лабораторией. </div></div><div class="CLAUSE_DEFAULT"><div name="6394378" id="6394378">Статья 32. Признание результатов оценки соответствия, выданных органами по оценке соответствия иностранных государств</div></div><div class="ACT_TEXT"><div name="6394379" id="6394379">Признание в Республике Узбекистан результатов оценки соответствия, проведенной за пределами Республики Узбекистан, проводится в порядке, установленном Кабинетом Министров Республики Узбекистан, с учетом международных договоров Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="6394380" id="6394380">Статья 33. Государственная регистрация продукции</div></div><div class="ACT_TEXT"><div name="6394381" id="6394381">Кабинет Министров Республики Узбекистан утверждает перечень продукции с высоким уровнем риска, подлежащей обязательной государственной регистрации.</div></div><div class="ACT_TEXT"><div name="6394382" id="6394382">Государственная регистрация продукции разрешается только в том случае, если продукция безопасна для употребления (использования) в Республике Узбекистан.</div></div><div class="ACT_TEXT"><div name="6394383" id="6394383">Специально уполномоченный государственный орган устанавливает требования по государственной регистрации продукции и разработке инструкции по безопасному использованию данной продукции на государственном языке.</div></div><div class="CLAUSE_DEFAULT"><div name="6394384" id="6394384">Статья 34. Назначение (нотификация) органа по оценке соответствия</div></div><div class="ACT_TEXT"><div name="6394385" id="6394385">Областью назначения (нотификации) является перечень процедур оценки соответствия и видов продукции, в отношении которых в соответствии с соответствующим техническим регламентом назначается орган по оценке соответствия.</div></div><div class="ACT_TEXT"><div name="6394386" id="6394386">Органы по оценке соответствия могут быть назначены (нотифицированы) для выполнения ими в качестве третьей стороны процедур по оценке соответствия согласно соответствующим техническим регламентам при условии, что они:</div></div><div class="ACT_TEXT"><div name="6394387" id="6394387">являются юридическими лицами — резидентами Республики Узбекистан независимо от форм собственности;</div></div><div class="ACT_TEXT"><div name="6394388" id="6394388">имеют опыт выполнения работ по оценке соответствия продукции в течение последних трех лет;</div></div><div class="ACT_TEXT"><div name="6394389" id="6394389">имеют собственные аккредитованные испытательные лаборатории для проведения испытаний продукции в пределах области назначения;</div></div><div class="ACT_TEXT"><div name="6394390" id="6394390">соответствуют специальным требованиям, определенным в соответствующих технических регламентах, которыми предусмотрено применение процедур оценки соответствия с привлечением назначенных (нотифицированных) органов, а в случае, если такие требования не определены в технических регламентах, специальным требованиям, установленным Кабинетом Министров Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6394391" id="6394391">Назначающий орган должен:</div></div><div class="ACT_TEXT"><div name="6394392" id="6394392">обеспечивать отсутствие конфликта интересов с органами по оценке соответствия;</div></div><div class="ACT_TEXT"><div name="6394393" id="6394393">гарантировать беспристрастность своих решений о назначении;</div></div><div class="ACT_TEXT"><div name="6394394" id="6394394">обеспечивать принятие каждого решения, которое касается назначения органа по оценке соответствия, компетентными лицами, не аффилированными с органом по оценке соответствия, и лицами, проводящими оценку соответствия;</div></div><div class="ACT_TEXT"><div name="6394395" id="6394395">обеспечивать конфиденциальность полученной информации.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="6394396" id="6394396">Глава 5. Осуществление государственного контроля в области технического регулирования</div></div><div class="CLAUSE_DEFAULT"><div name="6394397" id="6394397">Статья 35. Органы государственного контроля</div></div><div class="ACT_TEXT"><div name="6394398" id="6394398">Государственный контроль за соблюдением требований технических регламентов осуществляется органами государственного контроля в пределах своих полномочий.</div></div><div class="ACT_TEXT"><div name="6394399" id="6394399">Полномочия органов государственного контроля, порядок координации их деятельности по государственному контролю за соблюдением требований технических регламентов, а также порядок взаимодействия органов государственного контроля с органом по аккредитации утверждаются Кабинетом Министров Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6394400" id="6394400">При осуществлении государственного контроля проверки проводятся в порядке, установленном законодательством.</div></div><div class="ACT_TEXT"><div name="6394401" id="6394401">На основании требований, установленных в технических регламентах, меры контроля осуществляются на этапе выпуска продукции в обращение (реализации потребителю), за исключением случаев, предусмотренных <a href="https://lex.uz/uz/docs/6392314#6394402">частью пятой</a> настоящей статьи.</div></div><div class="ACT_TEXT"><div name="6394402" id="6394402">Если технические регламенты содержат требования к процессам, связанным с проектированием, производством, монтажом, наладкой, эксплуатацией, хранением, перевозкой, реализацией и утилизацией продукции, должны быть приняты и меры контроля по обеспечению выполнения этих требований.</div></div><div class="ACT_TEXT"><div name="6394403" id="6394403">При проведении контроля в виде отбора, проверки, испытаний и (или) измерений образцов органы государственного контроля используют методы испытаний и измерений, установленные соответствующими техническими регламентами.</div></div><div class="ACT_TEXT"><div name="6394404" id="6394404">Порядок принятия ограничительных мер, в котором должны быть определены четкие критерии оценки риска, условия и обстоятельства, при которых органы государственного контроля выбирают соответствующие ограничительные меры, утверждается Кабинетом Министров Республики Узбекистан. </div></div><div class="CLAUSE_DEFAULT"><div name="6394405" id="6394405">Статья 36. Права и обязанности органов государственного контроля</div></div><div class="ACT_TEXT"><div name="6394406" id="6394406">Органы государственного контроля имеют право:</div></div><div class="ACT_TEXT"><div name="6394407" id="6394407">требовать от производителя, уполномоченного представителя производителя, продавца и импортера представления информации о регистрационном номере сертификата соответствия или декларации о соответствии, если наличие таких документов предусмотрено соответствующим техническим регламентом;</div></div><div class="ACT_TEXT"><div name="6394408" id="6394408">осуществлять контрольные мероприятия в порядке, установленном законодательством;</div></div><div class="ACT_TEXT"><div name="6394409" id="6394409">выдавать предписания производителю, уполномоченному представителю производителя, продавцу и импортеру об устранении выявленных нарушений требований технических регламентов;</div></div><div class="ACT_TEXT"><div name="6394410" id="6394410">направлять информацию о необходимости приостановления или прекращения действия сертификата соответствия в выдавший его орган по оценке соответствия и специально уполномоченный государственный орган;</div></div><div class="ACT_TEXT"><div name="6394411" id="6394411">выдавать предписание о приостановлении или прекращении действия сертификата соответствия органу по оценке соответствия, о приостановлении или прекращении действия декларации о соответствии лицу, принявшему декларацию, и направлять информацию о выдаче предписания о приостановлении или прекращении действия сертификата соответствия, декларации о соответствии в орган по аккредитации;</div></div><div class="ACT_TEXT"><div name="6394412" id="6394412">привлекать производителя, уполномоченного представителя производителя, продавца и импортера к ответственности, предусмотренной настоящим Законом и законодательством;</div></div><div class="ACT_TEXT"><div name="6394413" id="6394413">требовать от производителя, уполномоченного представителя производителя, продавца и импортера предоставления доказательств и других документов, использованных при осуществлении обязательного подтверждения соответствия продукции требованиям технического регламента;</div></div><div class="ACT_TEXT"><div name="6394414" id="6394414">принимать решение о приостановлении, прекращении действия сертификата соответствия, декларации о соответствии в порядке, установленном законодательством;</div></div><div class="ACT_TEXT"><div name="6394415" id="6394415">принимать решение о запрете или приостановке выпуска в обращение, об изъятии или отзыве из обращения продукции, не соответствующей требованиям технических регламентов, и уведомить об этом решении соответствующие органы государственного контроля в соответствии с их полномочиями и (или) запретить использование этой продукции до устранения нарушений;</div></div><div class="ACT_TEXT"><div name="6394416" id="6394416">принимать иные меры, предусмотренные законодательством, в целях недопущения причинения вреда.</div></div><div class="ACT_TEXT"><div name="6394417" id="6394417">Органы государственного контроля обязаны:</div></div><div class="ACT_TEXT"><div name="6394418" id="6394418">проводить в ходе контрольных мероприятий разъяснительную работу по применению законодательства о техническом регулировании, информировать о существующих технических регламентах;</div></div><div class="ACT_TEXT"><div name="6394419" id="6394419">не разглашать коммерческую тайну и иную охраняемую законом тайну;</div></div><div class="ACT_TEXT"><div name="6394420" id="6394420">соблюдать порядок осуществления контрольных мероприятий и оформления результатов таких мероприятий, установленный законодательством;</div></div><div class="ACT_TEXT"><div name="6394421" id="6394421">принимать на основании результатов контрольных мероприятий меры по устранению последствий нарушений требований технических регламентов;</div></div><div class="ACT_TEXT"><div name="6394422" id="6394422">направлять информацию о несоответствии продукции требованиям технических регламентов производителю, уполномоченному представителю производителя, продавцу и импортеру.</div></div><div class="CLAUSE_DEFAULT"><div name="6394423" id="6394423">Статья 37. Ответственность органов государственного контроля и их должностных лиц</div></div><div class="ACT_TEXT"><div name="6394424" id="6394424">Органы государственного контроля и их должностные лица в случае неисполнения или ненадлежащего исполнения своих полномочий (служебных обязанностей) при проведении контрольных мероприятий или в случае совершения противоправных действий (бездействия) несут ответственность в установленном порядке.</div></div><div class="ACT_TEXT"><div name="6394425" id="6394425">Органы государственного контроля в течение месяца обязаны сообщить субъектам предпринимательства, права и законные интересы которых нарушены, о мерах, принятых в отношении виновных своих должностных лиц. </div></div><div class="CLAUSE_DEFAULT"><div name="6394426" id="6394426">Статья 38. Информация о несоответствии продукции требованиям технических регламентов</div></div><div class="ACT_TEXT"><div name="6394427" id="6394427">Производитель, уполномоченный представитель производителя, продавец, импортер или исполнитель, которому стало известно о несоответствии выпущенной в обращение продукции требованиям технических регламентов, обязан сообщить об этом в орган государственного контроля в течение десяти дней с момента получения указанной информации.</div></div><div class="ACT_TEXT"><div name="6394428" id="6394428">Уполномоченный представитель производителя, продавец, импортер или исполнитель, получивший информацию о несоответствии выпущенной в обращение продукции требованиям технических регламентов, в течение десяти дней обязан довести ее до производителя.</div></div><div class="ACT_TEXT"><div name="6394429" id="6394429">Лицо, которое не является производителем, уполномоченным представителем производителя, продавцом, импортером или исполнителем и которому стало известно о несоответствии выпущенной в обращение продукции требованиям технических регламентов, вправе направить эту информацию в орган государственного контроля.</div></div><div class="ACT_TEXT"><div name="6394430" id="6394430">При получении информации о несоответствии выпущенной в обращение продукции требованиям технических регламентов орган государственного контроля в течение пяти дней обязан известить производителя, уполномоченного представителя производителя, продавца, импортера или исполнителя о ее поступлении.</div></div><div class="ACT_TEXT"><div name="6394431" id="6394431">Запрещается исключение продукции из реестра продукции, признанной не соответствующей нормативным документам в области технического регулирования, в течение шести месяцев со дня включения ее в данный реестр, а также ввоз и выпуск в свободное обращение данной продукции на территории Республики Узбекистан производителем, уполномоченным представителем производителя, продавцом и импортером.</div></div><div class="CLAUSE_DEFAULT"><div name="6394432" id="6394432">Статья 39. Обязанности производителя, уполномоченного представителя производителя, продавца и импортера при получении информации о несоответствии продукции требованиям технических регламентов</div></div><div class="ACT_TEXT"><div name="6394433" id="6394433">В течение десяти дней с момента получения информации о несоответствии продукции требованиям технических регламентов производитель, уполномоченный представитель производителя, продавец, импортер обязаны проверить достоверность полученной информации, если необходимость установления более длительного срока не следует из содержания проводимых мероприятий. По требованию органа государственного контроля производитель, уполномоченный представитель производителя, продавец, импортер обязаны представить материалы указанной проверки данному органу. </div></div><div class="ACT_TEXT"><div name="6394434" id="6394434">При подтверждении достоверности информации о несоответствии продукции требованиям технических регламентов производитель, уполномоченный представитель производителя, продавец, импортер в течение десяти дней с момента подтверждения достоверности такой информации обязаны разработать программу мероприятий по предотвращению причинения вреда и согласовать ее с органом государственного контроля в соответствии с его полномочиями.</div></div><div class="ACT_TEXT"><div name="6394435" id="6394435">Программа мероприятий по предотвращению причинения вреда включает в себя мероприятия по оповещению покупателей (потребителей) о наличии угрозы причинения вреда и способах его предотвращения, а также о сроках реализации таких мероприятий.</div></div><div class="ACT_TEXT"><div name="6394436" id="6394436">В случае, если для предотвращения причинения вреда необходимо произвести дополнительные расходы, производитель, уполномоченный представитель производителя, продавец, импортер обязаны осуществить все мероприятия по предотвращению причинения вреда за свой счет, а при невозможности их осуществления объявить об отзыве продукции и возместить убытки, причиненные покупателям в связи с отзывом продукции.</div></div><div class="ACT_TEXT"><div name="6394437" id="6394437">Устранение недостатков продукции, а также ее доставка к месту устранения недостатков и возврат покупателям и (или) потребителям осуществляются производителем, уполномоченным представителем производителя, продавцом, импортером за их счет.</div></div><div class="ACT_TEXT"><div name="6394438" id="6394438">Изъятие продукции из обращения предусматривает возвращение продавцами соответствующей продукции, находящейся в их распоряжении, производителю этой продукции и прекращение ими предложения такой продукции покупателям (потребителям).</div></div><div class="ACT_TEXT"><div name="6394439" id="6394439">Отзыв продукции предусматривает возвращение уже проданной покупателям (потребителям) соответствующей продукции ее производителю.</div></div><div class="ACT_TEXT"><div name="6394440" id="6394440">В случае, если угроза причинения вреда не может быть устранена путем проведения установленных мероприятий, производитель, уполномоченный представитель производителя, продавец, импортер обязаны незамедлительно приостановить производство и реализацию продукции, отозвать продукцию и возместить покупателям (потребителям) убытки, возникшие в связи с отзывом продукции, незамедлительно прекратить действие сертификата о соответствии или декларации о соответствии на продукцию.</div></div><div class="ACT_TEXT"><div name="6394441" id="6394441">На весь период реализации программы мероприятий по предотвращению причинения вреда производитель, уполномоченный представитель производителя, продавец, импортер за свой счет обязаны обеспечить покупателям (потребителям) возможность получения оперативной информации о необходимых действиях.</div></div><div class="CLAUSE_DEFAULT"><div name="6394442" id="6394442">Статья 40. Действия органов государственного контроля при получении информации о несоответствии продукции требованиям технических регламентов</div></div><div class="ACT_TEXT"><div name="6394443" id="6394443">Органы государственного контроля при получении информации о несоответствии продукции требованиям технических регламентов в возможно короткие сроки проводят проверку достоверности полученной информации.</div></div><div class="ACT_TEXT"><div name="6394444" id="6394444">В ходе проведения проверки достоверности полученной информации органы государственного контроля вправе:</div></div><div class="ACT_TEXT"><div name="6394445" id="6394445">запрашивать у производителя, уполномоченного представителя производителя, исполнителя, продавца, импортера и иных лиц дополнительную информацию о продукции или связанных с требованиями к ней процессах проектирования, производства, монтажа, наладки, эксплуатации, хранения, перевозки, реализации и утилизации продукции, в том числе результаты исследований (испытаний) и измерений, проведенных при осуществлении обязательного подтверждения соответствия;</div></div><div class="ACT_TEXT"><div name="6394446" id="6394446">направлять запросы в органы государственного и хозяйственного управления, а также в органы исполнительной власти на местах;</div></div><div class="ACT_TEXT"><div name="6394447" id="6394447">при необходимости привлекать специалистов для анализа полученных материалов;</div></div><div class="ACT_TEXT"><div name="6394448" id="6394448">запрашивать у производителя, уполномоченного представителя производителя, продавца, импортера доказательства и другие документы, использованные при осуществлении обязательного подтверждения соответствия продукции требованиям технических регламентов.</div></div><div class="ACT_TEXT"><div name="6394449" id="6394449">При признании достоверности информации о несоответствии продукции требованиям технических регламентов орган государственного контроля в соответствии с его полномочиями выдает предписание о разработке в течение десяти дней производителем, уполномоченным представителем производителя, продавцом, импортером программы мероприятий по предотвращению причинения вреда, оказывает содействие в ее реализации и осуществляет контроль за ее выполнением.</div></div><div class="ACT_TEXT"><div name="6394450" id="6394450">Орган государственного контроля при осуществлении контроля за выполнением программы мероприятий по предотвращению причинения вреда:</div></div><div class="ACT_TEXT"><div name="6394451" id="6394451">способствует распространению информации о сроках и порядке проведения мероприятий по предотвращению причинения вреда;</div></div><div class="ACT_TEXT"><div name="6394452" id="6394452">запрашивает у производителя, уполномоченного представителя производителя, продавца, импортера и иных лиц документы, подтверждающие проведение мероприятий, указанных в программе мероприятий по предотвращению причинения вреда;</div></div><div class="ACT_TEXT"><div name="6394453" id="6394453">проверяет соблюдение сроков, указанных в программе мероприятий по предотвращению причинения вреда.</div></div><div class="ACT_TEXT"><div name="6394454" id="6394454">В случае необходимости принятия незамедлительных мер по предотвращению причинения вреда жизни и здоровью граждан при использовании продукции, не соответствующей требованиям технических регламентов, либо угрозы причинения такого вреда орган государственного контроля:</div></div><div class="ACT_TEXT"><div name="6394456" id="6394456">выдает предписание о приостановке реализации этой продукции;</div></div><div class="ACT_TEXT"><div name="6394457" id="6394457">информирует покупателей (потребителей) через средства массовой информации о несоответствии этой продукции требованиям технических регламентов и об угрозе причинения вреда жизни или здоровью граждан при использовании этой продукции;</div></div><div class="ACT_TEXT"><div name="6394458" id="6394458">принимает решение об обращении в суд с исковым заявлением о принудительном отзыве этой продукции.</div></div><div class="ACT_TEXT"><div name="6394459" id="6394459">Производитель, уполномоченный представитель производителя, продавец, импортер вправе обжаловать действия органа государственного контроля в судебном порядке.</div></div><div class="ACT_TEXT"><div name="6394460" id="6394460">В случае принятия судебного решения о неправомерности действий органа государственного контроля вред, причиненный производителю, уполномоченному представителю производителя, продавцу, импортеру действиями органа государственного контроля, подлежит возмещению.</div></div><div class="CLAUSE_DEFAULT"><div name="6394462" id="6394462">Статья 41. Принудительный отзыв продукции</div></div><div class="ACT_TEXT"><div name="6394463" id="6394463">В случае невыполнения предписания, предусмотренного настоящим Законом, орган государственного контроля в соответствии с его полномочиями, а также иные лица, которым стало известно о невыполнении производителем, уполномоченным представителем производителя, продавцом, импортером программы мероприятий по предотвращению причинения вреда, вправе обратиться в суд с исковым заявлением о принудительном отзыве продукции.</div></div><div class="ACT_TEXT"><div name="6394464" id="6394464">В случае удовлетворения искового заявления о принудительном отзыве продукции судебное решение не позднее одного месяца со дня его вступления в законную силу ответчиком доводится до сведения покупателей (потребителей) через средства массовой информации или иным способом.</div></div><div class="ACT_TEXT"><div name="6394465" id="6394465">В случае неисполнения ответчиком судебного решения в установленный судом срок исполнение судебного решения осуществляется в порядке, установленном законом. При этом истец вправе информировать покупателей (потребителей) о принудительном отзыве продукции через средства массовой информации или иным способом.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="6394467" id="6394467">Глава 6. Обязанности производителя, продавца, импортера</div></div><div class="CLAUSE_DEFAULT"><div name="6394468" id="6394468">Статья 42. Обязанности производителя</div></div><div class="ACT_TEXT"><div name="6394469" id="6394469">Производители обязаны:</div></div><div class="ACT_TEXT"><div name="6394470" id="6394470">выпускать в обращение безопасную продукцию;</div></div><div class="ACT_TEXT"><div name="6394471" id="6394471">обеспечивать проведение процедуры оценки соответствия в соответствии с техническим регламентом;</div></div><div class="ACT_TEXT"><div name="6394472" id="6394472">составлять техническую документацию и хранить ее в течение определенного периода времени;</div></div><div class="ACT_TEXT"><div name="6394474" id="6394474">составлять и предоставлять декларацию о соответствии в соответствии с техническим регламентом и хранить ее в течение указанного периода времени;</div></div><div class="ACT_TEXT"><div name="6394475" id="6394475">проставлять знак соответствия согласно требованиям настоящего Закона, если это предусмотрено техническим регламентом.</div></div><div class="ACT_TEXT"><div name="6394477" id="6394477">Производитель обязан поставить на продукцию номер партии или серии, позволяющий идентифицировать продукцию в соответствии с нормативными документами в области технического регулирования. Если из-за размера или других характеристик продукции производитель не может разместить указанную информацию, то она должна быть указана на упаковке или в прилагаемых к продукции документах.</div></div><div class="ACT_TEXT"><div name="6394478" id="6394478">Отдельные обязанности производителя могут быть возложены на уполномоченного представителя производителя в соответствии с договором. </div></div><div class="ACT_TEXT"><div name="6394479" id="6394479">Производитель может нести и иные обязанности в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6394480" id="6394480">Статья 43. Обязанности продавца</div></div><div class="ACT_TEXT"><div name="6394481" id="6394481">Продавец обязан:</div></div><div class="ACT_TEXT"><div name="6394482" id="6394482">проверить нанесение знака соответствия на продукцию в соответствии с техническим регламентом;</div></div><div class="ACT_TEXT"><div name="6394483" id="6394483">проверить наличие дополнительных документов и информации о безопасности продукции в соответствии с техническим регламентом на государственном языке;</div></div><div class="ACT_TEXT"><div name="6394484" id="6394484">гарантировать, что условия хранения и транспортировки не будут подвергать опасности соответствие продукции требованиям технических регламентов до ее реализации.</div></div><div class="ACT_TEXT"><div name="6394485" id="6394485">Если продавец считает, что продукция не соответствует требованиям технических регламентов, то он обязан принять корректирующие меры с целью приведения продукции в соответствие с требованиями технического регламента. </div></div><div class="ACT_TEXT"><div name="6394486" id="6394486">Если после принятых корректирующих мер выявленное несоответствие продукции требованиям технических регламентов не устранено, то продавец обязан информировать об этом производителя, уполномоченного представителя производителя или импортера, а также органы государственного контроля.</div></div><div class="CLAUSE_DEFAULT"><div name="6394487" id="6394487">Статья 44. Обязанности импортера</div></div><div class="ACT_TEXT"><div name="6394489" id="6394489">Импортер обязан:</div></div><div class="ACT_TEXT"><div name="6394490" id="6394490">размещать на рынке продукцию, которая соответствует требованиям технического регламента;</div></div><div class="ACT_TEXT"><div name="6394491" id="6394491">гарантировать при выпуске продукции в обращение, что производитель провел предусмотренную процедуру подтверждения соответствия, разработал техническую документацию, проставил знак соответствия на продукцию в соответствии с требованиями технического регламента;</div></div><div class="ACT_TEXT"><div name="6394492" id="6394492">контролировать условия хранения или транспортировки для предотвращения несоответствия продукции требованиям технического регламента.</div></div><div class="ACT_TEXT"><div name="6394493" id="6394493">Если импортер считает, что продукция не соответствует требованиям технического регламента, то он обязан принять корректирующие меры по обеспечению безопасности продукции до размещения ее на рынке.</div></div><div class="ACT_TEXT"><div name="6394494" id="6394494">Если после принятых корректирующих мер выявленное несоответствие продукции требованиям технических регламентов не устранено, то импортер обязан информировать об этом производителя и органы государственного контроля.</div></div><div class="CLAUSE_DEFAULT"><div name="6394495" id="6394495">Статья 45. Система оперативного взаимного оповещения о продукции, представляющей высокий риск</div></div><div class="ACT_TEXT"><div name="6394500" id="6394500">С целью обмена информацией о продукции, представляющей высокий риск, между органами государственного контроля создается и функционирует система оперативного взаимного оповещения о продукции, представляющей высокий риск.</div></div><div class="ACT_TEXT"><div name="6394501" id="6394501">Система оперативного взаимного оповещения о продукции, представляющей высокий риск, формируется из сообщений, представляемых органами государственного контроля в случае выявления ими продукции, представляющей высокий риск.</div></div><div class="ACT_TEXT"><div name="6394502" id="6394502">Сообщение о продукции, представляющей высокий риск, должно содержать:</div></div><div class="ACT_TEXT"><div name="6394503" id="6394503">сведения, позволяющие идентифицировать соответствующую продукцию;</div></div><div class="ACT_TEXT"><div name="6394504" id="6394504">описание риска, который создает продукция, результат испытания образцов такой продукции;</div></div><div class="ACT_TEXT"><div name="6394505" id="6394505">информацию о характере и продолжительности мер, принятых для предотвращения риска (если такие меры были приняты), в том числе мер, принятых производителем, уполномоченным представителем производителя, продавцом и (или) импортером по собственной инициативе;</div></div><div class="ACT_TEXT"><div name="6394506" id="6394506">информацию о происхождении и цепи поставки этой продукции на рынке;</div></div><div class="ACT_TEXT"><div name="6394507" id="6394507">сведения, полученные с помощью международных, региональных и иностранных систем сообщения или иным образом от компетентных органов других государств.</div></div><div class="ACT_TEXT"><div name="6394509" id="6394509">Сведения, содержащиеся в системе оперативного взаимного оповещения, о продукции, представляющей высокий риск, должны быть доступны для органов государственного контроля, таможенных органов, органов государственного управления, реализующих государственную политику в сфере экономического и социального развития, органов государственного управления, реализующих государственную политику в области государственного контроля за соблюдением законодательства о защите прав потребителей.</div></div><div class="ACT_TEXT"><div name="6394510" id="6394510">Порядок функционирования системы оперативного взаимного оповещения о продукции, представляющей высокий риск, утверждается Кабинетом Министров Республики Узбекистан.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="6394511" id="6394511">Глава 7. Ответственность за нарушение законодательства о техническом регулировании</div></div><div class="CLAUSE_DEFAULT"><div name="6394513" id="6394513">Статья 46. Ответственность производителя, уполномоченного представителя производителя, продавца, импортера при несоблюдении обязательных требований, установленных законодательством и техническим регламентом</div></div><div class="ACT_TEXT"><div name="6394515" id="6394515">За продолжение или неустранение правонарушения в области технического регулирования после получения предупреждения в установленном порядке физические лица в соответствии с законодательством несут административную ответственность. За продолжение или неустранение правонарушения в области технического регулирования после получения предупреждения в установленном порядке в отношении юридических лиц применяются финансовые санкции в виде штрафа в соответствии с <a href="https://lex.uz/uz/docs/6392314#6394516">частью второй</a> настоящей статьи.</div></div><div class="ACT_TEXT"><div name="6394516" id="6394516">В случае несоблюдения производителем, уполномоченным представителем производителя, продавцом или импортером обязательных требований к продукции, предусмотренных законодательством и техническим регламентом, в отношении них:</div></div><div class="ACT_TEXT"><div name="6394518" id="6394518">при совершении правонарушения впервые — применяются финансовые санкции в виде штрафа в размере до пятидесяти процентов от стоимости реализованной продукции, не соответствующей обязательным требованиям;</div></div><div class="ACT_TEXT"><div name="6394519" id="6394519">при повторном совершении того же правонарушения в течение одного года со дня применения финансовой санкции в виде штрафа, предусмотренной <a href="https://lex.uz/uz/docs/6392314#6394518">абзацем вторым</a> части второй настоящей статьи, — применяются финансовые санкции в виде штрафа в размере до ста процентов от стоимости реализованной продукции, не соответствующей обязательным требованиям.</div></div><div class="ACT_TEXT"><div name="6394520" id="6394520">Финансовые санкции в виде штрафа, предусмотренные <a href="https://lex.uz/uz/docs/6392314#6394516">частью второй</a> настоящей статьи, применяются в судебном порядке, за исключением случаев признания производителями, уполномоченными представителями производителя, продавцами или импортерами продукции вины в совершенном правонарушении и добровольной уплаты сумм финансовых санкций в месячный срок.</div></div><div class="BY_DEFAULT"><div name="7788565" id="7788565"></div></div><div class="ACT_TEXT"><div name="7788568" id="7788568">Производитель, уполномоченный представитель производителя, продавец или импортер, которые в установленном законодательством порядке отозвали не менее семидесяти процентов продукции, не соответствующей требованиям технических регламентов, освобождаются от финансовых санкций, предусмотренных <a href="https://lex.uz/uz/docs/6392314#6394516">частью второй</a> настоящей статьи.</div></div><div class="ACT_TEXT"><div name="6394521" id="6394521">Пятьдесят процентов суммы взысканного штрафа направляется во внебюджетный фонд Узбекского агентства по техническому регулированию, а остальная часть в Государственный бюджет Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6394522" id="6394522">Если в результате несоблюдения производителем, уполномоченным представителем производителя, продавцом или импортером обязательных требований к продукции, процессам или методам ее производства, установленных законодательством и техническим регламентом, причинен вред жизни или здоровью граждан, имуществу физических или юридических лиц, государственному имуществу, окружающей среде, жизни или здоровью животных, вред растениям или возникла угроза причинения такого вреда, производитель, уполномоченный представитель производителя, продавец, импортер, исполнитель обязаны возместить причиненный вред и принять меры в целях недопущения причинения вреда другим лицам, их имуществу, окружающей среде в соответствии с законодательством.</div></div><div class="ACT_TEXT"><div name="6394524" id="6394524">Обязанность возместить вред не может быть ограничена договором или заявлением одной из сторон.</div></div><div class="ACT_TEXT"><div name="6394525" id="6394525">Решение о применении финансовой санкции в виде штрафа за правонарушения, предусмотренные настоящей статьей, может быть обжаловано в соответствии с настоящим Законом.</div></div><div class="ACT_TEXT"><div name="6394526" id="6394526">Уплата финансовых санкций в виде штрафа не освобождает юридическое лицо от ответственности за ущерб, причиненный потребителям продукции.</div></div><div class="CLAUSE_DEFAULT"><div name="6394527" id="6394527">Статья 47. Ответственность органов по оценке соответствия</div></div><div class="BY_DEFAULT"><div name="7788570" id="7788570"></div></div><div class="ACT_TEXT"><div name="7788571" id="7788571">Орган по оценке соответствия, нарушивший правила оценки соответствия, и его должностные лица несут ответственность в соответствии с законом и договором об оказании услуг по сертификации.</div></div><div class="ACT_TEXT"><div name="6394529" id="6394529">Аккредитованные испытательные лаборатории (центры) несут ответственность за недостоверность или неточность исследований (испытаний) и результатов измерений в соответствии с законом и договором.</div></div><div class="ACT_TEXT"><div name="6394530" id="6394530">В случаях выявления правонарушений по результатам оценки соответствия должностными лицами органов государственного контроля составляется акт о выявлении правонарушения, являющегося основанием для применения административного взыскания и финансовых санкций в виде штрафа, который вместе с пояснениями руководителя, иных ответственных должностных лиц и документами, связанными с совершением правонарушения, передается в суд в течение трех рабочих дней.</div></div><div class="ACT_TEXT"><div name="6394531" id="6394531">Размер финансовых санкций в виде штрафа за следующие правонарушения определяется в зависимости от уровня риска и продолжительности правонарушения:</div></div><div class="ACT_TEXT"><div name="6394532" id="6394532">при установлении неправильного декларирования соответствия продукции, неправильного декларирования соответствия продукции, выпускаемой в обращение впервые, для которой обязательно подтверждение соответствия, или неправильного декларирования продукции на основе их личных доказательств в результате отсутствия стандартов или невозможности применения существующих стандартов из-за применения к ним требований технических регламентов — финансовые санкции в виде штрафа в размере ста базовых расчетных величин;</div></div><div class="ACT_TEXT"><div name="6394533" id="6394533">за необоснованный отказ в выдаче сертификата соответствия, необоснованное приостановление или прекращение действия сертификата соответствия либо декларации о соответствии — финансовые санкции в виде штрафа в размере двухсот базовых расчетных величин;</div></div><div class="ACT_TEXT"><div name="6394534" id="6394534">в случае нарушения установленных процедур при выполнении сертификационных работ — финансовые санкции в виде штрафа в размере трехсот базовых расчетных величин;</div></div><div class="ACT_TEXT"><div name="6394535" id="6394535">при установлении, что результаты испытаний, проведенных испытательной лабораторией с целью оценки соответствия продукции, представлены неверно и не обеспечивают беспристрастность, — финансовые санкции в виде штрафа в размере трехсот базовых расчетных величин.</div></div><div class="ACT_TEXT"><div name="6394536" id="6394536">Решение о применении финансовых санкций в виде штрафа за правонарушения, предусмотренные настоящей статьей, может быть обжаловано в установленном порядке.</div></div><div class="ACT_TEXT"><div name="6394537" id="6394537">Уплата финансовых санкций в виде штрафа не освобождает юридическое лицо от ответственности за ущерб, причиненный потребителям продукции.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="6394539" id="6394539">Глава 8. Заключительные положения</div></div><div class="CLAUSE_DEFAULT"><div name="6394541" id="6394541">Статья 48. Финансирование работ в области технического регулирования</div></div><div class="ACT_TEXT"><div name="6394551" id="6394551">Финансирование разработки, пересмотра технических регламентов, разработки методических рекомендаций по применению технических регламентов, осуществления государственного контроля, а также участия уполномоченных государственных органов в деятельности международных организаций по стандартизации и техническому регулированию осуществляется за счет Государственного бюджета Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6394552" id="6394552">Не допускается финансирование за счет бюджетных средств работ по разработке технических регламентов, не предусмотренных программой по разработке технических регламентов.</div></div><div class="CLAUSE_DEFAULT"><div name="6394553" id="6394553">Статья 49. Разрешение споров</div></div><div class="ACT_TEXT"><div name="6394554" id="6394554">Споры в области технического регулирования разрешаются в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6394555" id="6394555">Статья 50. Внесение изменений, а также признание утратившими силу некоторых законодательных актов Республики Узбекистан</div></div><div class="ACT_TEXT"><div name="6394558" id="6394558">Внести изменения в следующие законодательные акты Республики Узбекистан:</div></div><div class="ACT_TEXT"><div name="6394559" id="6394559">1. Внести в <a href="https://lex.uz/uz/docs/4782813?ONDATE=09.10.2020 00#4784120">статью 28</a> Закона Республики Узбекистан от 28 декабря 1993 года № 1004-XII «О метрологии» (в редакции Закона Республики Узбекистан от 7 апреля 2020 года № ЗРУ-614) (Ведомости палат Олий Мажлиса Республики Узбекистан, 2020 г., № 4, ст. 254; 2021 г., приложение к № 4) следующие изменения:</div></div><div class="ACT_TEXT"><div name="6394561" id="6394561">в <a href="https://lex.uz/uz/docs/4782813?ONDATE=09.10.2020 00#4784121">части первой</a> слова «нормативных документов в области технического регулирования» заменить словами «нормативных документов по обеспечению единства измерений»;</div></div><div class="ACT_TEXT"><div name="6394562" id="6394562">в <a href="https://lex.uz/uz/docs/4782813?ONDATE=09.10.2020 00#4784123">части второй</a> слова «нормативных документов в области технического регулирования» заменить словами «нормативных документов по обеспечению единства измерений».</div></div><div class="ACT_TEXT"><div name="6394563" id="6394563">2. <a href="https://lex.uz/uz/docs/14643?ONDATE=14.06.2017 00#3265227">Абзац восьмой</a> статьи 1 Закона Республики Узбекистан от 26 апреля 1996 года № 221-I «О защите прав потребителей» (Ведомости Олий Мажлиса Республики Узбекистан, 1996 г., № 5-6, ст. 59; 2002 г., № 4-5, ст. 74; 2003 г., № 5, ст. 67; Ведомости палат Олий Мажлиса Республики Узбекистан, 2005 г., № 12, ст. 413; 2006 г., № 10, ст. 536; 2008 г., № 4, ст. 183; 2010 г., № 10, ст. 380; 2013 г., № 10, ст. 263; 2014 г., № 1, ст. 2; 2016 г., № 4, ст. 125; 2017 г., № 6, ст. 300, № 9, ст. 510; 2018 г., № 1, ст. 1; 2019 г., № 12, ст. 891; 2021 г., приложение к № 4; 2022 г., № 1, ст. 4) изложить в следующей редакции:</div></div><div class="ACT_TEXT"><div name="6394564" id="6394564">«нормативные документы — нормативные документы в области технического регулирования и иные документы (градостроительные нормы и правила, государственная фармакопея и статьи фармакопеи), технические описания, рецептура, а также другие документы, содержащие обязательные требования к качеству и безопасности товара (работы, услуги)».</div></div><div class="ACT_TEXT"><div name="6394565" id="6394565">Признать утратившими силу:</div></div><div class="ACT_TEXT"><div name="6394566" id="6394566">1) <a href="https://lex.uz/uz/docs/99887">Закон </a>Республики Узбекистан от 28 декабря 1993 года № 1006-XII «О сертификации продукции и услуг» (Ведомости Верховного Совета Республики Узбекистан, 1994 г., № 2, ст. 50);</div></div><div class="ACT_TEXT"><div name="6394567" id="6394567">2) <a href="https://lex.uz/uz/docs/119309">постановление </a>Верховного Совета Республики Узбекистан от 28 декабря 1993 года № 1007-XII «О введении в действие Закона Республики Узбекистан «О сертификации продукции и услуг» (Ведомости Верховного Совета Республики Узбекистан, 1994 г., № 2, ст. 51);</div></div><div class="ACT_TEXT"><div name="6394568" id="6394568">3) <a href="https://lex.uz/uz/docs/36654?ONDATE=01.10.2000 00#36834">раздел IV</a> Закона Республики Узбекистан от 31 августа 2000 года № 125-II «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости Олий Мажлиса Республики Узбекистан, 2000 г., № 7-8, ст. 217);</div></div><div class="ACT_TEXT"><div name="6394569" id="6394569">4) <a href="https://lex.uz/uz/docs/55554?ONDATE=24.06.2003 00#57305">раздел IX</a> Закона Республики Узбекистан от 25 апреля 2003 года № 482-II «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости Олий Мажлиса Республики Узбекистан, 2003 г., № 5, ст. 67);</div></div><div class="ACT_TEXT"><div name="6394570" id="6394570">5) <a href="https://lex.uz/uz/docs/974162?ONDATE=08.04.2006 00#1074906">статью 1</a> Закона Республики Узбекистан от 6 апреля 2006 года № ЗРУ-31 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан в связи с упрощением процедуры сертификации продукции и услуг» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2006 г., № 4, ст. 157);</div></div><div class="ACT_TEXT"><div name="6394571" id="6394571">6) <a href="https://lex.uz/uz/docs/1067374?ONDATE=11.10.2006 00#1068288">статью 6</a> Закона Республики Узбекистан от 10 октября 2006 года № ЗРУ-59 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан в связи с совершенствованием системы правовой защиты и либерализацией финансовой ответственности субъектов предпринимательства» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2006 г., № 10, ст. 536);</div></div><div class="ACT_TEXT"><div name="6394572" id="6394572">7) <a href="https://lex.uz/uz/docs/1474640">Закон</a> Республики Узбекистан от 23 апреля 2009 года № ЗРУ-213 «О техническом регулировании» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2009 г., № 4, ст. 140);</div></div><div class="ACT_TEXT"><div name="6394573" id="6394573">8) <a href="https://lex.uz/uz/docs/2248101">Закон</a> Республики Узбекистан от 4 октября 2013 года № ЗРУ-354 «Об оценке соответствия» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2013 г., № 10, ст. 262);</div></div><div class="ACT_TEXT"><div name="6394574" id="6394574">9) <a href="https://lex.uz/uz/docs/2248650?ONDATE=08.10.2013 00#2248866">статью 6</a> Закона Республики Узбекистан от 7 октября 2013 года № ЗРУ-355 «О внесении изменений и дополнений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2013 г., № 10, ст. 263);</div></div><div class="ACT_TEXT"><div name="6394575" id="6394575">10) <a href="https://lex.uz/uz/docs/2517746?ONDATE=12.12.2014 00#2518037">статью 5</a> Закона Республики Узбекистан от 11 декабря 2014 года № ЗРУ-381 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2014 г., № 12, ст. 343);</div></div><div class="ACT_TEXT"><div name="6394576" id="6394576">11) <a href="https://lex.uz/uz/docs/2724500?ONDATE=21.08.2015 00#2727293">статью 43</a> Закона Республики Узбекистан от 20 августа 2015 года № ЗРУ-391 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан, направленных на дальнейшее усиление надежной защиты частной собственности, субъектов предпринимательства, снятие преград для их ускоренного развития» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2015 г., № 8, ст. 312);</div></div><div class="ACT_TEXT"><div name="6394577" id="6394577">12) <a href="https://lex.uz/uz/docs/2876196?ONDATE=22.04.2016 00#2876204">статью 1</a> Закона Республики Узбекистан от 20 января 2016 года № ЗРУ-401 «О внесении изменений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан в связи с принятием Таможенного кодекса Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2016 г., № 1 ст. 2);</div></div><div class="ACT_TEXT"><div name="6394578" id="6394578">13) <a href="https://lex.uz/uz/docs/2937149?ONDATE=26.04.2016 00#2938297">статью 22</a> Закона Республики Узбекистан от 25 апреля 2016 года № ЗРУ-405 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2016 г., № 4, ст. 125);</div></div><div class="ACT_TEXT"><div name="6394579" id="6394579">14) <a href="https://lex.uz/uz/docs/3084103?ONDATE=27.12.2016 00#3085180">статьи 20</a> и <a href="https://lex.uz/uz/docs/3084103?ONDATE=27.12.2016 00#3085203">24</a> Закона Республики Узбекистан от 26 декабря 2016 года № ЗРУ-416 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2016 г., № 12, ст. 383);</div></div><div class="ACT_TEXT"><div name="6394580" id="6394580">15) <a href="https://lex.uz/uz/docs/3235503?ONDATE=14.06.2017 00#3236951">статью 32</a> Закона Республики Узбекистан от 13 июня 2017 года № ЗРУ-436 «О внесении изменений и дополнений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2017 г., № 6, ст. 300);</div></div><div class="ACT_TEXT"><div name="6394581" id="6394581">16) <a href="https://lex.uz/uz/docs/3340556?ONDATE=15.09.2017 00#3343888">статьи 68</a> и <a href="https://lex.uz/uz/docs/3340556?ONDATE=15.09.2017 00#3343954">72</a> Закона Республики Узбекистан от 14 сентября 2017 года № ЗРУ-446 «О внесении изменений и дополнений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2017 г., № 9, ст. 510);</div></div><div class="ACT_TEXT"><div name="6394582" id="6394582">17) <a href="https://lex.uz/uz/docs/4661844?ONDATE=25.12.2019 00#4662351">статьи 15</a> и <a href="https://lex.uz/uz/docs/4661844?ONDATE=25.12.2019 00#4662398">18</a> Закона Республики Узбекистан от 24 декабря 2019 года № ЗРУ-597 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан в связи с совершенствованием деятельности отдельных государственных органов» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2019 г., № 12, ст. 891);</div></div><div class="ACT_TEXT"><div name="6394583" id="6394583">18) <a href="https://lex.uz/uz/docs/5220725?ONDATE=15.01.2021 00#5226691">статью 9</a> Закона Республики Узбекистан от 14 января 2021 года № ЗРУ-666 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., № 1, ст. 13);</div></div><div class="ACT_TEXT"><div name="6394584" id="6394584">19) статьи 38, 194 и 219 <a href="https://lex.uz/uz/docs/5388565">Закона</a> Республики Узбекистан от 21 апреля 2021 года № ЗРУ-683 «О внесении изменений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., приложение к № 4).</div></div><div class="CLAUSE_DEFAULT"><div name="6394585" id="6394585">Статья 51. Обеспечение исполнения, доведения, разъяснения сути и значения настоящего Закона</div></div><div class="ACT_TEXT"><div name="6394586" id="6394586">Узбекскому агентству по техническому регулированию и другим заинтересованным организациям обеспечить исполнение, доведение до исполнителей и разъяснение среди населения сути и значения настоящего Закона.</div></div><div class="CLAUSE_DEFAULT"><div name="6394587" id="6394587">Статья 52. Приведение законодательства в соответствие с настоящим Законом</div></div><div class="ACT_TEXT"><div name="6394590" id="6394590">Кабинету Министров Республики Узбекистан:</div></div><div class="ACT_TEXT"><div name="6394593" id="6394593">привести решения правительства в соответствие с настоящим Законом;</div></div><div class="ACT_TEXT"><div name="6394594" id="6394594">обеспечить пересмотр и отмену органами государственного управления своих нормативно-правовых актов, противоречащих настоящему Закону.</div></div><div class="CLAUSE_DEFAULT"><div name="6394596" id="6394596">Статья 53. Вступление в силу настоящего Закона</div></div><div class="ACT_TEXT"><div name="6394599" id="6394599">Настоящий Закон вступает в силу по истечении шести месяцев со дня его официального опубликования.</div></div><div class="SIGNATURE"><div name="6394601" id="6394601">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6394602" id="6394602">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6394603" id="6394603">27 февраля 2023 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="6394605" id="6394605">№ ЗРУ-819</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="6393635" id="6393635">(Национальная база данных законодательства, 28.02.2023 г., № 03/23/819/0113; 29.11.2023 г., № 03/23/880/0905)</div></div></div>
</div></body></html>