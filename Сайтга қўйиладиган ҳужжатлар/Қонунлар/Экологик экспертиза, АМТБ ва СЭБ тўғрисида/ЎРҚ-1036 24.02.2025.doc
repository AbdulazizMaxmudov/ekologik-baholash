<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Cyrl-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="7406345" id="7406345"></div></div><div class="ACT_FORM"><div name="7406346" id="7406346">Ўзбекистон Республикасининг Қонуни</div></div><div class="ACT_TITLE"><div name="7406348" id="7406348">Экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш тўғрисида</div></div><div class="GRIF_PARLAMENT"><div name="7406353" id="7406353">Қонунчилик палатаси томонидан 2024 йил 18 октябрда қабул қилинган<br />Сенат томонидан 2025 йил 24 январда маъқулланган</div></div><div class="BY_DEFAULT"><div name="7406356" id="7406356"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406369" id="7406369">1-боб. Умумий қоидалар</div></div><div class="CLAUSE_DEFAULT"><div name="7406370" id="7406370">1-модда. Ушбу Қонуннинг мақсади</div></div><div class="ACT_TEXT"><div name="7406371" id="7406371">Ушбу Қонуннинг мақсади экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш соҳасидаги муносабатларни тартибга солишдан иборат.</div></div><div class="CLAUSE_DEFAULT"><div name="7406372" id="7406372">2-модда. Экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш тўғрисидаги қонунчилик</div></div><div class="ACT_TEXT"><div name="7406373" id="7406373">Экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш тўғрисидаги қонунчилик ушбу Қонун ва бошқа қонунчилик ҳужжатларидан иборатдир.</div></div><div class="ACT_TEXT"><div name="7406374" id="7406374">Агар Ўзбекистон Республикасининг халқаро шартномасида Ўзбекистон Республикасининг экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш тўғрисидаги қонунчилигида назарда тутилганидан бошқача қоидалар белгиланган бўлса, халқаро шартнома қоидалари қўлланилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406376" id="7406376">3-модда. Асосий тушунчалар</div></div><div class="ACT_TEXT"><div name="7406377" id="7406377">Ушбу Қонунда қуйидаги асосий тушунчалар қўлланилади:</div></div><div class="ACT_TEXT"><div name="7406380" id="7406380"><strong>атроф-муҳит компонентлари</strong> — табиий муҳитда яшаш учун қулай шарт-шароитларни таъминлайдиган ер, ер ости бойликлари, сув, ўсимлик ва ҳайвонот дунёси ҳамда атмосфера ҳавоси;</div></div><div class="ACT_TEXT"><div name="7406381" id="7406381"><strong>атроф-муҳитга таъсир</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳит ва экологик хавфсизлик учун, шу жумладан инсон соғлиғи, атроф-муҳит компонентлари учун ҳар қандай оқибатлари ҳамда ушбу омилларнинг ўзаро боғлиқлиги, шунингдек ушбу омиллардаги ўзгаришларнинг ижтимоий-иқтисодий шарт-шароитларга ва маданий мерос объектларига таъсири;</div></div><div class="ACT_TEXT"><div name="7406383" id="7406383"><strong>атроф-муҳитга таъсирни баҳолаш</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳитга таъсири хусусиятларини ва даражасини, унинг эҳтимолий экологик оқибатларини аниқлашга ҳамда атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш чора-тадбирларини ишлаб чиқишга қаратилган тартиб-таомил;</div></div><div class="ACT_TEXT"><div name="7406385" id="7406385"><strong>атроф-муҳитга таъсирни баҳолаш материаллари</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳитга таъсирини баҳолаш натижалари бўйича тайёрланадиган ва экологик экспертиза ўтказиш учун тақдим этиладиган ҳужжатлар тўплами;</div></div><div class="ACT_TEXT"><div name="7406387" id="7406387"><strong>атроф-муҳитга таъсирни баҳолаш материалларини ва экологик нормативлар лойиҳаларини ишлаб чиқувчи (бундан буён матнда лойиҳани ишлаб чиқувчи деб юритилади)</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятини ва бошқа фаолиятни ташкил этиш учун атроф-муҳитга таъсирни баҳолаш материалларини, шунингдек амалга оширилаётган хўжалик фаолиятига ва бошқа фаолиятга оид экологик нормативлар лойиҳаларини ишлаб чиқишни амалга оширувчи юридик шахс;</div></div><div class="ACT_TEXT"><div name="7406388" id="7406388"><strong>буюртмачи (ташаббускор)</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятини ҳамда бошқа фаолиятни ташкил этиш учун атроф-муҳитга таъсирни баҳолаш материалларини, шунингдек амалга оширилаётган хўжалик фаолиятига ва бошқа фаолиятга оид экологик нормативлар лойиҳаларини экологик экспертизадан ўтказиш учун тақдим этадиган юридик ёки жисмоний шахс;</div></div><div class="ACT_TEXT"><div name="7406390" id="7406390"><strong>жамоатчилик эшитуви</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг мақсадга мувофиқлиги тўғрисида қарор қабул қилишга тааллуқли масалаларни муҳокама қилиш учун ташкил этиладиган жамоатчилик йиғилиши;</div></div><div class="ACT_TEXT"><div name="7406392" id="7406392"><strong>махсус ҳуқуқий режимга эга объектлар</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятини ҳамда бошқа фаолиятни амалга ошириш шарт-шароитларини тартибга солувчи алоҳида ҳуқуқий нормалар қўлланиладиган экологик экспертиза объектлари;</div></div><div class="ACT_TEXT"><div name="7406394" id="7406394"><strong>мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолияти ҳамда бошқа фаолият</strong> — атроф-муҳитга салбий таъсир кўрсатиши мумкин бўлган ҳамда экологик экспертиза объекти ҳисобланадиган ҳар қандай фаолият;</div></div><div class="ACT_TEXT"><div name="7406395" id="7406395"><strong>стратегик режалаштириш ҳужжатлари</strong> — давлат дастурларининг, концепцияларининг, ишлаб чиқариш кучларини, иқтисодий ва ижтимоий соҳалар тармоқларини жойлаштириш ҳамда ривожлантириш схемаларининг лойиҳалари ва шаҳарсозлик ҳужжатлари, шунингдек бошқа стратегик аҳамиятга эга бўлган объектларга оид ҳужжатлар;</div></div><div class="ACT_TEXT"><div name="7406396" id="7406396"><strong>стратегик экологик баҳолаш</strong> — стратегик режалаштириш ҳужжатлари асосида мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳитга таъсири хусусиятлари ва даражасини, эҳтимолий экологик оқибатларини аниқлашга, шунингдек баҳолаш натижалари бўйича атроф-муҳитни муҳофаза қилиш ҳамда табиий ресурслардан оқилона фойдаланиш чора-тадбирларини ишлаб чиқишга қаратилган тартиб-таомил;</div></div><div class="ACT_TEXT"><div name="7406397" id="7406397"><strong>экологик нормативлар </strong>— атроф-муҳитни ифлослантирувчи манбаларни инвентаризациядан ўтказиш натижалари асосида ишлаб чиқилган ҳамда ифлослантирувчи моддаларни чиқариш, оқизиш ва чиқиндиларни жойлаштириш нормативларини белгилаш учун экологик экспертизадан ўтказилиши лозим бўлган ҳужжатлар;</div></div><div class="ACT_TEXT"><div name="7406399" id="7406399"><strong>экологик экспертиза</strong> — мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг экологик талабларга мувофиқлигини белгилашга ҳамда экологик экспертиза объектини рўёбга чиқариш мумкинлигини ёки мумкин эмаслигини аниқлашга қаратилган тартиб-таомил.</div></div><div class="CLAUSE_DEFAULT"><div name="7406401" id="7406401">4-модда. Экологик экспертизанинг, атроф-муҳитга таъсирни баҳолашнинг ва стратегик экологик баҳолашнинг мақсадлари</div></div><div class="ACT_TEXT"><div name="7406402" id="7406402">Экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш қуйидаги мақсадларда ўтказилади:</div></div><div class="ACT_TEXT"><div name="7406403" id="7406403">мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятини ҳамда бошқа фаолиятни амалга ошириш тўғрисида қарор қабул қилинишидан олдинги босқичларда бундай фаолиятнинг экологик талабларга мувофиқлигини белгилаш;</div></div><div class="ACT_TEXT"><div name="7406404" id="7406404">мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳит ҳолатига ҳамда инсон соғлиғига салбий таъсир кўрсатиши мумкин бўлган ёки салбий таъсир кўрсатаётган экологик хавфлилик даражасини аниқлаш;</div></div><div class="ACT_TEXT"><div name="7406406" id="7406406">мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳитга ва инсон соғлиғига салбий таъсирининг олдини олиш ҳамда уни камайтириш;</div></div><div class="ACT_TEXT"><div name="7406408" id="7406408">атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш бўйича назарда тутилаётган чора-тадбирларнинг етарлилигини ҳамда асослилигини аниқлаш.</div></div><div class="CLAUSE_DEFAULT"><div name="7406409" id="7406409">5-модда. Экологик экспертизанинг, атроф-муҳитга таъсирни баҳолашнинг ва стратегик экологик баҳолашнинг асосий принциплари</div></div><div class="ACT_TEXT"><div name="7406410" id="7406410">Экологик экспертизанинг, атроф-муҳитга таъсирни баҳолашнинг ва стратегик экологик баҳолашнинг асосий принциплари қуйидагилардан иборат:</div></div><div class="ACT_TEXT"><div name="7406412" id="7406412">қонунийлик;</div></div><div class="ACT_TEXT"><div name="7406413" id="7406413">холислик;</div></div><div class="ACT_TEXT"><div name="7406414" id="7406414">асослилик;</div></div><div class="ACT_TEXT"><div name="7406416" id="7406416">ахборотдан эркин фойдаланиш ва унинг ҳаққонийлиги;</div></div><div class="ACT_TEXT"><div name="7406418" id="7406418">жамоатчилик иштироки;</div></div><div class="ACT_TEXT"><div name="7406420" id="7406420">очиқлик ва ошкоралик;</div></div><div class="ACT_TEXT"><div name="7406422" id="7406422">экологик хавфсизлик талабларини ҳисобга олишнинг мажбурийлиги;</div></div><div class="ACT_TEXT"><div name="7406424" id="7406424">ҳар қандай мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг кутилаётган экологик хавфлилик презумпцияси;</div></div><div class="ACT_TEXT"><div name="7406426" id="7406426">мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳитга ва инсон соғлиғига таъсирини баҳолашнинг комплекслилиги.</div></div><div class="CLAUSE_DEFAULT"><div name="7406429" id="7406429">6-модда. Ўзбекистон Республикаси Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлигининг экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш соҳасидаги ваколатлари</div></div><div class="ACT_TEXT"><div name="7406430" id="7406430">Ўзбекистон Республикаси Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш соҳасидаги махсус ваколатли давлат органидир (бундан буён матнда махсус ваколатли давлат органи деб юритилади).</div></div><div class="ACT_TEXT"><div name="7406431" id="7406431">Махсус ваколатли давлат органи:</div></div><div class="ACT_TEXT"><div name="7406432" id="7406432">давлат экологик экспертизасини ташкил этади ва ўтказади;</div></div><div class="ACT_TEXT"><div name="7406433" id="7406433">экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш соҳасидаги ягона давлат сиёсатини амалга оширади;</div></div><div class="ACT_TEXT"><div name="7406434" id="7406434">экологик экспертизанинг ягона тизимини ташкил қилувчи ихтисослаштирилган эксперт бўлинмалари фаолиятини ташкил этади;</div></div><div class="ACT_TEXT"><div name="7406435" id="7406435">экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш бўйича норматив-техник ва йўриқнома-услубий ҳужжатларни ишлаб чиқади ҳамда тасдиқлайди;</div></div><div class="ACT_TEXT"><div name="7406436" id="7406436">давлат экологик экспертизаси бўйича экспертлар кенгаши таркибини ҳамда унинг низомини тасдиқлайди;</div></div><div class="ACT_TEXT"><div name="7406437" id="7406437">давлат экологик экспертизасининг хулосасида кўрсатилган талабларнинг бажарилиши мониторингини олиб боради;</div></div><div class="ACT_TEXT"><div name="7406439" id="7406439">экологик экспертизанинг ижобий хулосасига эга бўлмаган объектларга нисбатан молиялаштириш, кредитлаш операцияларини ва бошқа молиявий операцияларни тўхтатиб туриш (тугатиш) тўғрисидаги тақдимномаларни банкларга ва бошқа кредит ташкилотларига юборади;</div></div><div class="ACT_TEXT"><div name="7406440" id="7406440">экологик экспертиза хулосаларининг бажарилиши устидан экологик назоратни амалга оширади;</div></div><div class="ACT_TEXT"><div name="7406441" id="7406441">бошқа давлатларнинг табиатни муҳофаза қилиш ташкилотлари ҳамда халқаро ташкилотлар билан экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш соҳасидаги ҳамкорликни амалга оширади.</div></div><div class="ACT_TEXT"><div name="7406442" id="7406442">Махсус ваколатли давлат органи қонунчиликка мувофиқ бошқа ваколатларни ҳам амалга ошириши мумкин.</div></div><div class="CLAUSE_DEFAULT"><div name="7406459" id="7406459">7-модда. Экологик экспертизанинг турлари</div></div><div class="ACT_TEXT"><div name="7406463" id="7406463">Экологик экспертиза давлат ва жамоат экологик экспертизаси тарзида амалга оширилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406466" id="7406466">8-модда. Экологик экспертиза объектлари</div></div><div class="ACT_TEXT"><div name="7406470" id="7406470">Экологик экспертиза объектлари қуйидагилардан иборат:</div></div><div class="ACT_TEXT"><div name="7406472" id="7406472">барча турдаги қурилишлар учун ер участкаларини танлаш ва (ёки) ажратиш материаллари;</div></div><div class="ACT_TEXT"><div name="7406474" id="7406474">лойиҳаолди ва лойиҳа ҳужжатлари;</div></div><div class="ACT_TEXT"><div name="7406477" id="7406477">табиий ресурслардан фойдаланиш билан боғлиқ бўлган хўжалик фаолиятини ҳамда бошқа фаолиятни тартибга солувчи норматив-техник ва йўриқнома-услубий ҳужжатлар, шу жумладан техник регламентлар ва шартларнинг, стандартларнинг, қоидалар ҳамда йўриқномаларнинг лойиҳалари;</div></div><div class="ACT_TEXT"><div name="7406479" id="7406479">чиқиндиларни зарарсизлантириш, қайта ишлаш ва утилизация қилиш учун янги турдаги технологияларни ҳамда техника воситаларини, материаллар, буюмларни, биологик, кимёвий моддаларни ва воситаларни яратиш бўйича ҳужжатлар;</div></div><div class="ACT_TEXT"><div name="7406481" id="7406481">атроф-муҳитнинг ҳолатига ва инсон соғлиғига салбий таъсир кўрсатувчи ишлаб турган корхоналар ҳамда бошқа объектлар;</div></div><div class="ACT_TEXT"><div name="7406483" id="7406483">махсус ҳуқуқий режимга эга бўлган объектлар.</div></div><div class="ACT_TEXT"><div name="7406485" id="7406485">Экологик экспертиза объектлари атроф-муҳитга таъсири бўйича уч тоифага бўлинади ва уларнинг рўйхати Ўзбекистон Республикаси Вазирлар Маҳкамаси томонидан тасдиқланади.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406500" id="7406500">2-боб. Давлат экологик экспертизаси</div></div><div class="CLAUSE_DEFAULT"><div name="7406501" id="7406501">9-модда. Давлат экологик экспертизасини ўтказиш</div></div><div class="ACT_TEXT"><div name="7406502" id="7406502">Давлат экологик экспертизаси мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг экологик талабларга мувофиқлигини белгилаш ва давлат экологик экспертизаси объектини рўёбга чиқариш мумкинлигини ёки мумкин эмаслигини аниқлаш мақсадида махсус ваколатли давлат органи томонидан ўтказилади.</div></div><div class="ACT_TEXT"><div name="7406504" id="7406504">Буюртмачи (ташаббускор) давлат экологик экспертизасини ўтказиш тўғрисида оммавий ахборот воситаларида эълон бериши мумкин. Бу ҳолда экологик экспертиза тугалланган кундан эътиборан бир ой ичида унинг натижалари тўғрисидаги маълумотлар эълон қилинади.</div></div><div class="ACT_TEXT"><div name="7406506" id="7406506">Давлат экологик экспертизаси ўтказилиши тўғрисида эълон бериши ва унинг натижалари ҳақидаги маълумотлар оммавий ахборот воситаларида эълон қилиниши шарт бўлган давлат экологик экспертизаси объектларининг рўйхати қонунчиликда белгиланади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406508" id="7406508">10-модда. Эколог-экспертнинг мустақиллиги</div></div><div class="ACT_TEXT"><div name="7406510" id="7406510">Буюртмачининг (ташаббускорнинг) ёки бошқа манфаатдор шахсларнинг эколог-эксперт фаолиятига аралашишига йўл қўйилмайди.</div></div><div class="CLAUSE_DEFAULT"><div name="7406513" id="7406513">11-модда. Давлат экологик экспертизаси ўтказилишининг мажбурийлиги</div></div><div class="ACT_TEXT"><div name="7406515" id="7406515">Ушбу Қонуннинг <a href="https://lex.uz/uz/docs/7397280#7406466">8-моддасида</a> назарда тутилган экологик экспертиза объектлари давлат экологик экспертизасидан ўтказилиши шарт.</div></div><div class="CLAUSE_DEFAULT"><div name="7406586" id="7406586">12-модда. Давлат экологик экспертизасини молиялаштириш</div></div><div class="ACT_TEXT"><div name="7406587" id="7406587">Давлат экологик экспертизасини молиялаштириш қонунчиликда белгиланган тартибда буюртмачининг (ташаббускорнинг) маблағлари ҳисобидан амалга оширилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406590" id="7406590">13-модда. Давлат экологик экспертизасини ўтказиш учун тақдим этиладиган материаллар</div></div><div class="ACT_TEXT"><div name="7406593" id="7406593">Давлат экологик экспертизасини ўтказиш учун буюртмачи (ташаббускор) томонидан қуйидагилар тақдим этилади:</div></div><div class="ACT_TEXT"><div name="7406595" id="7406595">лойиҳалаштирилаётган объектлар бўйича — атроф-муҳитга таъсир кўрсатилиши тўғрисидаги баёнот лойиҳасини, экологик оқибатлар тўғрисидаги баёнотни, қонунчиликда назарда тутилган ҳолларда эса атроф-муҳитга таъсир кўрсатилиши тўғрисидаги баёнотни ўз ичига оладиган атроф-муҳитга таъсирни баҳолаш материаллари;</div></div><div class="ACT_TEXT"><div name="7406597" id="7406597">ишлаб турган объектлар бўйича — экологик нормативларнинг лойиҳалари, объектнинг атроф-муҳитга ва инсон соғлиғига таъсир кўрсатиш ҳолати аниқланган тақдирда, атроф-муҳитга таъсир кўрсатилиши тўғрисида тайёрланган баёнот. Бунда буюртмачи (ташаббускор) қўшимча равишда экологик аудит материалларини тақдим этишга ҳақли;</div></div><div class="ACT_TEXT"><div name="7406617" id="7406617">ушбу Қонун 8-моддаси биринчи қисмининг <a href="https://lex.uz/uz/docs/7397280#7406479">бешинчи хатбошисида</a> кўрсатилган объектлар бўйича — ишлаб чиқилган барча ҳужжатлар.</div></div><div class="ACT_TEXT"><div name="7406618" id="7406618">Атроф-муҳитга таъсир кўрсатилиши тўғрисидаги баёнот лойиҳаси давлат экологик экспертизаси объектини молиялаштириш бошлангунига қадар тақдим этилади.</div></div><div class="ACT_TEXT"><div name="7406631" id="7406631">Атроф-муҳитга таъсир кўрсатилиши тўғрисидаги баёнот давлат экологик экспертизаси объектининг техник-иқтисодий асослари тасдиқлангунига қадар тақдим этилади.</div></div><div class="ACT_TEXT"><div name="7406632" id="7406632">Экологик оқибатлар тўғрисидаги баёнот объект қонунчиликда белгиланган тартибда фойдаланишга қабул қилиб олингунига қадар тақдим этилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406635" id="7406635">14-модда. Атроф-муҳитга таъсирни баҳолаш материалларини ва экологик нормативлар лойиҳаларини давлат экологик экспертизасидан ўтказиш учун тақдим этиш</div></div><div class="ACT_TEXT"><div name="7406638" id="7406638">Атроф-муҳитга таъсирни баҳолаш лойиҳани ишлаб чиқувчилар томонидан ўтказилади.</div></div><div class="ACT_TEXT"><div name="7406639" id="7406639">Атроф-муҳитга таъсирни баҳолаш материаллари ва экологик нормативлар лойиҳалари давлат экологик экспертизасини ўтказиш учун махсус ваколатли давлат органининг расмий веб-сайти орқали электрон ҳужжат шаклида тақдим этилади, бундан махсус ҳуқуқий режимга эга объектлар мустасно.</div></div><div class="ACT_TEXT"><div name="7406640" id="7406640">Махсус ҳуқуқий режимга эга объектларнинг давлат экологик экспертизасини ўтказиш учун атроф-муҳитга таъсирни баҳолаш материаллари ҳамда экологик нормативлар лойиҳалари қоғоз шаклида тақдим этилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406641" id="7406641">15-модда. Давлат экологик экспертизасини ўтказиш муддатлари</div></div><div class="ACT_TEXT"><div name="7406643" id="7406643">Давлат экологик экспертизасини ўтказиш муддати йигирма беш иш кунидан ошмаслиги керак. Давлат экологик экспертизаси объектининг мураккаблигига қараб, уни ўтказиш муддати махсус ваколатли давлат органи томонидан кўпи билан уч ой муддатга узайтирилиши мумкин.</div></div><div class="ACT_TEXT"><div name="7406644" id="7406644">Давлат экологик экспертизасини ўтказиш муддати давлат экологик экспертизасининг қиймати тўлиқ тўлангандан кейинги иш кунидан эътиборан ҳисобланади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406646" id="7406646">16-модда. Давлат экологик экспертизасини ўтказиш чоғида қўйиладиган талаблар</div></div><div class="ACT_TEXT"><div name="7406647" id="7406647">Давлат экологик экспертизасини ўтказишда қуйидагилар амалга оширилади:</div></div><div class="ACT_TEXT"><div name="7406649" id="7406649">тақдим этилган материалларнинг атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги қонунчилик талабларига мувофиқлигини текшириш;</div></div><div class="ACT_TEXT"><div name="7406651" id="7406651">мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг экологик ва ижтимоий оқибатлари тўғрисидаги маълумотларнинг ишончлилиги ва тўлиқлигини таҳлил қилиш;</div></div><div class="ACT_TEXT"><div name="7406652" id="7406652">биологик, кимёвий моддалар ва технологияларнинг атроф табиий муҳитга таъсирини баҳолашнинг асослилигини текшириш;</div></div><div class="ACT_TEXT"><div name="7406653" id="7406653">мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятини ҳамда бошқа фаолиятни амалга ошириш оқибатлари билан боғлиқ экологик хавфлилик даражасини баҳолашнинг тўғрилигини текшириш;</div></div><div class="ACT_TEXT"><div name="7406655" id="7406655">экологик хавфсизлик талабларини таъминлашга доир чора-тадбирларнинг етарлилигини ва асослилигини аниқлаш;</div></div><div class="ACT_TEXT"><div name="7406656" id="7406656">экологик нормативлар лойиҳаларининг асослилигини текшириш.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406662" id="7406662">3-боб. Давлат экологик экспертизасининг субъектлари</div></div><div class="CLAUSE_DEFAULT"><div name="7406664" id="7406664">17-модда. Буюртмачи (ташаббускор)</div></div><div class="ACT_TEXT"><div name="7406668" id="7406668">Буюртмачи (ташаббускор) қуйидаги ҳуқуқларга эга:</div></div><div class="ACT_TEXT"><div name="7406670" id="7406670">давлат экологик экспертизасини ўтказиш масалалари бўйича махсус ваколатли давлат органидан маслаҳатлар ва зарур услубий ёрдам олиш;</div></div><div class="ACT_TEXT"><div name="7406672" id="7406672">давлат экологик экспертизасининг объектини рўёбга чиқариш мумкин эмаслиги тўғрисидаги хулосасига асосан материалларни маромига етказиш ва такрорий давлат экологик экспертизасини ўтказиш учун тақдим этиш;</div></div><div class="ACT_TEXT"><div name="7406674" id="7406674">аккредитация қилинган лабораторияларни жалб этган ҳолда, ифлослантирувчи моддаларнинг чиқарилиш, оқизилиш ва чиқиндиларни жойлаштириш манбаларидан намуналар олиш ҳамда лаборатория таҳлилларини ўтказиш;</div></div><div class="ACT_TEXT"><div name="7406679" id="7406679">атроф-муҳитга таъсирни баҳолаш материаллари ва экологик нормативлар лойиҳалари тўғрисидаги ахборотни эълон қилиш, шунингдек давлат экологик экспертизасининг ўтказилиш жараёни ҳақидаги маълумотларни олиш.</div></div><div class="ACT_TEXT"><div name="7406681" id="7406681">Буюртмачи (ташаббускор):</div></div><div class="ACT_TEXT"><div name="7406684" id="7406684">атроф-муҳитни муҳофаза қилиш ҳамда табиий ресурслардан оқилона фойдаланиш тўғрисидаги қонунчилик талабларига мувофиқ атроф-муҳитга таъсирни баҳолаш материалларини ва экологик нормативлар лойиҳаларини ишлаб чиқиши ҳамда уларни давлат экологик экспертизасидан ўтказиш учун тақдим этиши;</div></div><div class="ACT_TEXT"><div name="7406687" id="7406687">давлат экологик экспертизасини ўтказиш учун қонунчиликда белгиланган тартибда тўловни амалга ошириши;</div></div><div class="ACT_TEXT"><div name="7406689" id="7406689">атроф-муҳитга таъсирни баҳолаш учун зарур бўлган тадқиқотларнинг молиялаштирилишини таъминлаши;</div></div><div class="ACT_TEXT"><div name="7406692" id="7406692">давлат экологик экспертизаси ўтказилгунига қадар мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолияти ҳамда бошқа фаолият бўйича жамоатчилик эшитувларини ўтказиши;</div></div><div class="ACT_TEXT"><div name="7406694" id="7406694">атроф-муҳитга таъсирни баҳолаш материалларида давлат экологик экспертизаси объекти фаолияти натижасида ҳосил бўладиган иссиқхона газларининг миқдорини ҳамда углерод нейтраллигини таъминлаш бўйича мақсадли кўрсаткичларни инобатга олиши;</div></div><div class="ACT_TEXT"><div name="7406696" id="7406696">стратегик режалаштириш ҳужжатида иқлим ўзгаришига мослашиш бўйича чора-тадбирларни ишлаб чиқиши ва амалга ошириши;</div></div><div class="ACT_TEXT"><div name="7406698" id="7406698">давлат экологик экспертизасининг хулосасида кўрсатилган талабларни бажариши шарт.</div></div><div class="ACT_TEXT"><div name="7406699" id="7406699">Буюртмачи (ташаббускор) қонунчиликка мувофиқ бошқа ҳуқуқларга эга бўлиши ва унинг зиммасида ўзга мажбуриятлар ҳам бўлиши мумкин.</div></div><div class="CLAUSE_DEFAULT"><div name="7406708" id="7406708">18-модда. Лойиҳани ишлаб чиқувчи</div></div><div class="ACT_TEXT"><div name="7406711" id="7406711">Лойиҳани ишлаб чиқувчи штатида экология ва атроф-муҳитни муҳофаза қилиш соҳасида камида уч йил ишлаган, тегишли малака сертификати мавжуд бўлган камида икки нафар ходимга эга бўлиши керак.</div></div><div class="ACT_TEXT"><div name="7406727" id="7406727">Атроф-муҳитга таъсирни баҳолаш материалларини ва экологик нормативлар лойиҳаларини ишлаб чиқувчининг фаолиятини ташкил этиш тартиби, шунингдек экологик экспертиза объектлари учун лойиҳа ҳужжатларини ишлаб чиқишга доир малака сертификатини бериш тартиби Ўзбекистон Республикаси Вазирлар Маҳкамаси томонидан белгиланади.</div></div><div class="ACT_TEXT"><div name="7406729" id="7406729">Атроф-муҳитга таъсирни баҳолаш материалларининг ва экологик нормативлар лойиҳаларининг сифатли ишлаб чиқилишини таъминлаш мақсадида махсус ваколатли давлат органи лойиҳаларни ишлаб чиқувчиларнинг рейтингини юритади.</div></div><div class="ACT_TEXT"><div name="7406731" id="7406731">Лойиҳани ишлаб чиқувчи атроф-муҳитга таъсирни баҳолаш бўйича материалларнинг ва экологик нормативлар лойиҳаларининг тўғрилиги, ишончлилиги ҳамда асослилиги учун буюртмачи (ташаббускор) билан солидар жавобгар бўлади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406734" id="7406734">19-модда. Эколог-эксперт</div></div><div class="ACT_TEXT"><div name="7406736" id="7406736">Олий маълумотга, экология ва атроф-муҳитни муҳофаза қилиш соҳасида ёки турдош соҳаларда камида узлуксиз уч йиллик иш стажига эга бўлган ҳамда белгиланган тартибда махсус ваколатли давлат органи томонидан аттестациядан ўтказилган ходим эколог-эксперт бўлиши мумкин.</div></div><div class="ACT_TEXT"><div name="7406737" id="7406737">Ўзбекистон Республикасининг норезидентлари ҳам махсус ваколатли давлат органи томонидан контрактга асосан халқаро эколог-экспертлар сифатида жалб этилиши мумкин, бундан давлат сирлари ёки қонун билан қўриқланадиган бошқа сир билан боғлиқ ҳоллар мустасно.</div></div><div class="ACT_TEXT"><div name="7406740" id="7406740">Эколог-эксперт фаолияти қонунчиликка мувофиқ тартибга солинадиган давлат фуқаролик хизматчисидир, бундан халқаро эколог-экспертлар мустасно.</div></div><div class="ACT_TEXT"><div name="7406742" id="7406742">Эколог-эксперт қуйидаги ҳуқуқларга эга:</div></div><div class="ACT_TEXT"><div name="7406744" id="7406744">давлат экологик экспертизасини ўтказиш учун зарур бўлган ҳужжатлар ва материалларни олиш;</div></div><div class="ACT_TEXT"><div name="7406746" id="7406746">давлат экологик экспертизасини ўтказиш учун тақдим этилган, қонунчилик талабларига жавоб бермайдиган атроф-муҳитга таъсирни баҳолаш материалларини ва экологик нормативлар лойиҳаларини рад этиш;</div></div><div class="ACT_TEXT"><div name="7406748" id="7406748">давлат экологик экспертизасини ўтказиш учун тақдим этилган материалларнинг ишончлилигини жойига чиққан ҳолда текшириш.</div></div><div class="ACT_TEXT"><div name="7406754" id="7406754">Эколог-эксперт:</div></div><div class="ACT_TEXT"><div name="7406757" id="7406757">давлат экологик экспертизасини ўтказишда қонунчилик талабларига риоя этиши;</div></div><div class="ACT_TEXT"><div name="7406759" id="7406759">давлат экологик экспертизасининг ўз вақтида, ҳар томонлама, холисона ва сифатли ўтказилишини, шунингдек унинг натижалари бўйича белгиланган тартибда хулоса берилишини таъминлаши;</div></div><div class="ACT_TEXT"><div name="7406761" id="7406761">давлат экологик экспертизасининг муайян объектига нисбатан шахсий манфаатдорлиги бўлган тақдирда ўзини ўзи рад этиши;</div></div><div class="ACT_TEXT"><div name="7406764" id="7406764">давлат экологик экспертизаси учун тақдим этилган материалларнинг бут сақланишини, шунингдек давлат сирларини, ҳарбий, хизмат ва тижорат сирини ташкил этувчи маълумотларнинг ошкор қилинмаслигини таъминлаши шарт.</div></div><div class="ACT_TEXT"><div name="7406767" id="7406767">Эколог-эксперт қонунчиликка мувофиқ бошқа ҳуқуқларга эга бўлиши ва унинг зиммасида ўзга мажбуриятлар ҳам бўлиши мумкин.</div></div><div class="ACT_TEXT"><div name="7406769" id="7406769">Эколог-эксперт ўз мажбуриятларини буюртмачининг (ташаббускорнинг) ҳуқуқларига ёки қонун билан муҳофаза қилинадиган манфаатларига моддий зарар ёки маънавий зиён етказган тарзда бажармаганлик ёки лозим даражада бажармаганлик учун, шунингдек экологик экспертиза тўғрисидаги қонунчиликни бошқача тарзда бузганлик учун қонунчиликка мувофиқ жавобгар бўлади.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406781" id="7406781">4-боб. Давлат экологик экспертизасининг хулосаси</div></div><div class="CLAUSE_DEFAULT"><div name="7406784" id="7406784">20-модда. Давлат экологик экспертизасини ўтказиш натижалари</div></div><div class="ACT_TEXT"><div name="7406785" id="7406785">Давлат экологик экспертизасини ўтказиш натижалари бўйича давлат экологик экспертизаси объектини рўёбга чиқариш мумкинлиги ёки мумкин эмаслиги тўғрисидаги якунларни ўз ичига олган хулоса тузилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406786" id="7406786">21-модда. Давлат экологик экспертизаси объектини рўёбга чиқариш мумкин эмаслиги тўғрисидаги хулоса</div></div><div class="ACT_TEXT"><div name="7406789" id="7406789">Давлат экологик экспертизаси объектини рўёбга чиқариш мумкин эмаслиги тўғрисидаги хулоса қуйидаги ҳолларда берилади:</div></div><div class="ACT_TEXT"><div name="7406790" id="7406790">агар буюртмачи (ташаббускор) томонидан тақдим этилган ҳужжатлар атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги қонунчилик талабларига зид бўлса;</div></div><div class="ACT_TEXT"><div name="7406793" id="7406793">агар давлат экологик экспертизасини ўтказиш чоғида буюртмачи (ташаббускор) томонидан тақдим этилган ҳужжатларда нотўғри ва (ёки) бузиб кўрсатилган маълумотлар мавжуд эканлиги аниқланган бўлса;</div></div><div class="ACT_TEXT"><div name="7406794" id="7406794">агар ўтказилган жамоатчилик эшитувлари натижаларига кўра тайёрланган якуний ҳужжатларда давлат экологик экспертизаси объектини рўёбга чиқаришга нисбатан жамоатчилик эшитувлари иштирокчилари томонидан асослантирилган эътирозлар билдирилган бўлса.</div></div><div class="ACT_TEXT"><div name="7406797" id="7406797">Давлат экологик экспертизаси объектини рўёбга чиқариш мумкин эмаслиги тўғрисидаги хулосани ушбу модданинг <a href="https://lex.uz/uz/docs/7397280#7406789">биринчи қисмида</a> назарда тутилмаган асосларга кўра беришга йўл қўйилмайди.</div></div><div class="CLAUSE_DEFAULT"><div name="7406802" id="7406802">22-модда. Давлат экологик экспертизаси хулосасини бажаришнинг мажбурийлиги</div></div><div class="ACT_TEXT"><div name="7406804" id="7406804">Давлат экологик экспертизасининг хулосаси давлат экологик экспертизаси объектини молиялаштириш ҳамда рўёбга чиқариш чоғида юридик ва жисмоний шахслар томонидан бажарилиши шарт. Давлат экологик экспертизасининг ижобий хулосаси бўлмай туриб, лойиҳаларнинг банк ва бошқа кредит ташкилотлари томонидан молиялаштирилиши, шунингдек рўёбга чиқарилиши тақиқланади.</div></div><div class="ACT_TEXT"><div name="7406806" id="7406806">Давлат экологик экспертизасининг давлат экологик экспертизаси объектини рўёбга чиқариш мумкин эмаслиги тўғрисидаги хулосаси бўлган тақдирда, буюртмачи (ташаббускор) хулосадаги мавжуд таклифларга мувофиқ лойиҳанинг қонунчилик талабларига мувофиқлаштирилишини таъминлаши ҳамда материалларни давлат экологик экспертизаси учун қайта тақдим этиши ёхуд режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятидан ва бошқа фаолиятдан воз кечиши шарт.</div></div><div class="CLAUSE_DEFAULT"><div name="7406809" id="7406809">23-модда. Давлат экологик экспертизаси хулосасининг амал қилиш муддати</div></div><div class="ACT_TEXT"><div name="7406810" id="7406810">Давлат экологик экспертизаси объектининг экологик талабларга мувофиқлиги тўғрисидаги давлат экологик экспертизасининг хулосаси қуйидаги муддатларда юридик кучга эга бўлади:</div></div><div class="ACT_TEXT"><div name="7406811" id="7406811">атроф-муҳитга таъсирни баҳолаш материаллари бўйича — хулоса берилган кундан эътиборан уч йил мобайнида;</div></div><div class="ACT_TEXT"><div name="7406812" id="7406812">экологик нормативлар лойиҳалари бўйича — хулоса берилган кундан эътиборан беш йил мобайнида.</div></div><div class="CLAUSE_DEFAULT"><div name="7406814" id="7406814">24-модда. Давлат экологик экспертизаси хулосаси бажарилишини мониторинг қилиш</div></div><div class="ACT_TEXT"><div name="7406815" id="7406815">Давлат экологик экспертизасининг хулосасида кўрсатилган талабларни таъминлашга қаратилган чора-тадбирларни амалга ошириш ва уларнинг бажарилишини мониторинг қилиш белгиланган тартибда буюртмачи (ташаббускор) томонидан таъминланади.</div></div><div class="ACT_TEXT"><div name="7406816" id="7406816">Буюртмачи (ташаббускор) давлат экологик экспертизаси хулосасида кўрсатилган талабларнинг бажарилиши тўғрисида ҳар чорак якунларига кўра, чоракдан кейинги ойнинг 25 санасидан кечиктирмай махсус ваколатли давлат органига ахборот тақдим этиши шарт.</div></div><div class="ACT_TEXT"><div name="7406817" id="7406817">Буюртмачи (ташаббускор) давлат экологик экспертизасининг хулосасида кўрсатилган талабларнинг бажарилиши тўғрисидаги ахборотни ушбу модданинг <a href="https://lex.uz/uz/docs/7397280#7406816">иккинчи қисмида</a> назарда тутилган муддатларда тақдим этмаган тақдирда, махсус ваколатли давлат органи буюртмачига (ташаббускорга) ёзма кўрсатма беради.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406818" id="7406818">5-боб. Давлат экологик экспертизасининг хулосасини қайта расмийлаштириш ва унинг амал қилишини тўхтатиб туриш ёки тугатиш</div></div><div class="CLAUSE_DEFAULT"><div name="7406819" id="7406819">25-модда. Давлат экологик экспертизасининг хулосасини қайта расмийлаштириш</div></div><div class="ACT_TEXT"><div name="7406820" id="7406820">Буюртмачи (ташаббускор) қайта ташкил этилган, унинг номи ўзгартирилган ёки ваколатлари ёхуд ҳуқуқ ва мажбуриятлари ҳуқуқий ворисга ўтган ҳолларда, буюртмачи (ташаббускор) ёки унинг ҳуқуқий вориси қайта рўйхатдан ўтказилганидан кейин етти иш куни ичида махсус ваколатли давлат органига тасдиқловчи ҳужжатларни илова қилган ҳолда, давлат экологик экспертизасининг хулосасини қайта расмийлаштиришга доир ариза бериши мумкин.</div></div><div class="ACT_TEXT"><div name="7406821" id="7406821">Давлат экологик экспертизасининг хулосасини қайта расмийлаштирганлик учун тўлов ундирилмайди.</div></div><div class="CLAUSE_DEFAULT"><div name="7406822" id="7406822">26-модда. Давлат экологик экспертизаси хулосасининг амал қилишини тўхтатиб туриш ёки тугатиш</div></div><div class="ACT_TEXT"><div name="7406823" id="7406823">Давлат экологик экспертизаси хулосасининг амал қилиши суд томонидан қуйидаги ҳолларда тўхтатиб турилиши мумкин:</div></div><div class="ACT_TEXT"><div name="7406824" id="7406824">буюртмачи (ташаббускор) давлат экологик экспертизаси хулосасининг амал қилишини тўхтатиб туриш тўғрисидаги ариза билан мурожаат қилганда;</div></div><div class="ACT_TEXT"><div name="7406825" id="7406825">буюртмачининг (ташаббускорнинг) фаолияти тўхтатиб турилганда;</div></div><div class="ACT_TEXT"><div name="7406826" id="7406826">буюртмачи (ташаббускор) томонидан давлат экологик экспертизасининг хулосасида кўрсатилган талабларга риоя этилмаганда;</div></div><div class="ACT_TEXT"><div name="7406827" id="7406827">қонунчиликда белгиланган бошқа ҳолларда.</div></div><div class="ACT_TEXT"><div name="7406828" id="7406828">Давлат экологик экспертизаси хулосасининг амал қилиши қуйидаги ҳолларда тугатилади:</div></div><div class="ACT_TEXT"><div name="7406829" id="7406829">давлат экологик экспертизаси хулосасининг амал қилиш муддати тугаганда;</div></div><div class="ACT_TEXT"><div name="7406830" id="7406830">буюртмачи (ташаббускор) тугатилганда, шунингдек буюртмачи (ташаббускор) қайта ташкил этилганда, бундан ҳуқуқий ворисликка йўл қўйиладиган ҳоллар мустасно.</div></div><div class="ACT_TEXT"><div name="7406831" id="7406831">Давлат экологик экспертизаси хулосаси амал қилишининг тўхтатиб турилиши тўғрисидаги суд қарори буюртмачига (ташаббускорга) ва махсус ваколатли давлат органига қонунчиликда белгиланган муддатларда юборилади.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406832" id="7406832">6-боб. Экологик нормативлар лойиҳаларини ишлаб чиқиш ва расмийлаштириш</div></div><div class="CLAUSE_DEFAULT"><div name="7406833" id="7406833">27-модда. Экологик нормативлар лойиҳаларини ишлаб чиқиш босқичлари</div></div><div class="ACT_TEXT"><div name="7406834" id="7406834">Экологик нормативлар лойиҳалари қуйидаги икки босқичда ишлаб чиқилади:</div></div><div class="ACT_TEXT"><div name="7406835" id="7406835">атроф-муҳитни ифлослантирувчи манбаларни инвентаризациядан ўтказиш;</div></div><div class="ACT_TEXT"><div name="7406836" id="7406836">атроф-муҳитни ифлослантирувчи манбаларни инвентаризациядан ўтказиш натижаларига кўра экологик нормативларни белгилаш.</div></div><div class="ACT_TEXT"><div name="7406837" id="7406837">Экологик нормативлар лойиҳаларини ишлаб чиқишда фан ва техниканинг атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги илғор ютуқлари инобатга олинади, чиқиндиларни жойлаштиришни, ифлослантирувчи моддаларнинг чиқарилишини, оқизилишини камайтириш бўйича замонавий технологияларни жорий этиш назарда тутилади.</div></div><div class="ACT_TEXT"><div name="7406838" id="7406838">Атроф-муҳитни ифлослантирувчи манбалар инвентаризацияси қуйидаги мақсадларда ўтказилади:</div></div><div class="ACT_TEXT"><div name="7406839" id="7406839">ифлослантирувчи моддаларни атроф-муҳитга чиқариш, оқизиш манбаларининг, чиқиндиларни жойлаштиришнинг дастлабки маълумотларини, кўрсаткичларини экологик нормативларни ишлаб чиқиш учун аниқлаш;</div></div><div class="ACT_TEXT"><div name="7406840" id="7406840">давлат экологик экспертизаси объектида қўлланиладиган ишлаб чиқариш технологик жараёнларининг, фойдаланиладиган хомашё ва материалларнинг экологик тавсифларини баҳолаш;</div></div><div class="ACT_TEXT"><div name="7406841" id="7406841">экологик хавфсизлик талабларини таъминлашга қаратилган тадбирларни ишлаб чиқиш.</div></div><div class="ACT_TEXT"><div name="7406842" id="7406842">Атроф-муҳитни ифлослантирувчи манбалар инвентаризацияси бевосита буюртмачи (ташаббускор) томонидан ёки атроф-муҳитга таъсирни баҳолаш материалларини ва экологик нормативлар лойиҳаларини ишлаб чиқувчи ташкилотлар жалб этилган ҳолда, давлат экологик экспертизаси объектининг хўжалик фаолиятини ва бошқа фаолиятни амалга ошириши даврида беш йилда бир марта ўтказилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406843" id="7406843">28-модда. Экологик нормативлар лойиҳаларини расмийлаштириш</div></div><div class="ACT_TEXT"><div name="7406844" id="7406844">Экологик нормативлар лойиҳалари атроф-муҳитни ифлослантирувчи манбаларни инвентаризациядан ўтказиш материалларига асосан ишлаб чиқилади.</div></div><div class="ACT_TEXT"><div name="7406845" id="7406845">Экологик нормативлар лойиҳалари давлат экологик экспертизасининг давлат экологик экспертизаси объектини рўёбга чиқариш мумкинлиги тўғрисидаги хулосасига асосан махсус ваколатли давлат органи томонидан тасдиқланади.</div></div><div class="ACT_TEXT"><div name="7406846" id="7406846">Атроф-муҳитни ифлослантирувчи манбаларни инвентаризациядан ўтказишга доир ҳужжатлар рўйхати, экологик нормативлар лойиҳаларининг таркиби ва уларни расмийлаштириш тартиби Ўзбекистон Республикаси Вазирлар Маҳкамаси томонидан белгиланади.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406847" id="7406847">7-боб. Атроф-муҳитга таъсирни трансчегаравий жиҳатдан баҳолаш ва стратегик экологик баҳолаш</div></div><div class="CLAUSE_DEFAULT"><div name="7406848" id="7406848">29-модда. Атроф-муҳитга таъсирни трансчегаравий жиҳатдан баҳолаш</div></div><div class="ACT_TEXT"><div name="7406849" id="7406849">Атроф-муҳитга таъсирни трансчегаравий жиҳатдан баҳолаш қуйидаги ҳолларда ўтказилади:</div></div><div class="ACT_TEXT"><div name="7406850" id="7406850">агар Ўзбекистон Республикаси ҳудудида мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолияти ҳамда бошқа фаолият қўшни давлат ҳудудида атроф-муҳитга сезиларли салбий таъсир қилиши мумкин бўлса;</div></div><div class="ACT_TEXT"><div name="7406851" id="7406851">агар қўшни давлатда мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолияти ҳамда бошқа фаолият Ўзбекистон Республикаси ҳудудида атроф-муҳитга сезиларли салбий таъсир кўрсатаётган бўлса.</div></div><div class="ACT_TEXT"><div name="7406852" id="7406852">Атроф-муҳитга таъсирни трансчегаравий жиҳатдан баҳолаш Ўзбекистон Республикасининг қонунчилигига мувофиқ амалга оширилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406853" id="7406853">30-модда. Стратегик экологик баҳолаш объектлари</div></div><div class="ACT_TEXT"><div name="7406854" id="7406854">Қуйидагилар стратегик экологик баҳолаш объектлари жумласига киради:</div></div><div class="ACT_TEXT"><div name="7406855" id="7406855">давлат дастурларининг, концепцияларининг, ишлаб чиқариш кучларини, иқтисодий ва ижтимоий соҳа тармоқларини жойлаштириш ҳамда ривожлантириш схемаларининг лойиҳалари;</div></div><div class="ACT_TEXT"><div name="7406856" id="7406856">шаҳарсозлик ҳужжатларининг барча турлари;</div></div><div class="ACT_TEXT"><div name="7406857" id="7406857">ҳудудларни кейинчалик уларга муҳофаза этиладиган табиий ҳудудлар мақомини бериш ҳамда ҳудудларни фавқулодда экологик вазият ва экологик офат зоналари деб эълон қилиш мақсадида комплекс текшириш материаллари, шунингдек муҳофаза этиладиган табиий ҳудудларни бошқариш режаларининг лойиҳалари юзасидан ишлаб чиқиладиган ҳужжатлар;</div></div><div class="ACT_TEXT"><div name="7406858" id="7406858">мавжуд стратегик режалаштириш ҳужжатларига киритилаётган, амалга оширилиши атроф-муҳитга салбий таъсир қилиши мумкин бўлган ўзгартиришлар ёки қўшимчалар.</div></div><div class="CLAUSE_DEFAULT"><div name="7406859" id="7406859">31-модда. Стратегик экологик баҳолаш мезонлари</div></div><div class="ACT_TEXT"><div name="7406860" id="7406860">Стратегик экологик баҳолаш махсус ваколатли давлат органи томонидан қуйидаги мезонларга асосан ўтказилади:</div></div><div class="ACT_TEXT"><div name="7406861" id="7406861">стратегик режалаштириш ҳужжати лойиҳасининг атроф-муҳитга таъсири билан боғлиқ экологик хавфларни ҳисобга олинишини таъминлаш ва мазкур ҳужжатнинг барқарор ривожланишга кўмаклашиш мақсадларига мувофиқлигини таъминлаш зарурлиги нуқтаи назаридан долзарблиги;</div></div><div class="ACT_TEXT"><div name="7406862" id="7406862">барқарор ривожланишга кўмаклашишни таъминлаш мақсадида стратегик режалаштириш ҳужжати лойиҳасида аҳоли соғлиғи билан боғлиқ экологик омилларни ҳисобга олиш зарурлиги;</div></div><div class="ACT_TEXT"><div name="7406863" id="7406863">стратегик режалаштириш ҳужжати лойиҳасини фаолият турларини, уларнинг жойлашувини, кўламларини, шароитларини ҳамда табиий ресурсларнинг мавжудлигини ва улардан фойдаланиш шартларини ҳисобга олган ҳолда амалга ошириш имконияти;</div></div><div class="ACT_TEXT"><div name="7406864" id="7406864">стратегик режалаштириш ҳужжати лойиҳасини амалга ошириш жараёнида экологик хавфларнинг, шу жумладан инсон соғлигига таъсирнинг ҳисобга олиниши;</div></div><div class="ACT_TEXT"><div name="7406865" id="7406865">стратегик режалаштириш ҳужжати лойиҳасининг атроф-муҳитни муҳофаза қилиш ва табиий ресурслардан оқилона фойдаланиш соҳасидаги қонунчилик талабларини ҳамда Ўзбекистон Республикасининг атроф-муҳитни муҳофаза қилиш соҳасидаги халқаро мажбуриятларини бажариш нуқтаи назаридан долзарблиги;</div></div><div class="ACT_TEXT"><div name="7406866" id="7406866">стратегик режалаштириш ҳужжати лойиҳасига киритилаётган ўзгартиришлар ва (ёки) қўшимчалар билан боғлиқ экологик муаммоларнинг, шу жумладан аҳоли соғлиғи билан боғлиқ муаммоларнинг мавжудлиги;</div></div><div class="ACT_TEXT"><div name="7406867" id="7406867">стратегик режалаштириш ҳужжати лойиҳасини амалга ошириш жараёнида юзага келадиган эҳтимол тутилган оқибатларнинг трансчегаравий хусусияти.</div></div><div class="ACT_TEXT"><div name="7406868" id="7406868">Махсус ваколатли давлат органи стратегик режалаштириш ҳужжати лойиҳасини ушбу модданинг <a href="https://lex.uz/uz/docs/7397280#7406860">биринчи қисмида</a> назарда тутилган мезонларга асосан стратегик экологик баҳолашдан ўтказади ҳамда тегишли тавсияларни беради.</div></div><div class="CLAUSE_DEFAULT"><div name="7406869" id="7406869">32-модда. Стратегик экологик баҳолаш босқичлари</div></div><div class="ACT_TEXT"><div name="7406870" id="7406870">Стратегик экологик баҳолаш қуйидаги босқичлардан иборат:</div></div><div class="ACT_TEXT"><div name="7406871" id="7406871">ушбу Қонуннинг <a href="https://lex.uz/uz/docs/7397280#7406859">31-моддасида</a> назарда тутилган мезонларга асосан стратегик экологик баҳолашдан ўтказиш заруриятини аниқлаш;</div></div><div class="ACT_TEXT"><div name="7406872" id="7406872">стратегик режалаштириш ҳужжати лойиҳасини стратегик экологик баҳолашда жамоатчиликнинг иштирокини таъминлаш;</div></div><div class="ACT_TEXT"><div name="7406873" id="7406873">стратегик экологик баҳолаш бўйича экологик маърузанинг (бундан буён матнда экологик маъруза деб юритилади) қамров доирасини белгилаш;</div></div><div class="ACT_TEXT"><div name="7406874" id="7406874">экологик маърузани тайёрлаш;</div></div><div class="ACT_TEXT"><div name="7406875" id="7406875">экологик маърузанинг сифатини баҳолаш;</div></div><div class="ACT_TEXT"><div name="7406876" id="7406876">стратегик режалаштириш ҳужжати лойиҳасини стратегик экологик баҳолаш доирасида манфаатдор вазирликлар ва идоралар билан маслаҳатлашувлар ўтказиш;</div></div><div class="ACT_TEXT"><div name="7406877" id="7406877">стратегик экологик баҳолаш жараёнида стратегик режалаштириш ҳужжати лойиҳасининг трансчегаравий таъсирини баҳолаш;</div></div><div class="ACT_TEXT"><div name="7406878" id="7406878">стратегик режалаштириш ҳужжатининг атроф-муҳитга таъсирини мониторинг қилиш.</div></div><div class="ACT_TEXT"><div name="7406879" id="7406879">Стратегик экологик баҳолаш ҳар бир стратегик экологик баҳолаш объекти бўйича бир марта ўтказилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406880" id="7406880">33-модда. Стратегик экологик баҳолашни ўтказишда жамоатчиликнинг иштирок этиши</div></div><div class="ACT_TEXT"><div name="7406881" id="7406881">Стратегик экологик баҳолашни амалга ошириш учун масъул бўлган республика ижро этувчи ҳокимият органи стратегик экологик баҳолаш масалалари юзасидан жамоатчилик эшитувлари ўтказилиши тўғрисида ўзининг расмий веб-сайтида, ижтимоий тармоқларда ва оммавий ахборот воситаларида эълон қилади.</div></div><div class="ACT_TEXT"><div name="7406882" id="7406882">Жамоатчилик эшитувининг иштирокчилари ўз фикрини эркин ифодалашга ва жамоатчилик эшитувига қўйилган стратегик экологик баҳолаш масалалари бўйича таклифлар киритишга ҳақли.</div></div><div class="CLAUSE_DEFAULT"><div name="7406883" id="7406883">34-модда. Экологик маърузанинг қамров доирасини белгилаш</div></div><div class="ACT_TEXT"><div name="7406884" id="7406884">Экологик маърузанинг қамров доирасини белгилашда стратегик режалаштириш ҳужжати лойиҳасининг тавсифи ва мазмунидан келиб чиқиб, экологик маърузага киритиладиган ахборотнинг ҳажми, тўлиқлилиги ва батафсиллиги даражаси аниқланади.</div></div><div class="ACT_TEXT"><div name="7406885" id="7406885">Экологик маърузанинг қамров доираси қуйидаги мақсадларда белгиланади:</div></div><div class="ACT_TEXT"><div name="7406886" id="7406886">стратегик режалаштириш ҳужжати лойиҳасига киритилиши мумкин бўлган, асослантирилган ва амалда қўлланиладиган муқобил ечимларни белгилаш, шу жумладан атроф-муҳитга ва (ёки) инсон соғлиғига таъсирни камайтириш;</div></div><div class="ACT_TEXT"><div name="7406887" id="7406887">стратегик режалаштириш ҳужжати лойиҳаси, шунингдек унга киритилиши мумкин бўлган ўзгартиришлар тўғрисида, шунингдек уни амалга оширишдан кутилаётган натижалар ҳақида жамоатчиликни хабардор қилиш;</div></div><div class="ACT_TEXT"><div name="7406888" id="7406888">стратегик режалаштириш ҳужжати лойиҳасининг муҳофаза этиладиган табиий ҳудудларга ҳамда қонунчиликка ва Ўзбекистон Республикасининг халқаро шартномалар бўйича мажбуриятларига мувофиқ муҳофаза этилиши лозим бўлган маҳаллий, давлат аҳамиятига ҳамда халқаро аҳамиятга эга бўлган бошқа ҳудудларга ва объектларга жиддий салбий таъсирини аниқлаш;</div></div><div class="ACT_TEXT"><div name="7406889" id="7406889">стратегик режалаштириш ҳужжати лойиҳасини амалга оширишда атроф-муҳитга трансчегаравий таъсир эҳтимолини аниқлаш;</div></div><div class="ACT_TEXT"><div name="7406890" id="7406890">инсон соғлиғини ва қулай атроф-муҳитни таъминлаш учун стратегик режалаштириш ҳужжати лойиҳасини амалга ошириш билан боғлиқ бўлган атроф-муҳитни муҳофаза қилиш соҳасидаги мақсадларни, шу жумладан халқаро ва миллий даражада белгиланган мақсадларни аниқлаш.</div></div><div class="CLAUSE_DEFAULT"><div name="7406891" id="7406891">35-модда. Экологик маърузани тайёрлаш ва баҳолаш</div></div><div class="ACT_TEXT"><div name="7406892" id="7406892">Стратегик режалаштириш ҳужжати лойиҳасини амалга ошириш учун масъул бўлган республика ижро этувчи ҳокимият органи экологик маърузани тайёрлайди ва унинг сифатини баҳолаш учун махсус ваколатли давлат органига тақдим этади.</div></div><div class="ACT_TEXT"><div name="7406893" id="7406893">Республика ижро этувчи ҳокимият органлари ва маҳаллий ижро этувчи ҳокимият органлари экологик маърузани тайёрлаш учун маҳаллий ҳамда хорижий малакали мутахассислар ва экспертларни қонунчиликда белгиланган тартибда жалб этиши мумкин.</div></div><div class="ACT_TEXT"><div name="7406894" id="7406894">Республика ижро этувчи ҳокимият органлари ва маҳаллий ижро этувчи ҳокимият органлари стратегик режалаштириш ҳужжати лойиҳасини тайёрлаш ва қабул қилишнинг барча босқичларида фуқароларнинг объектив экологик ахборотни ўз вақтида олишга бўлган ҳуқуқлари амалга оширилишини ва атроф-муҳит билан боғлиқ масалалар бўйича қарорлар қабул қилинишида жамоатчиликнинг иштирок этишини таъминлаш чораларини кўради.</div></div><div class="ACT_TEXT"><div name="7406895" id="7406895">Стратегик экологик баҳолаш бўйича экологик маърузани тайёрлаш ва унинг сифатини баҳолаш тартиби Ўзбекистон Республикаси Вазирлар Маҳкамаси томонидан белгиланади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406896" id="7406896">36-модда. Стратегик экологик баҳолаш масалалари юзасидан республика ижро этувчи ҳокимият органлари ва маҳаллий ижро этувчи ҳокимият органлари билан маслаҳатлашувлар ўтказиш</div></div><div class="ACT_TEXT"><div name="7406897" id="7406897">Махсус ваколатли давлат органи стратегик экологик баҳолаш масалалари юзасидан республика ижро этувчи ҳокимият органлари ва маҳаллий ижро этувчи ҳокимият органлари билан маслаҳатлашувлар ўтказишга ҳақли.</div></div><div class="ACT_TEXT"><div name="7406898" id="7406898">Республика ижро этувчи ҳокимият органлари ва маҳаллий ижро этувчи ҳокимият органлари махсус ваколатли давлат органи томонидан сўралган, стратегик экологик баҳолаш доирасида тегишли қарорларни қабул қилиш учун зарур бўлган маълумотларни тақдим этиши шарт.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406901" id="7406901">8-боб. Жамоат экологик экспертизаси</div></div><div class="CLAUSE_DEFAULT"><div name="7406902" id="7406902">37-модда. Жамоат экологик экспертизасини амалга ошириш</div></div><div class="ACT_TEXT"><div name="7406903" id="7406903">Жамоат экологик экспертизаси экологик жиҳатдан асослантириш талаб этиладиган ҳар қандай фаолият соҳасида нодавлат нотижорат ташкилотларининг ва фуқароларнинг ташаббуси билан амалга оширилиши мумкин.</div></div><div class="ACT_TEXT"><div name="7406904" id="7406904">Жамоат экологик экспертизасини амалга оширишга монелик қилиш тақиқланади.</div></div><div class="ACT_TEXT"><div name="7406905" id="7406905">Жамоат экологик экспертизаси давлат экологик экспертизаси ўтказилишидан қатьи назар амалга оширилиши мумкин.</div></div><div class="ACT_TEXT"><div name="7406906" id="7406906">Жамоат экологик экспертизасининг хулосаси тавсиявий хусусиятга эга бўлади.</div></div><div class="ACT_TEXT"><div name="7406907" id="7406907">Жамоат экологик экспертизаси қонунчиликда белгиланган тартибда амалга оширилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406908" id="7406908">38-модда. Жамоат экологик экспертизасини молиялаштириш</div></div><div class="ACT_TEXT"><div name="7406911" id="7406911">Жамоат экологик экспертизасини амалга ошириш жамоат экологик экспертизасини ташкил этувчи ва (ёки) ўтказувчи нодавлат нотижорат ташкилотларининг ўз маблағлари ҳисобидан молиялаштирилади.</div></div><div class="ACT_TEXT"><div name="7406912" id="7406912">Жамоат экологик экспертизасини амалга ошириш қонунда тақиқланмаган бошқа манбалар ҳисобидан молиялаштирилиши мумкин.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406915" id="7406915">9-боб. Атроф-муҳитга таъсирни баҳолашда жамоатчиликнинг иштирок этиши</div></div><div class="CLAUSE_DEFAULT"><div name="7406918" id="7406918">39-модда. Жамоатчилик эшитувларини ташкил этиш</div></div><div class="ACT_TEXT"><div name="7406927" id="7406927">Жамоатчилик эшитувлари мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган хўжалик фаолиятининг ҳамда бошқа фаолиятнинг атроф-муҳитга эҳтимол тутилган таъсири масалаларини аҳоли ва жамоатчилик ўртасида муҳокама қилиш мақсадида ташкил этилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406928" id="7406928">40-модда. Жамоатчилик эшитувларини ташкил этиш тартиби</div></div><div class="ACT_TEXT"><div name="7406929" id="7406929">Жамоатчилик эшитувлари давлат экологик экспертизаси ўтказилгунига қадар ташкил этилади.</div></div><div class="ACT_TEXT"><div name="7406930" id="7406930">Жамоатчилик эшитувларини ташкил этиш учун махсус ваколатли давлат органи атроф-муҳитга таъсирни баҳолаш бўйича барча материаллар келиб тушган кундан эътиборан уч иш куни ичида:</div></div><div class="ACT_TEXT"><div name="7406931" id="7406931">муҳокама қилинадиган масала ўз ҳуқуқларига ва қонуний манфаатларига дахл қиладиган ёки дахл қилиши мумкин бўлган шахслар доирасини ҳамда атроф-муҳитга ва аҳолига сезиларли таъсир кўрсатиши мумкин бўлган хўжалик фаолияти ҳамда бошқа фаолият мўлжалланилаётган ва (ёки) режалаштирилаётган ёки амалга оширилаётган ҳудудни белгилайди;</div></div><div class="ACT_TEXT"><div name="7406933" id="7406933">маҳаллий ижро этувчи ҳокимият органларига ва буюртмачига (ташаббускорга) атроф-муҳитга таъсирни баҳолашга доир тегишли ахборотни жамоат эшитувлари ташкил этилиши ҳақидаги хабарнома билан бирга юборади.</div></div><div class="ACT_TEXT"><div name="7406934" id="7406934">Жамоатчилик эшитувлари қонунчиликда белгиланган тартибда ўтказилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406935" id="7406935">41-модда. Жамоатчилик эшитувларининг натижалари тўғрисидаги ахборотни эълон қилиш</div></div><div class="ACT_TEXT"><div name="7406936" id="7406936">Жамоатчилик эшитувларининг натижалари якуний ҳужжатлар билан бирга махсус ваколатли давлат органининг ва жамоатчилик эшитувлари ўтказилган ҳудуддаги ижро этувчи ҳокимият органининг расмий веб-сайтларида эълон қилинади.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406937" id="7406937">10-боб. Якунловчи қоидалар</div></div><div class="CLAUSE_DEFAULT"><div name="7406938" id="7406938">42-модда. Низоларни ҳал этиш</div></div><div class="ACT_TEXT"><div name="7406939" id="7406939">Экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш соҳасидаги низолар қонунчиликда белгиланган тартибда ҳал этилади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406941" id="7406941">43-модда. Экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш тўғрисидаги қонунчиликни бузганлик учун жавобгарлик</div></div><div class="ACT_TEXT"><div name="7406945" id="7406945">Экологик экспертиза, атроф-муҳитга таъсирни баҳолаш ва стратегик экологик баҳолаш тўғрисидаги қонунчиликни бузганликда айбдор шахслар белгиланган тартибда жавобгар бўлади.</div></div><div class="CLAUSE_DEFAULT"><div name="7406948" id="7406948">44-модда. Ўзбекистон Республикасининг айрим қонун ҳужжатларини ўз кучини йўқотган деб топиш</div></div><div class="ACT_TEXT"><div name="7406950" id="7406950">Қуйидагилар ўз кучини йўқотган деб топилсин:</div></div><div class="ACT_TEXT"><div name="7406955" id="7406955">1) Ўзбекистон Республикасининг 2000 йил 25 майда қабул қилинган «Экологик экспертиза тўғрисида»ги 73-II-сонли <a href="https://lex.uz/uz/docs/32955">Қонуни</a> (Ўзбекистон Республикаси Олий Мажлисининг Ахборотномаси, 2000 йил, № 5-6, 144-модда);</div></div><div class="ACT_TEXT"><div name="7406957" id="7406957">2) Ўзбекистон Республикаси Олий Мажлисининг 2000 йил 25 майда қабул қилинган «Экологик экспертиза тўғрисида»ги Ўзбекистон Республикаси Қонунини амалга киритиш ҳақида»ги 74-II-сонли <a href="https://lex.uz/uz/docs/48711">Қарори</a> (Ўзбекистон Республикаси Олий Мажлисининг Ахборотномаси, 2000 йил, № 5-6, 145-модда);</div></div><div class="ACT_TEXT"><div name="7406960" id="7406960">3) Ўзбекистон Республикасининг 2011 йил 4 январда қабул қилинган «Ўзбекистон Республикасининг айрим қонун ҳужжатларига ўзгартиш ва қўшимчалар киритиш тўғрисида»ги ЎРҚ-278-сонли Қонунининг (Ўзбекистон Республикаси Олий Мажлиси палаталарининг Ахборотномаси, 2011 йил, № 1, 1-модда) <a href="https://lex.uz/uz/docs/1727648?ONDATE=05.01.2011 00#1728042">11-моддаси</a>;</div></div><div class="ACT_TEXT"><div name="7406961" id="7406961">4) Ўзбекистон Республикасининг 2017 йил 14 сентябрда қабул қилинган «Ўзбекистон Республикасининг айрим қонун ҳужжатларига ўзгартиш ва қўшимчалар киритиш, шунингдек айрим қонун ҳужжатларини ўз кучини йўқотган деб топиш тўғрисида»ги ЎРҚ-446-сонли Қонунининг (Ўзбекистон Республикаси Олий Мажлиси палаталарининг Ахборотномаси, 2017 йил, № 9, 510-модда) <a href="https://lex.uz/uz/docs/3340554?ONDATE=15.09.2017 00#3341092">44-моддаси</a>;</div></div><div class="ACT_TEXT"><div name="7406963" id="7406963">5) Ўзбекистон Республикасининг 2021 йил 21 апрелда қабул қилинган «Ўзбекистон Республикасининг айрим қонун ҳужжатларига ўзгартишлар киритиш тўғрисида»ги ЎРҚ-683-сонли Қонунининг (Ўзбекистон Республикаси Олий Мажлиси палаталарининг Ахборотномаси, 2021 йил, 4-сонга илова) <a href="https://lex.uz/uz/docs/5388561?ONDATE=21.04.2021 00#5395579">115-моддаси</a>;</div></div><div class="ACT_TEXT"><div name="7406964" id="7406964">6) Ўзбекистон Республикасининг 2021 йил 29 апрелда қабул қилинган «Ўзбекистон Республикасининг айрим қонун ҳужжатларига ўзгартишлар ва қўшимча киритиш тўғрисида»ги ЎРҚ-688-сонли Қонунининг (Ўзбекистон Республикаси Олий Мажлиси палаталарининг Ахборотномаси, 2021 йил, № 4, 1-модда) <a href="https://lex.uz/uz/docs/5398677?ONDATE=29.04.2021 00#5401785">4-моддаси</a>.</div></div><div class="CLAUSE_DEFAULT"><div name="7406977" id="7406977">45-модда. Ушбу Қонуннинг ижросини, етказилишини, моҳияти ва аҳамияти тушунтирилишини таъминлаш</div></div><div class="ACT_TEXT"><div name="7406979" id="7406979">Ўзбекистон Республикаси Экология, атроф-муҳитни муҳофаза қилиш ва иқлим ўзгариши вазирлиги, Адлия вазирлиги ва бошқа манфаатдор ташкилотлар ушбу Қонуннинг ижросини, ижрочиларга етказилишини ҳамда моҳияти ва аҳамияти аҳоли ўртасида тушунтирилишини таъминласин.</div></div><div class="CLAUSE_DEFAULT"><div name="7406981" id="7406981">46-модда. Қонунчиликни ушбу Қонунга мувофиқлаштириш</div></div><div class="ACT_TEXT"><div name="7406982" id="7406982">Ўзбекистон Республикаси Вазирлар Маҳкамаси:</div></div><div class="ACT_TEXT"><div name="7406983" id="7406983">ҳукумат қарорларини ушбу Қонунга мувофиқлаштирсин;</div></div><div class="ACT_TEXT"><div name="7406984" id="7406984">ушбу Қонун <a href="https://lex.uz/uz/docs/7397280#7406708">18-моддасининг</a> талабларини ҳисобга олган ҳолда, атроф-муҳитга таъсирни баҳолаш материалларини ва экологик нормативлар лойиҳаларини ишлаб чиқувчининг фаолиятини ташкил этиш тартиби тўғрисидаги низомни, шунингдек экологик экспертиза объектлари учун лойиҳа ҳужжатларини ишлаб чиқишга доир малака сертификатини бериш тартиби тўғрисидаги низомни ушбу Қонун расмий эълон қилинган кундан эътиборан олти ой ичида ишлаб чиқсин ва тасдиқласин;</div></div><div class="ACT_TEXT"><div name="7406985" id="7406985">ушбу Қонун <a href="https://lex.uz/uz/docs/7397280#7406891">35-моддасининг</a> талабларини ҳисобга олган ҳолда, стратегик экологик баҳолаш бўйича экологик маърузани тайёрлаш ва унинг сифатини баҳолаш тартиби тўғрисидаги низомни ушбу Қонун расмий эълон қилинган кундан эътиборан олти ой ичида ишлаб чиқсин ва тасдиқласин;</div></div><div class="ACT_TEXT"><div name="7406988" id="7406988">ушбу Қонун <a href="https://lex.uz/uz/docs/7397280#7406902">37-моддасининг</a> талабларини ҳисобга олган ҳолда, жамоат экологик экспертизасини амалга ошириш тартиби тўғрисидаги низомни ушбу Қонун расмий эълон қилинган кундан эътиборан олти ой ичида ишлаб чиқсин ва тасдиқласин;</div></div><div class="ACT_TEXT"><div name="7406989" id="7406989">республика ижро этувчи ҳокимият органлари ушбу Қонунга зид бўлган ўз норматив-ҳуқуқий ҳужжатларини қайта кўриб чиқишлари ва бекор қилишларини таъминласин.</div></div><div class="CLAUSE_DEFAULT"><div name="7406990" id="7406990">47-модда. Ушбу Қонуннинг кучга кириши</div></div><div class="ACT_TEXT"><div name="7406991" id="7406991">Ушбу Қонун расмий эълон қилинган кундан эътиборан олти ой ўтгач кучга киради.</div></div><div class="SIGNATURE"><div name="7407555" id="7407555">Ўзбекистон Республикасининг Президенти Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7407556" id="7407556">Тошкент ш.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7407558" id="7407558">2025 йил 24 февраль,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="7407559" id="7407559">ЎРҚ-1036-сон</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="7406355" id="7406355">(Қонунчилик маълумотлари миллий базаси, 24.02.2025 й., 03/25/1036/0173-сон)</div></div></div>
</div></body></html>