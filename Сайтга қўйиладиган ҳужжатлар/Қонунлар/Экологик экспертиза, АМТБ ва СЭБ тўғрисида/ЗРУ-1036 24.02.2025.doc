<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="7404935" id="7404935">Закон Республики Узбекистан</div></div><div class="ACCEPTING_BODY"><div name="7404936" id="7404936"></div></div><div class="ACT_TITLE"><div name="7404937" id="7404937">Об экологической экспертизе, оценке воздействия на окружающую среду и стратегической экологической оценке</div></div><div class="GRIF_PARLAMENT"><div name="7404938" id="7404938">Принят Законодательной палатой 18 октября 2024 года<br />Одобрен Сенатом 24 января 2025 года</div></div><div class="BY_DEFAULT"><div name="7404940" id="7404940"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="7404942" id="7404942">Глава 1. Общие положения</div></div><div class="CLAUSE_DEFAULT"><div name="7404943" id="7404943">Статья 1. Цель настоящего Закона</div></div><div class="ACT_TEXT"><div name="7404944" id="7404944">Целью настоящего Закона является регулирование отношений в области экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки.</div></div><div class="CLAUSE_DEFAULT"><div name="7404945" id="7404945">Статья 2. Законодательство об экологической экспертизе, оценке воздействия на окружающую среду и стратегической экологической оценке</div></div><div class="ACT_TEXT"><div name="7404946" id="7404946">Законодательство об экологической экспертизе, оценке воздействия на окружающую среду и стратегической экологической оценке состоит из настоящего Закона и иных актов законодательства.</div></div><div class="ACT_TEXT"><div name="7404947" id="7404947">Если международным договором Республики Узбекистан установлены иные правила, чем те, которые предусмотрены законодательством Республики Узбекистан об экологической экспертизе, оценке воздействия на окружающую среду и стратегической экологической оценке, то применяются правила международного договора.</div></div><div class="CLAUSE_DEFAULT"><div name="7404948" id="7404948">Статья 3. Основные понятия</div></div><div class="ACT_TEXT"><div name="7404949" id="7404949">В настоящем Законе применяются следующие основные понятия:</div></div><div class="ACT_TEXT"><div name="7404950" id="7404950"><strong>компоненты окружающей среды</strong> — земля, недра, воды, растительный и животный мир и атмосферный воздух, обеспечивающие благоприятные условия для существования в природной среде;</div></div><div class="ACT_TEXT"><div name="7404951" id="7404951"><strong>воздействие на окружающую среду</strong> — любые последствия намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности для окружающей среды и экологической безопасности, в том числе для здоровья человека, компонентов окружающей среды и взаимосвязь этих факторов, а также влияние изменений этих факторов на социально-экономические условия и объекты культурного наследия;</div></div><div class="ACT_TEXT"><div name="7404952" id="7404952"><strong>оценка воздействия на окружающую среду</strong> — процедура, направленная на определение свойства и уровня воздействия на окружающую среду, возможных экологических последствий намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности и на разработку мер по охране окружающей среды и рациональному использованию природных ресурсов;</div></div><div class="ACT_TEXT"><div name="7404953" id="7404953"><strong>материалы по оценке воздействия на окружающую среду</strong> — пакет документов, подготавливаемых по результатам оценки воздействия на окружающую среду намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности, и представляемых для проведения экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7404954" id="7404954"><strong>разработчик материалов по оценке воздействия на окружающую среду и проектов экологических нормативов (далее — разработчик проекта)</strong> — юридическое лицо, осуществляющее разработку материалов по оценке воздействия на окружающую среду для организации намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности, а также проектов экологических нормативов по осуществляемой хозяйственной и иной деятельности;</div></div><div class="ACT_TEXT"><div name="7404955" id="7404955"><strong>заказчик (инициатор)</strong> — юридическое или физическое лицо, представляющее материалы по оценке воздействия на окружающую среду для организации намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности, а также проекты экологических нормативов по осуществляемой хозяйственной и иной деятельности для проведения экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7404960" id="7404960"><strong>общественное слушание</strong> — общественное собрание, организуемое для обсуждения вопросов, касающихся принятия решения о целесообразности намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности;</div></div><div class="ACT_TEXT"><div name="7404962" id="7404962"><strong>объекты с особым правовым режимом</strong> — объекты экологической экспертизы, на которых применяются отдельные правовые нормы, регулирующие условия осуществления намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности;</div></div><div class="ACT_TEXT"><div name="7404964" id="7404964"><strong>намечаемая и (или) планируемая, или осуществляемая хозяйственная и иная деятельность</strong> — любая деятельность, которая может оказать негативное воздействие на окружающую среду и считается объектом экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7404967" id="7404967"><strong>документы стратегического планирования</strong> — проекты государственных программ, концепций, схем размещения и развития производительных сил, отраслей экономической и социальной сфер и градостроительная документация, а также документы по другим стратегически значимым объектам;</div></div><div class="ACT_TEXT"><div name="7404968" id="7404968"><strong>стратегическая экологическая оценка</strong> — процедура, направленная на определение свойства и уровня воздействия на окружающую среду, возможных экологических последствий намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности на основе документов стратегического планирования, а также на разработку мер по охране окружающей среды и рациональному использованию природных ресурсов по результатам оценки;</div></div><div class="ACT_TEXT"><div name="7404970" id="7404970"><strong>экологические нормативы</strong> — документы, разработанные на основе результатов инвентаризации источников загрязнения окружающей среды и подлежащие экологической экспертизе для установления нормативов выбросов, сбросов загрязняющих веществ и размещения отходов;</div></div><div class="ACT_TEXT"><div name="7404973" id="7404973"><strong>экологическая экспертиза</strong> — процедура, направленная на установление соответствия намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности экологическим требованиям, и определение допустимости или недопустимости реализации объекта экологической экспертизы.</div></div><div class="CLAUSE_DEFAULT"><div name="7404989" id="7404989">Статья 4. Цели экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7404990" id="7404990">Экологическая экспертиза, оценка воздействия на окружающую среду и стратегическая экологическая оценка проводятся в целях:</div></div><div class="ACT_TEXT"><div name="7404992" id="7404992">установления соответствия намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности экологическим требованиям на стадиях, предшествующих принятию решения о ее реализации;</div></div><div class="ACT_TEXT"><div name="7404993" id="7404993">определения уровня экологической опасности намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности, которая может оказать либо оказывает отрицательное воздействие на состояние окружающей среды и здоровье человека;</div></div><div class="ACT_TEXT"><div name="7404996" id="7404996">предотвращения и снижения отрицательного воздействия намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности на окружающую среду и здоровье человека;</div></div><div class="ACT_TEXT"><div name="7404998" id="7404998">определения достаточности и обоснованности предусматриваемых мер по охране окружающей природной среды и рациональному использованию природных ресурсов.</div></div><div class="CLAUSE_DEFAULT"><div name="7405000" id="7405000">Статья 5. Основные принципы экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7405001" id="7405001">Основными принципами экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки являются:</div></div><div class="ACT_TEXT"><div name="7405002" id="7405002">законность;</div></div><div class="ACT_TEXT"><div name="7405003" id="7405003">объективность;</div></div><div class="ACT_TEXT"><div name="7405004" id="7405004">обоснованность;</div></div><div class="ACT_TEXT"><div name="7405005" id="7405005">свободный доступ к информации и ее достоверность;</div></div><div class="ACT_TEXT"><div name="7405006" id="7405006">участие общественности;</div></div><div class="ACT_TEXT"><div name="7405010" id="7405010">открытость и гласность;</div></div><div class="ACT_TEXT"><div name="7405011" id="7405011">обязанность учитывать требования экологической безопасности;</div></div><div class="ACT_TEXT"><div name="7405012" id="7405012">презумпция ожидаемой экологической опасности любой намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности;</div></div><div class="ACT_TEXT"><div name="7405013" id="7405013">комплексность оценки воздействия намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности на окружающую среду и здоровье человека.</div></div><div class="CLAUSE_DEFAULT"><div name="7405014" id="7405014">Статья 6. Полномочия Министерства экологии, окружающей среды и изменения климата Республики Узбекистан в области экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7405015" id="7405015">Министерство экологии, окружающей среды и изменения климата Республики Узбекистан является специально уполномоченным государственным органом в области экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки (далее — специально уполномоченный государственный орган).</div></div><div class="ACT_TEXT"><div name="7405016" id="7405016">Специально уполномоченный государственный орган:</div></div><div class="ACT_TEXT"><div name="7405017" id="7405017">организует и проводит государственную экологическую экспертизу;</div></div><div class="ACT_TEXT"><div name="7405018" id="7405018">реализует единую государственную политику в области экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки;</div></div><div class="ACT_TEXT"><div name="7405019" id="7405019">организует деятельность специализированных экспертных подразделений, образующих единую систему экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405020" id="7405020">разрабатывает и утверждает нормативно-технические и инструктивно-методические документы по экологической экспертизе, оценке воздействия на окружающую среду и стратегической экологической оценке;</div></div><div class="ACT_TEXT"><div name="7405021" id="7405021">утверждает состав экспертного совета по государственной экологической экспертизе и его положение;</div></div><div class="ACT_TEXT"><div name="7405022" id="7405022">ведет мониторинг выполнения требований, указанных в заключении государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405023" id="7405023">направляет в банки и другие кредитные организации представления о приостановлении (прекращении) финансирования, кредитования и иных финансовых операций в отношении объектов, не имеющих положительного заключения экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405024" id="7405024">осуществляет экологический контроль за исполнением заключений экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405025" id="7405025">осуществляет сотрудничество с природоохранными организациями других государств и международными организациями в области экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки.</div></div><div class="ACT_TEXT"><div name="7405026" id="7405026">Специально уполномоченный государственный орган может осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7405065" id="7405065">Статья 7. Виды экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405067" id="7405067">Экологическая экспертиза осуществляется в виде государственной и общественной экологической экспертизы.</div></div><div class="CLAUSE_DEFAULT"><div name="7405070" id="7405070">Статья 8. Объекты экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405072" id="7405072">Объектами экологической экспертизы являются:</div></div><div class="ACT_TEXT"><div name="7405074" id="7405074">материалы по выбору и (или) выделению земельных участков под все виды строительства;</div></div><div class="ACT_TEXT"><div name="7405076" id="7405076">предпроектная и проектная документация;</div></div><div class="ACT_TEXT"><div name="7405078" id="7405078">нормативно-технические и инструктивно-методические документы, регулирующие хозяйственную и иную деятельность, связанную с использованием природных ресурсов, в том числе проекты технических регламентов и условий, стандартов, правил и инструкций;</div></div><div class="ACT_TEXT"><div name="7405080" id="7405080">документы по созданию новых видов технологий и технических средств, материалов, изделий, биологических, химических веществ и средств для обезвреживания, переработки и утилизации отходов;</div></div><div class="ACT_TEXT"><div name="7405082" id="7405082">действующие предприятия и другие объекты, оказывающие негативное влияние на состояние окружающей среды и здоровья человека;</div></div><div class="ACT_TEXT"><div name="7405084" id="7405084">объекты с особым правовым режимом.</div></div><div class="ACT_TEXT"><div name="7405087" id="7405087">Объекты экологической экспертизы делятся по воздействию на окружающую среду на три категории, и перечень их утверждается Кабинетом Министров Республики Узбекистан.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7405093" id="7405093">Глава 2. Государственная экологическая экспертиза</div></div><div class="CLAUSE_DEFAULT"><div name="7405098" id="7405098">Статья 9. Проведение государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405102" id="7405102">Государственная экологическая экспертиза проводится специально уполномоченным государственным органом в целях установления соответствия намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности экологическим требованиям и определения допустимости или недопустимости реализации объекта государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7405104" id="7405104">Заказчик (инициатор) может опубликовывать в средствах массовой информации объявление о проведении государственной экологической экспертизы. В этом случае в течение месяца со дня завершения экологической экспертизы публикуются сведения о ее результатах.</div></div><div class="ACT_TEXT"><div name="7405108" id="7405108">Перечень объектов государственной экологической экспертизы, для которых обязательно опубликование объявления о проведении государственной экологической экспертизы и публикация сведений о ее результатах в средствах массовой информации, устанавливается законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7405111" id="7405111">Статья 10. Независимость эколога-эксперта</div></div><div class="ACT_TEXT"><div name="7405113" id="7405113">Вмешательство заказчика (инициатора) или других заинтересованных лиц в деятельность эколога-эксперта не допускается.</div></div><div class="CLAUSE_DEFAULT"><div name="7405115" id="7405115">Статья 11. Обязательность прохождения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405118" id="7405118">Прохождение государственной экологической экспертизы объектов экологической экспертизы, предусмотренных в <a href="https://lex.uz/uz/docs/7397289#7405070">статье 8</a> настоящего Закона, является обязательным.</div></div><div class="CLAUSE_DEFAULT"><div name="7405125" id="7405125">Статья 12. Финансирование государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405127" id="7405127">Финансирование государственной экологической экспертизы осуществляется за счет средств заказчика (инициатора) в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7405128" id="7405128">Статья 13. Материалы, представляемые для проведения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405132" id="7405132">Для проведения государственной экологической экспертизы заказчиком (инициатором) представляются:</div></div><div class="ACT_TEXT"><div name="7405136" id="7405136">по проектируемым объектам — материалы оценки воздействия на окружающую среду, содержащие проект заявления о воздействии на окружающую среду, заявление об экологических последствиях, а в случаях, предусмотренных законодательством, — заявление о воздействии на окружающую среду;</div></div><div class="ACT_TEXT"><div name="7405139" id="7405139">по действующим объектам — проекты экологических нормативов, заявление о воздействии на окружающую среду, подготовленное при установлении случая воздействия объекта на окружающую среду и здоровье человека. При этом заказчик (инициатор) вправе дополнительно представить материалы экологического аудита;</div></div><div class="ACT_TEXT"><div name="7405140" id="7405140">по объектам, указанным в абзаце пятом <a href="https://lex.uz/uz/docs/7397289#7405072">части первой</a> статьи 8 настоящего Закона — вся разработанная документация.</div></div><div class="ACT_TEXT"><div name="7405141" id="7405141">Проект заявления о воздействии на окружающую среду представляется до начала финансирования объекта государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7405144" id="7405144">Заявление о воздействии на окружающую среду представляется до утверждения технико-экономического обоснования объекта государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7407560" id="7407560">Заявление об экологических последствиях представляется до приемки объекта в эксплуатацию в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7405155" id="7405155">Статья 14. Представление материалов по оценке воздействия на окружающую среду и проектов экологических нормативов для проведения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405157" id="7405157">Оценка воздействия на окружающую среду проводится разработчиками проекта.</div></div><div class="ACT_TEXT"><div name="7405160" id="7405160">Материалы оценки воздействия на окружающую среду и проекты экологических нормативов для проведения государственной экологической экспертизы представляются в виде электронного документа через официальный веб-сайт специально уполномоченного государственного органа, за исключением объектов с особым правовым режимом.</div></div><div class="ACT_TEXT"><div name="7405162" id="7405162">Для проведения государственной экологической экспертизы объектов с особым правовым режимом материалы оценки воздействия на окружающую среду и проекты экологических нормативов предоставляются в бумажном виде.</div></div><div class="CLAUSE_DEFAULT"><div name="7405169" id="7405169">Статья 15. Сроки проведения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405170" id="7405170">Срок проведения государственной экологической экспертизы не должен превышать двадцати пяти рабочих дней. В зависимости от сложности объекта государственной экологической экспертизы срок ее проведения может быть продлен специально уполномоченным государственным органом на срок не более трех месяцев.</div></div><div class="ACT_TEXT"><div name="7405173" id="7405173">Срок проведения государственной экологической экспертизы исчисляется с рабочего дня после полной оплаты стоимости государственной экологической экспертизы.</div></div><div class="CLAUSE_DEFAULT"><div name="7405176" id="7405176">Статья 16. Требования, предъявляемые при проведении государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405183" id="7405183">При проведении государственной экологической экспертизы осуществляются:</div></div><div class="ACT_TEXT"><div name="7405186" id="7405186">проверка соответствия представленных материалов требованиям законодательства в области охраны окружающей среды и рационального использования природных ресурсов;</div></div><div class="ACT_TEXT"><div name="7405188" id="7405188">анализ достоверности и полноты сведений об экологических и социальных последствиях намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности;</div></div><div class="ACT_TEXT"><div name="7405190" id="7405190">проверка обоснованности оценки воздействия биологических, химических веществ и технологий на окружающую природную среду;</div></div><div class="ACT_TEXT"><div name="7405192" id="7405192">проверка правильности оценки уровня экологической опасности, связанного с последствиями реализации намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности;</div></div><div class="ACT_TEXT"><div name="7405197" id="7405197">выявление достаточности и обоснованности мер по обеспечению требований экологической безопасности;</div></div><div class="ACT_TEXT"><div name="7405204" id="7405204">проверка обоснованности проектов экологических нормативов.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7405216" id="7405216">Глава 3. Субъекты государственной экологической экспертизы<br /></div></div><div class="CLAUSE_DEFAULT"><div name="7405220" id="7405220">Статья 17. Заказчик (инициатор)</div></div><div class="ACT_TEXT"><div name="7405226" id="7405226">Заказчик (инициатор) имеет право:</div></div><div class="ACT_TEXT"><div name="7405243" id="7405243">получать консультации и необходимую методическую помощь специально уполномоченного государственного органа по вопросам проведения государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405245" id="7405245">дорабатывать и представлять материалы для повторного проведения государственной экологической экспертизы на основании заключения о недопустимости реализации объекта государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405248" id="7405248">отбирать пробы и проводить лабораторные анализы из источников выбросов, сбросов загрязняющих веществ и размещения отходов с привлечением аккредитованных лабораторий;</div></div><div class="ACT_TEXT"><div name="7405250" id="7405250">публиковать информацию о материалах по оценке воздействия на окружающую среду и проектах экологических нормативов, а также получать сведения о ходе проведения государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7405251" id="7405251">Заказчик (инициатор) обязан:</div></div><div class="ACT_TEXT"><div name="7405254" id="7405254">разрабатывать материалы оценки воздействия на окружающую среду и проекты экологических нормативов в соответствии с требованиями законодательства об охране окружающей среды и рациональном использовании природных ресурсов и представлять их для проведения государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405255" id="7405255">осуществлять оплату за проведение государственной экологической экспертизы в порядке, установленном законодательством;</div></div><div class="ACT_TEXT"><div name="7405257" id="7405257">обеспечивать финансирование исследований, необходимых для оценки воздействия на окружающую среду;</div></div><div class="ACT_TEXT"><div name="7405265" id="7405265">проводить общественные слушания по намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности до проведения государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405267" id="7405267">учитывать в материалах по оценке воздействия на окружающую среду количество парниковых газов, образующихся в результате деятельности объекта государственной экологической экспертизы, и целевые показатели по обеспечению углеродной нейтральности;</div></div><div class="ACT_TEXT"><div name="7405270" id="7405270">разрабатывать и осуществлять меры по адаптации к изменению климата в документе стратегического планирования;</div></div><div class="ACT_TEXT"><div name="7405271" id="7405271">выполнять требования, указанные в заключении государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7405273" id="7405273">Заказчик (инициатор) может иметь иные права и нести другие обязанности в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7405285" id="7405285">Статья 18. Разработчик проекта</div></div><div class="ACT_TEXT"><div name="7405286" id="7405286">Разработчик проекта должен иметь в штате не менее двух сотрудников, проработавших в сфере экологии и охраны окружающей среды не менее трех лет, и имеющих соответствующий квалификационный сертификат.</div></div><div class="ACT_TEXT"><div name="7405289" id="7405289">Порядок организации деятельности разработчика материалов по оценке воздействия на окружающую среду и проектов экологических нормативов, а также порядок выдачи квалификационного сертификата на разработку проектной документации для объектов экологической экспертизы определяется Кабинетом Министров Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="7405292" id="7405292">В целях обеспечения качественной разработки материалов по оценке воздействия на окружающую среду и проектов экологических нормативов специально уполномоченный государственный орган ведет рейтинг разработчиков проектов.</div></div><div class="ACT_TEXT"><div name="7405293" id="7405293">Разработчик проекта несет солидарную ответственность с заказчиком (инициатором) за правильность, достоверность и обоснованность материалов по оценке воздействия на окружающую среду и проектов экологических нормативов.</div></div><div class="CLAUSE_DEFAULT"><div name="7405294" id="7405294">Статья 19. Эколог-эксперт</div></div><div class="ACT_TEXT"><div name="7405295" id="7405295">Экологом-экспертом может быть сотрудник, имеющий высшее образование, не менее трех лет непрерывного стажа работы в сфере экологии и охраны окружающей среды или в смежных сферах и аттестованный специально уполномоченным государственным органом в установленном порядке.</div></div><div class="ACT_TEXT"><div name="7405297" id="7405297">Нерезиденты Республики Узбекистан также могут быть привлечены специально уполномоченным государственным органом в качестве международных экологов-экспертов на основании контракта, за исключением случаев, связанных с государственными секретами или иной охраняемой законом тайной.</div></div><div class="ACT_TEXT"><div name="7405299" id="7405299">Эколог-эксперт является государственным гражданским служащим, деятельность которого регулируется в соответствии с законодательством, за исключением международных экологов-экспертов.</div></div><div class="ACT_TEXT"><div name="7405300" id="7405300">Эколог-эксперт имеет право:</div></div><div class="ACT_TEXT"><div name="7405301" id="7405301">получать документы и материалы, необходимые для проведения государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405302" id="7405302">отклонять материалы по оценке воздействия на окружающую среду и проекты экологических нормативов, представленные для проведения государственной экологической экспертизы, не соответствующие требованиям законодательства;</div></div><div class="ACT_TEXT"><div name="7405303" id="7405303">проверять достоверность материалов, представленных для проведения государственной экологической экспертизы с выездом на место.</div></div><div class="ACT_TEXT"><div name="7405305" id="7405305">Эколог-эксперт обязан:</div></div><div class="ACT_TEXT"><div name="7405311" id="7405311">соблюдать требования законодательства при проведении государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405312" id="7405312">обеспечивать своевременное, комплексное, объективное и качественное проведение государственной экологической экспертизы, а также выдачу по ее результатам заключения в установленном порядке;</div></div><div class="ACT_TEXT"><div name="7405313" id="7405313">заявлять самоотвод при наличии личной заинтересованности в отношении конкретного объекта государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405314" id="7405314">обеспечивать сохранность материалов, представленных на государственную экологическую экспертизу, а также неразглашение сведений, составляющих государственную тайну, военную, служебную и коммерческую тайну.</div></div><div class="ACT_TEXT"><div name="7405315" id="7405315">Эколог-эксперт может иметь иные права и нести другие обязанности в соответствии с законодательством.</div></div><div class="ACT_TEXT"><div name="7405316" id="7405316">Эколог-эксперт за невыполнение или ненадлежащее выполнение своих обязанностей, причинивший материальный ущерб или моральный вред правам или охраняемым законом интересам заказчика (инициатора), а также за иные нарушения законодательства об экологической экспертизе несет ответственность в соответствии с законодательством.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7405341" id="7405341">Глава 4. Заключение государственной экологической экспертизы</div></div><div class="CLAUSE_DEFAULT"><div name="7405354" id="7405354">Статья 20. Результаты проведения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405364" id="7405364">По результатам проведения государственной экологической экспертизы составляется заключение, содержащее выводы о допустимости или недопустимости реализации объекта государственной экологической экспертизы.</div></div><div class="CLAUSE_DEFAULT"><div name="7405369" id="7405369">Статья 21. Заключение о недопустимости реализации объекта государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405372" id="7405372">Заключение о недопустимости реализации объекта государственной экологической экспертизы выдается в следующих случаях:</div></div><div class="ACT_TEXT"><div name="7405379" id="7405379">если документы, представленные заказчиком (инициатором), противоречат требованиям законодательства в области охраны окружающей среды и рационального использования природных ресурсов;</div></div><div class="ACT_TEXT"><div name="7405381" id="7405381">если в ходе проведения государственной экологической экспертизы выявлено, что документы, предоставленные заказчиком (инициатором), содержат недостоверные и (или) искаженные сведения;</div></div><div class="ACT_TEXT"><div name="7405385" id="7405385">если в итоговых документах, подготовленных по результатам проведенных общественных слушаний, их участниками высказаны обоснованные возражения в отношении реализации объекта государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7405388" id="7405388">Не допускается выдача заключения о недопустимости реализации объекта государственной экологической экспертизы по основаниям, не предусмотренным <a href="https://lex.uz/uz/docs/7397289#7405372">частью первой</a> настоящей статьи.</div></div><div class="CLAUSE_DEFAULT"><div name="7405390" id="7405390">Статья 22. Обязательность исполнения заключения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405392" id="7405392">Заключение государственной экологической экспертизы обязательно для исполнения юридическими и физическими лицами при финансировании и реализации объекта государственной экологической экспертизы. Запрещается финансирование проектов банковскими и иными кредитными организациями, а также их реализация без положительного заключения государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7405394" id="7405394">В случае выдачи заключения государственной экологической экспертизы о недопустимости реализации объекта государственной экологической экспертизы заказчик (инициатор) обязан в соответствии с предложениями, содержащимися в заключении, обеспечить приведение проекта в соответствие с требованиями законодательства и повторно представить материалы на государственную экологическую экспертизу либо отказаться от планируемой или осуществляемой хозяйственной и иной деятельности.</div></div><div class="CLAUSE_DEFAULT"><div name="7405398" id="7405398">Статья 23. Срок действия заключения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405400" id="7405400">Заключение государственной экологической экспертизы о соответствии объекта государственной экологической экспертизы экологическим требованиям имеет юридическую силу в течение следующих сроков:</div></div><div class="ACT_TEXT"><div name="7405402" id="7405402">по материалам оценки воздействия на окружающую среду — в течение трех лет со дня выдачи заключения;</div></div><div class="ACT_TEXT"><div name="7405405" id="7405405">по проектам экологических нормативов — в течение пяти лет со дня выдачи заключения.</div></div><div class="CLAUSE_DEFAULT"><div name="7405426" id="7405426">Статья 24. Мониторинг исполнения заключения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405432" id="7405432">Реализация мер, направленных на обеспечение требований, указанных в заключении государственной экологической экспертизы, и мониторинг их исполнения обеспечиваются заказчиком (инициатором) в установленном порядке.</div></div><div class="ACT_TEXT"><div name="7405435" id="7405435">Заказчик (инициатор) обязан по итогам каждого квартала предоставлять в специально уполномоченный государственный орган информацию об исполнении требований, указанных в заключении государственной экологической экспертизы, не позднее 25 числа месяца, следующего за кварталом.</div></div><div class="ACT_TEXT"><div name="7405439" id="7405439">В случае непредставления заказчиком (инициатором) информации об исполнении требований, указанных в заключении государственной экологической экспертизы, в сроки, предусмотренные <a href="https://lex.uz/uz/docs/7397289#7405435">частью второй</a> настоящей статьи, специально уполномоченный государственный орган выдает заказчику (инициатору) предписание.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7405576" id="7405576">Глава 5. Переоформление заключения государственной экологической экспертизы, приостановление или прекращение его действия</div></div><div class="CLAUSE_DEFAULT"><div name="7405586" id="7405586">Статья 25. Переоформление заключения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405596" id="7405596">В случаях реорганизации заказчика (инициатора) государственной экологической экспертизы, изменения его наименования или передачи полномочий либо перехода его прав и обязанностей к правопреемнику, в течение семи рабочих дней после перерегистрации заказчик (инициатор) или его правопреемник может подать заявление в уполномоченный государственный орган на переоформление заключения государственной экологической экспертизы с приложением подтверждающих документов.</div></div><div class="ACT_TEXT"><div name="7405598" id="7405598">Плата за переоформление заключения государственной экологической экспертизы не взимается.</div></div><div class="CLAUSE_DEFAULT"><div name="7405599" id="7405599">Статья 26. Приостановление или прекращение действия заключения государственной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7405601" id="7405601">Действие заключения государственной экологической экспертизы может быть приостановлено судом:</div></div><div class="ACT_TEXT"><div name="7405603" id="7405603">при обращении заказчика (инициатора) с заявлением о приостановлении действия заключения государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405604" id="7405604">в случае приостановления деятельности заказчика (инициатора);</div></div><div class="ACT_TEXT"><div name="7405605" id="7405605">в случае несоблюдения заказчиком (инициатором) требований, указанных в заключении государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405606" id="7405606">в иных случаях, установленных законодательством.</div></div><div class="ACT_TEXT"><div name="7405607" id="7405607">Действие заключения государственной экологической экспертизы прекращается в следующих случаях:</div></div><div class="ACT_TEXT"><div name="7405612" id="7405612">по истечении срока действия заключения государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405613" id="7405613">при ликвидации заказчика (инициатора), а также реорганизации заказчика (инициатора), за исключением случаев, когда правопреемство допускается.</div></div><div class="ACT_TEXT"><div name="7405615" id="7405615">Решение суда о приостановлении действия заключения государственной экологической экспертизы направляется заказчику (инициатору) и специально уполномоченному государственному органу в сроки, установленные законодательством.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7405621" id="7405621">Глава 6. Разработка и оформление проектов экологических нормативов</div></div><div class="CLAUSE_DEFAULT"><div name="7405638" id="7405638">Статья 27. Этапы разработки проектов экологических нормативов</div></div><div class="ACT_TEXT"><div name="7405640" id="7405640">Проекты экологических нормативов разрабатываются в два этапа:</div></div><div class="ACT_TEXT"><div name="7405644" id="7405644">проведение инвентаризации источников загрязнения окружающей среды;</div></div><div class="ACT_TEXT"><div name="7405646" id="7405646">установление экологических нормативов по результатам проведения инвентаризации источников загрязнения окружающей среды.</div></div><div class="ACT_TEXT"><div name="7405649" id="7405649">При разработке проектов экологических нормативов учитываются передовые достижения науки и техники в области охраны окружающей среды и рационального использования природных ресурсов, предусматривается внедрение современных технологий по сокращению размещения отходов, выбросов и сбросов загрязняющих веществ.</div></div><div class="ACT_TEXT"><div name="7405650" id="7405650">Инвентаризация источников загрязнения окружающей среды проводится в целях:</div></div><div class="ACT_TEXT"><div name="7405654" id="7405654">определения исходных данных, параметров источников выбросов, сбросов загрязняющих веществ в окружающую среду, размещения отходов для разработки экологических нормативов;</div></div><div class="ACT_TEXT"><div name="7405656" id="7405656">оценки экологических характеристик применяемых производственных технологических процессов, сырья и материалов, используемых на объекте государственной экологической экспертизы;</div></div><div class="ACT_TEXT"><div name="7405658" id="7405658">разработки мероприятий, направленных на обеспечение требований экологической безопасности.</div></div><div class="ACT_TEXT"><div name="7405662" id="7405662">Инвентаризация источников загрязнения окружающей среды проводится один раз в пять лет непосредственно заказчиком (инициатором) или с привлечением организаций, разрабатывающих материалы оценки воздействия на окружающую среду и проекты экологических нормативов, в период осуществления хозяйственной и иной деятельности объекта государственной экологической экспертизы.</div></div><div class="CLAUSE_DEFAULT"><div name="7405711" id="7405711">Статья 28. Оформление проектов экологических нормативов</div></div><div class="ACT_TEXT"><div name="7405719" id="7405719">Проекты экологических нормативов разрабатываются на основе материалов инвентаризации источников загрязнения окружающей среды.</div></div><div class="ACT_TEXT"><div name="7405723" id="7405723">Проекты экологических нормативов утверждаются специально уполномоченным государственным органом на основании заключения государственной экологической экспертизы о допустимости реализации объекта государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7405725" id="7405725">Перечень документов инвентаризации источников загрязнения окружающей среды, состав проектов экологических нормативов и порядок их оформления определяются Кабинетом Министров Республики Узбекистан.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7405732" id="7405732">Глава 7. Оценка трансграничного воздействия на окружающую среду и стратегическая экологическая оценка</div></div><div class="CLAUSE_DEFAULT"><div name="7405738" id="7405738">Статья 29. Оценка трансграничного воздействия на окружающую среду</div></div><div class="ACT_TEXT"><div name="7405741" id="7405741">Оценка трансграничного воздействия на окружающую среду проводится в случаях:</div></div><div class="ACT_TEXT"><div name="7405743" id="7405743">если намечаемая и (или) планируемая или осуществляемая хозяйственная и иная деятельность на территории Республики Узбекистан может оказать существенное негативное воздействие на окружающую среду на территории сопредельного государства;</div></div><div class="ACT_TEXT"><div name="7405744" id="7405744">если намечаемая и (или) планируемая или осуществляемая хозяйственная и иная деятельность в сопредельном государстве оказывает существенное негативное воздействие на окружающую среду на территории Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="7405746" id="7405746">Оценка трансграничного воздействия на окружающую среду проводится в соответствии с законодательством Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="7405751" id="7405751">Статья 30. Объекты стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7405753" id="7405753">К объектам стратегической экологической оценки относятся:</div></div><div class="ACT_TEXT"><div name="7405754" id="7405754">проекты государственных программ, концепций, схем размещения и развития производственных сил, отраслей экономики и социальной сферы;</div></div><div class="ACT_TEXT"><div name="7405756" id="7405756">все виды градостроительной документации;</div></div><div class="ACT_TEXT"><div name="7405758" id="7405758">материалы комплексного обследования территорий в целях последующего придания им статуса охраняемых природных территорий и объявления территорий зонами чрезвычайной экологической ситуации и экологического бедствия, а также документы, разрабатываемые по проектам планов управления охраняемыми природными территориями;</div></div><div class="ACT_TEXT"><div name="7405760" id="7405760">изменения или дополнения, вносимые в существующие документы стратегического планирования, реализация которых может оказать негативное воздействие на окружающую среду.</div></div><div class="CLAUSE_DEFAULT"><div name="7405764" id="7405764">Статья 31. Критерии стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7405767" id="7405767">Стратегическая экологическая оценка проводится специальным уполномоченным государственным органом на основании следующих критериев:</div></div><div class="ACT_TEXT"><div name="7405770" id="7405770">актуальность с точки зрения необходимости обеспечения учета экологических рисков, связанных с воздействием проекта документа стратегического планирования на окружающую среду, и обеспечения соответствия данного документа целям содействия устойчивого развития;</div></div><div class="ACT_TEXT"><div name="7405772" id="7405772">необходимость учета в проекте документа стратегического планирования экологических факторов, связанных со здоровьем населения, в целях обеспечения содействия устойчивому развитию;</div></div><div class="ACT_TEXT"><div name="7405776" id="7405776">возможности реализации проекта документа стратегического планирования с учетом видов деятельности, их местоположения, масштабов, условий и доступности природных ресурсов и условий их использования;</div></div><div class="ACT_TEXT"><div name="7405778" id="7405778">учет экологических рисков, включая воздействие на здоровье человека, в процессе реализации проекта документа стратегического планирования;</div></div><div class="ACT_TEXT"><div name="7405782" id="7405782">актуальность проекта документа стратегического планирования с точки зрения выполнения требований законодательства в области охраны окружающей среды и рационального использования природных ресурсов и международных обязательств Республики Узбекистан в области охраны окружающей среды;</div></div><div class="ACT_TEXT"><div name="7405783" id="7405783">наличие экологических проблем, в том числе проблем со здоровьем населения, связанных с вносимыми изменениями и (или) дополнениями к проекту документа стратегического планирования;</div></div><div class="ACT_TEXT"><div name="7405784" id="7405784">трансграничный характер возможных последствий, возникающих в процессе реализации проекта документа стратегического планирования.</div></div><div class="ACT_TEXT"><div name="7405786" id="7405786">Специально уполномоченный государственный орган проводит стратегическую экологическую оценку проекта документа стратегического планирования на основании критериев, предусмотренных <a href="https://lex.uz/uz/docs/7397289#7405767">частью первой</a> настоящей статьи, и дает соответствующие рекомендации.</div></div><div class="CLAUSE_DEFAULT"><div name="7405789" id="7405789">Статья 32. Этапы стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7405790" id="7405790">Стратегическая экологическая оценка состоит из следующих этапов:</div></div><div class="ACT_TEXT"><div name="7405792" id="7405792">определение необходимости проведения стратегической экологической оценки на основании критериев, предусмотренных <a href="https://lex.uz/uz/docs/7397289#7405764">статьей 31</a> настоящего Закона;</div></div><div class="ACT_TEXT"><div name="7405795" id="7405795">обеспечение участия общественности в стратегической экологической оценке проекта документа стратегического планирования;</div></div><div class="ACT_TEXT"><div name="7405796" id="7405796">определение охвата экологического доклада по стратегической экологической оценке (далее — экологический доклад);</div></div><div class="ACT_TEXT"><div name="7405797" id="7405797">подготовка экологического доклада;</div></div><div class="ACT_TEXT"><div name="7405798" id="7405798">оценка качества экологического доклада;</div></div><div class="ACT_TEXT"><div name="7406167" id="7406167">проведение консультаций с заинтересованными министерствами и ведомствами в рамках стратегической экологической оценки проекта документа стратегического планирования;</div></div><div class="ACT_TEXT"><div name="7406168" id="7406168">оценка трансграничного воздействия проекта документа стратегического планирования в процессе стратегической экологической оценки;</div></div><div class="ACT_TEXT"><div name="7406172" id="7406172">мониторинг воздействия документа стратегического планирования на окружающую среду.</div></div><div class="ACT_TEXT"><div name="7406174" id="7406174">Стратегическая экологическая оценка проводится один раз по каждому объекту стратегической экологической оценки.</div></div><div class="CLAUSE_DEFAULT"><div name="7406177" id="7406177">Статья 33. Участие общественности в проведении стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7406182" id="7406182">Республиканский орган исполнительной власти, ответственный за проведение стратегической экологической оценки, объявляет на своем официальном веб-сайте, в социальных сетях и средствах массовой информации о проведении общественных слушаний по вопросам стратегической экологической оценки.</div></div><div class="ACT_TEXT"><div name="7406184" id="7406184">Участники общественного слушания вправе свободно высказывать свое мнение и вносить предложения по вопросам стратегической экологической оценки, вынесенным на общественное слушание.</div></div><div class="CLAUSE_DEFAULT"><div name="7406232" id="7406232">Статья 34. Определение охвата экологического доклада</div></div><div class="ACT_TEXT"><div name="7406233" id="7406233">При определении охвата экологического доклада, исходя из описания и содержания проекта документа стратегического планирования, определяется объем, полнота и уровень детализации информации, включаемой в экологический доклад.</div></div><div class="ACT_TEXT"><div name="7406234" id="7406234">Охват экологического доклада определяется в целях:</div></div><div class="ACT_TEXT"><div name="7406235" id="7406235">определения обоснованных и используемых на практике альтернативных решений, в том числе снижения воздействия на окружающую среду и (или) здоровье человека, которые могут быть включены в проект документа стратегического планирования;</div></div><div class="ACT_TEXT"><div name="7406236" id="7406236">информирования общественности о проекте документа стратегического планирования, а также возможных изменениях, вносимых в него, и об ожидаемых результатах его реализации;</div></div><div class="ACT_TEXT"><div name="7406237" id="7406237">определения существенного негативного влияния проекта документа стратегического планирования на охраняемые природные территории и другие территории и объекты местного, государственного и международного значения, подлежащие охране в соответствии с законодательством и обязательствами по международным договорам Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="7406238" id="7406238">определения возможности трансграничного воздействия на окружающую среду при реализации проекта документа стратегического планирования;</div></div><div class="ACT_TEXT"><div name="7406239" id="7406239">определения целей в области охраны окружающей среды, связанных с реализацией проекта документа стратегического планирования для обеспечения благоприятной окружающей среды и здоровья человека, в том числе установленных на международном и национальном уровнях.</div></div><div class="CLAUSE_DEFAULT"><div name="7406240" id="7406240">Статья 35. Подготовка и оценка экологического доклада</div></div><div class="ACT_TEXT"><div name="7406241" id="7406241">Республиканский орган исполнительной власти, ответственный за реализацию проекта документа стратегического планирования, подготавливает экологический доклад и для оценки его качества представляет специально уполномоченному государственному органу.</div></div><div class="ACT_TEXT"><div name="7406242" id="7406242">Республиканские органы исполнительной власти и органы исполнительной власти на местах для подготовки экологического доклада могут привлекать квалифицированных местных и зарубежных специалистов и экспертов в порядке, установленном законодательством.</div></div><div class="ACT_TEXT"><div name="7406243" id="7406243">Республиканские органы исполнительной власти и органы исполнительной власти на местах на всех этапах подготовки и принятия проекта документа стратегического планирования принимают меры по обеспечению реализации прав граждан на своевременное получение объективной экологической информации и участия общественности в принятии решений по вопросам, связанным с окружающей средой.</div></div><div class="ACT_TEXT"><div name="7406244" id="7406244">Порядок подготовки и оценки качества экологического доклада по стратегической экологической оценке определяется Кабинетом Министров Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="7406245" id="7406245">Статья 36. Проведение консультаций с республиканскими органами исполнительной власти и органами исполнительной власти на местах по вопросам стратегической экологической оценки</div></div><div class="ACT_TEXT"><div name="7406246" id="7406246">Специально уполномоченный государственный орган вправе проводить консультации с республиканскими органами исполнительной власти и органами исполнительной власти на местах по вопросам стратегической экологической оценки.</div></div><div class="ACT_TEXT"><div name="7406247" id="7406247">Республиканские органы исполнительной власти и органы исполнительной власти на местах обязаны предоставлять необходимые сведения, запрашиваемые специально уполномоченным государственным органом для принятия соответствующих решений в рамках стратегической экологической оценки.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406248" id="7406248">Глава 8. Общественная экологическая экспертиза</div></div><div class="CLAUSE_DEFAULT"><div name="7406249" id="7406249">Статья 37. Осуществление общественной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7406250" id="7406250">Общественная экологическая экспертиза может осуществляться по инициативе негосударственных некоммерческих организаций и граждан в любой сфере деятельности, требующей экологического обоснования.</div></div><div class="ACT_TEXT"><div name="7406251" id="7406251">Запрещается препятствовать осуществлению общественной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7406252" id="7406252">Общественная экологическая экспертиза может осуществляться независимо от проведения государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7406253" id="7406253">Заключение общественной экологической экспертизы носит рекомендательный характер.</div></div><div class="ACT_TEXT"><div name="7406254" id="7406254">Общественная экологическая экспертиза осуществляется в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7406255" id="7406255">Статья 38. Финансирование общественной экологической экспертизы</div></div><div class="ACT_TEXT"><div name="7406256" id="7406256">Осуществление общественной экологической экспертизы финансируется за счет собственных средств негосударственных некоммерческих организаций, организующих и (или) проводящих общественную экологическую экспертизу.</div></div><div class="ACT_TEXT"><div name="7406257" id="7406257">Осуществление общественной экологической экспертизы может финансироваться за счет иных источников, не запрещенных законом.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406258" id="7406258">Глава 9. Участие общественности в оценке воздействия на окружающую среду</div></div><div class="CLAUSE_DEFAULT"><div name="7406259" id="7406259">Статья 39. Организация общественных слушаний</div></div><div class="ACT_TEXT"><div name="7406260" id="7406260">Общественные слушания организуются с целью обсуждения среди населения и общественности вопросов возможного воздействия намечаемой и (или) планируемой или осуществляемой хозяйственной и иной деятельности на окружающую среду.</div></div><div class="CLAUSE_DEFAULT"><div name="7406261" id="7406261">Статья 40. Порядок организации общественных слушаний</div></div><div class="ACT_TEXT"><div name="7406263" id="7406263">Общественные слушания организуются до проведения государственной экологической экспертизы.</div></div><div class="ACT_TEXT"><div name="7406264" id="7406264">Для организации общественных слушаний специально уполномоченный государственный орган в течение трех рабочих дней со дня поступления всех материалов по оценке воздействия на окружающую среду:</div></div><div class="ACT_TEXT"><div name="7406265" id="7406265">определяет круг лиц, права и законные интересы которых затрагивает или может затронуть обсуждаемый вопрос, и территорию, где намечается и (или) планируется или осуществляется хозяйственная и иная деятельность, которая может оказать существенное влияние на окружающую среду и население;</div></div><div class="ACT_TEXT"><div name="7406266" id="7406266">направляет органам исполнительной власти на местах и заказчику (инициатору) соответствующую информацию по оценке воздействия на окружающую среду вместе с уведомлением об организации общественных слушаний.</div></div><div class="ACT_TEXT"><div name="7406267" id="7406267">Общественные слушания проводятся в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7406270" id="7406270">Статья 41. Публикация информации о результатах общественных слушаний</div></div><div class="ACT_TEXT"><div name="7406271" id="7406271">Результаты общественных слушаний вместе с итоговыми документами публикуются на официальных веб-сайтах специально уполномоченного государственного органа и органа исполнительной власти на территории которого проводились общественные слушания.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="7406272" id="7406272">Глава 10. Заключительные положения</div></div><div class="CLAUSE_DEFAULT"><div name="7406273" id="7406273">Статья 42. Разрешение споров</div></div><div class="ACT_TEXT"><div name="7406274" id="7406274">Споры в области экологической экспертизы, оценки воздействия на окружающую среду и стратегической экологической оценки разрешаются в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="7406275" id="7406275">Статья 43. Ответственность за нарушение законодательства об экологической экспертизе, оценке воздействия на окружающую среду и стратегической экологической оценке</div></div><div class="ACT_TEXT"><div name="7406276" id="7406276">Лица, виновные в нарушении законодательства об экологической экспертизе, оценке воздействия на окружающую среду и стратегической экологической оценке, несут ответственность в установленном порядке.</div></div><div class="CLAUSE_DEFAULT"><div name="7406277" id="7406277">Статья 44. Признание утратившими силу некоторых законодательных актов Республики Узбекистан</div></div><div class="ACT_TEXT"><div name="7406278" id="7406278">Признать утратившими силу:</div></div><div class="ACT_TEXT"><div name="7406279" id="7406279">1) <a href="https://lex.uz/uz/docs/9760">Закон</a> Республики Узбекистан от 25 мая 2000 года № 73-II «Об экологической экспертизе» (Ведомости Олий Мажлиса Республики Узбекистан, 2000 г., № 5-6, ст. 144);</div></div><div class="ACT_TEXT"><div name="7406280" id="7406280">2) <a href="https://lex.uz/uz/docs/48713">Постановление</a> Олий Мажлиса Республики Узбекистан от 25 мая 2000 года № 74-II «О введении в действие Закона Республики Узбекистан «Об экологической экспертизе» (Ведомости Олий Мажлиса Республики Узбекистан, 2000 г., № 5-6, ст. 145);</div></div><div class="ACT_TEXT"><div name="7406281" id="7406281">3) <a href="https://lex.uz/uz/docs/1727650?ONDATE=05.01.2011 00#1727823">статью 11</a> Закона Республики Узбекистан от 4 января 2011 года № ЗРУ-278 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2011 г., № 1, ст. 1);</div></div><div class="ACT_TEXT"><div name="7406282" id="7406282">4) <a href="https://lex.uz/uz/docs/3340556?ONDATE=15.09.2017 00#3342978">статью 44</a> Закона Республики Узбекистан от 14 сентября 2017 года № ЗРУ-446 «О внесении изменений и дополнений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2017 г., № 9, ст. 510);</div></div><div class="ACT_TEXT"><div name="7406283" id="7406283">5) статью 115 <a href="https://lex.uz/uz/docs/5388565">Закона</a> Республики Узбекистан от 21 апреля 2021 года № ЗРУ-683 «О внесении изменений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., приложение к № 4);</div></div><div class="ACT_TEXT"><div name="7406284" id="7406284">6) <a href="https://lex.uz/uz/docs/5398689?ONDATE=29.04.2021 00#5401994">статью 4</a> Закон Республики Узбекистан от 29 апреля 2021 года № ЗРУ-688 «О внесении изменений и дополнения в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., № 4, ст. 1).</div></div><div class="CLAUSE_DEFAULT"><div name="7406285" id="7406285">Статья 45. Обеспечение исполнения, доведения, разъяснения сути и значения настоящего Закона</div></div><div class="ACT_TEXT"><div name="7406286" id="7406286">Министерству экологии, охраны окружающей среды и изменения климата, Министерству юстиции Республики Узбекистан и другим заинтересованным организациям обеспечить исполнение, доведение до исполнителей и разъяснение среди населения сути и значения настоящего Закона.</div></div><div class="CLAUSE_DEFAULT"><div name="7406287" id="7406287">Статья 46. Приведение законодательства в соответствие с настоящим Законом</div></div><div class="ACT_TEXT"><div name="7406288" id="7406288">Кабинету Министров Республики Узбекистан:</div></div><div class="ACT_TEXT"><div name="7406289" id="7406289">привести решения правительства в соответствие с настоящим Законом;</div></div><div class="ACT_TEXT"><div name="7406290" id="7406290">в течение шести месяцев со дня официального опубликования настоящего Закона разработать и утвердить положение о порядке организации деятельности разработчика материалов по оценке воздействия на окружающую среду и проектов экологических нормативов, а также положение о порядке выдачи квалификационного сертификата на разработку проектной документации для объектов экологической экспертизы, с учетом требований <a href="https://lex.uz/uz/docs/7397289#7405285">статьи 18</a> настоящего Закона;</div></div><div class="ACT_TEXT"><div name="7406291" id="7406291">в течение шести месяцев со дня официального опубликования настоящего Закона разработать и утвердить положение о порядке подготовки и оценки качества экологического доклада по стратегической экологической оценке, с учетом требований <a href="https://lex.uz/uz/docs/7397289#7406240">статьи 35</a> настоящего Закона;</div></div><div class="ACT_TEXT"><div name="7406294" id="7406294">в течение шести месяцев со дня официального опубликования настоящего Закона разработать и утвердить положение о порядке осуществления общественной экологической экспертизы, с учетом требований <a href="https://lex.uz/uz/docs/7397289#7406249">статьи 37</a> настоящего Закона;</div></div><div class="ACT_TEXT"><div name="7406296" id="7406296">обеспечить пересмотр и отмену республиканскими органами исполнительной власти их нормативно-правовых актов, противоречащих настоящему Закону.</div></div><div class="CLAUSE_DEFAULT"><div name="7406324" id="7406324">Статья 47. Вступление в силу настоящего Закона</div></div><div class="ACT_TEXT"><div name="7406325" id="7406325">Настоящий Закон вступает в силу по истечении шести месяцев со дня его официального опубликования.</div></div><div class="SIGNATURE"><div name="7406328" id="7406328">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7406329" id="7406329">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="7406330" id="7406330">24 февраля 2025 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="7406332" id="7406332">№ ЗРУ-1036</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="7404939" id="7404939">(Национальная база данных законодательства, 24.02.2025 г., № 03/25/1036/0173)</div></div></div>
</div></body></html>