<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='ru-RU'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACT_FORM"><div name="6272593" id="6272593">Закон Республики Узбекистан</div></div><div class="ACT_TITLE"><div name="6272594" id="6272594">О стандартизации</div></div><div class="GRIF_PARLAMENT"><div name="6272597" id="6272597">Принят Законодательной палатой 15 июля 2022 года<br />Одобрен Сенатом 7 октября 2022 года</div></div><div class="BY_DEFAULT"><div name="6272596" id="6272596"></div></div><div class="CLAUSE_DEFAULT"><div name="6272598" id="6272598">Статья 1. Цель настоящего Закона</div></div><div class="ACT_TEXT"><div name="6272599" id="6272599">Целью настоящего Закона является регулирование отношений в области стандартизации.</div></div><div class="CLAUSE_DEFAULT"><div name="6272600" id="6272600">Статья 2. Сфера применения настоящего Закона</div></div><div class="ACT_TEXT"><div name="6272601" id="6272601">Действие настоящего Закона распространяется на отношения, возникающие при разработке, принятии и применении стандартов и соответствующих документов по стандартизации, а также осуществлении государственного контроля в области стандартизации. </div></div><div class="ACT_TEXT"><div name="6272602" id="6272602">Особенности стандартизации в военной сфере, сфере защиты государственных секретов и иной информации, в области использования атомной энергии, обеспечения ядерной и радиационной безопасности, в сфере финансов и образования устанавливаются отдельными актами законодательства Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="6272603" id="6272603">Статья 3. Законодательство о стандартизации</div></div><div class="ACT_TEXT"><div name="6272604" id="6272604">Законодательство о стандартизации состоит из настоящего Закона и иных актов законодательства.</div></div><div class="ACT_TEXT"><div name="6272605" id="6272605">Если международным договором Республики Узбекистан установлены иные правила, чем те, которые предусмотрены законодательством Республики Узбекистан о стандартизации, то применяются правила международного договора.</div></div><div class="CLAUSE_DEFAULT"><div name="6272606" id="6272606">Статья 4. Основные понятия</div></div><div class="ACT_TEXT"><div name="6272607" id="6272607">В настоящем Законе применяются следующие основные понятия:</div></div><div class="ACT_TEXT"><div name="6272611" id="6272611"><strong>национальный стандарт</strong> — стандарт, принятый Узбекским институтом стандартов Узбекского агентства по техническому регулированию при Министерстве инвестиций и внешней торговли Республики Узбекистан и доступный для широкой общественности;</div></div><div class="ACT_TEXT"><div name="6272614" id="6272614"><strong>стандарт</strong> — документ, устанавливающий для всеобщего и многократного использования правила, общие принципы или характеристики, касающиеся различных видов деятельности или их результатов, и который направлен на достижение наиболее оптимальной степени упорядочения в определенной области;</div></div><div class="ACT_TEXT"><div name="6272615" id="6272615"><strong>стандартизация</strong> — деятельность, направленная на достижение наиболее оптимальной степени упорядочения в определенной области, устанавливающая правила для всеобщего и многократного использования в отношении реально существующих или потенциальных задач;</div></div><div class="ACT_TEXT"><div name="6272616" id="6272616"><strong>Национальный орган по стандартизации</strong> — Узбекский институт стандартов Узбекского агентства по техническому регулированию при Министерстве инвестиций и внешней торговли Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="6272617" id="6272617"><strong>технический комитет по стандартизации</strong> — консультативно-совещательный орган, участвующий в осуществлении развития системы стандартизации по направлениям деятельности; </div></div><div class="ACT_TEXT"><div name="6272618" id="6272618"><strong>объект стандартизации</strong> — продукция, товары, услуги (далее — продукция), процессы, системы менеджмента, термины, условные обозначения, исследования (испытания), измерения (в том числе отбор образцов) и методы испытаний, маркировка, процедуры оценки соответствия и иные объекты;</div></div><div class="ACT_TEXT"><div name="6272619" id="6272619"><strong>международный (региональный) стандарт</strong> — стандарт, принятый международной или региональной организацией по стандартизации и доступный широкому кругу общественности;</div></div><div class="ACT_TEXT"><div name="6272621" id="6272621"><strong>стандарт зарубежной страны</strong> — стандарт, принятый уполномоченным органом (организацией) по стандартизации зарубежной страны;</div></div><div class="ACT_TEXT"><div name="6272624" id="6272624"><strong>консенсус</strong> — общее согласие, характеризующееся отсутствием возражений по существующим вопросам у большинства заинтересованных сторон и достигаемое в результате процесса, стремящееся учесть мнения всех сторон и сблизить несовпадающие точки зрения.</div></div><div class="CLAUSE_DEFAULT"><div name="6272627" id="6272627">Статья 5. Национальная система стандартизации Республики Узбекистан</div></div><div class="ACT_TEXT"><div name="6272629" id="6272629">Национальную систему стандартизации Республики Узбекистан составляют:</div></div><div class="ACT_TEXT"><div name="6272631" id="6272631">Узбекское агентство по техническому регулированию при Министерстве инвестиций и внешней торговли Республики Узбекистан (далее — Узбекское агентство по техническому регулированию);</div></div><div class="ACT_TEXT"><div name="6272633" id="6272633">Национальный орган по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272635" id="6272635">органы государственного и хозяйственного управления;</div></div><div class="ACT_TEXT"><div name="6272637" id="6272637">технические комитеты по стандартизации.</div></div><div class="CLAUSE_DEFAULT"><div name="6272639" id="6272639">Статья 6. Основные принципы стандартизации</div></div><div class="ACT_TEXT"><div name="6272641" id="6272641">Основными принципами стандартизации являются:</div></div><div class="ACT_TEXT"><div name="6272643" id="6272643">законность;</div></div><div class="ACT_TEXT"><div name="6272646" id="6272646">консенсус заинтересованных сторон при разработке национальных стандартов;</div></div><div class="ACT_TEXT"><div name="6272648" id="6272648">беспристрастность;</div></div><div class="ACT_TEXT"><div name="6272650" id="6272650">согласованность во избежание дублирования и противоречий в стандартах;</div></div><div class="ACT_TEXT"><div name="6272652" id="6272652">недопустимость дискриминационного отношения к продукции независимо от страны и (или) места происхождения продукции, а также формы собственности производителя;</div></div><div class="ACT_TEXT"><div name="6272653" id="6272653">открытость и прозрачность.</div></div><div class="CLAUSE_DEFAULT"><div name="6272654" id="6272654">Статья 7. Основные задачи стандартизации</div></div><div class="ACT_TEXT"><div name="6272655" id="6272655">Основными задачами стандартизации являются:</div></div><div class="ACT_TEXT"><div name="6272656" id="6272656">охрана жизни, здоровья граждан и их имущества; </div></div><div class="ACT_TEXT"><div name="6272657" id="6272657">охрана окружающей среды;</div></div><div class="ACT_TEXT"><div name="6272658" id="6272658">защита прав и охраняемых законом интересов потребителей в вопросах качества продукции;</div></div><div class="ACT_TEXT"><div name="6272661" id="6272661">обеспечение взаимозаменяемости и совместимости продукции;</div></div><div class="ACT_TEXT"><div name="6272663" id="6272663">повышение качества и конкурентоспособности продукции в зависимости от уровня развития науки и технологий для удовлетворения потребностей населения и отраслей экономики;</div></div><div class="ACT_TEXT"><div name="6272665" id="6272665">содействие экономии всех видов ресурсов, улучшение технико-экономических показателей производства;</div></div><div class="ACT_TEXT"><div name="6272668" id="6272668">практическое содействие при реализации социально-экономических и научно-технических программ и проектов;</div></div><div class="ACT_TEXT"><div name="6272670" id="6272670">содействие развитию экономики и научно-техническому прогрессу Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="6272678" id="6272678">обеспечение открытости и достоверности информации о номенклатуре и качестве выпускаемой продукции;</div></div><div class="ACT_TEXT"><div name="6272680" id="6272680">содействие по продвижению отечественной продукции на зарубежные рынки;</div></div><div class="ACT_TEXT"><div name="6272682" id="6272682">обеспечение единства измерений.</div></div><div class="CLAUSE_DEFAULT"><div name="6272684" id="6272684">Статья 8. Основные направления государственной политики в области стандартизации</div></div><div class="ACT_TEXT"><div name="6272687" id="6272687">Основными направлениями государственной политики в области стандартизации являются:</div></div><div class="ACT_TEXT"><div name="6272689" id="6272689">совершенствование правовых и организационных основ системы стандартизации;</div></div><div class="ACT_TEXT"><div name="6272691" id="6272691">разработка и реализация государственных и иных программ;</div></div><div class="ACT_TEXT"><div name="6272693" id="6272693">совершенствование инфраструктуры системы стандартизации;</div></div><div class="ACT_TEXT"><div name="6272695" id="6272695">внедрение передовых инновационных и современных информационно-коммуникационных технологий;</div></div><div class="ACT_TEXT"><div name="6272698" id="6272698">усовершенствование системы подготовки, переподготовки и повышения квалификации кадров;</div></div><div class="ACT_TEXT"><div name="6272701" id="6272701">развитие международного сотрудничества и гармонизация национальной системы стандартизации с международной системой.</div></div><div class="CLAUSE_DEFAULT"><div name="6272706" id="6272706">Статья 9. Полномочия Кабинета Министров Республики Узбекистан в области стандартизации</div></div><div class="ACT_TEXT"><div name="6272708" id="6272708">Кабинет Министров Республики Узбекистан:</div></div><div class="ACT_TEXT"><div name="6272710" id="6272710">обеспечивает реализацию единой государственной политики в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272712" id="6272712">координирует деятельность органов государственного и хозяйственного управления, органов государственной власти на местах в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272714" id="6272714">определяет приоритетные направления развития национальной системы стандартизации, организует разработку и реализацию государственных программ;</div></div><div class="ACT_TEXT"><div name="6272715" id="6272715">определяет стандарты, соблюдение требований которых является обязательным;</div></div><div class="ACT_TEXT"><div name="6272719" id="6272719">организует научно-техническую деятельность в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272721" id="6272721">осуществляет экономическую поддержку и стимулирование субъектов хозяйственной деятельности в области стандартизации.</div></div><div class="ACT_TEXT"><div name="6272723" id="6272723">Кабинет Министров Республики Узбекистан может осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6272724" id="6272724">Статья 10. Полномочия Узбекского агентства по техническому регулированию в области стандартизации</div></div><div class="ACT_TEXT"><div name="6272725" id="6272725">Узбекское агентство по техническому регулированию:</div></div><div class="ACT_TEXT"><div name="6272726" id="6272726">осуществляет государственную политику в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272727" id="6272727">осуществляет мониторинг выполнения плана стандартизации;</div></div><div class="ACT_TEXT"><div name="6272728" id="6272728">осуществляет государственный надзор за соблюдением требований стандартов, а также требований законодательства о стандартизации;</div></div><div class="ACT_TEXT"><div name="6272730" id="6272730">осуществляет создание единой интегрированной системы стандартизации, основанной на современных методах управления;</div></div><div class="ACT_TEXT"><div name="6272731" id="6272731">создает Апелляционную комиссию при Национальном органе по стандартизации и организует ее деятельность;</div></div><div class="ACT_TEXT"><div name="6272732" id="6272732">осуществляет международное сотрудничество в области стандартизации.</div></div><div class="ACT_TEXT"><div name="6272733" id="6272733">Узбекское агентство по техническому регулированию может осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6272734" id="6272734">Статья 11. Полномочия Национального органа по стандартизации</div></div><div class="ACT_TEXT"><div name="6272735" id="6272735">Национальный орган по стандартизации:</div></div><div class="ACT_TEXT"><div name="6272736" id="6272736">разрабатывает и реализует государственные и другие программы, концепции, а также стратегии в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272737" id="6272737">осуществляет цифровизацию системы стандартизации путем внедрения современных информационно-коммуникационных и инновационных технологий;</div></div><div class="ACT_TEXT"><div name="6272738" id="6272738">реализует план стандартизации;</div></div><div class="ACT_TEXT"><div name="6272739" id="6272739">согласно обращениям заинтересованных сторон, а также по собственной инициативе принимает решения о создании, приостановлении и прекращении деятельности отраслевых технических комитетов по стандартизации, утверждает положение о них, координирует их деятельность и содействует их развитию на основе международной практики;</div></div><div class="ACT_TEXT"><div name="6272740" id="6272740">представляет национальные интересы Республики Узбекистан в международных и региональных организациях по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272741" id="6272741">заключает соглашения с национальными органами по стандартизации зарубежных стран и осуществляет с ними сотрудничество;</div></div><div class="ACT_TEXT"><div name="6272742" id="6272742">утверждает и регистрирует национальные стандарты, принимает решения об их отмене, а также о внесении изменений и дополнений к ним;</div></div><div class="ACT_TEXT"><div name="6272744" id="6272744">принимает решения о введении в действие и отмене действия на территории Республики Узбекистан международных (региональных) стандартов, стандартов зарубежных стран, а также изменений к ним;</div></div><div class="ACT_TEXT"><div name="6272745" id="6272745">координирует работу заинтересованных сторон по разработке новых, пересмотру действующих стандартов;</div></div><div class="ACT_TEXT"><div name="6272748" id="6272748">дает рекомендации заинтересованным сторонам по гармонизации национальных стандартов с учетом международных (региональных) стандартов и стандартов зарубежных стран;</div></div><div class="ACT_TEXT"><div name="6272751" id="6272751">разрабатывает стандарты при отсутствии соответствующих технических комитетов по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272752" id="6272752">формирует и ведет Единую информационную базу стандартов;</div></div><div class="ACT_TEXT"><div name="6272754" id="6272754">осуществляет переподготовку и повышение квалификации кадров в области технического регулирования, стандартизации, сертификации и метрологии, а также создает систему повышения их квалификации.</div></div><div class="ACT_TEXT"><div name="6272755" id="6272755">Национальный орган по стандартизации может осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6272760" id="6272760">Статья 12. Полномочия органов государственного и хозяйственного управления в области стандартизации</div></div><div class="ACT_TEXT"><div name="6272761" id="6272761">Органы государственного и хозяйственного управления в пределах своих полномочий:</div></div><div class="ACT_TEXT"><div name="6272762" id="6272762">подготавливают предложения по разработке новых, внесению изменений, пересмотру и отмене действующих стандартов и предоставляют их в Национальный орган по стандартизации для включения в план стандартизации;</div></div><div class="ACT_TEXT"><div name="6272763" id="6272763">выполняют задачи, предусмотренные планом стандартизации;</div></div><div class="ACT_TEXT"><div name="6272764" id="6272764">инициируют и участвуют в разработке проектов стандартов;</div></div><div class="ACT_TEXT"><div name="6272765" id="6272765">совместно с Национальным органом по стандартизации участвуют в деятельности международных и региональных организаций по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272766" id="6272766">подготавливают и вносят предложения в Национальный орган по стандартизации по созданию, а также развитию технических комитетов по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272767" id="6272767">Органы государственного и хозяйственного управления могут осуществлять и иные полномочия в соответствии с законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6272768" id="6272768">Статья 13. Технический комитет по стандартизации</div></div><div class="ACT_TEXT"><div name="6272769" id="6272769">Технический комитет по стандартизации создается на основе добровольного участия органов государственного и хозяйственного управления и иных организаций, заинтересованных в принятии и применении стандартов, в соответствии с решением Национального органа по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272770" id="6272770">С инициативой о создании технического комитета по стандартизации могут выступать заинтересованные субъекты соответствующей отрасли в области стандартизации. </div></div><div class="ACT_TEXT"><div name="6272771" id="6272771">В состав технического комитета по стандартизации включаются представители заинтересованных сторон.</div></div><div class="ACT_TEXT"><div name="6272772" id="6272772">При техническом комитете по стандартизации создается секретариат для обеспечения его деятельности.</div></div><div class="ACT_TEXT"><div name="6272774" id="6272774">Информация о создаваемом техническом комитете по стандартизации открыта для всех заинтересованных сторон.</div></div><div class="ACT_TEXT"><div name="6272776" id="6272776">Технический комитет по стандартизации:</div></div><div class="ACT_TEXT"><div name="6272779" id="6272779">разрабатывает проекты национальных стандартов;</div></div><div class="ACT_TEXT"><div name="6272785" id="6272785">организует обсуждение проектов национальных стандартов в соответствии с областью деятельности;</div></div><div class="ACT_TEXT"><div name="6272786" id="6272786">подготавливает предложения по разработке новых, пересмотру действующих национальных стандартов для включения в план стандартизации;</div></div><div class="ACT_TEXT"><div name="6272787" id="6272787">осуществляет разработку стандартов, включенных в план стандартизации; </div></div><div class="ACT_TEXT"><div name="6272791" id="6272791">направляет обращения в органы государственного и хозяйственного управления по вопросам, входящим в их компетенцию;</div></div><div class="ACT_TEXT"><div name="6272792" id="6272792">формирует и ведет информационную базу стандартов в соответствии с областью деятельности; </div></div><div class="ACT_TEXT"><div name="6272794" id="6272794">участвует в научных исследованиях в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272795" id="6272795">совместно с Национальным органом по стандартизации участвует в работе технических комитетов по стандартизации международных, региональных организаций по стандартизации и защищает национальные интересы Республики Узбекистан на заседаниях данных комитетов. </div></div><div class="ACT_TEXT"><div name="6272796" id="6272796">Расходы, связанные с деятельностью технического комитета по стандартизации, осуществляются за счет средств субъектов, выступивших с инициативой о его создании, а также иных организаций, заинтересованных в принятии и применении стандартов.</div></div><div class="ACT_TEXT"><div name="6272797" id="6272797">Деятельность технического комитета по стандартизации приостанавливается на основании протокола его заседания решением Национального органа по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272798" id="6272798">Деятельность технического комитета по стандартизации прекращается решением Национального органа по стандартизации в одном из следующих случаев:</div></div><div class="ACT_TEXT"><div name="6272799" id="6272799">при достижении целей, для которых создавался технический комитет по стандартизации, и отсутствии потребности в его дальнейшем функционировании;</div></div><div class="ACT_TEXT"><div name="6272800" id="6272800">при неосуществлении деятельности технического комитета по стандартизации в течение двенадцати месяцев;</div></div><div class="ACT_TEXT"><div name="6272801" id="6272801">при подтверждении отрицательных результатов оценки эффективности деятельности технического комитета по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272802" id="6272802">при принятии соответствующего решения технического комитета по стандартизации.</div></div><div class="CLAUSE_DEFAULT"><div name="6272803" id="6272803">Статья 14. Государственные инспектора, их права и обязанности</div></div><div class="ACT_TEXT"><div name="6272804" id="6272804">Государственный надзор за соблюдением требований стандартов, а также требований законодательства о стандартизации осуществляется государственными инспекторами, являющимися представителями органов государственного управления.</div></div><div class="ACT_TEXT"><div name="6272807" id="6272807">Государственный инспектор имеет право:</div></div><div class="ACT_TEXT"><div name="6272808" id="6272808">доступа в установленном порядке в служебные и производственные помещения субъекта хозяйственной деятельности;</div></div><div class="ACT_TEXT"><div name="6272809" id="6272809">получать от субъекта хозяйственной деятельности документы и сведения, необходимые для проведения государственного надзора;</div></div><div class="ACT_TEXT"><div name="6272810" id="6272810">использовать технические средства и привлекать специалистов субъекта хозяйственной деятельности при проведении государственного надзора;</div></div><div class="ACT_TEXT"><div name="6272813" id="6272813">проводить в соответствии с нормативными документами по стандартизации отбор проб и образцов продукции для контроля их соответствия обязательным требованиям стандартов с отнесением стоимости израсходованных образцов и затрат на проведение испытаний (анализов, измерений) на издержки производства проверяемых субъектов хозяйственной деятельности;</div></div><div class="ACT_TEXT"><div name="6272814" id="6272814">выдавать предписания об устранении выявленных нарушений обязательных требований стандартов на стадиях производства, подготовки к производству, реализации (поставки, продажи), использования (эксплуатации), хранения, транспортирования и утилизации продукции;</div></div><div class="ACT_TEXT"><div name="6272815" id="6272815">запрещать реализацию продукции в случае уклонения субъекта хозяйственной деятельности от проверки.</div></div><div class="ACT_TEXT"><div name="6272816" id="6272816">Главный государственный инспектор Республики Узбекистан по обеспечению соблюдения требований законодательства в области технического регулирования, стандартизации, оценки соответствия и метрологии и его заместители, помимо прав, указанных в <a href="https://lex.uz/uz/docs/6270553#6272807">части второй</a> настоящей статьи, имеют исключительное право:</div></div><div class="ACT_TEXT"><div name="6272817" id="6272817">применять меры административного взыскания к должностным лицам субъектов хозяйственной деятельности и индивидуальным предпринимателям, виновным в нарушении обязательных требований стандартов;</div></div><div class="ACT_TEXT"><div name="6272818" id="6272818">принимать решение о наложении штрафа на юридических лиц, виновных в нарушении обязательных требований стандартов, и обращаться в суд о взыскании штрафа в случае неуплаты этими юридическими лицами штрафа в месячный срок в добровольном порядке;</div></div><div class="ACT_TEXT"><div name="6272819" id="6272819">выдавать предписания о запрете производства или приостановке реализации (поставки, продажи), использования (эксплуатации) проверенной продукции в случаях ее несоответствия обязательным требованиям стандартов;</div></div><div class="ACT_TEXT"><div name="6272820" id="6272820">запретить продажу импортной продукции, не соответствующей требованиям стандартов и не прошедшей государственную регистрацию.</div></div><div class="ACT_TEXT"><div name="6272821" id="6272821">За невыполнение предписаний государственных инспекторов о запрете производства или приостановке реализации (поставки, продажи), использования (эксплуатации) проверенной продукции в случаях ее несоответствия обязательным требованиям стандартов должностные лица субъектов хозяйственной деятельности и индивидуальные предприниматели привлекаются к административной ответственности.</div></div><div class="ACT_TEXT"><div name="6272822" id="6272822">Государственные инспектора за невыполнение или ненадлежащее выполнение обязанностей, возложенных на них законодательством, разглашение государственной или коммерческой тайны несут ответственность в установленном порядке.</div></div><div class="CLAUSE_DEFAULT"><div name="6272823" id="6272823">Статья 15. Планирование работ по стандартизации</div></div><div class="ACT_TEXT"><div name="6272824" id="6272824">Работы по стандартизации осуществляются на основании плана стандартизации. </div></div><div class="ACT_TEXT"><div name="6272825" id="6272825">План стандартизации может приниматься на краткосрочную (до одного года), среднесрочную (от одного года до пяти лет) и долгосрочную (от пяти до десяти лет) перспективу с учетом целей и направлений развития области стандартизации.</div></div><div class="ACT_TEXT"><div name="6272826" id="6272826">Планирование работ по стандартизации должно соответствовать основным направлениям социально-экономического развития Республики Узбекистан, учитывать результаты научных исследований и современных технологий.</div></div><div class="ACT_TEXT"><div name="6272827" id="6272827">В период действия плана стандартизации допускается внесение в него изменений и дополнений по предложениям заинтересованных сторон.</div></div><div class="ACT_TEXT"><div name="6272828" id="6272828">План стандартизации формируется на основе:</div></div><div class="ACT_TEXT"><div name="6272829" id="6272829">предложений заинтересованных сторон, технических комитетов по стандартизации и международного опыта;</div></div><div class="ACT_TEXT"><div name="6272830" id="6272830">планов работ технических комитетов по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272831" id="6272831">результатов мониторинга в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272832" id="6272832">анализа состояния социально-экономического развития Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6272833" id="6272833">План стандартизации включает в себя:</div></div><div class="ACT_TEXT"><div name="6272834" id="6272834">код по международному классификатору стандартов;</div></div><div class="ACT_TEXT"><div name="6272835" id="6272835">наименование проекта международного (регионального) или национального стандарта;</div></div><div class="ACT_TEXT"><div name="6272836" id="6272836">основание разработки (пересмотра) стандартов;</div></div><div class="ACT_TEXT"><div name="6272838" id="6272838">сроки реализации работ по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272839" id="6272839">источник финансирования;</div></div><div class="ACT_TEXT"><div name="6272840" id="6272840">организацию-заявителя, предоставившую предложение-заявку;</div></div><div class="ACT_TEXT"><div name="6272841" id="6272841">код классификации продукции по видам экономической деятельности.</div></div><div class="CLAUSE_DEFAULT"><div name="6272842" id="6272842">Статья 16. Единая информационная база стандартов</div></div><div class="ACT_TEXT"><div name="6272843" id="6272843">Единая информационная база стандартов формируется и ведется Национальным органом по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272844" id="6272844">Единая информационная база стандартов включает в себя национальные стандарты, международные (региональные) стандарты, стандарты зарубежных стран. </div></div><div class="CLAUSE_DEFAULT"><div name="6272845" id="6272845">Статья 17. Категории стандартов</div></div><div class="ACT_TEXT"><div name="6272846" id="6272846">К категориям стандартов относятся:</div></div><div class="ACT_TEXT"><div name="6272847" id="6272847">национальные стандарты;</div></div><div class="ACT_TEXT"><div name="6272848" id="6272848">международные (региональные) стандарты;</div></div><div class="ACT_TEXT"><div name="6272850" id="6272850">стандарты зарубежных стран.</div></div><div class="CLAUSE_DEFAULT"><div name="6272853" id="6272853">Статья 18. Национальные стандарты</div></div><div class="ACT_TEXT"><div name="6272856" id="6272856">Национальные стандарты разрабатываются для реализации задач, предусмотренных настоящим Законом, на основе плана стандартизации и имеют обозначение — OʻzMSt (Oʻzbekiston Milliy Standarti).</div></div><div class="ACT_TEXT"><div name="6272858" id="6272858">Определение оформления, построения по содержанию и обозначению национальных стандартов осуществляется согласно требованиям принятых национальных стандартов.</div></div><div class="ACT_TEXT"><div name="6272860" id="6272860">Национальные стандарты разрабатываются с учетом:</div></div><div class="ACT_TEXT"><div name="6272861" id="6272861">результатов научных исследований (испытаний) и измерений;</div></div><div class="ACT_TEXT"><div name="6272862" id="6272862">достижений науки и техники;</div></div><div class="ACT_TEXT"><div name="6272863" id="6272863">приобретенного практического опыта путем применения новых видов продукции, процессов и услуг;</div></div><div class="ACT_TEXT"><div name="6272864" id="6272864">международных (региональных) стандартов и стандартов зарубежных стран и иных документов, устанавливающих требования к объекту стандартизации.</div></div><div class="ACT_TEXT"><div name="6272865" id="6272865">Разработка национальных стандартов осуществляется заинтересованными сторонами, предусмотренными <a href="https://lex.uz/uz/docs/6270553#6272734">статьями 11</a>, <a href="https://lex.uz/uz/docs/6270553#6272760">12</a> и <a href="https://lex.uz/uz/docs/6270553#6272768">13</a> настоящего Закона.</div></div><div class="ACT_TEXT"><div name="6272866" id="6272866">Информация о начале и завершении разработки национальных стандартов, а также проекты национальных стандартов размещаются на официальном веб-сайте и электронном портале Национального органа по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272867" id="6272867">Проект национального стандарта до утверждения подлежит согласованию с заинтересованными сторонами в случаях, когда обязательность такого согласования предусмотрена нормативно-правовыми актами Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6272868" id="6272868">В период публичного обсуждения проекты национальных стандартов проходят техническое обсуждение в профильном техническом комитете по стандартизации, а в случае его отсутствия — в Национальном органе по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272869" id="6272869">Публичное обсуждение проектов национальных стандартов, размещенных на официальном веб-сайте и электронном портале Национального органа по стандартизации, осуществляется в течение шестидесяти календарных дней.</div></div><div class="ACT_TEXT"><div name="6272870" id="6272870">Перед утверждением национального стандарта разработчик в срок не более десяти календарных дней направляет проект стандарта на экспертизу.</div></div><div class="ACT_TEXT"><div name="6272871" id="6272871">Национальный стандарт вводится в действие после его государственной регистрации, но не ранее шестидесяти дней со дня размещения информации о его государственной регистрации на официальном веб-сайте Национального органа по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272872" id="6272872">Национальные стандарты должны основываться на достижениях отечественной и зарубежной науки и не должны противоречить требованиям настоящего Закона, иных нормативно-правовых актов, а также международных договоров с участием Республики Узбекистан.</div></div><div class="ACT_TEXT"><div name="6272874" id="6272874">Национальные стандарты не должны создавать излишних препятствий для международной торговли.</div></div><div class="ACT_TEXT"><div name="6272876" id="6272876">В национальных стандартах могут устанавливаться требования к продукции и ее классификации, терминологии, условным обозначениям, методам испытаний (измерений), отбора образцов, маркировки, процедуры оценки соответствия, системам управления.</div></div><div class="ACT_TEXT"><div name="6272877" id="6272877">Для обеспечения защиты интересов Республики Узбекистан и конкурентоспособности выпускаемой продукции в национальных стандартах в обоснованных случаях устанавливаются предварительные требования на перспективу, опережающие возможности традиционных технологий.</div></div><div class="ACT_TEXT"><div name="6272878" id="6272878">Обязательным условием принятия национального стандарта является достижение консенсуса.</div></div><div class="ACT_TEXT"><div name="6272880" id="6272880">При рассмотрении проекта национального стандарта в техническом комитете по стандартизации, если его членами признана целесообразность требований, научных разработок, продолжения исследований, приведенных в проекте стандарта, проект данного стандарта принимается в виде предварительного стандарта на определенный срок и ему присваивается обозначение — DS (Dastlabki Standart).</div></div><div class="ACT_TEXT"><div name="6272881" id="6272881">По инициативе заинтересованных сторон проекты, направленные на повышение качества продукции, не противоречащие техническим регламентам и стандартам в производстве, рекомендуемые к применению в масштабе страны, на основе достижений, использованных в качестве ноу-хау в технических условиях, могут быть направлены для рассмотрения и обсуждения в технические комитеты по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272882" id="6272882">Стандарты, содержащие сведения, составляющие государственную и иную охраняемую законом тайну, разрабатываются и принимаются в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6272883" id="6272883">Статья 19. Международные (региональные) стандарты и стандарты зарубежных стран</div></div><div class="ACT_TEXT"><div name="6272884" id="6272884">В Республике Узбекистан могут применяться международные (региональные) стандарты и стандарты зарубежных стран.</div></div><div class="ACT_TEXT"><div name="6272885" id="6272885">Международные (региональные) стандарты и стандарты зарубежных стран применяются на территории Республики Узбекистан наравне с национальными стандартами на основании решения Национального органа по стандартизации о введении их в действие.</div></div><div class="CLAUSE_DEFAULT"><div name="6272886" id="6272886">Статья 20. Внесение изменений и отмена национальных стандартов</div></div><div class="ACT_TEXT"><div name="6272887" id="6272887">Внесение изменений в национальные стандарты, замена национальных стандартов, дополнение или исключение отдельных требований, продление или восстановление сроков действия, введение новых требований и гармонизация национальных стандартов с международными (региональными) стандартами осуществляются в случаях, когда не влекут за собой нарушения действующего законодательства.</div></div><div class="ACT_TEXT"><div name="6272888" id="6272888">Внесение изменений в национальные стандарты осуществляется разработчиком данного стандарта или Национальным органом по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272889" id="6272889">Основаниями для отмены национальных стандартов являются:</div></div><div class="ACT_TEXT"><div name="6272890" id="6272890">противоречие данных стандартов требованиям законодательства Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="6272891" id="6272891">введение в действие нового национального, международного (регионального) стандарта взамен данных стандартов;</div></div><div class="ACT_TEXT"><div name="6272892" id="6272892">утрата актуальности применения данного стандарта.</div></div><div class="ACT_TEXT"><div name="6272893" id="6272893">Для отмены национального стандарта лица, инициирующие его отмену, направляют в Национальный орган по стандартизации свои предложения с обоснованием целесообразности его отмены.</div></div><div class="ACT_TEXT"><div name="6272894" id="6272894">Информация о внесении изменений в национальные стандарты и их отмене размещается на официальном веб-сайте и электронном портале Национального органа по стандартизации, а также осуществляется проведение общественного обсуждения в течение шестидесяти календарных дней.</div></div><div class="CLAUSE_DEFAULT"><div name="6272895" id="6272895">Статья 21. Принятие окончательного решения по вопросам стандартизации. Деятельность Апелляционной комиссии</div></div><div class="ACT_TEXT"><div name="6272896" id="6272896">В случае наличия разногласий при разработке, согласовании, утверждении, регистрации, введении в действие, внесении изменений, пересмотре, приостановке и отмене стандартов, а также в случаях, связанных с деятельностью технических комитетов по стандартизации, окончательное решение по вопросам стандартизации принимает Узбекское агентство по техническому регулированию.</div></div><div class="ACT_TEXT"><div name="6272898" id="6272898">При Национальном органе по стандартизации создается Апелляционная комиссия. Положение об Апелляционной комиссии и состав Апелляционной комиссии утверждаются Узбекским агентством по техническому регулированию.</div></div><div class="ACT_TEXT"><div name="6272901" id="6272901">В полномочия Апелляционной комиссии входит рассмотрение обращений (апелляций) заинтересованных сторон или технического комитета по стандартизации, не согласных с решением, принятым Национальным органом по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272905" id="6272905">В состав Апелляционной комиссии не могут входить сотрудники Национального органа по стандартизации. Член Апелляционной комиссии не может участвовать в рассмотрении апелляции в случае, если он находился или находится в служебной или иной зависимости от лиц, которые являются сторонами апелляции, либо при наличии других обстоятельств, вызывающих сомнение в беспристрастности такого члена.</div></div><div class="ACT_TEXT"><div name="6272907" id="6272907">Заинтересованная сторона или технический комитет по стандартизации имеет право подать апелляцию в Апелляционную комиссию в случае несогласия с решением Национального органа по стандартизации, а также, если считает, что решением или действиями (бездействием) Национального органа по стандартизации были нарушены процедуры в области стандартизации.</div></div><div class="ACT_TEXT"><div name="6272909" id="6272909">Срок рассмотрения апелляции не должен превышать тридцати дней.</div></div><div class="ACT_TEXT"><div name="6272911" id="6272911">Предметом апелляции не может быть содержание национального стандарта или его проекта. В случае, если Апелляционная комиссия признает, что решение или действия (бездействие) Национального органа по стандартизации нарушают процедуры в области стандартизации, она принимает решение, предусматривающее устранение Национальным органом по стандартизации нарушения процедуры.</div></div><div class="ACT_TEXT"><div name="6272912" id="6272912">Решение Апелляционной комиссии оформляется протоколом заседания и предоставляется сторонам спора.</div></div><div class="CLAUSE_DEFAULT"><div name="6272913" id="6272913">Статья 22. Применение стандартов</div></div><div class="ACT_TEXT"><div name="6272914" id="6272914">Стандарты применяются на добровольной основе, за исключением случаев указания ссылок в нормативно-правовых актах Республики Узбекистан на обязательное соблюдение требований стандарта (обязательное требование стандарта).</div></div><div class="ACT_TEXT"><div name="6272915" id="6272915">Стандарты могут применяться на стадиях разработки, проектирования, производства, хранения, испытания, исследования и измерения, отбора образцов продукции, в отношении терминологии, символики, упаковки, маркировки или этикеток и их нанесения, функционирования (эксплуатации, использования), перевозки, реализации и утилизации (переработки) продукции, при выполнении работ, оказании услуг в отношении иных объектов стандартизации.</div></div><div class="ACT_TEXT"><div name="6272916" id="6272916">Международные (региональные) стандарты и стандарты зарубежных стран применяются в случаях:</div></div><div class="ACT_TEXT"><div name="6272917" id="6272917">членства Республики Узбекистан в международных и региональных организациях по стандартизации;</div></div><div class="ACT_TEXT"><div name="6272918" id="6272918">наличия международных договоров Республики Узбекистан о сотрудничестве в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272919" id="6272919">наличия соглашения между Национальным органом по стандартизации и международной, региональной, иностранной организацией о сотрудничестве в области стандартизации;</div></div><div class="ACT_TEXT"><div name="6272920" id="6272920">соблюдения договоров, заключенных с органами по стандартизации, при применении международных (региональных) стандартов и стандартов зарубежных стран.</div></div><div class="ACT_TEXT"><div name="6272921" id="6272921">Стандарты могут использоваться в качестве основы для разработки технических регламентов Республики Узбекистан. Для выполнения требований технических регламентов и оценки соответствия продукции требованиям технических регламентов на добровольной основе в части выбора применяются взаимосвязанные стандарты.</div></div><div class="ACT_TEXT"><div name="6272922" id="6272922">Выполнение требований стандарта является обязательным для изготовителя и (или) исполнителя при его заявлении о соответствии продукции данному стандарту, в том числе в случае применения его обозначения в маркировке, в эксплуатационной или иной документации, договорах, рекламе, информационных ресурсах и иных формах представления информации.</div></div><div class="ACT_TEXT"><div name="6272923" id="6272923">В стандартах не допускается применение дублирующих требований к продукции.</div></div><div class="ACT_TEXT"><div name="6272924" id="6272924">Не допускается принятие стандартов:</div></div><div class="ACT_TEXT"><div name="6272925" id="6272925">содержащих нормы, имеющие общеобязательный характер, затрагивающие права, свободы и законные интересы граждан;</div></div><div class="ACT_TEXT"><div name="6272926" id="6272926">противоречащих действующим нормативно-правовым актам Республики Узбекистан и техническим регламентам;</div></div><div class="ACT_TEXT"><div name="6272927" id="6272927">создающих препятствия свободному обращению продукции, направленных на устранение и ограничение рыночной конкуренции.</div></div><div class="ACT_TEXT"><div name="6272928" id="6272928">Применение физическими и юридическими лицами документов по стандартизации осуществляется с соблюдением авторских прав.</div></div><div class="ACT_TEXT"><div name="6272929" id="6272929">Требования к продукции, направляемой на экспорт, устанавливаются в соответствии с положениями договора на поставку продукции.</div></div><div class="CLAUSE_DEFAULT"><div name="6272930" id="6272930">Статья 23. Опубликование, распространение и издание стандартов</div></div><div class="ACT_TEXT"><div name="6272931" id="6272931">Опубликование и распространение на договорной основе национальных стандартов осуществляется Национальным органом по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272933" id="6272933">Национальные стандарты должны быть опубликованы на государственном языке.</div></div><div class="ACT_TEXT"><div name="6272934" id="6272934">Стандарты и другие публикации международных и региональных организаций по стандартизации, а также зарубежных стран могут приниматься на одном из официальных языков этих организаций с последующим официальным переводом на государственный язык.</div></div><div class="ACT_TEXT"><div name="6272935" id="6272935">Издание и распространение стандартов международных и региональных организаций по стандартизации, членом которых является Республика Узбекистан, осуществляется Национальным органом по стандартизации в порядке и на условиях, определенных международной или региональной организацией по стандартизации.</div></div><div class="ACT_TEXT"><div name="6272936" id="6272936">Издание и распространение стандартов зарубежных стран осуществляется Национальным органом по стандартизации в соответствии с договорами с национальными органами по стандартизации данных стран.</div></div><div class="ACT_TEXT"><div name="6272937" id="6272937">В случаях, если лицензионными договорами с иностранными правообладателями, а также международными договорами и иными нормами международного права предусматриваются возмездность и (или) недопустимость предоставления свободного доступа к международным (региональным) стандартам, стандартам зарубежных стран, Национальный орган по стандартизации размещает на своем официальном веб-сайте сведения о размере платы за предоставление соответствующих документов и порядке их распространения.</div></div><div class="CLAUSE_DEFAULT"><div name="6272938" id="6272938">Статья 24. Информационное обеспечение в области стандартизации</div></div><div class="ACT_TEXT"><div name="6272939" id="6272939">Информационное обеспечение в области стандартизации осуществляется посредством:</div></div><div class="ACT_TEXT"><div name="6272940" id="6272940">размещения информации о стандартах на веб-сайтах;</div></div><div class="ACT_TEXT"><div name="6272941" id="6272941">распространения стандартов, официальных изданий и их копий.</div></div><div class="ACT_TEXT"><div name="6272942" id="6272942">Размещение информации о стандартах осуществляется посредством их официального опубликования на официальных веб-сайтах Национального органа по стандартизации и в ежегодных информационных указателях стандартов.</div></div><div class="ACT_TEXT"><div name="6272943" id="6272943">К информации о стандартах относятся:</div></div><div class="ACT_TEXT"><div name="6272944" id="6272944">номер и наименование;</div></div><div class="ACT_TEXT"><div name="6272946" id="6272946">область применения;</div></div><div class="ACT_TEXT"><div name="6272947" id="6272947">дата и номер решения об утверждении, внесении изменений и отмене;</div></div><div class="ACT_TEXT"><div name="6272949" id="6272949">сведения о разработчике.</div></div><div class="CLAUSE_DEFAULT"><div name="6272951" id="6272951">Статья 25. Финансирование работ в области стандартизации</div></div><div class="ACT_TEXT"><div name="6272953" id="6272953">Финансирование работ в области стандартизации осуществляется за счет:</div></div><div class="ACT_TEXT"><div name="6272954" id="6272954">средств Государственного бюджета Республики Узбекистан; </div></div><div class="ACT_TEXT"><div name="6272955" id="6272955">средств заинтересованных организаций;</div></div><div class="ACT_TEXT"><div name="6272956" id="6272956">добровольных взносов;</div></div><div class="ACT_TEXT"><div name="6272957" id="6272957">иных источников, не противоречащих законодательству.</div></div><div class="ACT_TEXT"><div name="6272958" id="6272958">Государственному финансированию работ по стандартизации подлежат:</div></div><div class="ACT_TEXT"><div name="6272959" id="6272959">разработка или участие в разработке международных (региональных) стандартов;</div></div><div class="ACT_TEXT"><div name="6272960" id="6272960">разработка стандартов в связи с исполнением решений Президента Республики Узбекистан и Кабинета Министров Республики Узбекистан;</div></div><div class="ACT_TEXT"><div name="6272961" id="6272961">разработка национальных стандартов, предусмотренных планом стандартизации;</div></div><div class="ACT_TEXT"><div name="6272962" id="6272962">проведение научно-исследовательских и иных работ по стандартизации, имеющих общегосударственное значение;</div></div><div class="ACT_TEXT"><div name="6272964" id="6272964">формирование и ведение Единой информационной базы стандартов;</div></div><div class="ACT_TEXT"><div name="6272965" id="6272965">иная деятельность в области стандартизации, определяемая Кабинетом Министров Республики Узбекистан.</div></div><div class="CLAUSE_DEFAULT"><div name="6272967" id="6272967">Статья 26. Разрешение споров</div></div><div class="ACT_TEXT"><div name="6272968" id="6272968">Споры в области стандартизации разрешаются в порядке, установленном законодательством.</div></div><div class="CLAUSE_DEFAULT"><div name="6272969" id="6272969">Статья 27. Ответственность за нарушение законодательства о стандартизации</div></div><div class="ACT_TEXT"><div name="6272971" id="6272971">За продолжение или неустранение правонарушения в области стандартизации после получения предупреждения в установленном порядке физические лица в соответствии с законодательством несут административную ответственность. За продолжение или неустранение правонарушения в области стандартизации после получения предупреждения в установленном порядке в отношении юридических лиц применяются финансовые санкции в виде штрафа в соответствии с <a href="https://lex.uz/uz/docs/6270553#6272972">частью второй </a>настоящей статьи.</div></div><div class="ACT_TEXT"><div name="6272972" id="6272972">В случае несоблюдения производителем или импортером продукции обязательных требований стандарта, предусмотренных законодательством о стандартизации, в отношении них:</div></div><div class="ACT_TEXT"><div name="6272973" id="6272973">при совершении правонарушения впервые — применяются финансовые санкции в виде штрафа в размере до пятидесяти процентов от стоимости реализованной продукции, не соответствующей обязательным требованиям стандартов;</div></div><div class="ACT_TEXT"><div name="6272974" id="6272974">при повторном совершении того же правонарушения в течение одного года со дня применения финансовой санкции в виде штрафа, предусмотренной <a href="https://lex.uz/uz/docs/6270553#6272973">абзацем вторым</a> части второй настоящей статьи, — применяются финансовые санкции в виде штрафа в размере до ста процентов от стоимости реализованной продукции, не соответствующей обязательным требованиям стандартов.</div></div><div class="ACT_TEXT"><div name="6272975" id="6272975">Финансовые санкции в виде штрафа, предусмотренные <a href="https://lex.uz/uz/docs/6270553#6272972">частью второй </a>настоящей статьи, применяются в судебном порядке, за исключением случаев признания производителем или импортером продукции вины в совершенном правонарушении и уплаты штрафа в добровольном порядке.</div></div><div class="ACT_TEXT"><div name="6272977" id="6272977">Пятьдесят процентов суммы взысканного штрафа направляется во внебюджетный фонд Узбекского агентства по техническому регулированию, а остальная часть — в Государственный бюджет Республики Узбекистан.</div></div><div class="BY_DEFAULT"><div name="7788714" id="7788714"></div></div><div class="ACT_TEXT"><div name="7788715" id="7788715">Юридические лица, которые в установленном законодательством порядке отозвали не менее семидесяти процентов продукции, не соответствующей обязательным требованиям стандартов, освобождаются от финансовых санкций, предусмотренных частью второй настоящей статьи.</div></div><div class="CLAUSE_DEFAULT"><div name="6272978" id="6272978">Статья 28. Внесение изменений, а также признание утратившими силу некоторых законодательных актов Республики Узбекистан</div></div><div class="ACT_TEXT"><div name="6272979" id="6272979">Внести изменения в следующие законодательные акты Республики Узбекистан:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="8098688" id="8098688">(пункт 1 статьи 28 исключен <a href="https://lex.uz/uz/docs/8096691">Законом </a>Республики Узбекистан от 24 марта 2026 года № ЗРУ-1123)</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7668557" id="7668557">(дата исключения пункта 2 часть первая статьи 28 на основании <a href="https://lex.uz/uz/docs/7655829">Закона </a>Республики Узбекистан от 30 июля 2025 года № ЗРУ-1076 — 31 октября 2025 года)</div></div><div class="ACT_TEXT"><div name="6272982" id="6272982">3. Внести в Гражданский <a href="https://lex.uz/uz/docs/180550">кодекс </a>Республики Узбекистан, утвержденный законами Республики Узбекистан от 21 декабря 1995 года № 163-I и от 29 августа 1996 года № 256-I (Ведомости Олий Мажлиса Республики Узбекистан, 1996 г., приложение к № 2, № 11-12; 1997 г., № 2, ст. 56, № 9, ст. 241; 1998 г., № 5-6, ст. 102; 1999 г., № 1, ст. 20, № 9, ст. 229; 2001 г., № 1-2, ст. 23, № 9-10, ст. 182; 2002 г., № 1, ст. 20, № 9, ст. 165; 2003 г., № 1, ст. 8, № 5, ст. 67; 2004 г., № 1-2, ст. 18, № 5, ст. 90, № 9, ст. 171; Ведомости палат Олий Мажлиса Республики Узбекистан, 2006 г., № 4, ст. 154, № 9, ст.ст. 494, 498; 2007 г., № 1, ст.ст. 3, 5, № 4, ст.ст. 156, 164, № 8, ст. 367, № 9, ст. 416, № 12, ст.ст. 598, 608; 2008 г., № 4, ст. 192, № 12, ст. 640; 2009 г., № 9, ст. 337; 2010 г., № 9, ст.ст. 335, 337, 340; 2011 г., № 12/2, ст.ст. 363, 364, 365; 2012 г., № 4, ст.ст. 106, 109, № 12, ст. 336; 2013 г., № 10, ст. 263; 2014 г., № 5, ст. 130, № 12, ст. 343; 2015 г., № 8, ст.ст. 310, 312; 2016 г., № 4, ст. 125; 2017 г., № 4, ст. 137, № 9, ст. 510, № 12, ст. 773; 2018 г., № 1, ст. 4, № 4, ст. 224, № 7, ст. 433, № 10, ст. 673; 2019 г., № 3, ст.ст. 161, 166, № 5, ст. 267, № 10, ст. 671, № 12, ст.ст. 880, 886; 2020 г., № 1, ст.ст. 3, 4, № 10, ст. 593; 2021 г., приложение к № 4, № 8, ст. 801, № 10, ст. 968; 2022 г., № 2, ст. 79, № 3, ст.ст. 217, 218, № 4, ст. 340, № 5, ст. 464, № 6, ст. 570), следующие изменения:</div></div><div class="ACT_TEXT"><div name="6272984" id="6272984">в <a href="https://lex.uz/uz/docs/180550?ONDATE=01.03.1997 00#180744">части первой</a> статьи 405 слова «государственными стандартами» заменить словами «национальными стандартами»;</div></div><div class="ACT_TEXT"><div name="6272985" id="6272985"><a href="https://lex.uz/uz/docs/180550?ONDATE=01.03.1997 00#180750">часть вторую</a> статьи 407 изложить в следующей редакции:</div></div><div class="ACT_TEXT"><div name="6272986" id="6272986">«В случаях, когда стандарты устанавливают требования к контролю качества товаров, качество должно проверяться в соответствии с их указаниями».</div></div><div class="ACT_TEXT"><div name="6272987" id="6272987">4. В <a href="https://lex.uz/uz/docs/41329?ONDATE=04.10.2007 00#1256072">абзаце втором</a> части первой статьи 5 Закона Республики Узбекистан от 29 августа 1996 года № 265-I «Об охране здоровья граждан» (Ведомости Олий Мажлиса Республики Узбекистан, 1996 г., № 9, ст. 128; 1999 г., № 5, ст. 124; 2001 г., № 5, ст. 89; Ведомости палат Олий Мажлиса Республики Узбекистан, 2006 г., № 10, ст. 536; 2007 г., № 10, ст. 473; 2010 г., № 5, ст. 177; 2016 г., № 12, ст. 383; 2017 г., № 6, ст. 300; 2018 г., № 1, ст. 1; 2019 г., № 2, ст. 47, № 5, ст.ст. 265, 267, № 9, ст.ст. 589, 592; 2020 г., № 12, ст. 691; 2021 г., приложение к № 4, № 8, ст. 797; 2022 г., № 5, ст. 464) слово «государственных» заменить словом «национальных».</div></div><div class="ACT_TEXT"><div name="6272988" id="6272988">5. <a href="https://lex.uz/uz/docs/18673?ONDATE=27.12.2016 00#3086381">Часть первую</a> статьи 5 Закона Республики Узбекистан от 30 августа 1997 года № 483-I «О качестве и безопасности пищевой продукции» (Ведомости Олий Мажлиса Республики Узбекистан, 1997 г., № 9, ст. 239; 2003 г., № 5, ст. 67; Ведомости палат Олий Мажлиса Республики Узбекистан, 2006 г., № 4, ст. 157; 2016 г., № 12, ст. 383; 2017 г., № 4, ст. 137, № 10, ст. 605; 2018 г., № 1, ст. 4; 2019 г., № 1, ст. 3, № 8, ст. 470, № 11, ст. 791; 2021 г., приложение к № 4, № 4, ст. 290; 2022 г., № 5, ст. 465) изложить в следующей редакции:</div></div><div class="ACT_TEXT"><div name="6272989" id="6272989">«Государственное нормирование в области обеспечения качества и безопасности пищевой продукции осуществляется путем установления технических регламентов, санитарных, ветеринарных, ветеринарно-санитарных правил и норм, фитосанитарных норм, правил и гигиенических нормативов, национальных стандартов, технических условий (далее — нормы и правила), содержащих требования к качеству и безопасности пищевой продукции, условиям ее производства, заготовки, закупки, переработки, поставки, хранения, транспортировки и реализации».</div></div><div class="ACT_TEXT"><div name="6272990" id="6272990">6. В <a href="https://lex.uz/uz/docs/1545?ONDATE=10.06.2015 00#2676108">абзаце третьем</a> части первой статьи 6 Закона Республики Узбекистан от 25 декабря 1998 года № 725-I «О радиочастотном спектре» (Ведомости Олий Мажлиса Республики Узбекистан, 1999 г., № 1, ст. 16; 2003 г., № 5, ст. 67; Ведомости палат Олий Мажлиса Республики Узбекистан, 2013 г., № 4, ст. 98; 2014 г., № 5, ст. 130; 2015 г., № 6, ст. 228; 2017 г., № 4, ст. 137; 2019 г., № 2, ст. 47; 2021 г., приложение к № 4) слова «государственные стандарты» заменить словами «национальные стандарты».</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7295304" id="7295304">(пункт 7 утратил силу <a href="https://lex.uz/uz/docs/7283074?ONDATE=28.12.2024 00#7287103">Законом </a>Республики Узбекистан от 27 декабря 2024 года № ЗРУ-1015 — Национальная база данных законодательства, 28.12.2024 г., № 03/24/1015/1087)</div></div><div class="ACT_TEXT"><div name="6272992" id="6272992">8. В <a href="https://lex.uz/uz/docs/13868?ONDATE=19.09.2000 00#14042">статье 11</a> Закона Республики Узбекистан от 31 августа 2000 года № 120-II «О радиационной безопасности» (Ведомости Олий Мажлиса Республики Узбекистан, 2000 г., № 7-8, ст. 212; Ведомости палат Олий Мажлиса Республики Узбекистан, 2007 г., № 12, ст. 604; 2011 г., № 4, ст. 98; 2013 г., № 4, ст. 98; 2017 г., № 9, ст. 510; 2019 г., № 8, ст. 470, № 9, ст. 591, № 12, ст. 891; 2021 г., приложение к № 4) слова «государственных стандартов» заменить словами «национальных стандартов».</div></div><div class="ACT_TEXT"><div name="6272993" id="6272993">9. Внести в <a href="https://lex.uz/uz/docs/1184051">Закон </a>Республики Узбекистан от 3 мая 2007 года № ЗРУ-97 «О профилактике йододефицитных заболеваний» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2007 г., № 5, ст. 219; Ведомости палат Олий Мажлиса Республики Узбекистан, 2015 г., № 6, ст. 228; 2021 г., приложение к № 4) следующие изменения:</div></div><div class="ACT_TEXT"><div name="6272994" id="6272994">в <a href="https://lex.uz/uz/docs/1184051?ONDATE=04.05.2007 00#1184166">части первой</a> статьи 16 слова «государственных стандартов, правил и норм» заменить словами «национальных стандартов, правил и норм»;</div></div><div class="ACT_TEXT"><div name="6272995" id="6272995">в <a href="https://lex.uz/uz/docs/1184051?ONDATE=04.05.2007 00#1184171">части первой</a> статьи 17 слова «государственных стандартов, правил и норм» заменить словами «национальных стандартов, правил и норм».</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="7060059" id="7060059">(пункт 10 утратит силу с 9 ноября 2024 года <a href="https://lex.uz/uz/docs/7051594?ONDATE=09.11.2024 00#7055683">Законом </a>Республики Узбекистан от 7 августа 2024 года № ЗРУ-939 — Национальная база данных законодательства, 08.08.2024 г., № 03/24/939/0595)</div></div><div class="ACT_TEXT"><div name="6273005" id="6273005">11. В <a href="https://lex.uz/uz/docs/2732584?ONDATE=27.08.2015 00#2732805">части первой</a> статьи 26 Закона Республики Узбекистан от 26 августа 2015 года № ЗРУ-393 «О санитарно-эпидемиологическом благополучии населения» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2015 г., № 8, ст. 314; 2019 г., № 2, ст. 47; 2021 г., № 1, ст. 13, приложение к № 4, № 4, ст. 290) слова «государственным стандартам» заменить словами «национальным стандартам».</div></div><div class="ACT_TEXT"><div name="6273006" id="6273006">12. <a href="https://lex.uz/uz/docs/4880166?ONDATE=04.10.2020 00#4881792">Абзац пятнадцатый</a> статьи 3 Закона Республики Узбекистан от 2 июля 2020 года № ЗРУ-626 «О геодезической и картографической деятельности» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2020 г., № 7, ст. 446; 2021 г., приложение к № 4, № 8, ст. 800, № 10, ст. 968) изложить в следующей редакции:</div></div><div class="ACT_TEXT"><div name="6273007" id="6273007">«<strong>Национальная инфраструктура пространственных данных </strong>— система, включающая организационную структуру, научно-техническую политику, технические и программные средства, базовые и профильные пространственные данные, метаданные и базы метаданных, сервисы пространственных данных, нормативно-правовые акты, а также нормативные документы в области технического регулирования по вопросам производства, обновления, обработки, хранения, предоставления, интеграции и использования пространственных данных, которые доступны на территории Республики Узбекистан».</div></div><div class="ACT_TEXT"><div name="6273008" id="6273008">13. В <a href="https://lex.uz/uz/docs/5307955?ONDATE=23.05.2021 00#5309420">абзаце девятом</a> части второй статьи 20 Градостроительного кодекса Республики Узбекистан, утвержденного Законом Республики Узбекистан от 22 февраля 2021 года № ЗРУ-676 (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., № 2, ст. 145; 2022 г., № 6, ст. 570), слова «государственных стандартов» заменить словами «национальных стандартов».</div></div><div class="ACT_TEXT"><div name="6273009" id="6273009">14. В <a href="https://lex.uz/uz/docs/5351640?ONDATE=02.04.2021 00#5353258">части третьей</a> статьи 12 Закона Республики Узбекистан от 1 апреля 2021 года № ЗРУ-680 «О дехканском хозяйстве» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., № 4, ст. 286) слова «государственными стандартами» заменить словами «национальными стандартами».</div></div><div class="ACT_TEXT"><div name="6273010" id="6273010">15. <a href="https://lex.uz/uz/docs/5522844?ONDATE=25.10.2021 00#5525084">Текст </a>статьи 14 Закона Республики Узбекистан от 23 июля 2021 года № ЗРУ-702 «О пространственных данных» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., № 7, ст. 662) изложить в следующей редакции:</div></div><div class="ACT_TEXT"><div name="6273011" id="6273011">«В настоящем Законе под Национальной инфраструктурой пространственных данных понимается система, включающая организационную структуру, научно-техническую политику, технические и программные средства, базовые и профильные пространственные данные, метаданные и базы метаданных, сервисы пространственных данных, нормативно-правовые акты, а также нормативные документы в области технического регулирования по вопросам производства, обновления, обработки и интеграции пространственных данных, которые доступны на территории Республики Узбекистан».</div></div><div class="ACT_TEXT"><div name="6273012" id="6273012">16. Внести в <a href="https://lex.uz/uz/docs/5743071">Закон </a>Республики Узбекистан от 26 ноября 2021 года № ЗРУ-731 «Об издательской деятельности» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., № 11, ст. 1063) следующие изменения:</div></div><div class="ACT_TEXT"><div name="6273013" id="6273013">в <a href="https://lex.uz/uz/docs/5743071?ONDATE=26.11.2021 00#5746106">части четвертой</a> статьи 15:</div></div><div class="ACT_TEXT"><div name="6273014" id="6273014">в <a href="https://lex.uz/uz/docs/5743071?ONDATE=26.11.2021 00#5746177">абзаце втором</a> слова «государственными стандартами» заменить словами «национальными стандартами»;</div></div><div class="ACT_TEXT"><div name="6273015" id="6273015">в <a href="https://lex.uz/uz/docs/5743071?ONDATE=26.11.2021 00#5746179">абзаце третьем</a> слова «государственных стандартов» заменить словами «национальных стандартов»;</div></div><div class="ACT_TEXT"><div name="6273016" id="6273016">в <a href="https://lex.uz/uz/docs/5743071?ONDATE=26.11.2021 00#5746408">части второй </a>статьи 24 слова «государственными стандартами» заменить словами «национальными стандартами».</div></div><div class="ACT_TEXT"><div name="6273017" id="6273017">Признать утратившими силу:</div></div><div class="ACT_TEXT"><div name="6273018" id="6273018">1) <a href="https://lex.uz/uz/docs/99870">Закон </a>Республики Узбекистан от 28 декабря 1993 года № 1002-XII «О стандартизации» (Ведомости Верховного Совета Республики Узбекистан, 1994 г., № 2, ст. 46);</div></div><div class="ACT_TEXT"><div name="6273019" id="6273019">2) <a href="https://lex.uz/uz/docs/117876">Постановление </a>Верховного Совета Республики Узбекистан от 28 декабря 1993 года № 1003-XII «О порядке введения в действие Закона Республики Узбекистан «О стандартизации» (Ведомости Верховного Совета Республики Узбекистан, 1994 г., № 2, ст. 47);</div></div><div class="ACT_TEXT"><div name="6273020" id="6273020">3) <a href="https://lex.uz/uz/docs/43455?ONDATE=09.07.2000 00#82759">раздел X</a> Закона Республики Узбекистан от 26 мая 2000 года № 82-II «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости Олий Мажлиса Республики Узбекистан, 2000 г., № 5-6, ст. 153);</div></div><div class="ACT_TEXT"><div name="6273021" id="6273021">4) <a href="https://lex.uz/uz/docs/55554?ONDATE=24.06.2003 00#57213">раздел VII</a> Закона Республики Узбекистан от 25 апреля 2003 года № 482-II «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости Олий Мажлиса Республики Узбекистан, 2003 г., № 5, ст. 67);</div></div><div class="ACT_TEXT"><div name="6273022" id="6273022">5) <a href="https://lex.uz/uz/docs/1067374?ONDATE=11.10.2006 00#1068283">статью 5</a> Закона Республики Узбекистан от 10 октября 2006 года № ЗРУ-59 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан в связи с совершенствованием системы правовой защиты и либерализацией финансовой ответственности субъектов предпринимательства» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2006 г., № 10, ст. 536);</div></div><div class="ACT_TEXT"><div name="6273023" id="6273023">6) <a href="https://lex.uz/uz/docs/1464654">Закон </a>Республики Узбекистан от 3 апреля 2009 года № ЗРУ-202 «О внесении изменений в Закон Республики Узбекистан «О стандартизации» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2009 г., № 4, ст. 129);</div></div><div class="ACT_TEXT"><div name="6273024" id="6273024">7) <a href="https://lex.uz/uz/docs/2159834?ONDATE=01.05.2013 00#2161132">статью 8</a> Закона Республики Узбекистан от 30 апреля 2013 года № ЗРУ-352 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2013 г., № 4, ст. 98);</div></div><div class="ACT_TEXT"><div name="6273025" id="6273025">8) <a href="https://lex.uz/uz/docs/2248650?ONDATE=08.10.2013 00#2248857">статью 5</a> Закона Республики Узбекистан от 7 октября 2013 года № ЗРУ-355 «О внесении изменений и дополнений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2013 г., № 10, ст. 263);</div></div><div class="ACT_TEXT"><div name="6273026" id="6273026">9) <a href="https://lex.uz/uz/docs/3235503?ONDATE=14.06.2017 00#3236371">статью 9</a> Закона Республики Узбекистан от 13 июня 2017 года № ЗРУ-436 «О внесении изменений и дополнений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2017 г., № 6, ст. 300);</div></div><div class="ACT_TEXT"><div name="6273027" id="6273027">10) <a href="https://lex.uz/uz/docs/3340556?ONDATE=15.09.2017 00#3342626">статью 12</a> Закона Республики Узбекистан от 14 сентября 2017 года № ЗРУ-446 «О внесении изменений и дополнений, а также признании утратившими силу некоторых законодательных актов Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2017 г., № 9, ст. 510);</div></div><div class="ACT_TEXT"><div name="6273028" id="6273028">11) <a href="https://lex.uz/uz/docs/4661844?ONDATE=25.12.2019 00#4662251">статью 4</a> Закона Республики Узбекистан от 24 декабря 2019 года № ЗРУ-597 «О внесении изменений и дополнений в некоторые законодательные акты Республики Узбекистан в связи с совершенствованием деятельности отдельных государственных органов» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2019 г., № 12, ст. 891);</div></div><div class="ACT_TEXT"><div name="6273029" id="6273029">12) статью 36 <a href="https://lex.uz/uz/docs/5388565">Закона </a>Республики Узбекистан от 21 апреля 2021 года № ЗРУ-683 «О внесении изменений в некоторые законодательные акты Республики Узбекистан» (Ведомости палат Олий Мажлиса Республики Узбекистан, 2021 г., приложение к № 4).</div></div><div class="CLAUSE_DEFAULT"><div name="6273030" id="6273030">Статья 29. Обеспечение исполнения, доведения, разъяснения сути и значения настоящего Закона</div></div><div class="ACT_TEXT"><div name="6273031" id="6273031">Узбекскому агентству по техническому регулированию, Министерству юстиции Республики Узбекистан и другим заинтересованным организациям обеспечить исполнение, доведение до исполнителей и разъяснение среди населения сути и значения настоящего Закона.</div></div><div class="CLAUSE_DEFAULT"><div name="6273032" id="6273032">Статья 30. Приведение законодательства в соответствие с настоящим Законом</div></div><div class="ACT_TEXT"><div name="6273033" id="6273033">Кабинету Министров Республики Узбекистан:</div></div><div class="ACT_TEXT"><div name="6273034" id="6273034">привести решения правительства в соответствие с настоящим Законом;</div></div><div class="ACT_TEXT"><div name="6273035" id="6273035">обеспечить пересмотр и отмену органами государственного управления их нормативно-правовых актов, противоречащих настоящему Закону.</div></div><div class="CLAUSE_DEFAULT"><div name="6273036" id="6273036">Статья 31. Вступление в силу настоящего Закона</div></div><div class="ACT_TEXT"><div name="6273037" id="6273037">Настоящий Закон вступает в силу по истечении двенадцати месяцев со дня его официального опубликования.</div></div><div class="ACT_TEXT"><div name="6273038" id="6273038">Действующие стандарты Республики Узбекистан и соответствующие документы, принятые до вступления в силу настоящего Закона с обозначением аббревиатуры OʻzDSt, считаются национальными стандартами и должны быть пересмотрены в течение пяти лет со дня вступления в силу настоящего Закона.</div></div><div class="SIGNATURE"><div name="6273039" id="6273039">Президент Республики Узбекистан Ш. МИРЗИЁЕВ</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6273040" id="6273040">г. Ташкент,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="6273041" id="6273041">3 ноября 2022 г.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="6273042" id="6273042">№ ЗРУ-800</div></div><div class="PUBLICATION_ORIGIN"><label id="s1089"></label><div name="6272595" id="6272595">(Национальная база данных законодательства, 04.11.2022 г., № 03/22/800/0990; 08.08.2024 г., № 03/24/939/0595; 28.12.2024 г., № 03/24/1015/1087)</div></div></div>
</div></body></html>